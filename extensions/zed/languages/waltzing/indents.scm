; Indentation rules for Waltzing templates

; Content blocks (function bodies, control flow)
(content_block) @indent

; HTML elements
(html_element) @indent

; Definitions
(struct_definition) @indent
(enum_definition) @indent
(function_definition) @indent

; Control flow
(if_statement) @indent
(for_loop) @indent
(match_statement) @indent
(match_arm) @indent

; Function tags
(container_function_tag) @indent
