@*
 * Input OTP component
 * One-time password input with individual digit boxes
 *
 * @example
 * @import components/input-otp.wtz as input_otp
 *
 * // Basic 6-digit OTP input
 * <@input_otp::apply name="otp" length=6 />
 *
 * // 4-digit PIN
 * <@input_otp::apply name="pin" length=4 />
 *
 * // With separator (XXX-XXX pattern)
 * <@input_otp::with_separator name="code" length=6 separator_after=3 />
 *
 * // Disabled state
 * <@input_otp::apply name="otp" length=6 disabled=true />
 *@


@fn apply(
    name: &str,
    length: u32,
    disabled: bool = false,
    class: &str = "",
) {
    @let container_base = "flex items-center gap-2"
    @let input_base = "h-10 w-10 text-center text-sm font-medium rounded-md border border-input bg-transparent shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"

    <div
        class=@cn(&[container_base, class])
        x-data=@```json {
            digits: Array(@length).fill(''),
            get value() { return this.digits.join(''); },
            focusInput(index) {
                const inputs = this.$el.querySelectorAll('input[data-otp-input]');
                if (inputs[index]) inputs[index].focus();
            },
            handleInput(index, event) {
                const val = event.target.value;
                if (!/^\d*$/.test(val)) {
                    event.target.value = this.digits[index];
                    return;
                }
                if (val.length > 1) {
                    const chars = val.split('').filter(c => /\d/.test(c)).slice(0, @length - index);
                    chars.forEach((c, i) => {
                        if (index + i < @length) this.digits[index + i] = c;
                    });
                    this.focusInput(Math.min(index + chars.length, @length - 1));
                } else {
                    this.digits[index] = val;
                    if (val && index < @length - 1) this.focusInput(index + 1);
                }
                this.$refs.hidden.value = this.value;
                this.$dispatch('input', { name: @name, value: this.value });
            },
            handleKeydown(index, event) {
                if (event.key === 'Backspace') {
                    if (!this.digits[index] && index > 0) {
                        this.focusInput(index - 1);
                    } else {
                        this.digits[index] = '';
                    }
                    this.$refs.hidden.value = this.value;
                } else if (event.key === 'ArrowLeft' && index > 0) {
                    this.focusInput(index - 1);
                } else if (event.key === 'ArrowRight' && index < @length - 1) {
                    this.focusInput(index + 1);
                }
            },
            handlePaste(event) {
                event.preventDefault();
                const paste = (event.clipboardData || window.clipboardData).getData('text');
                const chars = paste.split('').filter(c => /\d/.test(c)).slice(0, @length);
                chars.forEach((c, i) => { this.digits[i] = c; });
                this.focusInput(Math.min(chars.length, @length - 1));
                this.$refs.hidden.value = this.value;
                this.$dispatch('input', { name: @name, value: this.value });
            }
        } ```@
    >
        @* Hidden input for form submission *@
        <input type="hidden" name=@name x-ref="hidden" :value="value" />

        @for i in 0..length {
            <input
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength=@length
                data-otp-input
                class=@input_base
                :value="digits[@i]"
                x-on:input="handleInput(@i, $event)"
                x-on:keydown="handleKeydown(@i, $event)"
                x-on:paste="handlePaste($event)"
                x-on:focus="$event.target.select()"
                @if disabled { disabled }
            />
        }
    </div>
}

@* OTP input with separator between groups *@
@fn with_separator(
    name: &str,
    length: u32,
    separator_after: u32,
    disabled: bool = false,
    class: &str = "",
) {
    @let container_base = "flex items-center gap-2"
    @let input_base = "h-10 w-10 text-center text-sm font-medium rounded-md border border-input bg-transparent shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
    @let separator_cls = "text-muted-foreground text-xl font-light"

    <div
        class=@cn(&[container_base, class])
        x-data=@```json {
            digits: Array(@length).fill(''),
            get value() { return this.digits.join(''); },
            focusInput(index) {
                const inputs = this.$el.querySelectorAll('input[data-otp-input]');
                if (inputs[index]) inputs[index].focus();
            },
            handleInput(index, event) {
                const val = event.target.value;
                if (!/^\d*$/.test(val)) {
                    event.target.value = this.digits[index];
                    return;
                }
                if (val.length > 1) {
                    const chars = val.split('').filter(c => /\d/.test(c)).slice(0, @length - index);
                    chars.forEach((c, i) => {
                        if (index + i < @length) this.digits[index + i] = c;
                    });
                    this.focusInput(Math.min(index + chars.length, @length - 1));
                } else {
                    this.digits[index] = val;
                    if (val && index < @length - 1) this.focusInput(index + 1);
                }
                this.$refs.hidden.value = this.value;
                this.$dispatch('input', { name: @name, value: this.value });
            },
            handleKeydown(index, event) {
                if (event.key === 'Backspace') {
                    if (!this.digits[index] && index > 0) {
                        this.focusInput(index - 1);
                    } else {
                        this.digits[index] = '';
                    }
                    this.$refs.hidden.value = this.value;
                } else if (event.key === 'ArrowLeft' && index > 0) {
                    this.focusInput(index - 1);
                } else if (event.key === 'ArrowRight' && index < @length - 1) {
                    this.focusInput(index + 1);
                }
            },
            handlePaste(event) {
                event.preventDefault();
                const paste = (event.clipboardData || window.clipboardData).getData('text');
                const chars = paste.split('').filter(c => /\d/.test(c)).slice(0, @length);
                chars.forEach((c, i) => { this.digits[i] = c; });
                this.focusInput(Math.min(chars.length, @length - 1));
                this.$refs.hidden.value = this.value;
                this.$dispatch('input', { name: @name, value: this.value });
            }
        } ```@
    >
        @* Hidden input for form submission *@
        <input type="hidden" name=@name x-ref="hidden" :value="value" />

        @for i in 0..length {
            @* Add separator after specified position *@
            @if (i > 0) && ((i % separator_after) == 0) {
                <span class=@separator_cls>-</span>
            }
            <input
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength=@length
                data-otp-input
                class=@input_base
                :value="digits[@i]"
                x-on:input="handleInput(@i, $event)"
                x-on:keydown="handleKeydown(@i, $event)"
                x-on:paste="handlePaste($event)"
                x-on:focus="$event.target.select()"
                @if disabled { disabled }
            />
        }
    </div>
}

@* Simple 6-digit OTP input *@
@fn simple(name: &str) {
    <@apply name=@name length=6 />
}

@* 4-digit PIN input *@
@fn pin(name: &str) {
    <@apply name=@name length=4 />
}

@* 6-digit OTP with dash separator (XXX-XXX) *@
@fn split(name: &str) {
    <@with_separator name=@name length=6 separator_after=3 />
}

@* Disabled OTP input *@
@fn disabled(name: &str, length: u32) {
    <@apply name=@name length=@length disabled=true />
}
