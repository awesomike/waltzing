@*
 * Toast component
 * Temporary notification messages with auto-dismiss
 *
 * @example
 * @import components/toast.wtz as toast
 *
 * Toast container (place once in your layout):
 * <@toast::container position="top-right" />
 *
 * Show a toast (typically triggered via Alpine.js event):
 * <@toast::apply
 *     variant=toast::Variant::Success
 *     title="Saved!"
 *     description=Some("Your changes have been saved.")
 *     duration=Some(5000)
 * />
 *
 * Shorthand variants:
 * <@toast::success title="Success" description=Some("Operation completed.") />
 * <@toast::error title="Error" description=Some("Something went wrong.") />
 * <@toast::warning title="Warning" description=Some("Please review your input.") />
 *@

@import lib/utils.wtz as utils

@enum Variant {
    Default,
    Success,
    Error,
    Warning,
}

@* Toast container for positioning - place once in layout *@
@fn container(position: &str = "bottom-right", class: Option<&str> = None) {
    @let position_cls = {
        match position {
            "top-left" => "top-0 left-0",
            "top-center" => "top-0 left-1/2 -translate-x-1/2",
            "top-right" => "top-0 right-0",
            "bottom-left" => "bottom-0 left-0",
            "bottom-center" => "bottom-0 left-1/2 -translate-x-1/2",
            "bottom-right" | _ => "bottom-0 right-0",
        }
    }

    @let extra_cls = class.unwrap_or("")
    @let cls_parts = vec!["fixed z-[100] flex flex-col gap-2 p-4 max-h-screen overflow-hidden pointer-events-none", position_cls, extra_cls]
    @let container_cls = utils::cn(cls_parts)

    <div
        id="toast-container"
        class="@container_cls"
        x-data="{ toasts: [] }"
        @toast.window="
            const id = Date.now();
            toasts.push({ id, ...$event.detail });
            if ($event.detail.duration !== 0) {
                setTimeout(() => {
                    toasts = toasts.filter(t => t.id !== id);
                }, $event.detail.duration || 5000);
            }
        "
    >
        <template x-for="toast in toasts" :key="toast.id">
            <div
                class="pointer-events-auto w-full max-w-sm rounded-lg border bg-background p-4 shadow-lg transition-all duration-300"
                :class="{
                    'border-border': toast.variant === 'default',
                    'border-green-500/50 bg-green-50 dark:bg-green-950': toast.variant === 'success',
                    'border-destructive/50 bg-red-50 dark:bg-red-950': toast.variant === 'error',
                    'border-yellow-500/50 bg-yellow-50 dark:bg-yellow-950': toast.variant === 'warning'
                }"
                x-transition:enter="transform ease-out duration-300"
                x-transition:enter-start="translate-x-full opacity-0"
                x-transition:enter-end="translate-x-0 opacity-100"
                x-transition:leave="transform ease-in duration-200"
                x-transition:leave-start="translate-x-0 opacity-100"
                x-transition:leave-end="translate-x-full opacity-0"
                role="alert"
                aria-live="assertive"
            >
                <div class="flex items-start gap-3">
                    @* Icon based on variant *@
                    <template x-if="toast.variant === 'success'">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600 dark:text-green-400 shrink-0 mt-0.5">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </template>
                    <template x-if="toast.variant === 'error'">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-destructive shrink-0 mt-0.5">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </template>
                    <template x-if="toast.variant === 'warning'">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-600 dark:text-yellow-400 shrink-0 mt-0.5">
                            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                    </template>

                    @* Content *@
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold" x-text="toast.title"></p>
                        <template x-if="toast.description">
                            <p class="mt-1 text-sm text-muted-foreground" x-text="toast.description"></p>
                        </template>
                    </div>

                    @* Close button *@
                    <button
                        type="button"
                        class="shrink-0 rounded-md p-1 opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                        @click="toasts = toasts.filter(t => t.id !== toast.id)"
                        aria-label="Close"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 6 6 18"></path>
                            <path d="m6 6 12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </template>
    </div>
}

@* Individual toast - renders a static toast (for SSR or non-JS fallback) *@
@fn apply(
    variant: Variant = Variant::Default,
    title: &str,
    description: Option<&str> = None,
    duration: Option<u32> = None,
    class: Option<&str> = None,
) {
    @let base = "pointer-events-auto w-full max-w-sm rounded-lg border p-4 shadow-lg"

    @let variant_cls = match variant {
        Variant::Default => { "border-border bg-background text-foreground" }
        Variant::Success => { "border-green-500/50 bg-green-50 dark:bg-green-950 text-green-900 dark:text-green-100" }
        Variant::Error => { "border-destructive/50 bg-red-50 dark:bg-red-950 text-destructive" }
        Variant::Warning => { "border-yellow-500/50 bg-yellow-50 dark:bg-yellow-950 text-yellow-900 dark:text-yellow-100" }
    }

    @let extra_cls = class.unwrap_or("")
    @let cls_parts = vec![base, variant_cls, extra_cls]
    @let toast_cls = utils::cn(cls_parts)

    @let duration_ms = duration.unwrap_or(5000)

    <div
        class="@toast_cls"
        role="alert"
        aria-live="assertive"
        x-data="{ show: true }"
        x-show="show"
        x-init="setTimeout(() => show = false, @duration_ms)"
        x-transition:enter="transform ease-out duration-300"
        x-transition:enter-start="translate-x-full opacity-0"
        x-transition:enter-end="translate-x-0 opacity-100"
        x-transition:leave="transform ease-in duration-200"
        x-transition:leave-start="translate-x-0 opacity-100"
        x-transition:leave-end="translate-x-full opacity-0"
    >
        <div class="flex items-start gap-3">
            @* Icon *@
            @match variant {
                Variant::Success => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600 dark:text-green-400 shrink-0 mt-0.5">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                }
                Variant::Error => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-destructive shrink-0 mt-0.5">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                }
                Variant::Warning => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-600 dark:text-yellow-400 shrink-0 mt-0.5">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                }
                Variant::Default => {}
            }

            @* Content *@
            <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold">@title</p>
                @if let Some(desc) = description {
                    <p class="mt-1 text-sm text-muted-foreground">@desc</p>
                }
            </div>

            @* Close button *@
            <button
                type="button"
                class="shrink-0 rounded-md p-1 opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                @click="show = false"
                aria-label="Close"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>
        </div>
    </div>
}

@* Shorthand for default toast *@
@fn default(title: &str, description: Option<&str> = None, duration: Option<u32> = None) {
    <@apply variant=Variant::Default title=@title description=@description duration=@duration />
}

@* Shorthand for success toast *@
@fn success(title: &str, description: Option<&str> = None, duration: Option<u32> = None) {
    <@apply variant=Variant::Success title=@title description=@description duration=@duration />
}

@* Shorthand for error toast *@
@fn error(title: &str, description: Option<&str> = None, duration: Option<u32> = None) {
    <@apply variant=Variant::Error title=@title description=@description duration=@duration />
}

@* Shorthand for warning toast *@
@fn warning(title: &str, description: Option<&str> = None, duration: Option<u32> = None) {
    <@apply variant=Variant::Warning title=@title description=@description duration=@duration />
}

@* Helper to trigger a toast from Alpine.js *@
@* Usage: <button @click="$dispatch('toast', { title: 'Hello', variant: 'success' })">Show Toast</button> *@
@fn trigger_script() {
    <script>
        // Toast helper - dispatch custom event to show toast
        window.showToast = function(options) {
            window.dispatchEvent(new CustomEvent('toast', {
                detail: {
                    title: options.title || 'Notification',
                    description: options.description || null,
                    variant: options.variant || 'default',
                    duration: options.duration || 5000
                }
            }));
        };
    </script>
}
