@*
 * Badge component
 * Small status indicator or tag
 *
 * @example
 * @import components/badge.wtz as badge
 *
 * <@badge::default>New</@badge::default>
 * <@badge::secondary>Pending</@badge::secondary>
 * <@badge::destructive>Error</@badge::destructive>
 *
 * <@badge variant=badge::Variant::Outline class="ml-2">
 *     Custom
 * </@badge>
 *@

@enum Variant {
    Default,
    Secondary,
    Outline,
    Destructive,
}

@fn apply(
    variant: Variant = Variant::Default,
    class: &str = "",
    content: @(),
) {
    @let base = "inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"

    @match variant {
        Variant::Default => {
            <span class=@cn(&[base, "border-transparent bg-primary text-primary-foreground shadow hover:bg-primary/80", class])>
                @content()
            </span>
        }
        Variant::Secondary => {
            <span class=@cn(&[base, "border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80", class])>
                @content()
            </span>
        }
        Variant::Outline => {
            <span class=@cn(&[base, "text-foreground", class])>
                @content()
            </span>
        }
        Variant::Destructive => {
            <span class=@cn(&[base, "border-transparent bg-destructive text-destructive-foreground shadow hover:bg-destructive/80", class])>
                @content()
            </span>
        }
    }
}

@* Shorthand for default badge *@
@fn default(class: &str = "", content: @()) {
    <@apply variant=Variant::Default class=@class>
        @content()
    </@apply>
}

@* Shorthand for secondary badge *@
@fn secondary(class: &str = "", content: @()) {
    <@apply variant=Variant::Secondary class=@class>
        @content()
    </@apply>
}

@* Shorthand for outline badge *@
@fn outline(class: &str = "", content: @()) {
    <@apply variant=Variant::Outline class=@class>
        @content()
    </@apply>
}

@* Shorthand for destructive badge *@
@fn destructive(class: &str = "", content: @()) {
    <@apply variant=Variant::Destructive class=@class>
        @content()
    </@apply>
}
