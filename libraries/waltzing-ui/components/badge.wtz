@*
 * Badge component
 * Small status indicator or tag
 *@

@import lib/utils.wtz as utils

@enum Variant {
    Default,
    Secondary,
    Outline,
    Destructive,
}

@fn apply(
    variant: Variant,
    class: Option<&str>,
    content: @(),
) {
    @let base = "inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"

    @let variant_cls = @match variant {
        Variant::Default => { "border-transparent bg-primary text-primary-foreground shadow hover:bg-primary/80" }
        Variant::Secondary => { "border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80" }
        Variant::Outline => { "text-foreground" }
        Variant::Destructive => { "border-transparent bg-destructive text-destructive-foreground shadow hover:bg-destructive/80" }
    }

    <span class="@utils::cn(&[@base, @variant_cls, @class.unwrap_or("")])">
        @content()
    </span>
}

@* Shorthand for default badge *@
@fn default(content: @()) {
    <@apply variant=Variant::Default class=None>
        @content()
    </@>
}

@* Shorthand for secondary badge *@
@fn secondary(content: @()) {
    <@apply variant=Variant::Secondary class=None>
        @content()
    </@>
}

@* Shorthand for outline badge *@
@fn outline(content: @()) {
    <@apply variant=Variant::Outline class=None>
        @content()
    </@>
}

@* Shorthand for destructive badge *@
@fn destructive(content: @()) {
    <@apply variant=Variant::Destructive class=None>
        @content()
    </@>
}
