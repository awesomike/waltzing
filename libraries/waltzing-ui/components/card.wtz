@*
 * Card component
 * A container with optional header and footer slots
 *@


@fn apply(
    header: Option<@()>,
    footer: Option<@()>,
    class: &str = "",
    content: @(),
) {
    @let extra = class
    @let classes = vec!["rounded-xl border bg-card text-card-foreground shadow", extra]
    <div class="@cn(classes)">
        @if let Some(h) = header {
            <div class="flex flex-col space-y-1.5 p-6">
                @h()
            </div>
        }
        <div class="p-6 pt-0">
            @content()
        </div>
        @if let Some(f) = footer {
            <div class="flex items-center p-6 pt-0">
                @f()
            </div>
        }
    </div>
}

@* Card with just content *@
@fn simple(class: &str = "", content: @()) {
    @let extra = class
    @let classes = vec!["rounded-xl border bg-card text-card-foreground shadow p-6", extra]
    <div class="@cn(classes)">
        @content()
    </div>
}

@* Card header component for composition *@
@fn header(class: &str = "", content: @()) {
    @let extra = class
    @let classes = vec!["flex flex-col space-y-1.5 p-6", extra]
    <div class="@cn(classes)">
        @content()
    </div>
}

@* Card title *@
@fn title(class: &str = "", content: @()) {
    @let extra = class
    @let classes = vec!["font-semibold leading-none tracking-tight", extra]
    <h3 class="@cn(classes)">
        @content()
    </h3>
}

@* Card description *@
@fn description(class: &str = "", content: @()) {
    @let extra = class
    @let classes = vec!["text-sm text-muted-foreground", extra]
    <p class="@cn(classes)">
        @content()
    </p>
}

@* Card content area *@
@fn content(class: &str = "", content: @()) {
    @let extra = class
    @let classes = vec!["p-6 pt-0", extra]
    <div class="@cn(classes)">
        @content()
    </div>
}

@* Card footer *@
@fn footer(class: &str = "", content: @()) {
    @let extra = class
    @let classes = vec!["flex items-center p-6 pt-0", extra]
    <div class="@cn(classes)">
        @content()
    </div>
}
