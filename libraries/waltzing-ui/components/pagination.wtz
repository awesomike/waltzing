@*
 * Pagination component
 * Page navigation controls with prev/next and page numbers
 *
 * Usage:
 *   @import ui/components/pagination.wtz as pagination
 *
 *   Full pagination with page numbers:
 *   <@pagination::apply current=3 total=10 siblings=1 href_template="/posts?page={page}" />
 *
 *   Simple prev/next only:
 *   <@pagination::simple
 *       current=2
 *       total=5
 *       prev_url=Some("/posts?page=1")
 *       next_url=Some("/posts?page=3")
 *   />
 *
 *   Or build manually with components:
 *   <@pagination::root>
 *       <@pagination::content>
 *           <@pagination::prev_enabled href="/posts?page=1" />
 *           <@pagination::link href="/posts?page=1" is_active=false>1</@>
 *           <@pagination::link href="/posts?page=2" is_active=true>2</@>
 *           <@pagination::ellipsis />
 *           <@pagination::link href="/posts?page=10" is_active=false>10</@>
 *           <@pagination::next_enabled href="/posts?page=3" />
 *       </@>
 *   </@>
 *@


@* Root pagination container *@
@fn root(
    class: Option<&str> = None,
    content: @(),
) {
    <nav
        role="navigation"
        aria-label="pagination"
        class=@cn(&["mx-auto flex w-full justify-center", class.unwrap_or("")])
    >
        @content()
    </nav>
}

@* Pagination content wrapper (ul) *@
@fn content(
    class: Option<&str> = None,
    content: @(),
) {
    <ul class=@cn(&["flex flex-row items-center gap-1", class.unwrap_or("")])>
        @content()
    </ul>
}

@* Pagination item wrapper (li) *@
@fn item(
    class: Option<&str> = None,
    content: @(),
) {
    <li class=@class.unwrap_or("")>
        @content()
    </li>
}

@* Page number link *@
@fn link(
    href: &str,
    is_active: bool,
    class: Option<&str> = None,
    content: @(),
) {
    @let base = "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 h-9 w-9"
    @let active_cls = utils::class_if(is_active, "border border-input bg-background shadow-sm pointer-events-none")
    @let inactive_cls = utils::class_if(!is_active, "hover:bg-accent hover:text-accent-foreground")

    <@item>
        <a
            href=@href
            class=@cn(&[base, active_cls, inactive_cls, class.unwrap_or("")])
            @if is_active { aria-current="page" }
        >
            @content()
        </a>
    </@>
}

@* Previous page button (enabled) *@
@fn prev_enabled(
    href: &str,
    class: Option<&str> = None,
) {
    @let base = "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-9 px-4 py-2 gap-1 pl-2.5 hover:bg-accent hover:text-accent-foreground"

    <@item>
        <a
            href=@href
            class=@cn(&[base, class.unwrap_or("")])
            aria-label="Go to previous page"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                <path d="m15 18-6-6 6-6"/>
            </svg>
            <span>Previous</span>
        </a>
    </@>
}

@* Previous page button (disabled) *@
@fn prev_disabled(
    class: Option<&str> = None,
) {
    @let base = "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors h-9 px-4 py-2 gap-1 pl-2.5 pointer-events-none opacity-50"

    <@item>
        <span
            class=@cn(&[base, class.unwrap_or("")])
            aria-disabled="true"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                <path d="m15 18-6-6 6-6"/>
            </svg>
            <span>Previous</span>
        </span>
    </@>
}

@* Next page button (enabled) *@
@fn next_enabled(
    href: &str,
    class: Option<&str> = None,
) {
    @let base = "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-9 px-4 py-2 gap-1 pr-2.5 hover:bg-accent hover:text-accent-foreground"

    <@item>
        <a
            href=@href
            class=@cn(&[base, class.unwrap_or("")])
            aria-label="Go to next page"
        >
            <span>Next</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                <path d="m9 18 6-6-6-6"/>
            </svg>
        </a>
    </@>
}

@* Next page button (disabled) *@
@fn next_disabled(
    class: Option<&str> = None,
) {
    @let base = "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors h-9 px-4 py-2 gap-1 pr-2.5 pointer-events-none opacity-50"

    <@item>
        <span
            class=@cn(&[base, class.unwrap_or("")])
            aria-disabled="true"
        >
            <span>Next</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                <path d="m9 18 6-6-6-6"/>
            </svg>
        </span>
    </@>
}

@* Ellipsis indicator for skipped pages *@
@fn ellipsis(
    class: Option<&str> = None,
) {
    <@item>
        <span
            aria-hidden="true"
            class=@cn(&["flex h-9 w-9 items-center justify-center", class.unwrap_or("")])
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                <circle cx="12" cy="12" r="1"/>
                <circle cx="19" cy="12" r="1"/>
                <circle cx="5" cy="12" r="1"/>
            </svg>
            <span class="sr-only">More pages</span>
        </span>
    </@>
}

@* Simple pagination with just prev/next buttons *@
@fn simple(
    current: u32,
    total: u32,
    prev_url: Option<&str>,
    next_url: Option<&str>,
    class: Option<&str> = None,
) {
    @let is_first = (current == 1)
    @let is_last = (current == total)
    @let prev_href = prev_url.unwrap_or("#")
    @let next_href = next_url.unwrap_or("#")

    <@root class=@class>
        <@content>
            @if is_first {
                <@prev_disabled />
            }
            @if !is_first {
                <@prev_enabled href=@prev_href />
            }
            <@item>
                <span class="text-sm text-muted-foreground px-4">
                    Page @current of @total
                </span>
            </@>
            @if is_last {
                <@next_disabled />
            }
            @if !is_last {
                <@next_enabled href=@next_href />
            }
        </@>
    </@>
}

@* Full pagination with page numbers and ellipsis *@
@fn apply(
    current: u32,
    total: u32,
    siblings: u32,
    href_template: &str,
    class: Option<&str> = None,
) {
    @let is_first = (current == 1)
    @let is_last = (current == total)

    @* Calculate the range of page numbers to show *@
    @let start = {
        let s = if current > siblings + 1 { current - siblings } else { 1 };
        if s < 1 { 1 } else { s }
    }
    @let end = {
        let e = current + siblings;
        if e > total { total } else { e }
    }

    @* Determine if we need ellipsis *@
    @let show_left_ellipsis = (start > 2)
    @let show_right_ellipsis = (end < (total - 1))
    @let prev_href = { href_template.replace("{page}", &(current - 1).to_string()) }
    @let next_href = { href_template.replace("{page}", &(current + 1).to_string()) }

    <@root class=@class>
        <@content>
            @* Previous button *@
            @if is_first {
                <@prev_disabled />
            }
            @if !is_first {
                <@prev_enabled href=&prev_href />
            }

            @* First page (always show if not in range) *@
            @if start > 1 {
                @let first_href = { href_template.replace("{page}", "1") }
                <@link href=&first_href is_active=false>1</@>
            }

            @* Left ellipsis *@
            @if show_left_ellipsis {
                <@ellipsis />
            }

            @* Page numbers in range *@
            @for page in start..=end {
                @let page_href = { href_template.replace("{page}", &page.to_string()) }
                @let is_current = (page == current)
                <@link href=&page_href is_active=@is_current>
                    @page
                </@>
            }

            @* Right ellipsis *@
            @if show_right_ellipsis {
                <@ellipsis />
            }

            @* Last page (always show if not in range) *@
            @if end < total {
                @let last_href = { href_template.replace("{page}", &total.to_string()) }
                <@link href=&last_href is_active=false>@total</@>
            }

            @* Next button *@
            @if is_last {
                <@next_disabled />
            }
            @if !is_last {
                <@next_enabled href=&next_href />
            }
        </@>
    </@>
}
