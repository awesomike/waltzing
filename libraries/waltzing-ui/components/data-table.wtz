@*
 * Data Table component
 * Enhanced table with sorting, filtering, pagination, and row selection
 * Uses Alpine.js for client-side state management
 *
 * Usage:
 *   @import ui/components/data-table.wtz as data_table
 *
 *   Define columns:
 *   @let columns = vec![
 *       data_table::Column { key: "name".into(), label: "Name".into(), sortable: true },
 *       data_table::Column { key: "email".into(), label: "Email".into(), sortable: true },
 *       data_table::Column { key: "status".into(), label: "Status".into(), sortable: false },
 *   ]
 *
 *   Basic usage with server-side data:
 *   <@data_table::apply
 *       columns=@columns
 *       current_page=1
 *       total_pages=10
 *       total_items=100
 *       page_size=10
 *       sort_key="name"
 *       sort_dir="asc"
 *       searchable=true
 *       selectable=true
 *   >
 *       <@data_table::selectable_row row_id="1">
 *           <@data_table::cell>John Doe</@>
 *           <@data_table::cell>john@example.com</@>
 *           <@data_table::cell>Active</@>
 *       </@>
 *   </@>
 *
 * Events dispatched:
 *   - sort-change: { key: string, dir: 'asc'|'desc'|'' }
 *   - search-change: { query: string }
 *   - selection-change: { selected: string[] }
 *   - page-change: { page: number }
 *@


@* Column definition struct *@
@struct Column {
    key: String,
    label: String,
    sortable: bool,
}


@* Main data table component *@
@fn apply(
    columns: Vec<Column>,
    current_page: u32,
    total_pages: u32,
    total_items: u32,
    page_size: u32,
    sort_key: &str = "",
    sort_dir: &str = "",
    searchable: bool = false,
    selectable: bool = false,
    search_placeholder: &str = "Search...",
    class: &str = "",
    content: @(),
) {
    @let is_first = (current_page == 1)
    @let is_last = (current_page == total_pages)

    <div
        class=@cn(&["w-full", class])
        x-data=@```json {
            sortKey: '@sort_key',
            sortDir: '@sort_dir',
            search: '',
            selectedRows: new Set(),
            allSelected: false,
            toggleSort(key) {
                if (this.sortKey === key) {
                    if (this.sortDir === 'asc') {
                        this.sortDir = 'desc';
                    } else if (this.sortDir === 'desc') {
                        this.sortKey = '';
                        this.sortDir = '';
                    } else {
                        this.sortDir = 'asc';
                    }
                } else {
                    this.sortKey = key;
                    this.sortDir = 'asc';
                }
                this.$dispatch('sort-change', { key: this.sortKey, dir: this.sortDir });
            },
            toggleRow(id) {
                if (this.selectedRows.has(id)) {
                    this.selectedRows.delete(id);
                } else {
                    this.selectedRows.add(id);
                }
                this.selectedRows = new Set(this.selectedRows);
                this.updateAllSelected();
                this.$dispatch('selection-change', { selected: Array.from(this.selectedRows) });
            },
            toggleAll() {
                const rows = this.$refs.tbody.querySelectorAll('[data-row-id]');
                if (this.allSelected) {
                    this.selectedRows = new Set();
                } else {
                    rows.forEach(row => this.selectedRows.add(row.dataset.rowId));
                }
                this.selectedRows = new Set(this.selectedRows);
                this.allSelected = !this.allSelected;
                this.$dispatch('selection-change', { selected: Array.from(this.selectedRows) });
            },
            updateAllSelected() {
                const rows = this.$refs.tbody.querySelectorAll('[data-row-id]');
                this.allSelected = rows.length > 0 && this.selectedRows.size === rows.length;
            },
            isSelected(id) {
                return this.selectedRows.has(id);
            },
            onSearch() {
                this.$dispatch('search-change', { query: this.search });
            }
        }```@
    >
        @* Toolbar with search *@
        @if searchable {
            <div class="flex items-center py-4">
                <input
                    type="text"
                    x-model="search"
                    x-on:input.debounce.300ms="onSearch()"
                    placeholder="@search_placeholder"
                    class="flex h-9 w-full max-w-sm rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                />
            </div>
        }

        @* Table container *@
        <div class="relative w-full overflow-auto rounded-md border">
            <table class="w-full caption-bottom text-sm">
                <thead class="[&_tr]:border-b">
                    <tr class="border-b transition-colors hover:bg-muted/50">
                        @* Select all checkbox *@
                        @if selectable {
                            <th class="h-10 w-12 px-2 text-left align-middle font-medium text-muted-foreground">
                                <div class="flex items-center justify-center">
                                    <input
                                        type="checkbox"
                                        class="h-4 w-4 rounded border border-primary ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                                        :checked="allSelected"
                                        x-on:click="toggleAll()"
                                        aria-label="Select all"
                                    />
                                </div>
                            </th>
                        }
                        @* Column headers *@
                        @for col in columns {
                            <@header_cell
                                key=&col.key
                                label=&col.label
                                sortable=@col.sortable
                            />
                        }
                    </tr>
                </thead>
                <tbody x-ref="tbody" class="[&_tr:last-child]:border-0">
                    @content()
                </tbody>
            </table>
        </div>

        @* Footer with pagination *@
        <div class="flex items-center justify-between px-2 py-4">
            @* Selection info *@
            @if selectable {
                <div class="flex-1 text-sm text-muted-foreground">
                    <span x-text="selectedRows.size"></span> of @total_items row(s) selected
                </div>
            }
            @if !selectable {
                <div class="flex-1 text-sm text-muted-foreground">
                    @total_items results
                </div>
            }

            @* Pagination controls *@
            <div class="flex items-center space-x-6 lg:space-x-8">
                <div class="flex items-center space-x-2">
                    @* First page *@
                    <button
                        class=@cn(&["inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-8 w-8 border border-input bg-transparent shadow-sm", class_if(is_first, "pointer-events-none opacity-50"), class_if(!is_first, "hover:bg-accent hover:text-accent-foreground")])
                        @if is_first { disabled }
                        aria-label="Go to first page"
                        x-on:click="$dispatch('page-change', { page: 1 })"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                            <path d="m11 17-5-5 5-5"/>
                            <path d="m18 17-5-5 5-5"/>
                        </svg>
                    </button>
                    @* Previous page *@
                    <button
                        class=@cn(&["inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-8 w-8 border border-input bg-transparent shadow-sm", class_if(is_first, "pointer-events-none opacity-50"), class_if(!is_first, "hover:bg-accent hover:text-accent-foreground")])
                        @if is_first { disabled }
                        aria-label="Go to previous page"
                        x-on:click="$dispatch('page-change', { page: @(current_page - 1) })"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                    </button>

                    @* Page indicator *@
                    <div class="flex w-[100px] items-center justify-center text-sm font-medium">
                        Page @current_page of @total_pages
                    </div>

                    @* Next page *@
                    <button
                        class=@cn(&["inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-8 w-8 border border-input bg-transparent shadow-sm", class_if(is_last, "pointer-events-none opacity-50"), class_if(!is_last, "hover:bg-accent hover:text-accent-foreground")])
                        @if is_last { disabled }
                        aria-label="Go to next page"
                        x-on:click="$dispatch('page-change', { page: @(current_page + 1) })"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                            <path d="m9 18 6-6-6-6"/>
                        </svg>
                    </button>
                    @* Last page *@
                    <button
                        class=@cn(&["inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-8 w-8 border border-input bg-transparent shadow-sm", class_if(is_last, "pointer-events-none opacity-50"), class_if(!is_last, "hover:bg-accent hover:text-accent-foreground")])
                        @if is_last { disabled }
                        aria-label="Go to last page"
                        x-on:click="$dispatch('page-change', { page: @total_pages })"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                            <path d="m13 17 5-5-5-5"/>
                            <path d="m6 17 5-5-5-5"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Header cell with optional sort functionality *@
@fn header_cell(
    key: &str,
    label: &str,
    sortable: bool,
    class: &str = "",
) {
    @let base = "h-10 px-2 text-left align-middle font-medium text-muted-foreground"

    @if sortable {
        <th class=@cn(&[base, class])>
            <button
                class="inline-flex items-center gap-1 hover:text-foreground transition-colors"
                x-on:click="toggleSort('@key')"
            >
                @label
                @* Sort indicator *@
                <span class="ml-1">
                    @* Unsorted state *@
                    <svg
                        x-show="sortKey !== '@key'"
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4 opacity-30"
                    >
                        <path d="m7 15 5 5 5-5"/>
                        <path d="m7 9 5-5 5 5"/>
                    </svg>
                    @* Ascending *@
                    <svg
                        x-show="sortKey === '@key' && sortDir === 'asc'"
                        x-cloak
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                    >
                        <path d="m7 9 5-5 5 5"/>
                    </svg>
                    @* Descending *@
                    <svg
                        x-show="sortKey === '@key' && sortDir === 'desc'"
                        x-cloak
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                    >
                        <path d="m7 15 5 5 5-5"/>
                    </svg>
                </span>
            </button>
        </th>
    } else {
        <th class=@cn(&[base, class])>
            @label
        </th>
    }
}

@* Table row without selection checkbox *@
@fn row(
    row_id: &str,
    class: &str = "",
    content: @(),
) {
    @let base = "border-b transition-colors hover:bg-muted/50"

    <tr
        class=@cn(&[base, class])
        data-row-id="@row_id"
        :class="isSelected('@row_id') && 'bg-muted'"
    >
        @content()
    </tr>
}

@* Selectable row - includes checkbox cell *@
@fn selectable_row(
    row_id: &str,
    class: &str = "",
    content: @(),
) {
    @let base = "border-b transition-colors hover:bg-muted/50"

    <tr
        class=@cn(&[base, class])
        data-row-id="@row_id"
        :class="isSelected('@row_id') && 'bg-muted'"
    >
        <td class="w-12 p-2 align-middle">
            <div class="flex items-center justify-center">
                <input
                    type="checkbox"
                    class="h-4 w-4 rounded border border-primary ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                    :checked="isSelected('@row_id')"
                    x-on:click="toggleRow('@row_id')"
                    aria-label="Select row"
                />
            </div>
        </td>
        @content()
    </tr>
}

@* Table cell *@
@fn cell(
    class: &str = "",
    content: @(),
) {
    @let base = "p-2 align-middle"

    <td class=@cn(&[base, class])>
        @content()
    </td>
}

@* Empty state for no data *@
@fn empty(
    colspan: u32,
    content: @(),
) {
    <tr>
        <td colspan="@colspan" class="h-24 text-center text-muted-foreground">
            @content()
        </td>
    </tr>
}
