@*
 * Form component
 * Form wrapper with validation display and field layouts
 *
 * @example
 * @import components/form.wtz as form
 * @import components/input.wtz as input
 * @import components/button.wtz as button
 *
 * <@form::apply action=Some("/submit") method=Some("POST") class=None>
 *     <@form::field
 *         name="email"
 *         label=Some("Email")
 *         description=Some("We'll never share your email.")
 *         error=email_error
 *         required=true
 *         class=None
 *     >
 *         <@input::apply
 *             input_type=input::InputType::Email
 *             name="email"
 *             value=None
 *             placeholder=Some("you@example.com")
 *             disabled=false
 *             required=true
 *             error=email_error
 *             class=None
 *         />
 *     </@>
 *
 *     <@form::actions align=None class=None>
 *         <@button::primary>Submit</@>
 *     </@>
 * </@>
 *@


@* Main form wrapper *@
@fn apply(
    action: Option<&str>,
    method: Option<&str>,
    enctype: Option<&str>,
    class: Option<&str>,
    content: @(),
) {
    @let base = "space-y-6"
    @let class_val = class.unwrap_or("")
    @let class_vec = vec![base, class_val]
    @let classes = cn(class_vec)

    <form
        @if let Some(a) = action { action="@a" }
        @if let Some(m) = method { method="@m" }
        @if let Some(e) = enctype { enctype="@e" }
        class="@classes"
        novalidate
    >
        @content()
    </form>
}

@* Form field wrapper with label, description, and error *@
@fn field(
    name: &str,
    label: Option<&str>,
    description: Option<&str>,
    error: Option<&str>,
    required: bool,
    class: Option<&str>,
    content: @(),
) {
    @let label_cls = "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
    @let class_val = class.unwrap_or("")
    @let field_vec = vec!["space-y-2", class_val]
    @let field_cls = cn(field_vec)

    <div class="@field_cls">
        @if let Some(l) = label {
            <label for="@name" class="@label_cls">
                @l
                @if required { <span class="text-destructive ml-0.5">*</span> }
            </label>
        }
        @content()
        @if let Some(d) = description {
            @if error.is_none() {
                <p class="text-sm text-muted-foreground">@d</p>
            }
        }
        @if let Some(e) = error {
            <p class="text-sm text-destructive" role="alert">@e</p>
        }
    </div>
}

@* Display error message for a field *@
@fn message(error: Option<&str>) {
    @if let Some(e) = error {
        <p class="text-sm text-destructive" role="alert">@e</p>
    }
}

@* Form section with title and description *@
@fn section(
    title: Option<&str>,
    description: Option<&str>,
    class: Option<&str>,
    content: @(),
) {
    @let class_val = class.unwrap_or("")
    @let section_vec = vec!["space-y-4", class_val]
    @let section_cls = cn(section_vec)

    <div class="@section_cls">
        @if title.is_some() || description.is_some() {
            <div class="space-y-1">
                @if let Some(t) = title {
                    <h3 class="text-lg font-medium">@t</h3>
                }
                @if let Some(d) = description {
                    <p class="text-sm text-muted-foreground">@d</p>
                }
            </div>
        }
        <div class="space-y-4">
            @content()
        </div>
    </div>
}

@* Inline form row for side-by-side fields *@
@fn row(
    class: Option<&str>,
    content: @(),
) {
    @let class_val = class.unwrap_or("")
    @let row_vec = vec!["grid gap-4 sm:grid-cols-2", class_val]
    @let row_cls = cn(row_vec)

    <div class="@row_cls">
        @content()
    </div>
}

@* Form actions/buttons container *@
@fn actions(
    align: Option<&str>,
    class: Option<&str>,
    content: @(),
) {
    @let align_val = align.unwrap_or("end")
    @let align_cls = match align_val {
        "start" => { "justify-start" }
        "center" => { "justify-center" }
        "end" => { "justify-end" }
        "between" => { "justify-between" }
        _ => { "justify-end" }
    }
    @let class_val = class.unwrap_or("")
    @let actions_vec = vec!["flex flex-col-reverse gap-2 sm:flex-row", align_cls, class_val]
    @let actions_cls = cn(actions_vec)

    <div class="@actions_cls">
        @content()
    </div>
}

@* Simple form for common use cases *@
@fn simple(
    action: &str,
    method: &str,
    content: @(),
) {
    <@apply
        action=Some(@action)
        method=Some(@method)
        enctype=None
        class=None
    >
        @content()
    </@>
}

@* Multipart form for file uploads *@
@fn multipart(
    action: &str,
    content: @(),
) {
    @let method_val = "POST"
    @let enctype_val = "multipart/form-data"

    <@apply
        action=Some(@action)
        method=Some(@method_val)
        enctype=Some(@enctype_val)
        class=None
    >
        @content()
    </@>
}

