@*
 * Toggle component
 * A two-state button that can be toggled on or off
 *
 * Usage:
 *   @import ui/components/toggle.wtz as toggle
 *
 *   <@toggle::apply name="bold" pressed=false variant=toggle::Variant::Default size=toggle::Size::Default>B</@toggle::apply>
 *   <@toggle::simple name="italic">I</@toggle::simple>
 *   <@toggle::outline name="underline" pressed=true>U</@toggle::outline>
 *   <@toggle::icon name="star">★</@toggle::icon>
 *@


@enum Variant {
    Default,
    Outline,
}

@enum Size {
    Sm,
    Default,
    Lg,
}

@fn apply(
    name: &str,
    pressed: bool,
    disabled: bool = false,
    variant: Variant,
    size: Size,
    class: &str = "",
    content: @(),
) {
    @let base = "inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors hover:bg-muted hover:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"

    @let variant_cls = match variant {
        Variant::Default => { "bg-transparent" }
        Variant::Outline => { "border border-input bg-transparent shadow-sm hover:bg-accent hover:text-accent-foreground" }
    }

    @let size_cls = match size {
        Size::Sm => { "h-8 px-2 min-w-8" }
        Size::Default => { "h-9 px-3 min-w-9" }
        Size::Lg => { "h-10 px-3 min-w-10" }
    }

    @let aria_pressed_val = if pressed { "true" } else { "false" }
    @let data_state_val = if pressed { "on" } else { "off" }

    @let extra_class = class
    @let classes = [base, variant_cls, size_cls, extra_class]

    <button
        type="button"
        id=@name
        name=@name
        role="button"
        class=@cn(classes)
        aria-pressed=@aria_pressed_val
        data-state=@data_state_val
        @if disabled { disabled aria-disabled="true" }
        x-data=@```json { pressed: @pressed } ```@
        x-on:click="pressed = !pressed; $dispatch('input', { name: '@name', value: pressed })"
        :aria-pressed="pressed.toString()"
        :data-state="pressed ? 'on' : 'off'"
        :class="pressed ? 'bg-accent text-accent-foreground' : ''"
    >
        @content()
    </button>
    <input type="hidden" name=@name :value="pressed" />
}

@* Simple toggle with default settings *@
@fn simple(name: &str, content: @()) {
    <@apply
        name=@name
        pressed=false
       
        variant=Variant::Default
        size=Size::Default
       
    >
        @content()
    </@apply>
}

@* Toggle with outline variant *@
@fn outline(name: &str, pressed: bool, content: @()) {
    <@apply
        name=@name
        pressed=@pressed
       
        variant=Variant::Outline
        size=Size::Default
       
    >
        @content()
    </@apply>
}

@* Toggle sized for icons *@
@fn icon(name: &str, content: @()) {
    @let icon_class = Some("h-9 w-9 p-0")
    <@apply
        name=@name
        pressed=false
       
        variant=Variant::Default
        size=Size::Default
        class=@icon_class
    >
        @content()
    </@apply>
}

@* Disabled toggle *@
@fn disabled(name: &str, pressed: bool, content: @()) {
    <@apply
        name=@name
        pressed=@pressed
        disabled=true
        variant=Variant::Default
        size=Size::Default
       
    >
        @content()
    </@apply>
}

@* Small toggle *@
@fn sm(name: &str, content: @()) {
    <@apply
        name=@name
        pressed=false
       
        variant=Variant::Default
        size=Size::Sm
       
    >
        @content()
    </@apply>
}

@* Large toggle *@
@fn lg(name: &str, content: @()) {
    <@apply
        name=@name
        pressed=false
       
        variant=Variant::Default
        size=Size::Lg
       
    >
        @content()
    </@apply>
}

@* Toggle group for multiple related toggles (like text formatting) *@
@fn group(class: &str = "", content: @()) {
    @let base = "inline-flex items-center gap-1"
    @let extra_class = class
    @let classes = [base, extra_class]
    <div
        class=@cn(classes)
        role="group"
    >
        @content()
    </div>
}
