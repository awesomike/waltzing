@*
 * Checkbox component
 * Custom styled checkbox with SVG checkmark icon
 *
 * @example
 * @import components/checkbox.wtz as checkbox
 *
 * <@checkbox::apply name="terms" checked=false />
 *
 * <@checkbox::labeled
 *     label="Accept terms and conditions"
 *     name="terms"
 *     checked=@false
 *    
 *     description=@None
 * />
 *
 * <@checkbox::labeled
 *     label="Marketing emails"
 *     name="marketing"
 *     checked=@true
 *    
 *     description=Some("Receive emails about new products and features")
 * />
 *@


@fn apply(
    name: &str,
    checked: bool,
    disabled: bool = false,
    class: &str = "",
) {
    @* The visible square is a sibling of the sr-only `<input>`,
       controlled by Tailwind's `peer-checked:` modifier so it reacts
       to client-side state changes (the previous version was a bare
       `<div>` that never updated). Wrapping in a `<label for=name>`
       makes clicking the square toggle the input — the unwrapped
       `<div>` had no click semantics, which broke the form for users
       who expect to click the box. *@
    @let extra_class = class
    @let box_classes = ["peer-checked:bg-primary peer-checked:border-primary",
        "h-4 w-4 shrink-0 rounded-sm border border-primary",
        "peer-disabled:cursor-not-allowed peer-disabled:opacity-70",
        "inline-flex items-center justify-center cursor-pointer",
        extra_class]

    <label for=@name class="relative inline-flex items-center justify-center cursor-pointer">
        <input
            type="checkbox"
            name=@name
            id=@name
            class="sr-only peer"
            @if checked { checked }
            @if disabled { disabled }
        />
        <span class=@cn(&box_classes)>
        </span>
        @* SVG checkmark — sibling of the input (NOT inside the span)
           so Tailwind's sibling-only `peer-checked:` modifier applies.
           Hidden by default, shown when input is :checked. The
           `peer-checked:block` utility (already compiled into the
           pod's static CSS) gives us `display: block` on toggle.
           Positioned absolutely on top of the visual box;
           pointer-events:none so clicks fall through. *@
        <svg
            class="hidden peer-checked:block absolute h-3 w-3 text-primary-foreground pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
    </label>
}

@* Checkbox with label and optional description *@
@fn labeled(
    label: &str,
    name: &str,
    checked: bool,
    disabled: bool = false,
    description: Option<String>,
) {
    @let label_cls = "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"

    @let checkbox_cls = if description.is_some() { Some("mt-0.5") } else { None }

    <div class="flex items-start space-x-2">
        <@apply
            name=@name
            checked=@checked
            disabled=@disabled
            class=@checkbox_cls.unwrap_or("")
        />
        <div class="grid gap-1.5 leading-none">
            <label for=@name class=@label_cls>@label</label>
            @if let Some(desc) = description {
                <p class="text-sm text-muted-foreground">@desc</p>
            }
        </div>
    </div>
}

@* Simple unchecked checkbox with label *@
@fn simple(name: &str, label: &str) {
    <@labeled
        label=@label
        name=@name
        checked=@false
       
        description=@None
    />
}

@* Checkbox that's checked by default *@
@fn checked(name: &str, label: &str) {
    <@labeled
        label=@label
        name=@name
        checked=@true
       
        description=@None
    />
}
