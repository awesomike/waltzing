@*
 * Checkbox component
 * Boolean input with label
 *@

@import lib/utils.wtz as utils

@fn apply(
    name: &str,
    checked: bool,
    disabled: bool,
    required: bool,
    class: Option<&str>,
) {
    @let base = "peer h-4 w-4 shrink-0 rounded-sm border border-primary shadow focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 data-[state=checked]:bg-primary data-[state=checked]:text-primary-foreground"

    <input
        type="checkbox"
        name="@name"
        id="@name"
        class="@utils::cn(&[@base, @class.unwrap_or("")])"
        @if checked { checked data-state="checked" } else { data-state="unchecked" }
        @if disabled { disabled }
        @if required { required }
    />
}

@* Checkbox with label *@
@fn labeled(
    label: &str,
    name: &str,
    checked: bool,
    disabled: bool,
    required: bool,
    class: Option<&str>,
) {
    @let label_cls = "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"

    <div class="flex items-center space-x-2">
        <@apply
            name=@name
            checked=@checked
            disabled=@disabled
            required=@required
            class=@class
        />
        <label for="@name" class="@label_cls">
            @label
            @if required { <span class="text-destructive ml-0.5">*</span> }
        </label>
    </div>
}

@* Checkbox with label and description *@
@fn with_description(
    label: &str,
    description: &str,
    name: &str,
    checked: bool,
    disabled: bool,
) {
    @let label_cls = "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"

    <div class="flex items-start space-x-2">
        <@apply
            name=@name
            checked=@checked
            disabled=@disabled
            required=false
            class=Some("mt-0.5")
        />
        <div class="grid gap-1.5 leading-none">
            <label for="@name" class="@label_cls">@label</label>
            <p class="text-sm text-muted-foreground">@description</p>
        </div>
    </div>
}

@* Simple unchecked checkbox *@
@fn simple(name: &str, label: &str) {
    <@labeled
        label=@label
        name=@name
        checked=false
        disabled=false
        required=false
        class=None
    />
}

@* Checkbox that's checked by default *@
@fn checked(name: &str, label: &str) {
    <@labeled
        label=@label
        name=@name
        checked=true
        disabled=false
        required=false
        class=None
    />
}
