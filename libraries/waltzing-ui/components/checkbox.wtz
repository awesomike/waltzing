@*
 * Checkbox component
 * Custom styled checkbox with SVG checkmark icon
 *
 * @example
 * @import components/checkbox.wtz as checkbox
 *
 * <@checkbox::apply name="terms" checked=false disabled=false class=None />
 *
 * <@checkbox::labeled
 *     label="Accept terms and conditions"
 *     name="terms"
 *     checked=false
 *     disabled=false
 *     description=None
 * />
 *
 * <@checkbox::labeled
 *     label="Marketing emails"
 *     name="marketing"
 *     checked=true
 *     disabled=false
 *     description=Some("Receive emails about new products and features")
 * />
 *@

@import lib/utils.wtz as utils

@fn apply(
    name: &str,
    checked: bool,
    disabled: bool,
    class: Option<&str>,
) {
    @let base = "peer h-4 w-4 shrink-0 rounded-sm border border-primary ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"

    @let checked_cls = @if checked { "bg-primary text-primary-foreground" } else { "" }

    @let data_state = @if checked { "checked" } else { "unchecked" }

    @let classes = &[@base, @checked_cls, @class.unwrap_or("")]

    <div class="relative inline-flex items-center justify-center">
        <input
            type="checkbox"
            name="@name"
            id="@name"
            class="sr-only peer"
            data-state="@data_state"
            @if checked { checked }
            @if disabled { disabled }
        />
        <div
            class="@utils::cn(@classes)"
            data-state="@data_state"
        >
            @if checked {
                <svg
                    class="h-3 w-3 text-current"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            }
        </div>
    </div>
}

@* Checkbox with label and optional description *@
@fn labeled(
    label: &str,
    name: &str,
    checked: bool,
    disabled: bool,
    description: Option<&str>,
) {
    @let label_cls = "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"

    @let checkbox_cls = @if description.is_some() { Some("mt-0.5") } else { None }

    <div class="flex items-start space-x-2">
        <@apply
            name=@name
            checked=@checked
            disabled=@disabled
            class=@checkbox_cls
        />
        <div class="grid gap-1.5 leading-none">
            <label for="@name" class="@label_cls">@label</label>
            @if let Some(desc) = description {
                <p class="text-sm text-muted-foreground">@desc</p>
            }
        </div>
    </div>
}

@* Simple unchecked checkbox with label *@
@fn simple(name: &str, label: &str) {
    <@labeled
        label=@label
        name=@name
        checked=false
        disabled=false
        description=None
    />
}

@* Checkbox that's checked by default *@
@fn checked(name: &str, label: &str) {
    <@labeled
        label=@label
        name=@name
        checked=true
        disabled=false
        description=None
    />
}
