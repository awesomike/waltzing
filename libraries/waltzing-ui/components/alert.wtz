@*
 * Alert component
 * Callout for important messages
 *
 * @example
 * @import components/alert.wtz as alert
 *
 * <@alert::default>
 *     <@alert::title>Heads up!</@alert::title>
 *     <@alert::description>You can use alerts to display important messages.</@alert::description>
 * </@alert::default>
 *
 * <@alert::destructive>
 *     <@alert::title>Error</@alert::title>
 *     <@alert::description>Something went wrong. Please try again.</@alert::description>
 * </@alert::destructive>
 *
 * <@alert::apply variant=alert::Variant::Success class="my-4">
 *     <@alert::title>Success!</@alert::title>
 *     <@alert::description>Your changes have been saved.</@alert::description>
 * </@alert::apply>
 *@


@enum Variant {
    Default,
    Destructive,
    Warning,
    Success,
}

@fn apply(
    variant: Variant,
    class: &str = "",
    content: @(),
) {
    @let base = "relative w-full rounded-lg border px-4 py-3 text-sm [&>svg+div]:translate-y-[-3px] [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg]:text-foreground [&>svg~*]:pl-7"

    @let variant_cls = match variant {
        Variant::Default => { "bg-background text-foreground" }
        Variant::Destructive => { "border-destructive/50 text-destructive dark:border-destructive [&>svg]:text-destructive" }
        Variant::Warning => { "border-yellow-500/50 text-yellow-600 dark:text-yellow-500 [&>svg]:text-yellow-600 dark:[&>svg]:text-yellow-500" }
        Variant::Success => { "border-green-500/50 text-green-600 dark:text-green-500 [&>svg]:text-green-600 dark:[&>svg]:text-green-500" }
    }

    @let extra = class
    @let classes = vec![@base, @variant_cls, @extra]
    <div role="alert" class="@cn(classes)">
        @content()
    </div>
}

@* Alert title *@
@fn title(class: &str = "", content: @()) {
    @let extra = class
    @let classes = vec!["mb-1 font-medium leading-none tracking-tight", @extra]
    <h5 class="@cn(classes)">
        @content()
    </h5>
}

@* Alert description *@
@fn description(class: &str = "", content: @()) {
    @let extra = class
    @let classes = vec!["text-sm [&_p]:leading-relaxed", @extra]
    <div class="@cn(classes)">
        @content()
    </div>
}

@* Shorthand for default alert *@
@fn default(content: @()) {
    <@apply variant=Variant::Default>
        @content()
    </@apply>
}

@* Shorthand for destructive alert *@
@fn destructive(content: @()) {
    <@apply variant=Variant::Destructive>
        @content()
    </@apply>
}

@* Shorthand for warning alert *@
@fn warning(content: @()) {
    <@apply variant=Variant::Warning>
        @content()
    </@apply>
}

@* Shorthand for success alert *@
@fn success(content: @()) {
    <@apply variant=Variant::Success>
        @content()
    </@apply>
}
