@*
 * Toggle Group component
 * A group of toggle buttons with single or multiple selection
 *
 * Usage:
 *
 * 1. Declarative (for static items):
 * <@toggle_group::single name="align" selected=@Some("left")>
 *     <@toggle_group::item value="left">Left</@toggle_group::item>
 *     <@toggle_group::item value="center">Center</@toggle_group::item>
 *     <@toggle_group::item value="right">Right</@toggle_group::item>
 * </@toggle_group::single>
 *
 * 2. Data-driven (for dynamic items):
 * <@toggle_group::single name="align" items=@items selected=@Some("left") />
 *@

@use waltzing::escape::attr

@* Item struct for data-driven usage *@
@struct ToggleItem {
    value: String,
    label: String,
    icon: Option<String>,
    disabled: bool,
}

@enum Variant {
    Default,
    Outline,
}

@enum Size {
    Sm,
    Default,
    Lg,
}

@* Single selection toggle group - use with children or items vec *@
@fn single(
    name: &str,
    items: Vec<ToggleItem> = Vec::new(),
    selected: Option<&str> = None,
    variant: Variant = Variant::Default,
    size: Size = Size::Default,
    class: &str = "",
    content: @(),
) {
    @let group_base = "inline-flex items-center rounded-md"
    @let variant_cls = match variant {
        Variant::Default => "bg-transparent",
        Variant::Outline => "border border-input",
    }
    @let sel = selected.unwrap_or("")
    @let variant_str = match variant {
        Variant::Default => "default",
        Variant::Outline => "outline",
    }
    @let size_str = match size {
        Size::Sm => "sm",
        Size::Default => "default",
        Size::Lg => "lg",
    }
    @let classes = [group_base, variant_cls, class]
    @let sel_esc = attr(sel)
    @let name_esc = attr(name)
    @let variant_esc = attr(variant_str)
    @let size_esc = attr(size_str)
    @let x_data = format("{{ selected: '{}', toggleName: '{}', variant: '{}', size: '{}', mode: 'single' }}", sel_esc, name_esc, variant_esc, size_esc)

    <div
        role="group"
        class=@cn(classes)
        x-data=@x_data
    >
        @if items.is_empty() {
            @content()
        } else {
            @for it in &items {
                @if let Some(ic) = &it.icon {
                    <@item value=@&it.value icon=@ic.as_str() disabled=@it.disabled>
                        @&it.label
                    </@item>
                } else {
                    <@item value=@&it.value disabled=@it.disabled>
                        @&it.label
                    </@item>
                }
            }
        }
        <input type="hidden" name=@name :value="selected || ''" />
    </div>
}

@* Multiple selection toggle group - use with children or items vec *@
@fn multiple(
    name: &str,
    items: Vec<ToggleItem> = Vec::new(),
    selected: Vec<&str>,
    variant: Variant = Variant::Default,
    size: Size = Size::Default,
    class: &str = "",
    content: @(),
) {
    @let group_base = "inline-flex items-center rounded-md"
    @let variant_cls = match variant {
        Variant::Default => "bg-transparent",
        Variant::Outline => "border border-input",
    }
    @let variant_str = match variant {
        Variant::Default => "default",
        Variant::Outline => "outline",
    }
    @let size_str = match size {
        Size::Sm => "sm",
        Size::Default => "default",
        Size::Lg => "lg",
    }
    @let classes = [group_base, variant_cls, class]

    <div
        role="group"
        class=@cn(classes)
        x-data=@```json {
            selected: @selected,
            toggleName: @name,
            variant: @variant_str,
            size: @size_str,
            mode: "multiple"
        } ```@
    >
        @if items.is_empty() {
            @content()
        } else {
            @for it in &items {
                @if let Some(ic) = &it.icon {
                    <@item value=@&it.value icon=@ic.as_str() disabled=@it.disabled>
                        @&it.label
                    </@item>
                } else {
                    <@item value=@&it.value disabled=@it.disabled>
                        @&it.label
                    </@item>
                }
            }
        }
        <input type="hidden" name=@name :value="JSON.stringify(selected)" />
    </div>
}

@* Individual toggle item - must be used inside single/multiple *@
@fn item(
    value: &str,
    icon: Option<&str> = None,
    disabled: bool = false,
    content: @(),
) {
    @let base = "inline-flex items-center justify-center text-sm font-medium transition-colors hover:bg-muted hover:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"
    @let btn_cls = cn(&[base, "first:rounded-l-md last:rounded-r-md [&:not(:first-child):not(:last-child)]:rounded-none"])
    @let value_esc = attr(value)
    @let class_expr = format(r#"{{
        'h-8 px-2.5 min-w-8': size === 'sm',
        'h-9 px-3 min-w-9': size === 'default',
        'h-10 px-3 min-w-10': size === 'lg',
        'bg-accent text-accent-foreground': mode === 'single' ? selected === '{}' : selected.includes('{}'),
        'bg-transparent': mode === 'single' ? selected !== '{}' : !selected.includes('{}')
    }}"#, value_esc, value_esc, value_esc, value_esc)
    @let aria_pressed = format("mode === 'single' ? (selected === '{}' ? 'true' : 'false') : (selected.includes('{}') ? 'true' : 'false')", value_esc, value_esc)
    @let data_state = format("mode === 'single' ? (selected === '{}' ? 'on' : 'off') : (selected.includes('{}') ? 'on' : 'off')", value_esc, value_esc)
    @let click_handler = format(r#"
        if (mode === 'single') {{
            selected = '{}';
        }} else {{
            selected.includes('{}')
                ? selected = selected.filter(v => v !== '{}')
                : selected.push('{}');
        }}
        $dispatch('change', {{ name: toggleName, value: selected }});
    "#, value_esc, value_esc, value_esc, value_esc)

    <button
        type="button"
        data-value=@value
        class=@btn_cls
        :class=@class_expr
        :role="mode === 'single' ? 'radio' : 'checkbox'"
        :aria-pressed=@aria_pressed
        :data-state=@data_state
        @if disabled { disabled aria-disabled="true" }
        x-on:click=@click_handler
    >
        @if let Some(ic) = icon {
            <span class="mr-2">@ic</span>
        }
        @content()
    </button>
}

@* Convenience: simple single with defaults *@
@fn simple_single(
    name: &str,
    selected: Option<&str> = None,
    class: &str = "",
    content: @(),
) {
    @let sel = selected.unwrap_or("")
    @if !sel.is_empty() {
        <@single name=@name selected=@sel class=@class>
            @content()
        </@single>
    } else {
        <@single name=@name class=@class>
            @content()
        </@single>
    }
}

@* Convenience: simple multiple with defaults - pass empty vec for no selection *@
@fn simple_multiple(
    name: &str,
    selected: Vec<&str>,
    class: &str = "",
    content: @(),
) {
    <@multiple name=@name selected=@selected class=@class>
        @content()
    </@multiple>
}

@* Convenience: outline single *@
@fn outline_single(
    name: &str,
    selected: Option<&str> = None,
    class: &str = "",
    content: @(),
) {
    @let sel = selected.unwrap_or("")
    @if !sel.is_empty() {
        <@single name=@name selected=@sel variant=@Variant::Outline class=@class>
            @content()
        </@single>
    } else {
        <@single name=@name variant=@Variant::Outline class=@class>
            @content()
        </@single>
    }
}

@* Convenience: outline multiple *@
@fn outline_multiple(
    name: &str,
    selected: Vec<&str>,
    class: &str = "",
    content: @(),
) {
    <@multiple name=@name selected=@selected variant=@Variant::Outline class=@class>
        @content()
    </@multiple>
}
