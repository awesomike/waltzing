@*
 * Toggle Group component
 * A group of toggle buttons with single or multiple selection
 *
 * @example
 * @import components/toggle-group.wtz as toggle_group
 *
 * @let items = vec![
 *     ToggleItem { value: "left".into(), label: "Left".into(), icon: None, disabled: false },
 *     ToggleItem { value: "center".into(), label: "Center".into(), icon: None, disabled: false },
 *     ToggleItem { value: "right".into(), label: "Right".into(), icon: None, disabled: false },
 * ];
 *
 * <@toggle_group::single name="align" items=&items selected=Some("left") class="" />
 * <@toggle_group::multiple name="format" items=&items selected=&["left", "right"] class="" />
 *@


@struct ToggleItem {
    value: String,
    label: String,
    icon: Option<String>,
    disabled: bool,
}

@enum Variant {
    Default,
    Outline,
}

@enum Size {
    Sm,
    Default,
    Lg,
}

@* Single selection toggle group - only one item can be selected at a time *@
@fn single(
    name: &str,
    items: Vec<ToggleItem>,
    selected: Option<&str>,
    variant: Variant,
    size: Size,
    class: &str = "",
) {
    @let group_base = "inline-flex items-center rounded-md"

    @let variant_cls = {
        match variant {
            Variant::Default => "bg-transparent",
            Variant::Outline => "border border-input",
        }
    }

    @let selected_json = {
        if let Some(s) = selected {
            format!("'{}'", s)
        } else {
            "null".to_string()
        }
    }

    @let cls = class
    <div
        role="group"
        class="@cn(&[@group_base, @variant_cls, @cls])"
        x-data=@```json { selected: @selected_json } ```@
    >
        @for (idx, item) in items.iter().enumerate() {
            @let is_first = (idx == 0)
            @let is_last = (idx == (items.len() - 1))
            @let is_selected = (selected == Some(item.value.as_str()))
            @let item_id = format!("{}_{}", name, item.value)

            @let base = "inline-flex items-center justify-center text-sm font-medium transition-colors hover:bg-muted hover:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"

            @let size_cls = {
                match size {
                    Size::Sm => "h-8 px-2.5 min-w-8",
                    Size::Default => "h-9 px-3 min-w-9",
                    Size::Lg => "h-10 px-3 min-w-10",
                }
            }

            @let position_cls = {
                if is_first && is_last {
                    "rounded-md"
                } else if is_first {
                    "rounded-l-md rounded-r-none"
                } else if is_last {
                    "rounded-l-none rounded-r-md"
                } else {
                    "rounded-none"
                }
            }

            @let selected_cls = { if is_selected { "bg-accent text-accent-foreground" } else { "bg-transparent" } }
            @let aria_pressed_val = { if is_selected { "true" } else { "false" } }
            @let data_state_val = { if is_selected { "on" } else { "off" } }

            <button
                type="button"
                id="@item_id"
                role="radio"
                class="@cn(&[@base, @size_cls, @position_cls, @selected_cls])"
                aria-pressed="@aria_pressed_val"
                data-state="@data_state_val"
                data-value="@item.value"
                @if item.disabled { disabled aria-disabled="true" }
                x-on:click="selected = '@item.value'; $dispatch('change', { name: '@name', value: selected })"
                :aria-pressed="selected === '@item.value' ? 'true' : 'false'"
                :data-state="selected === '@item.value' ? 'on' : 'off'"
                :class="selected === '@item.value' ? 'bg-accent text-accent-foreground' : 'bg-transparent'"
            >
                @if let Some(icon) = &item.icon {
                    @let icon_margin = { if !item.label.is_empty() { "mr-2" } else { "" } }
                    <span class="@icon_margin">@icon</span>
                }
                @item.label
            </button>
        }
        <input type="hidden" name="@name" :value="selected || ''" />
    </div>
}

@* Multiple selection toggle group - multiple items can be selected *@
@fn multiple(
    name: &str,
    items: Vec<ToggleItem>,
    selected: Vec<&str>,
    variant: Variant,
    size: Size,
    class: &str = "",
) {
    @let group_base = "inline-flex items-center rounded-md"

    @let variant_cls = {
        match variant {
            Variant::Default => "bg-transparent",
            Variant::Outline => "border border-input",
        }
    }

    @let selected_json = format!("[{}]", selected.iter().map(|s| format!("'{}'", s)).collect::<Vec<String>>().join(", "))

    @let cls = class
    <div
        role="group"
        class="@cn(&[@group_base, @variant_cls, @cls])"
        x-data=@```json { selected: @selected_json } ```@
    >
        @for (idx, item) in items.iter().enumerate() {
            @let is_first = (idx == 0)
            @let is_last = (idx == (items.len() - 1))
            @let is_selected = selected.contains(&item.value.as_str())
            @let item_id = format!("{}_{}", name, item.value)

            @let base = "inline-flex items-center justify-center text-sm font-medium transition-colors hover:bg-muted hover:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"

            @let size_cls = {
                match size {
                    Size::Sm => "h-8 px-2.5 min-w-8",
                    Size::Default => "h-9 px-3 min-w-9",
                    Size::Lg => "h-10 px-3 min-w-10",
                }
            }

            @let position_cls = {
                if is_first && is_last {
                    "rounded-md"
                } else if is_first {
                    "rounded-l-md rounded-r-none"
                } else if is_last {
                    "rounded-l-none rounded-r-md"
                } else {
                    "rounded-none"
                }
            }

            @let selected_cls = { if is_selected { "bg-accent text-accent-foreground" } else { "bg-transparent" } }
            @let aria_pressed_val = { if is_selected { "true" } else { "false" } }
            @let data_state_val = { if is_selected { "on" } else { "off" } }

            <button
                type="button"
                id="@item_id"
                role="checkbox"
                class="@cn(&[@base, @size_cls, @position_cls, @selected_cls])"
                aria-pressed="@aria_pressed_val"
                data-state="@data_state_val"
                data-value="@item.value"
                @if item.disabled { disabled aria-disabled="true" }
                x-on:click="selected.includes('@item.value') ? selected = selected.filter(v => v !== '@item.value') : selected.push('@item.value'); $dispatch('change', { name: '@name', value: selected })"
                :aria-pressed="selected.includes('@item.value') ? 'true' : 'false'"
                :data-state="selected.includes('@item.value') ? 'on' : 'off'"
                :class="selected.includes('@item.value') ? 'bg-accent text-accent-foreground' : 'bg-transparent'"
            >
                @if let Some(icon) = &item.icon {
                    @let icon_margin = { if !item.label.is_empty() { "mr-2" } else { "" } }
                    <span class="@icon_margin">@icon</span>
                }
                @item.label
            </button>
        }
        <input type="hidden" name="@name" :value="JSON.stringify(selected)" />
    </div>
}

@* Simple single selection with default styling *@
@fn simple_single(
    name: &str,
    items: Vec<ToggleItem>,
    selected: Option<&str>,
    class: &str = "",
) {
    <@single
        name=@name
        items=@items
        selected=@selected
        variant=Variant::Default
        size=Size::Default
        class=@class
    />
}

@* Simple multiple selection with default styling *@
@fn simple_multiple(
    name: &str,
    items: Vec<ToggleItem>,
    selected: Vec<&str>,
    class: &str = "",
) {
    <@multiple
        name=@name
        items=@items
        selected=@selected
        variant=Variant::Default
        size=Size::Default
        class=@class
    />
}

@* Outline variant single selection *@
@fn outline_single(
    name: &str,
    items: Vec<ToggleItem>,
    selected: Option<&str>,
    class: &str = "",
) {
    <@single
        name=@name
        items=@items
        selected=@selected
        variant=Variant::Outline
        size=Size::Default
        class=@class
    />
}

@* Outline variant multiple selection *@
@fn outline_multiple(
    name: &str,
    items: Vec<ToggleItem>,
    selected: Vec<&str>,
    class: &str = "",
) {
    <@multiple
        name=@name
        items=@items
        selected=@selected
        variant=Variant::Outline
        size=Size::Default
        class=@class
    />
}

@* Small single selection *@
@fn sm_single(
    name: &str,
    items: Vec<ToggleItem>,
    selected: Option<&str>,
    class: &str = "",
) {
    <@single
        name=@name
        items=@items
        selected=@selected
        variant=Variant::Default
        size=Size::Sm
        class=@class
    />
}

@* Large single selection *@
@fn lg_single(
    name: &str,
    items: Vec<ToggleItem>,
    selected: Option<&str>,
    class: &str = "",
) {
    <@single
        name=@name
        items=@items
        selected=@selected
        variant=Variant::Default
        size=Size::Lg
        class=@class
    />
}
