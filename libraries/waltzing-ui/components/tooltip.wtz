@**
 * Tooltip component
 * Hover information popup for providing contextual hints
 * Uses Alpine.js for show/hide behavior on hover and focus
 *
 * Usage:
 *   @import components/tooltip.wtz as tooltip
 *
 *   <@tooltip::apply
 *       side=tooltip::Side::Top
 *       text="This is helpful information"
 *       trigger=@{ <button>Hover me</button> }
 *   />
 *
 *   Or with rich content:
 *   <@tooltip::rich
 *       side=tooltip::Side::Bottom
 *       trigger=@{ <span>Info</span> }
 *       content=@{ <strong>Bold</strong> tooltip content }
 *   />
 **@

@enum Side {
    Top,
    Right,
    Bottom,
    Left,
}

@enum Align {
    Start,
    Center,
    End,
}

@* Simple text tooltip *@
@fn apply(
    side: Side = Side::Top,
    text: &str = "",
    trigger: @() = @{},
) {
    <@rich side=@side align=Align::Center trigger=@trigger>
        @text
    </@rich>
}

@* Rich content tooltip with alignment control, auto-flip, and scroll tracking *@
@fn rich(
    side: Side = Side::Top,
    align: Align = Align::Center,
    trigger: @() = @{},
    content: @() = @{},
) {
    @let side_type = match side {
        Side::Top => "top",
        Side::Bottom => "bottom",
        Side::Left => "left",
        Side::Right => "right",
    }

    @let align_type = match align {
        Align::Start => "start",
        Align::Center => "center",
        Align::End => "end",
    }

    <div class="inline-block" x-data=@```json {
        show: false,
        pos: { x: 0, y: 0 },
        flipTop: @side_type === 'top',
        side: @side_type,
        align: @align_type,
        updatePos() {
            const trigger = this.$refs.trigger;
            if (!trigger) return;
            const rect = trigger.getBoundingClientRect();
            const tooltipHeight = 40;
            const isVertical = this.side === 'top' || this.side === 'bottom';
            if (isVertical) {
                const spaceBelow = window.innerHeight - rect.bottom;
                const spaceAbove = rect.top;
                this.flipTop = (this.side === 'top') || (spaceBelow < tooltipHeight + 10 && spaceAbove > spaceBelow);
                this.pos.y = this.flipTop ? rect.top : rect.bottom;
                if (this.align === 'start') this.pos.x = rect.left;
                else if (this.align === 'center') this.pos.x = rect.left + rect.width / 2;
                else this.pos.x = rect.right;
            } else {
                this.pos.y = rect.top + rect.height / 2;
                this.pos.x = this.side === 'right' ? rect.right : rect.left;
            }
        },
        onScroll() { if (this.show) this.updatePos(); },
        init() {
            this._scrollHandler = () => this.onScroll();
            window.addEventListener('scroll', this._scrollHandler, true);
            window.addEventListener('resize', this._scrollHandler);
        },
        destroy() {
            window.removeEventListener('scroll', this._scrollHandler, true);
            window.removeEventListener('resize', this._scrollHandler);
        }
    } ```@ x-init="init()" @@destroy="destroy()">
        <div
            x-ref="trigger"
            @@mouseenter="show = true; $nextTick(() => updatePos())"
            @@mouseleave="show = false"
            @@focus="show = true; $nextTick(() => updatePos())"
            @@blur="show = false"
            aria-describedby="tooltip"
        >
            @trigger()
        </div>

        <template x-teleport="body">
            <div
                x-show="show"
                x-cloak
                x-transition:enter="transition ease-out duration-150"
                x-transition:enter-start="opacity-0 scale-95"
                x-transition:enter-end="opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-100"
                x-transition:leave-start="opacity-100 scale-100"
                x-transition:leave-end="opacity-0 scale-95"
                class="fixed z-[9999] max-w-xs px-3 py-1.5 rounded-md bg-primary text-primary-foreground text-xs shadow-md pointer-events-none"
                :style="(side === 'left' || side === 'right')
                    ? `left: ${side === 'right' ? pos.x + 8 : 'auto'}px; right: ${side === 'left' ? (window.innerWidth - pos.x + 8) : 'auto'}px; top: ${pos.y}px; transform: translateY(-50%);`
                    : `left: ${pos.x}px; ${flipTop ? 'bottom: ' + (window.innerHeight - pos.y + 8) + 'px' : 'top: ' + (pos.y + 8) + 'px'}; ${align === 'center' ? 'transform: translateX(-50%)' : (align === 'end' ? 'transform: translateX(-100%)' : '')}`"
                role="tooltip"
            >
                @content()
                <span class="absolute w-0 h-0 border-4" :class="(side === 'left' || side === 'right') ? (side === 'right' ? 'right-full top-1/2 -translate-y-1/2 border-r-primary border-y-transparent border-l-transparent' : 'left-full top-1/2 -translate-y-1/2 border-l-primary border-y-transparent border-r-transparent') : (flipTop ? 'top-full left-1/2 -translate-x-1/2 border-t-primary border-x-transparent border-b-transparent' : 'bottom-full left-1/2 -translate-x-1/2 border-b-primary border-x-transparent border-t-transparent')"></span>
            </div>
        </template>
    </div>
}

@* Tooltip with delay before showing *@
@fn delayed(
    side: Side = Side::Top,
    text: &str = "",
    delay_ms: u32 = 300,
    trigger: @() = @{},
) {
    @let side_cls = {
        match side {
            Side::Top => "bottom-full mb-2",
            Side::Right => "left-full ml-2",
            Side::Bottom => "top-full mt-2",
            Side::Left => "right-full mr-2",
        }
    }

    @let arrow_side_cls = {
        match side {
            Side::Top => "top-full left-1/2 -translate-x-1/2 border-t-primary border-x-transparent border-b-transparent",
            Side::Right => "right-full top-1/2 -translate-y-1/2 border-r-primary border-y-transparent border-l-transparent",
            Side::Bottom => "bottom-full left-1/2 -translate-x-1/2 border-b-primary border-x-transparent border-t-transparent",
            Side::Left => "left-full top-1/2 -translate-y-1/2 border-l-primary border-y-transparent border-l-transparent",
        }
    }

    @let tooltip_cls = cn(&["absolute z-50 max-w-xs px-3 py-1.5 rounded-md bg-primary text-primary-foreground text-xs shadow-md pointer-events-none left-1/2 -translate-x-1/2", side_cls])

    @let arrow_cls = cn(&["absolute w-0 h-0 border-4", arrow_side_cls])

    <div class="relative inline-block" x-data="{ show: false, timeout: null }">
        <div
            @mouseenter="timeout = setTimeout(() => show = true, @delay_ms)"
            @mouseleave="clearTimeout(timeout); show = false"
            @focus="timeout = setTimeout(() => show = true, @delay_ms)"
            @blur="clearTimeout(timeout); show = false"
            aria-describedby="tooltip"
        >
            @trigger()
        </div>

        <div
            x-show="show"
            x-cloak
            x-transition:enter="transition ease-out duration-150"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-100"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            class=@tooltip_cls
            role="tooltip"
            id="tooltip"
        >
            @text
            <span class=@arrow_cls></span>
        </div>
    </div>
}

@* Shorthand for top tooltip *@
@fn top(text: &str = "", trigger: @() = @{}) {
    <@apply side=Side::Top text=@text trigger=@trigger />
}

@* Shorthand for bottom tooltip *@
@fn bottom(text: &str = "", trigger: @() = @{}) {
    <@apply side=Side::Bottom text=@text trigger=@trigger />
}

@* Shorthand for left tooltip *@
@fn left(text: &str = "", trigger: @() = @{}) {
    <@apply side=Side::Left text=@text trigger=@trigger />
}

@* Shorthand for right tooltip *@
@fn right(text: &str = "", trigger: @() = @{}) {
    <@apply side=Side::Right text=@text trigger=@trigger />
}
