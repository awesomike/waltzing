@*
 * Popover component
 * Floating content anchored to a trigger element
 * Uses Alpine.js for positioning and click-outside handling
 *
 * Usage:
 *   @import components/popover.wtz as popover
 *
 *   <@popover::apply
 *       side=popover::Side::Bottom
 *       align=popover::Align::Center
 *       trigger=@{ <button>Open</button> }
 *       content=@{ <p>Popover content here</p> }
 *   />
 *@

@enum Side {
    Top,
    Right,
    Bottom,
    Left,
}

@enum Align {
    Start,
    Center,
    End,
}

@fn apply(
    side: Side = Side::Bottom,
    align: Align = Align::Center,
    class: &str = "",
    trigger: @() = @{},
    content: @() = @{},
) {
    @let side_type = match side {
        Side::Top => "top",
        Side::Bottom => "bottom",
        Side::Left => "left",
        Side::Right => "right",
    }

    @let align_type = match align {
        Align::Start => "start",
        Align::Center => "center",
        Align::End => "end",
    }

    @let popover_cls = cn(&["fixed z-[9999] w-72 rounded-md border bg-popover p-4 text-popover-foreground shadow-md outline-none", class])

    @let x_data = format(r#"{{
        open: false,
        pos: {{ x: 0, y: 0 }},
        flipTop: false,
        side: '{}',
        align: '{}',
        updatePos() {{
            const trigger = this.$refs.trigger;
            if (!trigger) return;
            const rect = trigger.getBoundingClientRect();
            const popoverHeight = 200;
            const popoverWidth = 288;
            const isVertical = this.side === 'top' || this.side === 'bottom';
            if (isVertical) {{
                const spaceBelow = window.innerHeight - rect.bottom;
                const spaceAbove = rect.top;
                this.flipTop = (this.side === 'top') || (spaceBelow < popoverHeight && spaceAbove > spaceBelow);
                this.pos.y = this.flipTop ? rect.top : rect.bottom;
                if (this.align === 'start') this.pos.x = rect.left;
                else if (this.align === 'center') this.pos.x = rect.left + rect.width / 2;
                else this.pos.x = rect.right;
            }} else {{
                this.pos.y = rect.top + rect.height / 2;
                this.pos.x = this.side === 'right' ? rect.right : rect.left;
            }}
        }},
        onScroll() {{ if (this.open) this.updatePos(); }},
        init() {{
            this._scrollHandler = () => this.onScroll();
            window.addEventListener('scroll', this._scrollHandler, true);
            window.addEventListener('resize', this._scrollHandler);
        }},
        destroy() {{
            window.removeEventListener('scroll', this._scrollHandler, true);
            window.removeEventListener('resize', this._scrollHandler);
        }}
    }}"#, side_type, align_type)

    <div class="inline-block" x-data=@x_data x-init="init()" @destroy="destroy()">
        <div x-ref="trigger" @click="open = !open; $nextTick(() => updatePos())" aria-haspopup="true" :aria-expanded="open">
            @trigger()
        </div>

        <template x-teleport="body">
            <div
                x-show="open"
                x-cloak
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 scale-95"
                x-transition:enter-end="opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100 scale-100"
                x-transition:leave-end="opacity-0 scale-95"
                @click.outside="open = false"
                @keydown.escape.window="open = false"
                class=@popover_cls
                :style="(side === 'left' || side === 'right')
                    ? `left: ${side === 'right' ? pos.x + 8 : 'auto'}px; right: ${side === 'left' ? (window.innerWidth - pos.x + 8) : 'auto'}px; top: ${pos.y}px; transform: translateY(-50%);`
                    : `left: ${align === 'end' ? 'auto' : pos.x + 'px'}; right: ${align === 'end' ? (window.innerWidth - pos.x) + 'px' : 'auto'}; ${flipTop ? 'bottom: ' + (window.innerHeight - pos.y + 8) + 'px' : 'top: ' + (pos.y + 8) + 'px'}; ${align === 'center' ? 'transform: translateX(-50%)' : ''}`"
                role="dialog"
            >
                @content()
            </div>
        </template>
    </div>
}

@* Controlled popover (external state) *@
@fn controlled(
    open_var: &str,
    side: Side = Side::Bottom,
    align: Align = Align::Center,
    class: &str = "",
    trigger: @() = @{},
    content: @() = @{},
) {
    @let side_type = match side {
        Side::Top => "top",
        Side::Bottom => "bottom",
        Side::Left => "left",
        Side::Right => "right",
    }

    @let align_type = match align {
        Align::Start => "start",
        Align::Center => "center",
        Align::End => "end",
    }

    @let popover_cls = cn(&["fixed z-[9999] w-72 rounded-md border bg-popover p-4 text-popover-foreground shadow-md outline-none", class])

    @let x_data = format(r#"{{
        pos: {{ x: 0, y: 0 }},
        flipTop: false,
        side: '{}',
        align: '{}',
        updatePos() {{
            const trigger = this.$refs.trigger;
            if (!trigger) return;
            const rect = trigger.getBoundingClientRect();
            const popoverHeight = 200;
            const isVertical = this.side === 'top' || this.side === 'bottom';
            if (isVertical) {{
                const spaceBelow = window.innerHeight - rect.bottom;
                const spaceAbove = rect.top;
                this.flipTop = (this.side === 'top') || (spaceBelow < popoverHeight && spaceAbove > spaceBelow);
                this.pos.y = this.flipTop ? rect.top : rect.bottom;
                if (this.align === 'start') this.pos.x = rect.left;
                else if (this.align === 'center') this.pos.x = rect.left + rect.width / 2;
                else this.pos.x = rect.right;
            }} else {{
                this.pos.y = rect.top + rect.height / 2;
                this.pos.x = this.side === 'right' ? rect.right : rect.left;
            }}
        }},
        onScroll() {{ if ({}) this.updatePos(); }},
        init() {{
            this._scrollHandler = () => this.onScroll();
            window.addEventListener('scroll', this._scrollHandler, true);
            window.addEventListener('resize', this._scrollHandler);
        }},
        destroy() {{
            window.removeEventListener('scroll', this._scrollHandler, true);
            window.removeEventListener('resize', this._scrollHandler);
        }}
    }}"#, side_type, align_type, open_var)

    @let toggle_expr = format("{} = !{}; $nextTick(() => updatePos())", open_var, open_var)
    @let close_expr = format("{} = false", open_var)

    <div class="inline-block" x-data=@x_data x-init="init()" @destroy="destroy()">
        <div x-ref="trigger" @click=@toggle_expr aria-haspopup="true" :aria-expanded=@open_var>
            @trigger()
        </div>

        <template x-teleport="body">
            <div
                x-show=@open_var
                x-cloak
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 scale-95"
                x-transition:enter-end="opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100 scale-100"
                x-transition:leave-end="opacity-0 scale-95"
                @click.outside=@close_expr
                @keydown.escape.window=@close_expr
                class=@popover_cls
                :style="(side === 'left' || side === 'right')
                    ? `left: ${side === 'right' ? pos.x + 8 : 'auto'}px; right: ${side === 'left' ? (window.innerWidth - pos.x + 8) : 'auto'}px; top: ${pos.y}px; transform: translateY(-50%);`
                    : `left: ${align === 'end' ? 'auto' : pos.x + 'px'}; right: ${align === 'end' ? (window.innerWidth - pos.x) + 'px' : 'auto'}; ${flipTop ? 'bottom: ' + (window.innerHeight - pos.y + 8) + 'px' : 'top: ' + (pos.y + 8) + 'px'}; ${align === 'center' ? 'transform: translateX(-50%)' : ''}`"
                role="dialog"
            >
                @content()
            </div>
        </template>
    </div>
}

@* Close button helper for popover content *@
@fn close_button(class: &str = "") {
    @let btn_cls = cn(&["absolute right-2 top-2 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2", class])

    <button
        class=@btn_cls
        @click="open = false"
        aria-label="Close"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
        </svg>
    </button>
}
