@*
 * Scroll Area component
 * Custom styled scrollable container with styled scrollbars
 *
 * @example
 * @import components/scroll-area.wtz as scroll_area
 *
 * // Vertical scroll area (default)
 * <@scroll_area::apply class="h-72 w-48">
 *     <p>Long scrollable content...</p>
 * </@scroll_area::apply>
 *
 * // Horizontal scroll area
 * <@scroll_area::horizontal class="w-96">
 *     <div class="flex gap-4">
 *         <div class="w-32 shrink-0">Item 1</div>
 *         <div class="w-32 shrink-0">Item 2</div>
 *     </div>
 * </@scroll_area::horizontal>
 *
 * // Both directions
 * <@scroll_area::both class="h-72 w-96">
 *     <div class="w-[600px]">Wide and tall content...</div>
 * </@scroll_area::both>
 *
 * // With fade edges
 * <@scroll_area::apply class="h-72" fade=true>
 *     <p>Content with faded edges...</p>
 * </@scroll_area::apply>
 *@


@* Vertical scroll area *@
@fn apply(
    class: &str = "",
    fade: bool = false,
    content: @(),
) {
    @let scrollbar = "scrollbar-thin scrollbar-thumb-rounded-md scrollbar-thumb-border scrollbar-track-transparent hover:scrollbar-thumb-muted-foreground/50"
    @let base = "relative overflow-y-auto overflow-x-hidden"

    @if fade {
        <div class="relative">
            <div class=@cn(&[base, scrollbar, class])>
                @content()
            </div>
            <div class="pointer-events-none absolute inset-x-0 top-0 h-4 bg-gradient-to-b from-background to-transparent"></div>
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-4 bg-gradient-to-t from-background to-transparent"></div>
        </div>
    } else {
        <div class=@cn(&[base, scrollbar, class])>
            @content()
        </div>
    }
}

@* Horizontal scroll area *@
@fn horizontal(
    class: &str = "",
    fade: bool = false,
    content: @(),
) {
    @let scrollbar = "scrollbar-thin scrollbar-thumb-rounded-md scrollbar-thumb-border scrollbar-track-transparent hover:scrollbar-thumb-muted-foreground/50"
    @let base = "relative overflow-x-auto overflow-y-hidden"

    @if fade {
        <div class="relative">
            <div class=@cn(&[base, scrollbar, class])>
                @content()
            </div>
            <div class="pointer-events-none absolute inset-y-0 left-0 w-4 bg-gradient-to-r from-background to-transparent"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 w-4 bg-gradient-to-l from-background to-transparent"></div>
        </div>
    } else {
        <div class=@cn(&[base, scrollbar, class])>
            @content()
        </div>
    }
}

@* Scroll area with both directions *@
@fn both(
    class: &str = "",
    fade: bool = false,
    content: @(),
) {
    @let scrollbar = "scrollbar-thin scrollbar-thumb-rounded-md scrollbar-thumb-border scrollbar-track-transparent hover:scrollbar-thumb-muted-foreground/50"
    @let base = "relative overflow-auto"

    @if fade {
        <div class="relative">
            <div class=@cn(&[base, scrollbar, class])>
                @content()
            </div>
            <div class="pointer-events-none absolute inset-x-0 top-0 h-4 bg-gradient-to-b from-background to-transparent"></div>
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-4 bg-gradient-to-t from-background to-transparent"></div>
            <div class="pointer-events-none absolute inset-y-0 left-0 w-4 bg-gradient-to-r from-background to-transparent"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 w-4 bg-gradient-to-l from-background to-transparent"></div>
        </div>
    } else {
        <div class=@cn(&[base, scrollbar, class])>
            @content()
        </div>
    }
}

@* Viewport wrapper for custom positioning *@
@fn viewport(
    class: &str = "",
    content: @(),
) {
    <div class=@cn(&["h-full w-full rounded-[inherit]", class])>
        @content()
    </div>
}
