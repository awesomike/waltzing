@*
 * Accordion component
 * Collapsible content sections using Alpine.js collapse plugin
 *
 * Dependencies: @alpinejs/collapse
 *
 * @example
 * @import components/accordion.wtz as accordion
 *
 * @let items = vec![
 *     accordion::AccordionItem { id: "faq-1".into(), title: "What is Waltzing?".into() },
 *     accordion::AccordionItem { id: "faq-2".into(), title: "How do I get started?".into() },
 * ]
 *
 * <@accordion items=items content=|id: &str, out: @Out| @{
 *     @match id {
 *         "faq-1" => { <p>Waltzing is a template engine for Rust.</p> }
 *         "faq-2" => { <p>Install via cargo and read the docs!</p> }
 *         _ => {}
 *     }
 * } />
 *
 * <@accordion::single items=items content=|id: &str, out: @Out| @{ <p>Content for @id</p> } />
 *
 * <@accordion::item id="standalone" title="Standalone Item">
 *     <p>This is a standalone accordion item.</p>
 * </@>
 *@

@struct AccordionItem {
    id: String,
    title: String,
}

@* Main accordion with configurable multi-open support *@
@fn apply(
    items: Vec<AccordionItem>,
    content: |id: &str, out: @Out|,
    multiple: bool = false,
    class: &str = "",
) {
    @if multiple {
        <@multiple_mode items=@items content=@content class=@class />
    } else {
        <@single_mode items=@items content=@content class=@class />
    }
}

@* Accordion with only one section open at a time *@
@fn single(
    items: Vec<AccordionItem>,
    content: |id: &str, out: @Out|,
    class: &str = "",
) {
    <@single_mode items=@items content=@content class=@class />
}

@* Internal: Single-open mode implementation *@
@fn single_mode(
    items: Vec<AccordionItem>,
    content: |id: &str, out: @Out|,
    class: &str = "",
) {
    @let base = "divide-y divide-border rounded-md border"

    <div
        x-data="{ active: null }"
        class=@cn(&[base, class])
    >
        @for item in items.iter() {
            <div class="accordion-item">
                @* Trigger button *@
                <button
                    type="button"
                    @@click=@format!("active = active === '{}' ? null : '{}'", item.id, item.id)
                    :aria-expanded=@format!("active === '{}'", item.id)
                    aria-controls=@format!("accordion-content-{}", item.id)
                    class="flex w-full items-center justify-between px-4 py-4 text-sm font-medium transition-all hover:underline [&[aria-expanded=true]>svg]:rotate-180"
                >
                    <span>@item.title</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200"
                    >
                        <path d="m6 9 6 6 6-6"/>
                    </svg>
                </button>

                @* Collapsible content *@
                <div
                    id=@format!("accordion-content-{}", item.id)
                    x-show=@format!("active === '{}'", item.id)
                    x-collapse
                    x-cloak
                >
                    <div class="px-4 pb-4 pt-0 text-sm">
                        @content(&item.id, @out)
                    </div>
                </div>
            </div>
        }
    </div>
}

@* Internal: Multiple-open mode implementation *@
@fn multiple_mode(
    items: Vec<AccordionItem>,
    content: |id: &str, out: @Out|,
    class: &str = "",
) {
    @let base = "divide-y divide-border rounded-md border"

    <div
        x-data="{ open: {} }"
        class=@cn(&[base, class])
    >
        @for item in items.iter() {
            <div class="accordion-item">
                @* Trigger button *@
                <button
                    type="button"
                    @@click=@format!("open['{}'] = !open['{}']", item.id, item.id)
                    :aria-expanded=@format!("open['{}']", item.id)
                    aria-controls=@format!("accordion-content-{}", item.id)
                    class="flex w-full items-center justify-between px-4 py-4 text-sm font-medium transition-all hover:underline [&[aria-expanded=true]>svg]:rotate-180"
                >
                    <span>@item.title</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200"
                    >
                        <path d="m6 9 6 6 6-6"/>
                    </svg>
                </button>

                @* Collapsible content *@
                <div
                    id=@format!("accordion-content-{}", item.id)
                    x-show=@format!("open['{}']", item.id)
                    x-collapse
                    x-cloak
                >
                    <div class="px-4 pb-4 pt-0 text-sm">
                        @content(&item.id, @out)
                    </div>
                </div>
            </div>
        }
    </div>
}

@* Standalone accordion item for custom composition *@
@fn item(
    id: &str,
    title: &str,
    default_open: bool = false,
    class: &str = "",
    content: @(),
) {
    @let base = "border-b"
    @let open_str = if default_open { "true" } else { "false" }

    <div
        x-data=@format!("{{ open: {} }}", open_str)
        class=@cn(&[base, class])
    >
        <button
            type="button"
            @@click="open = !open"
            :aria-expanded="open"
            aria-controls=@format!("accordion-content-{}", id)
            class="flex w-full items-center justify-between px-4 py-4 text-sm font-medium transition-all hover:underline [&[aria-expanded=true]>svg]:rotate-180"
        >
            <span>@title</span>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200"
            >
                <path d="m6 9 6 6 6-6"/>
            </svg>
        </button>

        <div
            id=@format!("accordion-content-{}", id)
            x-show="open"
            x-collapse
            x-cloak
        >
            <div class="px-4 pb-4 pt-0 text-sm">
                @content(@out)
            </div>
        </div>
    </div>
}
