@*
 * Collapsible component
 * Simple show/hide section with smooth collapse animation
 *
 * Dependencies: @alpinejs/collapse
 *
 * @example
 * @import components/collapsible.wtz as collapsible
 *
 * <@collapsible
 *     open=false
 *     trigger=@{ <span>Toggle content</span> }
 *     content=@{ <p>This content can be shown or hidden.</p> }
 * />
 *
 * // With external state control (controlled version)
 * <div x-data="{ isOpen: true }">
 *     <button x-on:click="isOpen = !isOpen">External Toggle</button>
 *     <@collapsible::controlled
 *         open_var="isOpen"
 *         trigger=@{ <span>Show/Hide</span> }
 *         content=@{ <p>Controlled content.</p> }
 *     />
 * </div>
 *@

@* Full collapsible with trigger and content *@
@fn apply(
    open: bool,
    trigger: @(),
    content: @(),
) {
    @let open_str = if open { "true" } else { "false" }

    <div x-data=@format!("{{ open: {} }}", open_str)>
        <button
            type="button"
            @@click="open = !open"
            :aria-expanded="open"
            class="flex items-center gap-2"
        >
            @trigger(@out)
        </button>

        <div
            x-show="open"
            x-collapse
            x-cloak
        >
            @content(@out)
        </div>
    </div>
}

@* Controlled collapsible (external state) *@
@fn controlled(
    open_var: &str,
    trigger: @(),
    content: @(),
) {
    <div>
        <button
            type="button"
            @@click=@format!("{} = !{}", open_var, open_var)
            :aria-expanded=@open_var
            class="flex items-center gap-2"
        >
            @trigger(@out)
        </button>

        <div
            x-show=@open_var
            x-collapse
            x-cloak
        >
            @content(@out)
        </div>
    </div>
}
