@**
 * Time Picker component
 * A time input with hour, minute, and optional seconds selection
 * Uses Alpine.js for interactive time picking with popover
 * Supports dynamic 12h/24h toggle and HH:MM/HH:MM:SS format toggle
 *
 * Usage:
 *   @import components/time-picker.wtz as time_picker
 *
 *   Basic time picker:
 *   <@time_picker::apply name="start_time" value=Some("14:30") />
 *
 *   With label:
 *   <@time_picker::labeled
 *       label="Meeting Time"
 *       name="meeting_time"
 *       value=Some("09:00")
 *       required=true
 *   />
 **@


@fn apply(
    name: &str,
    value: Option<&str> = None,
    disabled: bool = false,
    placeholder: Option<&str> = None,
    error: Option<&str> = None,
    class: Option<&str> = None,
) {
    @let placeholder_text = placeholder.unwrap_or("Select time")
    @let initial_value = value.unwrap_or("")

    @let input_cls = cn(&[
        "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm transition-colors",
        "placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring",
        "disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer pr-10",
        if error.is_some() { "border-destructive focus-visible:ring-destructive" } else { "" },
        class.unwrap_or("")
    ])

    <div
        class="inline-block w-full"
        x-data="{
            open: false,
            value: '@initial_value',
            displayValue: '',
            hour: 0,
            minute: 0,
            second: 0,
            period: 'AM',
            use12h: false,
            includeSeconds: false,
            pos: { x: 0, y: 0, width: 0 },
            flipTop: false,

            get maxHour() { return this.use12h ? 12 : 23; },
            get minHour() { return this.use12h ? 1 : 0; },

            updatePos() {
                const trigger = this.$refs.trigger;
                if (!trigger) return;
                const rect = trigger.getBoundingClientRect();
                const pickerHeight = 320;
                const spaceBelow = window.innerHeight - rect.bottom;
                const spaceAbove = rect.top;
                this.flipTop = spaceBelow < pickerHeight && spaceAbove > spaceBelow;
                this.pos.x = rect.left;
                this.pos.y = this.flipTop ? rect.top : rect.bottom;
                this.pos.width = rect.width;
            },

            onScroll() { if (this.open) this.updatePos(); },

            init() {
                this._scrollHandler = () => this.onScroll();
                window.addEventListener('scroll', this._scrollHandler, true);
                window.addEventListener('resize', this._scrollHandler);

                if (this.value) {
                    this.parseTime(this.value);
                }
                this.updateDisplayValue();
            },

            destroy() {
                window.removeEventListener('scroll', this._scrollHandler, true);
                window.removeEventListener('resize', this._scrollHandler);
            },

            parseTime(timeStr) {
                if (!timeStr) return;
                const parts = timeStr.split(':');
                if (parts.length >= 1) {
                    let h = parseInt(parts[0], 10) || 0;
                    if (this.use12h) {
                        this.period = h >= 12 ? 'PM' : 'AM';
                        h = h % 12;
                        if (h === 0) h = 12;
                    }
                    this.hour = h;
                }
                if (parts.length >= 2) {
                    this.minute = parseInt(parts[1], 10) || 0;
                }
                if (parts.length >= 3) {
                    this.second = parseInt(parts[2], 10) || 0;
                    this.includeSeconds = true;
                }
            },

            formatTime24h() {
                let h = this.hour;
                if (this.use12h) {
                    h = this.hour % 12;
                    if (this.period === 'PM') h += 12;
                    if (h === 12 && this.period === 'AM') h = 0;
                    if (h === 24) h = 12;
                }
                const hStr = h.toString().padStart(2, '0');
                const mStr = this.minute.toString().padStart(2, '0');
                const sStr = this.second.toString().padStart(2, '0');

                if (this.includeSeconds) {
                    return `${hStr}:${mStr}:${sStr}`;
                }
                return `${hStr}:${mStr}`;
            },

            updateDisplayValue() {
                if (!this.value && this.hour === 0 && this.minute === 0 && this.second === 0) {
                    this.displayValue = '';
                    return;
                }
                let h = this.hour;
                if (this.use12h && h === 0) h = 12;
                const hStr = h.toString().padStart(2, '0');
                const mStr = this.minute.toString().padStart(2, '0');
                const sStr = this.second.toString().padStart(2, '0');

                if (this.includeSeconds) {
                    this.displayValue = this.use12h
                        ? `${hStr}:${mStr}:${sStr} ${this.period}`
                        : `${hStr}:${mStr}:${sStr}`;
                } else {
                    this.displayValue = this.use12h
                        ? `${hStr}:${mStr} ${this.period}`
                        : `${hStr}:${mStr}`;
                }
            },

            selectTime() {
                this.value = this.formatTime24h();
                this.updateDisplayValue();
                this.open = false;
            },

            setNow() {
                const now = new Date();
                let h = now.getHours();
                if (this.use12h) {
                    this.period = h >= 12 ? 'PM' : 'AM';
                    h = h % 12;
                    if (h === 0) h = 12;
                }
                this.hour = h;
                this.minute = now.getMinutes();
                this.second = now.getSeconds();
            },

            toggle12h() {
                const was12h = this.use12h;
                this.use12h = !this.use12h;

                if (this.use12h && !was12h) {
                    // Converting from 24h to 12h
                    this.period = this.hour >= 12 ? 'PM' : 'AM';
                    this.hour = this.hour % 12;
                    if (this.hour === 0) this.hour = 12;
                } else if (!this.use12h && was12h) {
                    // Converting from 12h to 24h
                    let h = this.hour % 12;
                    if (this.period === 'PM') h += 12;
                    if (h === 24) h = 0;
                    this.hour = h;
                }
            },

            incrementHour() {
                if (this.hour >= this.maxHour) {
                    this.hour = this.minHour;
                } else {
                    this.hour++;
                }
            },

            decrementHour() {
                if (this.hour <= this.minHour) {
                    this.hour = this.maxHour;
                } else {
                    this.hour--;
                }
            },

            incrementMinute() {
                this.minute = (this.minute + 1) % 60;
            },

            decrementMinute() {
                this.minute = this.minute - 1;
                if (this.minute < 0) this.minute = 59;
            },

            incrementSecond() {
                this.second = (this.second + 1) % 60;
            },

            decrementSecond() {
                this.second = this.second - 1;
                if (this.second < 0) this.second = 59;
            },

            togglePeriod() {
                this.period = this.period === 'AM' ? 'PM' : 'AM';
            }
        }"
        x-init="init()"
        @@destroy="destroy()"
    >
        <input type="hidden" name="@name" x-model="value" />

        <div
            class="relative"
            x-ref="trigger"
            @@click="if (!$el.querySelector('input[type=text]').disabled) { open = !open; $nextTick(() => updatePos()); }"
        >
            <input
                type="text"
                readonly
                x-model="displayValue"
                placeholder="@placeholder_text"
                class="@input_cls"
                @if disabled { disabled }
                @if error.is_some() { aria-invalid="true" }
                aria-haspopup="dialog"
                :aria-expanded="open"
            />
            <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-muted-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
        </div>

        <template x-teleport="body">
            <div
                x-show="open"
                x-cloak
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 scale-95"
                x-transition:enter-end="opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100 scale-100"
                x-transition:leave-end="opacity-0 scale-95"
                @@click.outside="open = false"
                @@keydown.escape.window="open = false"
                class="fixed z-[9999] rounded-md border bg-popover text-popover-foreground shadow-md"
                :style="`left: ${pos.x}px; min-width: ${pos.width}px; ${flipTop ? 'bottom: ' + (window.innerHeight - pos.y + 8) + 'px' : 'top: ' + (pos.y + 8) + 'px'}`"
                role="dialog"
                aria-modal="true"
                aria-label="Choose time"
            >
                @* Format Toggles *@
                <div class="p-3 border-b">
                    <div class="flex items-center justify-between gap-4">
                        @* 12h/24h Toggle *@
                        <div class="flex items-center gap-2">
                            <button
                                type="button"
                                @@click="if (use12h) toggle12h()"
                                class="px-2 py-1 text-xs font-medium rounded transition-colors"
                                :class="!use12h ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'"
                            >
                                24h
                            </button>
                            <button
                                type="button"
                                @@click="if (!use12h) toggle12h()"
                                class="px-2 py-1 text-xs font-medium rounded transition-colors"
                                :class="use12h ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'"
                            >
                                12h
                            </button>
                        </div>
                        @* HH:MM / HH:MM:SS Toggle *@
                        <div class="flex items-center gap-2">
                            <button
                                type="button"
                                @@click="includeSeconds = false; second = 0"
                                class="px-2 py-1 text-xs font-medium rounded transition-colors"
                                :class="!includeSeconds ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'"
                            >
                                HH:MM
                            </button>
                            <button
                                type="button"
                                @@click="includeSeconds = true"
                                class="px-2 py-1 text-xs font-medium rounded transition-colors"
                                :class="includeSeconds ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'"
                            >
                                HH:MM:SS
                            </button>
                        </div>
                    </div>
                </div>

                <div class="p-4">
                    <div class="flex items-center justify-center gap-2">
                        @* Hours *@
                        <div class="flex flex-col items-center">
                            <span class="text-xs text-muted-foreground mb-1">Hour</span>
                            <button
                                type="button"
                                @@click="incrementHour()"
                                class="p-1 hover:bg-accent hover:text-accent-foreground rounded transition-colors"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m18 15-6-6-6 6"/>
                                </svg>
                            </button>
                            <div class="w-12 h-10 flex items-center justify-center rounded border bg-background text-lg font-mono font-medium" x-text="hour.toString().padStart(2, '0')"></div>
                            <button
                                type="button"
                                @@click="decrementHour()"
                                class="p-1 hover:bg-accent hover:text-accent-foreground rounded transition-colors"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </button>
                        </div>

                        <span class="text-xl font-bold text-muted-foreground mt-5">:</span>

                        @* Minutes *@
                        <div class="flex flex-col items-center">
                            <span class="text-xs text-muted-foreground mb-1">Min</span>
                            <button
                                type="button"
                                @@click="incrementMinute()"
                                class="p-1 hover:bg-accent hover:text-accent-foreground rounded transition-colors"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m18 15-6-6-6 6"/>
                                </svg>
                            </button>
                            <div class="w-12 h-10 flex items-center justify-center rounded border bg-background text-lg font-mono font-medium" x-text="minute.toString().padStart(2, '0')"></div>
                            <button
                                type="button"
                                @@click="decrementMinute()"
                                class="p-1 hover:bg-accent hover:text-accent-foreground rounded transition-colors"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </button>
                        </div>

                        @* Seconds (conditional) *@
                        <template x-if="includeSeconds">
                            <div class="flex items-center gap-2">
                                <span class="text-xl font-bold text-muted-foreground mt-5">:</span>
                                <div class="flex flex-col items-center">
                                    <span class="text-xs text-muted-foreground mb-1">Sec</span>
                                    <button
                                        type="button"
                                        @@click="incrementSecond()"
                                        class="p-1 hover:bg-accent hover:text-accent-foreground rounded transition-colors"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m18 15-6-6-6 6"/>
                                        </svg>
                                    </button>
                                    <div class="w-12 h-10 flex items-center justify-center rounded border bg-background text-lg font-mono font-medium" x-text="second.toString().padStart(2, '0')"></div>
                                    <button
                                        type="button"
                                        @@click="decrementSecond()"
                                        class="p-1 hover:bg-accent hover:text-accent-foreground rounded transition-colors"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m6 9 6 6 6-6"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </template>

                        @* AM/PM toggle for 12-hour format *@
                        <template x-if="use12h">
                            <div class="flex flex-col items-center ml-2">
                                <span class="text-xs text-muted-foreground mb-1">&nbsp;</span>
                                <button
                                    type="button"
                                    @@click="togglePeriod()"
                                    class="w-12 h-10 flex items-center justify-center rounded border bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90 transition-colors"
                                    x-text="period"
                                ></button>
                                <span class="text-xs text-muted-foreground mt-1">&nbsp;</span>
                            </div>
                        </template>
                    </div>

                    @* Action buttons *@
                    <div class="flex gap-2 mt-4 pt-3 border-t">
                        <button
                            type="button"
                            class="flex-1 inline-flex items-center justify-center rounded-md text-sm font-medium h-8 px-3 bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                            @@click="setNow()"
                        >
                            Now
                        </button>
                        <button
                            type="button"
                            class="flex-1 inline-flex items-center justify-center rounded-md text-sm font-medium h-8 px-3 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                            @@click="selectTime()"
                        >
                            Set
                        </button>
                    </div>
                </div>
            </div>
        </template>
    </div>
}

@fn labeled(
    label: &str,
    name: &str,
    value: Option<&str> = None,
    disabled: bool = false,
    required: bool = false,
    placeholder: Option<&str> = None,
    error: Option<&str> = None,
    class: Option<&str> = None,
) {
    <div class="space-y-2">
        <label for="@name" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
            @label
            @if required { <span class="text-destructive">*</span> }
        </label>
        <@apply
            name=@name
            value=@value
            disabled=@disabled
            placeholder=@placeholder
            error=@error
            class=@class
        />
        @if let Some(e) = error {
            <p class="text-sm text-destructive">@e</p>
        }
    </div>
}

@fn simple(name: &str, value: Option<&str>) {
    <@apply
        name=@name
        value=@value
    />
}
