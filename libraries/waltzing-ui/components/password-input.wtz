@*
 * Password input component
 * Password input field with show/hide visibility toggle
 *
 * Usage:
 *   @import ui/components/password-input.wtz as password_input
 *
 *   <@password_input::apply name="password" value=None placeholder=Some("Enter password") disabled=false required=true error=None class="" />
 *   <@password_input::labeled label="Password" name="password" value=None placeholder=Some("Enter password") disabled=false required=true error=None class="" />
 *   <@password_input::simple name="password" />
 *@


@fn apply(
    name: &str,
    value: Option<&str>,
    placeholder: Option<&str>,
    disabled: bool,
    required: bool,
    error: Option<&str>,
    class: &str = "",
) {
    @let base = "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 pr-10 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"

    @let error_cls = if error.is_some() { "border-destructive focus-visible:ring-destructive" } else { "" }

    @let cls = class
    @let classes = vec![@base, @error_cls, @cls]

    <div class="relative" x-data="{ show: false }">
        <input
            :type="show ? 'text' : 'password'"
            name="@name"
            id="@name"
            class="@cn(@classes)"
            @if let Some(v) = value { value="@v" }
            @if let Some(p) = placeholder { placeholder="@p" }
            @if disabled { disabled }
            @if required { required }
            @if error.is_some() { aria-invalid="true" }
            autocomplete="current-password"
        />
        <button
            type="button"
            class="absolute right-0 top-0 h-9 w-9 flex items-center justify-center text-muted-foreground hover:text-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring rounded-r-md disabled:pointer-events-none disabled:opacity-50"
            x-on:click="show = !show"
            :aria-label="show ? 'Hide password' : 'Show password'"
            @if disabled { disabled }
        >
            @* Eye icon (shown when password is hidden) *@
            <svg
                x-show="!show"
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4"
            >
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
            @* Eye-off icon (shown when password is visible) *@
            <svg
                x-show="show"
                x-cloak
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4"
            >
                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
                <line x1="2" x2="22" y1="2" y2="22"/>
            </svg>
        </button>
    </div>
}

@* Password input with label *@
@fn labeled(
    label: &str,
    name: &str,
    value: Option<&str>,
    placeholder: Option<&str>,
    disabled: bool,
    required: bool,
    error: Option<&str>,
    class: &str = "",
) {
    <div class="space-y-2">
        <label for="@name" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
            @label
            @if required { <span class="text-destructive">*</span> }
        </label>
        <@apply
            name=@name
            value=@value
            placeholder=@placeholder
            disabled=@disabled
            required=@required
            error=@error
            class=@class
        />
        @if let Some(e) = error {
            <p class="text-sm text-destructive">@e</p>
        }
    </div>
}

@* Simple password input with default settings *@
@fn simple(name: &str) {
    <@apply
        name=@name
        value=None
        placeholder=None
        disabled=false
        required=false
        error=None
        class=""
    />
}

@* Password input with placeholder *@
@fn with_placeholder(name: &str, placeholder: &str) {
    <@apply
        name=@name
        value=None
        placeholder=Some(@placeholder)
        disabled=false
        required=false
        error=None
        class=""
    />
}

@* Required password input *@
@fn required(name: &str, placeholder: Option<&str>) {
    <@apply
        name=@name
        value=None
        placeholder=@placeholder
        disabled=false
        required=true
        error=None
        class=""
    />
}
