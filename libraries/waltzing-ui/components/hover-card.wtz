@**
 * Hover Card component
 * Rich content card shown on hover, like GitHub user hover cards
 * Uses Alpine.js for hover state with delay before showing
 * Stays open while hovering the content
 *
 * Usage:
 *   @import components/hover-card.wtz as hover_card
 *
 *   <@hover_card::apply
 *       side=hover_card::Side::Bottom
 *       trigger=@{ <a href="/user/jane">@jane</a> }
 *       content=@{
 *           <div class="flex gap-4">
 *               <img src="/avatar.jpg" class="h-12 w-12 rounded-full" />
 *               <div>
 *                   <h4 class="text-sm font-semibold">Jane Doe</h4>
 *                   <p class="text-sm text-muted-foreground">Software Engineer</p>
 *               </div>
 *           </div>
 *       }
 *   />
 **@

@enum Side {
    Top,
    Right,
    Bottom,
    Left,
}

@enum Align {
    Start,
    Center,
    End,
}

@* Main hover card with delay and rich content *@
@fn apply(
    side: Side = Side::Bottom,
    align: Align = Align::Center,
    open_delay_ms: u32 = 500,
    close_delay_ms: u32 = 300,
    class: Option<&str> = None,
    trigger: @() = @{},
    content: @() = @{},
) {
    @let side_cls = {
        match side {
            Side::Top => "bottom-full mb-2",
            Side::Right => "left-full ml-2",
            Side::Bottom => "top-full mt-2",
            Side::Left => "right-full mr-2",
        }
    }

    @let align_cls = {
        match align {
            Align::Start => "left-0",
            Align::Center => "left-1/2 -translate-x-1/2",
            Align::End => "right-0",
        }
    }

    @let card_cls = cn(&["absolute z-50 w-64 rounded-md border bg-popover p-4 text-popover-foreground shadow-md outline-none", side_cls, align_cls, class.unwrap_or("")])

    <div class="relative inline-block" x-data="{ open: false, openTimeout: null, closeTimeout: null }">
        <div
            @mouseenter="clearTimeout(closeTimeout); openTimeout = setTimeout(() => open = true, @open_delay_ms)"
            @mouseleave="clearTimeout(openTimeout); closeTimeout = setTimeout(() => open = false, @close_delay_ms)"
            @focus="clearTimeout(closeTimeout); openTimeout = setTimeout(() => open = true, @open_delay_ms)"
            @blur="clearTimeout(openTimeout); closeTimeout = setTimeout(() => open = false, @close_delay_ms)"
        >
            @trigger()
        </div>

        <div
            x-show="open"
            x-cloak
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            @mouseenter="clearTimeout(closeTimeout)"
            @mouseleave="closeTimeout = setTimeout(() => open = false, @close_delay_ms)"
            class="@card_cls"
        >
            @content()
        </div>
    </div>
}

@* Hover card without delay (instant show/hide) *@
@fn instant(
    side: Side = Side::Bottom,
    align: Align = Align::Center,
    class: Option<&str> = None,
    trigger: @() = @{},
    content: @() = @{},
) {
    @let side_cls = {
        match side {
            Side::Top => "bottom-full mb-2",
            Side::Right => "left-full ml-2",
            Side::Bottom => "top-full mt-2",
            Side::Left => "right-full mr-2",
        }
    }

    @let align_cls = {
        match align {
            Align::Start => "left-0",
            Align::Center => "left-1/2 -translate-x-1/2",
            Align::End => "right-0",
        }
    }

    @let card_cls = cn(&["absolute z-50 w-64 rounded-md border bg-popover p-4 text-popover-foreground shadow-md outline-none", side_cls, align_cls, class.unwrap_or("")])

    <div class="relative inline-block" x-data="{ open: false }">
        <div
            @mouseenter="open = true"
            @mouseleave="open = false"
            @focus="open = true"
            @blur="open = false"
        >
            @trigger()
        </div>

        <div
            x-show="open"
            x-cloak
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            @mouseenter="open = true"
            @mouseleave="open = false"
            class="@card_cls"
        >
            @content()
        </div>
    </div>
}

@* Hover card trigger wrapper *@
@fn trigger(class: Option<&str> = None, content: @() = @{}) {
    @let trigger_cls = cn(&["cursor-pointer", class.unwrap_or("")])

    <span class="@trigger_cls">
        @content()
    </span>
}

@* Hover card content wrapper with avatar layout *@
@fn avatar_content(
    avatar_src: &str = "",
    avatar_alt: &str = "",
    class: Option<&str> = None,
    content: @() = @{},
) {
    @let content_cls = cn(&["flex gap-4", class.unwrap_or("")])

    <div class="@content_cls">
        <img src="@avatar_src" alt="@avatar_alt" class="h-12 w-12 rounded-full" />
        <div class="space-y-1">
            @content()
        </div>
    </div>
}
