@**
 * Hover Card component
 * Rich content card shown on hover, like GitHub user hover cards
 * Uses Alpine.js for hover state with delay before showing
 * Stays open while hovering the content
 *
 * Usage:
 *   @import components/hover-card.wtz as hover_card
 *
 *   <@hover_card::apply
 *       side=hover_card::Side::Bottom
 *       trigger=@{ <a href="/user/jane">@jane</a> }
 *       content=@{
 *           <div class="flex gap-4">
 *               <img src="/avatar.jpg" class="h-12 w-12 rounded-full" />
 *               <div>
 *                   <h4 class="text-sm font-semibold">Jane Doe</h4>
 *                   <p class="text-sm text-muted-foreground">Software Engineer</p>
 *               </div>
 *           </div>
 *       }
 *   />
 **@

@enum Side {
    Top,
    Right,
    Bottom,
    Left,
}

@enum Align {
    Start,
    Center,
    End,
}

@* Main hover card with delay, rich content, auto-flip, and scroll tracking *@
@fn apply(
    side: Side = Side::Bottom,
    align: Align = Align::Center,
    open_delay_ms: u32 = 500u32,
    close_delay_ms: u32 = 300u32,
    class: &str = "",
    trigger: @() = @{},
    content: @() = @{},
) {
    @let _side_type = match side {
        Side::Top => "top",
        Side::Bottom => "bottom",
        Side::Left => "left",
        Side::Right => "right",
    }

    @let _align_type = match align {
        Align::Start => "start",
        Align::Center => "center",
        Align::End => "end",
    }

    @let extra_cls = class

    @let mouseenter_handler = format("clearTimeout(closeTimeout); openTimeout = setTimeout(() => {{ open = true; $nextTick(() => updatePos()); }}, {})", open_delay_ms)
    @let mouseleave_handler = format("clearTimeout(openTimeout); closeTimeout = setTimeout(() => open = false, {})", close_delay_ms)
    @let focus_handler = format("clearTimeout(closeTimeout); openTimeout = setTimeout(() => {{ open = true; $nextTick(() => updatePos()); }}, {})", open_delay_ms)
    @let blur_handler = format("clearTimeout(openTimeout); closeTimeout = setTimeout(() => open = false, {})", close_delay_ms)
    @let content_mouseleave = format("closeTimeout = setTimeout(() => open = false, {})", close_delay_ms)
    @let card_cls = cn(&["fixed z-[9999] w-64 rounded-md border bg-popover p-4 text-popover-foreground shadow-md outline-none", extra_cls])

    <div class="inline-block" x-data=@```json {
        open: false,
        pos: { x: 0, y: 0 },
        flipTop: @_side_type === 'top',
        side: @_side_type,
        align: @_align_type,
        openTimeout: null,
        closeTimeout: null,
        updatePos() {
            const trigger = this.$refs.trigger;
            if (!trigger) return;
            const rect = trigger.getBoundingClientRect();
            const cardHeight = 150;
            const isVertical = this.side === 'top' || this.side === 'bottom';
            if (isVertical) {
                const spaceBelow = window.innerHeight - rect.bottom;
                const spaceAbove = rect.top;
                this.flipTop = (this.side === 'top') || (spaceBelow < cardHeight && spaceAbove > spaceBelow);
                this.pos.y = this.flipTop ? rect.top : rect.bottom;
                if (this.align === 'start') this.pos.x = rect.left;
                else if (this.align === 'center') this.pos.x = rect.left + rect.width / 2;
                else this.pos.x = rect.right;
            } else {
                this.pos.y = rect.top + rect.height / 2;
                this.pos.x = this.side === 'right' ? rect.right : rect.left;
            }
        },
        onScroll() { if (this.open) this.updatePos(); },
        init() {
            this._scrollHandler = () => this.onScroll();
            window.addEventListener('scroll', this._scrollHandler, true);
            window.addEventListener('resize', this._scrollHandler);
        },
        destroy() {
            window.removeEventListener('scroll', this._scrollHandler, true);
            window.removeEventListener('resize', this._scrollHandler);
        }
    } ```@ x-init="init()" @@destroy="destroy()">
        <div
            x-ref="trigger"
            @@mouseenter=@mouseenter_handler
            @@mouseleave=@mouseleave_handler
            @@focus=@focus_handler
            @@blur=@blur_handler
        >
            @trigger()
        </div>

        <template x-teleport="body">
            <div
                x-show="open"
                x-cloak
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 scale-95"
                x-transition:enter-end="opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100 scale-100"
                x-transition:leave-end="opacity-0 scale-95"
                @@mouseenter="clearTimeout(closeTimeout)"
                @@mouseleave=@content_mouseleave
                class=@card_cls
                :style="(side === 'left' || side === 'right')
                    ? `left: ${side === 'right' ? pos.x + 8 : 'auto'}px; right: ${side === 'left' ? (window.innerWidth - pos.x + 8) : 'auto'}px; top: ${pos.y}px; transform: translateY(-50%);`
                    : `left: ${align === 'end' ? 'auto' : pos.x + 'px'}; right: ${align === 'end' ? (window.innerWidth - pos.x) + 'px' : 'auto'}; ${flipTop ? 'bottom: ' + (window.innerHeight - pos.y + 8) + 'px' : 'top: ' + (pos.y + 8) + 'px'}; ${align === 'center' ? 'transform: translateX(-50%)' : ''}`"
            >
                @content()
            </div>
        </template>
    </div>
}

@* Hover card without delay (instant show/hide) *@
@fn instant(
    side: Side = Side::Bottom,
    align: Align = Align::Center,
    class: &str = "",
    trigger: @() = @{},
    content: @() = @{},
) {
    @let side_cls = {
        match side {
            Side::Top => "bottom-full mb-2",
            Side::Right => "left-full ml-2",
            Side::Bottom => "top-full mt-2",
            Side::Left => "right-full mr-2",
        }
    }

    @let align_cls = {
        match align {
            Align::Start => "left-0",
            Align::Center => "left-1/2 -translate-x-1/2",
            Align::End => "right-0",
        }
    }

    @let card_cls = cn(&["absolute z-50 w-64 rounded-md border bg-popover p-4 text-popover-foreground shadow-md outline-none", side_cls, align_cls, class])

    <div class="relative inline-block" x-data="{ open: false, closeTimer: null }">
        <div
            @mouseenter="clearTimeout(closeTimer); open = true"
            @mouseleave="closeTimer = setTimeout(() => open = false, 150)"
            @focus="clearTimeout(closeTimer); open = true"
            @blur="closeTimer = setTimeout(() => open = false, 150)"
        >
            @trigger()
        </div>

        <div
            x-show="open"
            x-cloak
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            @mouseenter="clearTimeout(closeTimer); open = true"
            @mouseleave="closeTimer = setTimeout(() => open = false, 150)"
            class=@card_cls
        >
            @content()
        </div>
    </div>
}

@* Hover card trigger wrapper *@
@fn trigger(class: &str = "", content: @() = @{}) {
    @let trigger_cls = cn(&["cursor-pointer", class])

    <span class=@trigger_cls>
        @content()
    </span>
}

@* Hover card content wrapper with avatar layout *@
@fn avatar_content(
    avatar_src: &str = "",
    avatar_alt: &str = "",
    class: &str = "",
    content: @() = @{},
) {
    @let content_cls = cn(&["flex gap-4", class])

    <div class=@content_cls>
        <img src=@avatar_src alt=@avatar_alt class="h-12 w-12 rounded-full" />
        <div class="space-y-1">
            @content()
        </div>
    </div>
}
