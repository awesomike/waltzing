@*
 * Table component
 * Responsive data table with header and row rendering
 *@


@fn apply(
    header: @(),
    body: @(),
    class: &str = "",
) {
    @let cls = class
    @let base = "w-full caption-bottom text-sm"
    @let classes = &[base, cls]
    <div class="relative w-full overflow-auto">
        <table class="@cn(@classes)">
            <thead class="[&_tr]:border-b">
                @header()
            </thead>
            <tbody class="[&_tr:last-child]:border-0">
                @body()
            </tbody>
        </table>
    </div>
}

@* Table header row *@
@fn header_row(content: @()) {
    <tr class="border-b transition-colors hover:bg-muted/50">
        @content()
    </tr>
}

@* Table header cell *@
@fn th(class: &str = "", content: @()) {
    @let cls = class
    @let base = "h-10 px-2 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]"
    @let classes = &[base, cls]
    <th class="@cn(@classes)">
        @content()
    </th>
}

@* Table row *@
@fn row(class: &str = "", content: @()) {
    @let cls = class
    @let base = "border-b transition-colors hover:bg-muted/50"
    @let classes = &[base, cls]
    <tr class="@cn(@classes)">
        @content()
    </tr>
}

@* Table cell *@
@fn td(class: &str = "", content: @()) {
    @let cls = class
    @let base = "p-2 align-middle [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]"
    @let classes = &[base, cls]
    <td class="@cn(@classes)">
        @content()
    </td>
}

@* Empty state row *@
@fn empty(content: @()) {
    <tr>
        <td colspan="100" class="h-24 text-center text-muted-foreground">
            @content()
        </td>
    </tr>
}

@* Table caption *@
@fn caption(content: @()) {
    <caption class="mt-4 text-sm text-muted-foreground">
        @content()
    </caption>
}

@* Table footer *@
@fn footer(content: @()) {
    <tfoot class="border-t bg-muted/50 font-medium [&>tr]:last:border-b-0">
        @content()
    </tfoot>
}
