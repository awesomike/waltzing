@*
 * Native Select component
 * A styled native HTML <select> element
 *
 * Usage:
 *
 * 1. Data-driven:
 * <@native_select::apply name="country" options=@options selected=@Some("us") />
 *
 * 2. With label:
 * <@native_select::labeled label="Country" name="country" options=@options />
 *@


@* Option struct for data-driven usage *@
@struct NativeSelectOption {
    value: String,
    label: String,
    disabled: bool,
}

@* Native select element *@
@fn apply(
    name: &str,
    options: Vec<NativeSelectOption>,
    selected: Option<&str> = None,
    disabled: bool = false,
    required: bool = false,
    error: Option<&str> = None,
    class: &str = "",
) {
    @let base = "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"

    @let error_cls = if error.is_some() { "border-destructive focus-visible:ring-destructive" } else { "" }

    @let extra_class = class
    @let classes = [base, error_cls, extra_class]

    <select
        name=@name
        class=@cn(@classes)
        @if disabled { disabled }
        @if required { required }
        @if error.is_some() { aria-invalid="true" }
    >
        @for opt in options {
            <option
                value="@opt.value"
                @if opt.disabled { disabled }
                @if let Some(sel) = selected {
                    @if sel == opt.value { selected }
                }
            >
                @opt.label
            </option>
        }
    </select>
}

@* Native select with label *@
@fn labeled(
    label: &str,
    name: &str,
    options: Vec<NativeSelectOption>,
    selected: Option<&str> = None,
    disabled: bool = false,
    required: bool = false,
    error: Option<&str> = None,
    class: &str = "",
) {
    <div class="space-y-2">
        <label for=@name class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
            @label
            @if required { <span class="text-destructive">*</span> }
        </label>
        <@apply
            name=@name
            options=@options
            selected=@selected
            disabled=@disabled
            required=@required
            error=@error
            class=@class
        />
        @if let Some(e) = error {
            <p class="text-sm text-destructive">@e</p>
        }
    </div>
}
