@*
 * Drawer component
 * Mobile-friendly bottom sheet drawer (similar to Vaul)
 * Slides up from bottom with drag handle and backdrop overlay
 * Requires: @alpinejs/focus plugin
 *
 * Usage:
 *   @import ui/components/drawer.wtz as drawer
 *
 *   <@drawer::apply
 *       title="Edit Profile"
 *       description=Some("Make changes to your profile here.")
 *       trigger=@{ <button>Open Drawer</button> }
 *       content=@{
 *           <p>Drawer content goes here</p>
 *       }
 *   />
 *@


@fn apply(
    title: &str,
    description: Option<&str>,
    trigger: @(),
    content: @(),
    footer: Option<@()>,
) {
    <div x-data="{
        open: false,
        dragging: false,
        startY: 0,
        currentY: 0,
        snapPoints: [0.4, 1],
        snapIndex: 1,
        get snapHeight() { return this.snapPoints[this.snapIndex] * 100 }
    }">
        @* Trigger *@
        <div @click="open = true; snapIndex = 1">
            @trigger()
        </div>

        @* Drawer *@
        <template x-teleport="body">
            <div
                x-show="open"
                x-transition:enter="ease-out duration-300"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="ease-in duration-200"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="fixed inset-0 z-50"
                style="display: none;"
            >
                @* Backdrop *@
                <div
                    class="fixed inset-0 bg-black/80"
                    @click="open = false"
                    aria-hidden="true"
                ></div>

                @* Drawer Content *@
                <div
                    x-show="open"
                    x-transition:enter="ease-out duration-300"
                    x-transition:enter-start="translate-y-full"
                    x-transition:enter-end="translate-y-0"
                    x-transition:leave="ease-in duration-200"
                    x-transition:leave-start="translate-y-0"
                    x-transition:leave-end="translate-y-full"
                    :style="dragging ? `transform: translateY(${Math.max(0, currentY - startY)}px)` : ''"
                    class="fixed inset-x-0 bottom-0 z-50 mt-24 flex h-auto max-h-[96%] flex-col rounded-t-[10px] border bg-background"
                    x-trap.inert.noscroll="open"
                    @keydown.escape.window="open = false"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="drawer-title"
                >
                    @* Drag Handle *@
                    <div
                        class="mx-auto mt-4 h-2 w-[100px] cursor-grab rounded-full bg-muted active:cursor-grabbing"
                        @mousedown="dragging = true; startY = $event.clientY; currentY = $event.clientY"
                        @mousemove.window="if (dragging) { currentY = $event.clientY }"
                        @mouseup.window="
                            if (dragging) {
                                dragging = false;
                                const delta = currentY - startY;
                                if (delta > 100) {
                                    open = false;
                                }
                            }
                        "
                        @touchstart="dragging = true; startY = $event.touches[0].clientY; currentY = $event.touches[0].clientY"
                        @touchmove="if (dragging) { currentY = $event.touches[0].clientY }"
                        @touchend="
                            if (dragging) {
                                dragging = false;
                                const delta = currentY - startY;
                                if (delta > 100) {
                                    open = false;
                                }
                            }
                        "
                    ></div>

                    @* Header *@
                    <div class="flex flex-col space-y-1.5 p-4 text-center">
                        <h2 id="drawer-title" class="text-lg font-semibold leading-none tracking-tight">
                            @title
                        </h2>
                        @if let Some(desc) = description {
                            <p class="text-sm text-muted-foreground">@desc</p>
                        }
                    </div>

                    @* Content *@
                    <div class="flex-1 overflow-auto px-4 pb-4">
                        @content()
                    </div>

                    @* Footer *@
                    @if let Some(ref f) = footer {
                        <div class="flex flex-col gap-2 p-4 pt-0">
                            @f()
                        </div>
                    }
                </div>
            </div>
        </template>
    </div>
}

@* Controlled drawer (external state) *@
@fn controlled(
    open_var: &str,
    title: &str,
    description: Option<&str>,
    content: @(),
    footer: Option<@()>,
) {
    @let close_expr = format("{} = false", open_var)

    <template x-teleport="body">
        <div
            x-show=@open_var
            x-transition:enter="ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="ease-in duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="fixed inset-0 z-50"
            style="display: none;"
        >
            <div
                class="fixed inset-0 bg-black/80"
                @click=@close_expr
                aria-hidden="true"
            ></div>

            <div
                x-show=@open_var
                x-transition:enter="ease-out duration-300"
                x-transition:enter-start="translate-y-full"
                x-transition:enter-end="translate-y-0"
                x-transition:leave="ease-in duration-200"
                x-transition:leave-start="translate-y-0"
                x-transition:leave-end="translate-y-full"
                class="fixed inset-x-0 bottom-0 z-50 mt-24 flex h-auto max-h-[96%] flex-col rounded-t-[10px] border bg-background"
                x-trap.inert.noscroll=@open_var
                @keydown.escape.window=@close_expr
                role="dialog"
                aria-modal="true"
            >
                @* Drag Handle *@
                <div class="mx-auto mt-4 h-2 w-[100px] rounded-full bg-muted"></div>

                <div class="flex flex-col space-y-1.5 p-4 text-center">
                    <h2 class="text-lg font-semibold">@title</h2>
                    @if let Some(desc) = description {
                        <p class="text-sm text-muted-foreground">@desc</p>
                    }
                </div>

                <div class="flex-1 overflow-auto px-4 pb-4">@content()</div>

                @if let Some(ref f) = footer {
                    <div class="flex flex-col gap-2 p-4 pt-0">
                        @f()
                    </div>
                }
            </div>
        </div>
    </template>
}
