@*
 * Avatar component
 * User avatar with image and fallback support
 *
 * @example
 * @import components/avatar.wtz as avatar
 *
 * <@avatar::image src="/user.jpg" alt="John Doe" fallback="JD" />
 * <@avatar::fallback initials="JD" />
 * <@avatar::sm src="/user.jpg" alt="John Doe" fallback="JD" />
 * <@avatar::lg src="/user.jpg" alt="John Doe" fallback="JD" />
 *
 * <@avatar::apply
 *     src=Some("/user.jpg")
 *     alt="John Doe"
 *     fallback="JD"
 *     size=avatar::Size::Lg
 *     class="ring-2 ring-primary"
 * />
 *@


@enum Size {
    Sm,
    Default,
    Lg,
}

@fn apply(
    src: Option<&str>,
    alt: &str,
    fallback: &str,
    size: Size,
    class: &str = "",
) {
    @let base = "relative flex shrink-0 overflow-hidden rounded-full"
    @let cls = class

    @let size_cls = match size {
        Size::Sm => { "h-8 w-8" }
        Size::Default => { "h-10 w-10" }
        Size::Lg => { "h-14 w-14" }
    }

    @let fallback_text_size = match size {
        Size::Sm => { "text-xs" }
        Size::Default => { "text-sm" }
        Size::Lg => { "text-lg" }
    }

    @let container_classes = vec![@base, @size_cls, @cls]
    @let container_cls = cn(@container_classes)
    @let fallback_base = "flex h-full w-full items-center justify-center rounded-full bg-muted"
    @let fallback_classes = vec![@fallback_base, @fallback_text_size]
    @let fallback_cls = cn(@fallback_classes)

    <span class="@container_cls">
        @if let Some(image_src) = src {
            <img
                src="@image_src"
                alt="@alt"
                class="aspect-square h-full w-full object-cover"
                x-data="{ failed: false }"
                x-on:error="failed = true"
                x-show="!failed"
            />
            <span
                class="@fallback_cls"
                x-show="failed"
                x-cloak
            >
                @fallback
            </span>
        } else {
            <span class="@fallback_cls">
                @fallback
            </span>
        }
    </span>
}

@* Shorthand for default avatar with image *@
@fn image(src: &str, alt: &str, fallback: &str) {
    <@apply src=Some(@src) alt=@alt fallback=@fallback size=Size::Default class="" />
}

@* Shorthand for avatar with only fallback (no image) *@
@fn fallback(initials: &str) {
    <@apply src=None alt=@initials fallback=@initials size=Size::Default class="" />
}

@* Small avatar with image *@
@fn sm(src: &str, alt: &str, fallback: &str) {
    <@apply src=Some(@src) alt=@alt fallback=@fallback size=Size::Sm class="" />
}

@* Large avatar with image *@
@fn lg(src: &str, alt: &str, fallback: &str) {
    <@apply src=Some(@src) alt=@alt fallback=@fallback size=Size::Lg class="" />
}
