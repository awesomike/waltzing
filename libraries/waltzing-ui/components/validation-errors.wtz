@**
 * Validation Errors component
 * Display a list of form validation errors with destructive styling
 *
 * Usage:
 *   import components/validation-errors.wtz as validation
 *
 *   Display list of errors:
 *   <validation::apply errors=errors class="" />
 *
 *   Display single error if present:
 *   <validation::single error=Some("This field is required") class="" />
 *
 *   Minimal inline field error:
 *   <validation::field_error error=Some("Invalid email format") />
 **@

@* Display a list of validation errors with icon and destructive styling *@
@fn apply(errors: Vec<&str>, class: &str = "") {
    @if !errors.is_empty() {
        @let base = "rounded-lg border border-destructive/50 bg-destructive/10 p-4 text-sm text-destructive"

        <div role="alert" aria-live="polite" class=@cn(&[base, class])>
            <div class="flex items-start gap-3">
                <svg class="h-4 w-4 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div class="flex-1">
                    <ul class="list-disc pl-5 space-y-1">
                        @for error in errors {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
}

@* Display a single error message if present *@
@fn single(error: Option<&str>, class: &str = "") {
    @if let Some(msg) = error {
        @let base = "rounded-lg border border-destructive/50 bg-destructive/10 p-4 text-sm text-destructive"

        <div role="alert" aria-live="polite" class=@cn(&[base, class])>
            <div class="flex items-start gap-3">
                <svg class="h-4 w-4 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <p>@msg</p>
            </div>
        </div>
    }
}

@* Minimal inline field error - for use below form inputs *@
@fn field_error(error: Option<&str>) {
    @if let Some(msg) = error {
        <p class="text-sm text-destructive mt-1" role="alert">@msg</p>
    }
}

@* Display errors with a title header *@
@fn with_title(errors: Vec<&str>, title: &str, class: &str = "") {
    @if !errors.is_empty() {
        @let base = "rounded-lg border border-destructive/50 bg-destructive/10 p-4 text-sm text-destructive"

        <div role="alert" aria-live="polite" class=@cn(&[base, class])>
            <div class="flex items-start gap-3">
                <svg class="h-4 w-4 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div class="flex-1">
                    <p class="font-medium mb-2">@title</p>
                    <ul class="list-disc pl-5 space-y-1">
                        @for error in errors {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
}
