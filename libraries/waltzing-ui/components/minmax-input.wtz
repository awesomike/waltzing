@*
 * MinMax Input Component
 * A collapsible range input inside one shared border container.
 * Collapsed: [value ... | unit▼]  — click ... to expand to range
 * Expanded:  [min - max | unit▼]  — auto-collapses when min == max
 *
 * Usage:
 *   @import ui/components/minmax-input.wtz as minmax_input
 *
 *   // Basic integer input
 *   <@minmax_input::input
 *       label="Sets"
 *       model_min="data.sets_min"
 *       model_max="data.sets_max"
 *   />
 *
 *   // Decimal input
 *   <@minmax_input::input
 *       label="Protein (g)"
 *       number_type=minmax_input::NumberType::Decimal
 *       model_min="data.protein_min"
 *       model_max="data.protein_max"
 *       step=0.1
 *   />
 *
 *   // With unit dropdown
 *   <@minmax_input::input
 *       label="Weight"
 *       model_min="data.weight_min"
 *       model_max="data.weight_max"
 *       model_unit="data.weight_unit"
 *       unit_preset="weight"
 *       step=0.5
 *   />
 *
 *   // With static suffix
 *   <@minmax_input::input
 *       label="Calories"
 *       model_min="data.cal_min"
 *       model_max="data.cal_max"
 *       suffix="kcal"
 *   />
 *
 *   // Form submission with unit
 *   <@minmax_input::form_input
 *       label="Height"
 *       name_min="height_min"
 *       name_max="height_max"
 *       value_min=Some(170)
 *       value_max=Some(180)
 *       unit_name="height_unit"
 *       unit_value="cm"
 *       unit_preset="height"
 *   />
 *
 *   // Bare form input (no label)
 *   <@minmax_input::apply
 *       name="reps"
 *       min_value=Some(8.0)
 *       max_value=Some(12.0)
 *       input_min=Some(1.0)
 *   />
 *
 *   Unit presets: "height", "body_weight", "weight", "exercise_weight",
 *   "distance", "time", "volume"
 *@

@import /components/numeric-field.wtz as numeric_field

@enum NumberType {
    Integer,
    Decimal,
}


@* Alpine.js reactive input with model binding.
   Supports optional unit dropdown or static suffix on the right.
   Collapsed: [value ... | unit▼]  — click ... to expand
   Expanded:  [min - max | unit▼]  — auto-collapses when min == max *@
@fn input(
    label: &str,
    model_min: &str,
    model_max: &str,
    number_type: NumberType = NumberType::Integer,
    step: f64 = 0.0,
    input_min: Option<f64> = None,
    input_max: Option<f64> = None,
    placeholder: &str = "—",
    model_unit: &str = "",
    unit_preset: &str = "",
    suffix: &str = "",
    class: &str = "",
) {
    @let resolved_step = if step > 0.0 { step } else { match number_type { NumberType::Integer => { 1.0 } NumberType::Decimal => { 0.01 } } }
    @let step_str = if resolved_step == 1.0 { "1".to_string() } else { resolved_step.to_string() }
    @let has_unit = (!unit_preset.is_empty() && !model_unit.is_empty())
    @let has_suffix = !suffix.is_empty()
    @let has_right = (has_unit || has_suffix)
    @let min_str = input_min.map(|v| v.to_string())
    @let max_str = input_max.map(|v| v.to_string())

    @let input_cls = "flex-1 min-w-0 px-3 py-2 bg-transparent text-sm border-0 focus:outline-none focus:ring-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
    @let cls = class

    <div class=@cn(["space-y-2", cls])
         x-data=@```json {
            expanded: (@model_min !== null && @model_max !== null && @model_min !== @model_max)
        } ```@>
        <label class="text-sm font-medium leading-none">@label</label>

        <div class="flex rounded-md border border-input shadow-sm"
             @if has_unit { x-data="{ open: false }" x-on:click.outside="open = false" }>
            @* Collapsed: single value input *@
            <input x-show="!expanded" type="number"
                   step=@step_str
                   @if let Some(min) = &min_str { min=@min }
                   @if let Some(max) = &max_str { max=@max }
                   x-model.number=@model_min
                   @input=@format("{model_max} = {model_min}")
                   class=@cn([input_cls, "rounded-l-md"])
                   placeholder=@placeholder />

            @* Expanded: min input *@
            <input x-show="expanded" x-ref="minInput" type="number"
                   step=@step_str
                   @if let Some(min) = &min_str { min=@min }
                   @if let Some(max) = &max_str { max=@max }
                   x-model.number=@model_min
                   x-on:input=@format("if ({model_min} === {model_max}) expanded = false")
                   class=@cn([input_cls, "rounded-l-md"])
                   placeholder="Min" />

            @* Expand trigger (collapsed) / separator (expanded) *@
            <button x-show="!expanded" type="button"
                    @click=@format("expanded = true; $nextTick(() => {{ if (!{model_min} && {model_min} !== 0) $refs.minInput.focus(); else $refs.maxInput.focus(); }})")
                    class="inline-flex items-center px-1.5 text-muted-foreground hover:text-foreground cursor-pointer"
                    title="Expand to range">
                <span class="text-xs tracking-widest">...</span>
            </button>
            <span x-show="expanded" class="inline-flex items-center px-1 text-muted-foreground text-sm select-none">-</span>

            @* Expanded: max input *@
            <input x-show="expanded" x-ref="maxInput" type="number"
                   step=@step_str
                   @if let Some(min) = &min_str { min=@min }
                   @if let Some(max) = &max_str { max=@max }
                   x-model.number=@model_max
                   x-on:input=@format("if ({model_min} === {model_max}) expanded = false")
                   class=@cn([input_cls, if has_right { "" } else { "rounded-r-md" }])
                   placeholder="Max" />

            @if has_suffix {
                <span class="inline-flex items-center px-3 py-2 text-sm text-muted-foreground bg-muted border-l border-input rounded-r-md select-none">@suffix</span>
            } else if has_unit {
                <@numeric_field::unit_dropdown model=@model_unit preset=@unit_preset />
            }
        </div>
    </div>
}

@* Form-compatible minmax input for standard form submission.
   Supports optional unit dropdown or static suffix on the right.
   Collapsed: [value ... | unit▼]  — click ... to expand
   Expanded:  [min - max | unit▼]  — auto-collapses when min == max *@
@fn form_input(
    label: &str,
    name_min: &str,
    name_max: &str,
    value_min: Option<i32> = None,
    value_max: Option<i32> = None,
    number_type: NumberType = NumberType::Integer,
    step: f64 = 0.0,
    input_min: Option<f64> = None,
    input_max: Option<f64> = None,
    placeholder: &str = "—",
    unit_name: &str = "",
    unit_value: &str = "",
    unit_preset: &str = "",
    suffix: &str = "",
    class: &str = "",
) {
    @let resolved_step = if step > 0.0 { step } else { match number_type { NumberType::Integer => { 1.0 } NumberType::Decimal => { 0.01 } } }
    @let step_str = if resolved_step == 1.0 { "1".to_string() } else { resolved_step.to_string() }
    @let is_expanded = (value_min.is_some() && value_max.is_some() && value_min != value_max)
    @let has_unit = (!unit_preset.is_empty() && !unit_name.is_empty())
    @let has_suffix = !suffix.is_empty()
    @let has_right = (has_unit || has_suffix)
    @let min_attr = input_min.map(|v| v.to_string())
    @let max_attr = input_max.map(|v| v.to_string())
    @let min_init = value_min.map(|v| v as f64)
    @let max_init = value_max.map(|v| v as f64)

    @let input_cls = "flex-1 min-w-0 px-3 py-2 bg-transparent text-sm border-0 focus:outline-none focus:ring-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
    @let cls = class

    <div class=@cn(["space-y-2", cls])
         x-data=@```json {
            expanded: @is_expanded,
            minVal: @min_init,
            maxVal: @max_init,
            @if has_unit {
                unit: @unit_value,
            }
        } ```@>
        <label class="text-sm font-medium leading-none">@label</label>

        @* Hidden inputs for form submission *@
        <input type="hidden" name=@name_min x-model="minVal" />
        <input type="hidden" name=@name_max x-model="maxVal" />

        <div class="flex rounded-md border border-input shadow-sm"
             @if has_unit { x-data="{ open: false }" x-on:click.outside="open = false" }>
            @* Collapsed: single value input *@
            <input x-show="!expanded" type="number"
                   step=@step_str
                   @if let Some(min) = &min_attr { min=@min }
                   @if let Some(max) = &max_attr { max=@max }
                   x-model.number="minVal"
                   @input="maxVal = minVal"
                   class=@cn([input_cls, "rounded-l-md"])
                   placeholder=@placeholder />

            @* Expanded: min input *@
            <input x-show="expanded" x-ref="minInput" type="number"
                   step=@step_str
                   @if let Some(min) = &min_attr { min=@min }
                   @if let Some(max) = &max_attr { max=@max }
                   x-model.number="minVal"
                   x-on:input="if (minVal === maxVal) expanded = false"
                   class=@cn([input_cls, "rounded-l-md"])
                   placeholder="Min" />

            @* Expand trigger (collapsed) / separator (expanded) *@
            <button x-show="!expanded" type="button"
                    @click="expanded = true; $nextTick(() => { if (!minVal && minVal !== 0) $refs.minInput.focus(); else $refs.maxInput.focus(); })"
                    class="inline-flex items-center px-1.5 text-muted-foreground hover:text-foreground cursor-pointer"
                    title="Expand to range">
                <span class="text-xs tracking-widest">...</span>
            </button>
            <span x-show="expanded" class="inline-flex items-center px-1 text-muted-foreground text-sm select-none">-</span>

            @* Expanded: max input *@
            <input x-show="expanded" x-ref="maxInput" type="number"
                   step=@step_str
                   @if let Some(min) = &min_attr { min=@min }
                   @if let Some(max) = &max_attr { max=@max }
                   x-model.number="maxVal"
                   x-on:input="if (minVal === maxVal) expanded = false"
                   class=@cn([input_cls, if has_right { "" } else { "rounded-r-md" }])
                   placeholder="Max" />

            @if has_suffix {
                <span class="inline-flex items-center px-3 py-2 text-sm text-muted-foreground bg-muted border-l border-input rounded-r-md select-none">@suffix</span>
            } else if has_unit {
                <@numeric_field::unit_dropdown model="unit" preset=@unit_preset unit_name=@unit_name />
            }
        </div>
    </div>
}

@* Bare form-compatible apply function (no label) *@
@fn apply(
    name: &str,
    min_value: Option<f64> = None,
    max_value: Option<f64> = None,
    number_type: NumberType = NumberType::Integer,
    step: f64 = 0.0,
    input_min: Option<f64> = None,
    input_max: Option<f64> = None,
    placeholder: &str = "—",
    unit_name: &str = "",
    unit_value: &str = "",
    unit_preset: &str = "",
    suffix: &str = "",
    class: &str = "",
) {
    @let resolved_step = if step > 0.0 { step } else { match number_type { NumberType::Integer => { 1.0 } NumberType::Decimal => { 0.01 } } }
    @let step_str = if resolved_step == 1.0 { "1".to_string() } else { resolved_step.to_string() }
    @let min_attr = input_min.map(|v| v.to_string())
    @let max_attr = input_max.map(|v| v.to_string())
    @let is_expanded = (min_value.is_some() && max_value.is_some() && min_value != max_value)
    @let min_init = min_value.unwrap_or(0.0)
    @let max_init = max_value.unwrap_or(0.0)
    @let name_min = format("{}_min", name)
    @let name_max = format("{}_max", name)
    @let has_unit = (!unit_preset.is_empty() && !unit_name.is_empty())
    @let has_suffix = !suffix.is_empty()
    @let has_right = (has_unit || has_suffix)

    @let input_cls = "flex-1 min-w-0 px-3 py-2 bg-transparent text-sm border-0 focus:outline-none focus:ring-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
    @let cls = class

    <div class=@cn(["inline-flex items-center", cls])
         x-data=@```json {
            expanded: @is_expanded,
            minVal: @min_init,
            maxVal: @max_init
        } ```@>
        @* Hidden max input for form submission *@
        <input type="hidden" name=@name_max x-model="maxVal" />

        <div class="flex rounded-md border border-input shadow-sm"
             @if has_unit { x-data=@```json { open: false, unit: @unit_value } ```@ x-on:click.outside="open = false" }>
            @* Collapsed: single value input *@
            <input x-show="!expanded" type="number"
                   name=@name_min
                   step=@step_str
                   @if let Some(min) = &min_attr { min=@min }
                   @if let Some(max) = &max_attr { max=@max }
                   x-model.number="minVal"
                   @input="maxVal = minVal"
                   class=@cn([input_cls, "rounded-l-md"])
                   placeholder=@placeholder />

            @* Expanded: min input *@
            <input x-show="expanded" x-ref="minInput" type="number"
                   name=@name_min
                   step=@step_str
                   @if let Some(min) = &min_attr { min=@min }
                   @if let Some(max) = &max_attr { max=@max }
                   x-model.number="minVal"
                   x-on:input="if (minVal === maxVal) expanded = false"
                   class=@cn([input_cls, "rounded-l-md"])
                   placeholder="Min"
                   aria-label="Minimum value" />

            @* Expand trigger (collapsed) / separator (expanded) *@
            <button x-show="!expanded" type="button"
                    @click="expanded = true; $nextTick(() => { if (!minVal && minVal !== 0) $refs.minInput.focus(); else $refs.maxInput.focus(); })"
                    class="inline-flex items-center px-1.5 text-muted-foreground hover:text-foreground cursor-pointer"
                    title="Expand to range">
                <span class="text-xs tracking-widest">...</span>
            </button>
            <span x-show="expanded" class="inline-flex items-center px-1 text-muted-foreground text-sm select-none">-</span>

            @* Expanded: max input *@
            <input x-show="expanded" x-ref="maxInput" type="number"
                   name=@name_max
                   step=@step_str
                   @if let Some(min) = &min_attr { min=@min }
                   @if let Some(max) = &max_attr { max=@max }
                   x-model.number="maxVal"
                   x-on:input="if (minVal === maxVal) expanded = false"
                   class=@cn([input_cls, if has_right { "" } else { "rounded-r-md" }])
                   placeholder="Max"
                   aria-label="Maximum value" />

            @if has_suffix {
                <span class="inline-flex items-center px-3 py-2 text-sm text-muted-foreground bg-muted border-l border-input rounded-r-md select-none">@suffix</span>
            } else if has_unit {
                <@numeric_field::unit_dropdown model="unit" preset=@unit_preset unit_name=@unit_name />
            }
        </div>
    </div>
}

@* Apply with label *@
@fn labeled(
    label: &str,
    name: &str,
    min_value: Option<f64> = None,
    max_value: Option<f64> = None,
    number_type: NumberType = NumberType::Integer,
    step: f64 = 0.0,
    input_min: Option<f64> = None,
    input_max: Option<f64> = None,
    placeholder: &str = "—",
    unit_name: &str = "",
    unit_value: &str = "",
    unit_preset: &str = "",
    suffix: &str = "",
    class: &str = "",
) {
    @let cls = class
    <div class=@cn(["space-y-2", cls])>
        <label class="text-sm font-medium leading-none">@label</label>
        <@apply
            name=@name
            min_value=@min_value
            max_value=@max_value
            number_type=@number_type
            step=@step
            input_min=@input_min
            input_max=@input_max
            placeholder=@placeholder
            unit_name=@unit_name
            unit_value=@unit_value
            unit_preset=@unit_preset
            suffix=@suffix
        />
    </div>
}

@* Shorthand for simple apply with defaults *@
@fn simple(name: &str, min_value: Option<f64>, max_value: Option<f64>) {
    <@apply
        name=@name
        min_value=@min_value
        max_value=@max_value
    />
}
