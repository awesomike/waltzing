@*
 * Breadcrumb component
 * Navigation path indicator showing the current page location
 *
 * Usage:
 *   @import ui/components/breadcrumb.wtz as breadcrumb
 *
 *   @let items = vec![
 *       breadcrumb::BreadcrumbItem { label: "Home".to_string(), href: Some("/".to_string()) },
 *       breadcrumb::BreadcrumbItem { label: "Products".to_string(), href: Some("/products".to_string()) },
 *       breadcrumb::BreadcrumbItem { label: "Widgets".to_string(), href: None },
 *   ]
 *   <@breadcrumb::apply items=items />
 *
 *   With custom separator:
 *   <@breadcrumb::apply items=items separator_text=Some(">") />
 *
 *   Or build manually with components:
 *   <@breadcrumb::root>
 *       <@breadcrumb::list>
 *           <@breadcrumb::item><@breadcrumb::link href="/">Home</@breadcrumb::link></@breadcrumb::item>
 *           <@breadcrumb::separator />
 *           <@breadcrumb::item><@breadcrumb::page>Products</@breadcrumb::page></@breadcrumb::item>
 *       </@breadcrumb::list>
 *   </@breadcrumb::root>
 *@


@struct BreadcrumbItem {
    label: String,
    href: Option<String>,
}

@* Root breadcrumb container *@
@fn root(
    class: &str = "",
    content: @(),
) {
    <nav
        aria-label="Breadcrumb"
        class=@class
    >
        @content()
    </nav>
}

@* Breadcrumb list container *@
@fn list(
    class: &str = "",
    content: @(),
) {
    <ol class=@cn(&["flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5", class])>
        @content()
    </ol>
}

@* Individual breadcrumb item wrapper *@
@fn item(
    class: &str = "",
    content: @(),
) {
    <li class=@cn(&["inline-flex items-center gap-1.5", class])>
        @content()
    </li>
}

@* Breadcrumb link (clickable item) *@
@fn link(
    href: &str,
    class: &str = "",
    content: @(),
) {
    <a
        href=@href
        class=@cn(&["transition-colors hover:text-foreground", class])
    >
        @content()
    </a>
}

@* Current page indicator (non-clickable, last item) *@
@fn page(
    class: &str = "",
    content: @(),
) {
    <span
        role="link"
        aria-disabled="true"
        aria-current="page"
        class=@cn(&["font-normal text-foreground", class])
    >
        @content()
    </span>
}

@* Separator between breadcrumb items (customizable, default: /) *@
@fn separator(
    text: Option<&str> = None,
    class: &str = "",
) {
    @let sep = text.unwrap_or("/")
    <li
        role="presentation"
        aria-hidden="true"
        class=@cn(&["text-muted-foreground", class])
    >
        @sep
    </li>
}

@* Ellipsis for collapsed breadcrumb items *@
@fn ellipsis(
    class: &str = "",
) {
    <span
        role="presentation"
        aria-hidden="true"
        class=@cn(&["flex h-9 w-9 items-center justify-center", class])
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
            <circle cx="12" cy="12" r="1"/>
            <circle cx="19" cy="12" r="1"/>
            <circle cx="5" cy="12" r="1"/>
        </svg>
        <span class="sr-only">More</span>
    </span>
}

@* High-level apply function that renders a list of items *@
@fn apply(
    items: Vec<BreadcrumbItem>,
    separator_text: Option<&str> = None,
    class: &str = "",
) {
    <@root class=@class>
        <@list>
            @for (i, item) in items.iter().enumerate() {
                @if i > 0 {
                    <@separator text=@separator_text />
                }
                <@item>
                    @if let Some(ref href) = item.href {
                        <@link href=@href>@item.label</@link>
                    } else {
                        <@page>@item.label</@page>
                    }
                </@item>
            }
        </@list>
    </@root>
}
