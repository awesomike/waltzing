@*
 * Radio Group component
 * Single selection from a list of options with custom styled radio buttons
 *
 * @example
 * @import components/radio-group.wtz as radio
 *
 * @let options = vec![
 *     RadioOption { value: "light".into(), label: "Light".into(), description: None, disabled: false },
 *     RadioOption { value: "dark".into(), label: "Dark".into(), description: None, disabled: false },
 *     RadioOption { value: "system".into(), label: "System".into(), description: Some("Use system preference".into()), disabled: false },
 * ];
 *
 * <@radio::apply
 *     name="theme"
 *     options=&options
 *     selected=Some("light")
 *     class=None
 * />
 *
 * <@radio::horizontal name="size" options=&options selected=Some("md") />
 *@


@struct RadioOption {
    value: String,
    label: String,
    description: Option<String>,
    disabled: bool,
}

@fn apply(
    name: &str,
    options: Vec<RadioOption>,
    selected: Option<&str>,
    class: Option<&str>,
) {
    @let group_base = "grid gap-2"
    @let cls = class.unwrap_or("")

    <div
        role="radiogroup"
        class="@cn(&[@group_base, @cls])"
    >
        @for opt in options {
            @let is_checked = (selected == Some(opt.value.as_str()))
            @let item_id = format!("{}_{}", name, opt.value)
            @let radio_base = "aspect-square h-4 w-4 rounded-full border border-primary text-primary shadow focus:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
            @let label_cls = "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"

            <div class="flex items-start space-x-2">
                <div class="grid place-items-center">
                    @* Native radio input styled as custom circle *@
                    <input
                        type="radio"
                        id="@item_id"
                        name="@name"
                        value="@opt.value"
                        class="@radio_base peer col-start-1 row-start-1"
                        @if is_checked { checked }
                        @if opt.disabled { disabled }
                    />
                    @* Filled circle indicator when selected *@
                    <div class="col-start-1 row-start-1 h-2 w-2 rounded-full bg-primary @if is_checked { block } else { hidden } peer-checked:block"></div>
                </div>
                @* Label and optional description *@
                @if opt.description.is_some() {
                    <div class="grid gap-1.5 leading-none">
                        <label for="@item_id" class="@label_cls">
                            @opt.label
                        </label>
                        @if let Some(desc) = &opt.description {
                            <p class="text-sm text-muted-foreground">@desc</p>
                        }
                    </div>
                } else {
                    <label for="@item_id" class="@label_cls">
                        @opt.label
                    </label>
                }
            </div>
        }
    </div>
}

@* Radio group with horizontal layout *@
@fn horizontal(
    name: &str,
    options: Vec<RadioOption>,
    selected: Option<&str>,
    class: Option<&str>,
) {
    @let group_base = "flex flex-wrap gap-4"
    @let cls = class.unwrap_or("")

    <div
        role="radiogroup"
        class="@cn(&[@group_base, @cls])"
    >
        @for opt in options {
            @let is_checked = (selected == Some(opt.value.as_str()))
            @let item_id = format!("{}_{}", name, opt.value)
            @let radio_base = "aspect-square h-4 w-4 rounded-full border border-primary text-primary shadow focus:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
            @let label_cls = "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"

            <div class="flex items-center space-x-2">
                <div class="grid place-items-center">
                    <input
                        type="radio"
                        id="@item_id"
                        name="@name"
                        value="@opt.value"
                        class="@radio_base peer col-start-1 row-start-1"
                        @if is_checked { checked }
                        @if opt.disabled { disabled }
                    />
                    <div class="col-start-1 row-start-1 h-2 w-2 rounded-full bg-primary @if is_checked { block } else { hidden } peer-checked:block"></div>
                </div>
                <label for="@item_id" class="@label_cls">
                    @opt.label
                </label>
            </div>
        }
    </div>
}

@* Radio group with label *@
@fn labeled(
    label: &str,
    name: &str,
    options: Vec<RadioOption>,
    selected: Option<&str>,
    required: bool,
    error: Option<&str>,
    class: Option<&str>,
) {
    @let cls = class.unwrap_or("")

    <fieldset class="space-y-3 @if error.is_some() { [&_input]:border-destructive }">
        <legend class="text-sm font-medium leading-none">
            @label
            @if required { <span class="text-destructive ml-0.5">*</span> }
        </legend>
        <@apply
            name=@name
            options=@options
            selected=@selected
            class=Some(@cls)
        />
        @if let Some(e) = error {
            <p class="text-sm text-destructive">@e</p>
        }
    </fieldset>
}
