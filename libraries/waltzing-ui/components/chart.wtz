@*
 * Chart component
 * CSS-only and SVG-based charts with shadcn theme colors
 *
 * Usage:
 *   @import ui/components/chart.wtz as chart
 *
 *   // Bar chart (vertical)
 *   @let data = vec![
 *       chart::DataPoint { label: "Jan", value: 100.0, color: None },
 *       chart::DataPoint { label: "Feb", value: 150.0, color: None },
 *       chart::DataPoint { label: "Mar", value: 80.0, color: None },
 *   ]
 *   <@chart::bar data=@data />
 *
 *   // Horizontal bar chart
 *   <@chart::bar data=@data direction=chart::Direction::Horizontal />
 *
 *   // Line chart
 *   <@chart::line data=@data />
 *
 *   // Donut chart
 *   @let segments = vec![
 *       chart::Segment { label: "Desktop", value: 60.0, color: Some("hsl(var(--primary))") },
 *       chart::Segment { label: "Mobile", value: 30.0, color: Some("hsl(var(--secondary))") },
 *       chart::Segment { label: "Tablet", value: 10.0, color: Some("hsl(var(--muted))") },
 *   ]
 *   <@chart::donut data=@segments />
 *
 *   // Sparkline (inline small chart)
 *   @let values = vec![10.0, 25.0, 15.0, 30.0, 20.0, 35.0, 28.0]
 *   <@chart::sparkline data=@values />
 *@


@* Data point for bar and line charts *@
@struct DataPoint {
    label: String,
    value: f64,
    color: Option<String>,
}

@* Segment for pie/donut charts *@
@struct Segment {
    label: String,
    value: f64,
    color: Option<String>,
}

@* Direction for bar charts *@
@enum Direction {
    Vertical,
    Horizontal,
}


@* Vertical or horizontal bar chart *@
@fn bar(
    data: Vec<DataPoint>,
    direction: Direction = Direction::Vertical,
    height: &str = "h-64",
    show_labels: bool = true,
    show_values: bool = true,
    class: &str = "",
) {
    @let max_value = data.iter().map(|d| d.value).fold(0.0_f64, |a, b| a.max(b))
    @let safe_max = if (max_value == 0.0) { 1.0 } else { max_value }
    @let extra_class = class

    @match direction {
        Direction::Vertical => {
            @let container = vec!["flex flex-col gap-2", extra_class]
            <div class="@cn(@container)">
                <div class="flex items-end gap-2 @height">
                    @for point in data {
                        @let pct = (point.value / safe_max * 100.0)
                        @let bar_color = match &point.color {
                            Some(c) => { c.as_str() }
                            None => { "hsl(var(--primary))" }
                        }
                        <div class="flex-1 flex flex-col items-center justify-end h-full">
                            @if show_values {
                                @let value_int = point.value as i64
                                <span class="text-xs text-muted-foreground mb-1">@value_int</span>
                            }
                            <div
                                class="w-full rounded-t-sm transition-all duration-300 hover:opacity-80"
                                style="height: @(pct)%; background-color: @bar_color; min-height: 4px;"
                                role="img"
                                aria-label="@(point.label): @(point.value)"
                            ></div>
                        </div>
                    }
                </div>
                @if show_labels {
                    <div class="flex gap-2">
                        @for point in data {
                            <div class="flex-1 text-center">
                                <span class="text-xs text-muted-foreground truncate">@(point.label)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        Direction::Horizontal => {
            @let container = vec!["flex flex-col gap-3", extra_class]
            <div class="@cn(@container)">
                @for point in data {
                    @let pct = (point.value / safe_max * 100.0)
                    @let bar_color = match &point.color {
                        Some(c) => { c.as_str() }
                        None => { "hsl(var(--primary))" }
                    }
                    <div class="flex items-center gap-3">
                        @if show_labels {
                            <span class="text-sm text-muted-foreground w-16 truncate">@(point.label)</span>
                        }
                        <div class="flex-1 h-6 bg-muted rounded-sm overflow-hidden">
                            <div
                                class="h-full rounded-sm transition-all duration-300 hover:opacity-80 flex items-center justify-end pr-2"
                                style="width: @(pct)%; background-color: @bar_color; min-width: 4px;"
                                role="img"
                                aria-label="@(point.label): @(point.value)"
                            >
                                @if show_values {
                                    @let value_int = point.value as i64
                                    <span class="text-xs font-medium text-primary-foreground">@value_int</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
}


@* Line chart using SVG polyline *@
@fn line(
    data: Vec<DataPoint>,
    height: u32 = 200,
    width: u32 = 400,
    show_dots: bool = true,
    show_labels: bool = true,
    show_grid: bool = true,
    fill: bool = false,
    class: &str = "",
) {
    @let max_value = data.iter().map(|d| d.value).fold(0.0_f64, |a, b| a.max(b))
    @let min_value = data.iter().map(|d| d.value).fold(f64::MAX, |a, b| a.min(b))
    @let safe_range = if ((max_value - min_value) == 0.0) { 1.0 } else { (max_value - min_value) }
    @let count = data.len()
    @let padding = 40_u32
    @let chart_width = (width - padding * 2)
    @let chart_height = (height - padding * 2)
    @let chart_width_f64 = chart_width as f64
    @let count_minus_one_f64 = (count - 1) as f64
    @let step_x = if (count > 1) { (chart_width_f64 / count_minus_one_f64) } else { chart_width_f64 }

    @* Build points string for polyline *@
    @let points = data.iter().enumerate().map(|(i, d)| {
        let x = padding as f64 + (i as f64 * step_x);
        let y = padding as f64 + chart_height as f64 - ((d.value - min_value) / safe_range * chart_height as f64);
        format!("{},{}", x as i32, y as i32)
    }).collect::<Vec<_>>().join(" ")

    @* Build fill polygon points (includes bottom corners) *@
    @let fill_points = {
        let mut pts = data.iter().enumerate().map(|(i, d)| {
            let x = padding as f64 + (i as f64 * step_x);
            let y = padding as f64 + chart_height as f64 - ((d.value - min_value) / safe_range * chart_height as f64);
            format!("{},{}", x as i32, y as i32)
        }).collect::<Vec<_>>();
        let bottom_y = padding + chart_height;
        pts.push(format!("{},{}", padding + chart_width, bottom_y));
        pts.push(format!("{},{}", padding, bottom_y));
        pts.join(" ")
    }

    @let extra_class = class
    @let container = vec!["w-full", extra_class]

    <div class="@cn(@container)">
        <svg
            viewBox="0 0 @width @height"
            class="w-full h-auto"
            role="img"
            aria-label="Line chart"
        >
            @* Grid lines *@
            @if show_grid {
                <g class="text-muted" stroke="currentColor" stroke-opacity="0.2">
                    @* Horizontal grid lines *@
                    @for i in 0..5 {
                        @let y = (padding + (chart_height / 4 * i as u32))
                        <line x1="@padding" y1="@y" x2="@(padding + chart_width)" y2="@y" />
                    }
                </g>
            }

            @* Fill area *@
            @if fill {
                <polygon
                    points="@fill_points"
                    fill="hsl(var(--primary))"
                    fill-opacity="0.1"
                />
            }

            @* Line *@
            <polyline
                points="@points"
                fill="none"
                stroke="hsl(var(--primary))"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            />

            @* Data points *@
            @if show_dots {
                @for (i, point) in data.iter().enumerate() {
                    @let x = (padding as f64 + (i as f64 * step_x)) as i32
                    @let y = (padding as f64 + chart_height as f64 - ((point.value - min_value) / safe_range * chart_height as f64)) as i32
                    <circle
                        cx="@x"
                        cy="@y"
                        r="4"
                        fill="hsl(var(--background))"
                        stroke="hsl(var(--primary))"
                        stroke-width="2"
                    >
                        <title>@(point.label): @(point.value)</title>
                    </circle>
                }
            }

            @* X-axis labels *@
            @if show_labels {
                @for (i, point) in data.iter().enumerate() {
                    @let x = (padding as f64 + (i as f64 * step_x)) as i32
                    @let y = (height - 10)
                    <text
                        x="@x"
                        y="@y"
                        text-anchor="middle"
                        class="text-xs fill-muted-foreground"
                        style="font-size: 10px; fill: hsl(var(--muted-foreground));"
                    >@(point.label)</text>
                }
            }
        </svg>
    </div>
}


@* Donut/pie chart using SVG *@
@fn donut(
    data: Vec<Segment>,
    size: u32 = 200,
    thickness: u32 = 40,
    show_legend: bool = true,
    class: &str = "",
) {
    @let total = data.iter().map(|s| s.value).sum::<f64>()
    @let safe_total = if (total == 0.0) { 1.0 } else { total }
    @let center = (size / 2)
    @let radius = ((size - thickness) / 2)
    @let radius_f64 = radius as f64
    @let circumference = (2.0 * 3.14159265359 * radius_f64)

    @* Default colors using theme variables *@
    @let default_colors = vec![
        "hsl(var(--primary))",
        "hsl(var(--secondary))",
        "hsl(var(--accent))",
        "hsl(var(--muted))",
        "hsl(var(--destructive))",
    ]

    @let extra_class = class
    @let container = vec!["flex flex-col items-center gap-4", extra_class]

    @* Precompute cumulative offsets for each segment *@
    @let offsets = {
        let mut result = Vec::new();
        let mut sum = 0.0_f64;
        for segment in data.iter() {
            result.push(sum);
            let pct = segment.value / safe_total;
            let dash = pct * circumference;
            sum = sum + dash;
        }
        result
    }
    @let center_radius = (radius - thickness / 2) as i32

    <div class="@cn(@container)">
        <svg
            width="@size"
            height="@size"
            viewBox="0 0 @size @size"
            class="transform -rotate-90"
            role="img"
            aria-label="Donut chart"
        >
            @for (i, segment) in data.iter().enumerate() {
                @let pct = (segment.value / safe_total)
                @let dash = (pct * circumference)
                @let gap = (circumference - dash)
                @let offset = offsets.get(i).copied().unwrap_or(0.0)
                @let neg_offset = (-offset)
                @let color = match &segment.color {
                    Some(c) => { c.as_str() }
                    None => { default_colors.get(i % default_colors.len()).unwrap_or(&"hsl(var(--primary))") }
                }
                @let pct_int = (pct * 100.0) as i32

                <circle
                    cx="@center"
                    cy="@center"
                    r="@radius"
                    fill="none"
                    stroke="@color"
                    stroke-width="@thickness"
                    stroke-dasharray="@dash @gap"
                    stroke-dashoffset="@neg_offset"
                    class="transition-all duration-300 hover:opacity-80"
                >
                    <title>@(segment.label): @(segment.value) (@(pct_int)%)</title>
                </circle>
            }

            @* Center hole (for better visual) *@
            <circle
                cx="@center"
                cy="@center"
                r="@center_radius"
                fill="hsl(var(--background))"
            />
        </svg>

        @* Legend *@
        @if show_legend {
            <div class="flex flex-wrap justify-center gap-4">
                @for (i, segment) in data.iter().enumerate() {
                    @let color = match &segment.color {
                        Some(c) => { c.as_str() }
                        None => { default_colors.get(i % default_colors.len()).unwrap_or(&"hsl(var(--primary))") }
                    }
                    @let pct = (segment.value / safe_total * 100.0) as i32
                    <div class="flex items-center gap-2">
                        <div
                            class="w-3 h-3 rounded-full"
                            style="background-color: @color;"
                        ></div>
                        <span class="text-sm text-muted-foreground">
                            @(segment.label) (@(pct)%)
                        </span>
                    </div>
                }
            </div>
        }
    </div>
}


@* Pie chart (solid, no center hole) *@
@fn pie(
    data: Vec<Segment>,
    size: u32 = 200,
    show_legend: bool = true,
    class: &str = "",
) {
    @let thickness = (size / 2)
    <@donut
        data=@data
        size=@size
        thickness=@thickness
        show_legend=@show_legend
        class=@class
    />
}


@* Sparkline - small inline chart *@
@fn sparkline(
    data: Vec<f64>,
    width: u32 = 100,
    height: u32 = 24,
    color: &str = "hsl(var(--primary))",
    fill: bool = false,
    class: &str = "",
) {
    @let max_value = data.iter().fold(0.0_f64, |a, &b| a.max(b))
    @let min_value = data.iter().fold(f64::MAX, |a, &b| a.min(b))
    @let safe_range = if ((max_value - min_value) == 0.0) { 1.0 } else { (max_value - min_value) }
    @let count = data.len()
    @let width_f64 = width as f64
    @let count_minus_one_f64 = (count - 1) as f64
    @let step_x = if (count > 1) { (width_f64 / count_minus_one_f64) } else { width_f64 }
    @let padding = 2_u32
    @let chart_height = (height - padding * 2)

    @let points = data.iter().enumerate().map(|(i, &v)| {
        let x = (i as f64 * step_x) as i32;
        let y = padding as i32 + chart_height as i32 - ((v - min_value) / safe_range * chart_height as f64) as i32;
        format!("{},{}", x, y)
    }).collect::<Vec<_>>().join(" ")

    @let fill_points = {
        let mut pts = data.iter().enumerate().map(|(i, &v)| {
            let x = (i as f64 * step_x) as i32;
            let y = padding as i32 + chart_height as i32 - ((v - min_value) / safe_range * chart_height as f64) as i32;
            format!("{},{}", x, y)
        }).collect::<Vec<_>>();
        pts.push(format!("{},{}", width, height));
        pts.push(format!("0,{}", height));
        pts.join(" ")
    }

    @let stroke_color = color
    @let extra_class = class
    @let container = vec!["inline-block", extra_class]

    <svg
        width="@width"
        height="@height"
        viewBox="0 0 @width @height"
        class="@cn(@container)"
        role="img"
        aria-label="Sparkline"
    >
        @if fill {
            <polygon
                points="@fill_points"
                fill="@stroke_color"
                fill-opacity="0.1"
            />
        }
        <polyline
            points="@points"
            fill="none"
            stroke="@stroke_color"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
        />
    </svg>
}


@* Sparkline with trend indicator *@
@fn sparkline_with_trend(
    data: Vec<f64>,
    width: u32 = 100,
    height: u32 = 24,
    class: &str = "",
) {
    @let first = data.first().copied().unwrap_or(0.0)
    @let last = data.last().copied().unwrap_or(0.0)
    @let trend = (last - first)
    @let trend_pct = if (first == 0.0) { 0.0 } else { ((last - first) / first * 100.0) }
    @let is_positive = (trend >= 0.0)

    @let trend_color = if is_positive { "hsl(var(--chart-2))" } else { "hsl(var(--destructive))" }
    @let trend_text_cls = if is_positive { "text-green-600" } else { "text-destructive" }
    @let arrow = if is_positive { "^" } else { "v" }

    @let extra_class = class
    @let container = vec!["inline-flex items-center gap-2", extra_class]

    <div class="@cn(@container)">
        <@sparkline
            data=@data
            width=@width
            height=@height
            color=@trend_color
            fill=true
        />
        @let trend_pct_int = (trend_pct.abs()) as i32
        <span class="text-xs font-medium @trend_text_cls">
            @arrow @(trend_pct_int)%
        </span>
    </div>
}


@* Bar chart with stacked values *@
@fn stacked_bar(
    labels: Vec<String>,
    series: Vec<Vec<f64>>,
    colors: Vec<String>,
    height: &str = "h-64",
    show_labels: bool = true,
    class: &str = "",
) {
    @let max_total = labels.iter().enumerate().map(|(i, _)| {
        series.iter().map(|s| s.get(i).copied().unwrap_or(0.0)).sum::<f64>()
    }).fold(0.0_f64, |a, b| a.max(b))
    @let safe_max = if (max_total == 0.0) { 1.0 } else { max_total }

    @let default_colors = vec![
        "hsl(var(--primary))",
        "hsl(var(--secondary))",
        "hsl(var(--accent))",
        "hsl(var(--muted))",
    ]

    @let extra_class = class
    @let container = vec!["flex flex-col gap-2", extra_class]

    <div class="@cn(@container)">
        <div class="flex items-end gap-2 @height">
            @for (i, label) in labels.iter().enumerate() {
                @let total = series.iter().map(|s| s.get(i).copied().unwrap_or(0.0)).sum::<f64>()
                @let total_pct = (total / safe_max * 100.0)

                <div class="flex-1 flex flex-col items-center justify-end h-full">
                    <div class="w-full flex flex-col-reverse" style="height: @(total_pct)%;">
                        @for (j, serie) in series.iter().enumerate() {
                            @let value = serie.get(i).copied().unwrap_or(0.0)
                            @let segment_pct = if (total == 0.0) { 0.0 } else { (value / total * 100.0) }
                            @let color = colors.get(j).map(|s| s.as_str()).unwrap_or(
                                default_colors.get(j % default_colors.len()).unwrap_or(&"hsl(var(--primary))")
                            )

                            <div
                                class="w-full transition-all duration-300 hover:opacity-80"
                                style="height: @(segment_pct)%; background-color: @color; min-height: 2px;"
                                role="img"
                                aria-label="@label series @(j + 1): @(value)"
                            ></div>
                        }
                    </div>
                </div>
            }
        </div>
        @if show_labels {
            <div class="flex gap-2">
                @for label in labels {
                    <div class="flex-1 text-center">
                        <span class="text-xs text-muted-foreground truncate">@label</span>
                    </div>
                }
            </div>
        }
    </div>
}


@* Simple progress-style bar *@
@fn progress_bar(
    value: f64,
    max: f64 = 100.0,
    label: Option<String>,
    show_value: bool = true,
    color: &str = "hsl(var(--primary))",
    class: &str = "",
) {
    @let pct = (value / max * 100.0)
    @let clamped = if (pct > 100.0) { 100.0 } else if (pct < 0.0) { 0.0 } else { pct }
    @let clamped_int = clamped as i32

    @let extra_class = class
    @let container = vec!["w-full", extra_class]

    <div class="@cn(@container)">
        @if let Some(lbl) = label {
            <div class="flex justify-between mb-1">
                <span class="text-sm text-muted-foreground">@lbl</span>
                @if show_value {
                    <span class="text-sm font-medium">@(clamped_int)%</span>
                }
            </div>
        }
        <div class="w-full h-2 bg-muted rounded-full overflow-hidden">
            <div
                class="h-full rounded-full transition-all duration-300"
                style="width: @(clamped)%; background-color: @color;"
                role="progressbar"
                aria-valuenow="@value"
                aria-valuemin="0"
                aria-valuemax="@max"
            ></div>
        </div>
    </div>
}


@* Gauge/radial chart *@
@fn gauge(
    value: f64,
    max: f64 = 100.0,
    size: u32 = 120,
    thickness: u32 = 12,
    label: Option<String>,
    color: &str = "hsl(var(--primary))",
    class: &str = "",
) {
    @let pct = (value / max * 100.0)
    @let clamped = if (pct > 100.0) { 100.0 } else if (pct < 0.0) { 0.0 } else { pct }
    @let clamped_int = clamped as i32
    @let center = (size / 2)
    @let radius = ((size - thickness) / 2)
    @let radius_f64 = radius as f64
    @let circumference = (2.0 * 3.14159265359 * radius_f64)
    @let dash = (clamped / 100.0 * circumference)

    @let extra_class = class
    @let container = vec!["inline-flex flex-col items-center gap-2", extra_class]

    <div class="@cn(@container)">
        <div class="relative">
            <svg
                width="@size"
                height="@size"
                viewBox="0 0 @size @size"
                class="transform -rotate-90"
                role="img"
                aria-label="Gauge showing @(clamped_int)%"
            >
                @* Background track *@
                <circle
                    cx="@center"
                    cy="@center"
                    r="@radius"
                    fill="none"
                    stroke="hsl(var(--muted))"
                    stroke-width="@thickness"
                />
                @* Value arc *@
                <circle
                    cx="@center"
                    cy="@center"
                    r="@radius"
                    fill="none"
                    stroke="@color"
                    stroke-width="@thickness"
                    stroke-dasharray="@dash @circumference"
                    stroke-linecap="round"
                    class="transition-all duration-500"
                />
            </svg>
            @* Center value *@
            <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-2xl font-bold">@(clamped_int)%</span>
            </div>
        </div>
        @if let Some(lbl) = label {
            <span class="text-sm text-muted-foreground">@lbl</span>
        }
    </div>
}
