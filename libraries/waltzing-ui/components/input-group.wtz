@*
 * Input Group component
 * Input with prefix/suffix addons for seamless visual connection
 *
 * Usage:
 *   @import ui/components/input-group.wtz as input_group
 *   @import ui/components/input.wtz as input
 *
 *   Basic with text addons:
 *   <@input_group::apply>
 *       <@input_group::prefix>$</@input_group::prefix>
 *       <@input::apply input_type=input::InputType::Number name="amount" placeholder=Some("0.00") />
 *       <@input_group::suffix>.00</@input_group::suffix>
 *   </@input_group::apply>
 *
 *   With icon prefix:
 *   <@input_group::with_icon icon="search">
 *       <@input::apply input_type=input::InputType::Search name="search" placeholder=Some("Search...") />
 *   </@input_group::with_icon>
 *
 *   With button suffix:
 *   <@input_group::apply>
 *       <@input::apply input_type=input::InputType::Email name="email" placeholder=Some("Enter email") />
 *       <@input_group::suffix_button>Subscribe</@input_group::suffix_button>
 *   </@input_group::apply>
 *@


@* Enum for common icon types *@
@enum Icon {
    Search,
    Mail,
    User,
    Lock,
    Phone,
    Link,
    Calendar,
    Clock,
    CreditCard,
    Hash,
    AtSign,
    Globe,
}

@* Main input group container *@
@fn apply(
    class: &str = "",
    content: @(),
) {
    @let extra = class
    @let classes = ["flex w-full", extra]

    <div class=@cn(classes)>
        @content()
    </div>
}

@* Prefix addon - text or icon before the input *@
@fn prefix(
    class: &str = "",
    content: @(),
) {
    @let base = "flex items-center justify-center rounded-l-md border border-r-0 border-input bg-muted px-3 text-sm text-muted-foreground"
    @let extra = class
    @let classes = [base, extra]

    <span class=@cn(classes)>
        @content()
    </span>
}

@* Suffix addon - text or icon after the input *@
@fn suffix(
    class: &str = "",
    content: @(),
) {
    @let base = "flex items-center justify-center rounded-r-md border border-l-0 border-input bg-muted px-3 text-sm text-muted-foreground"
    @let extra = class
    @let classes = [base, extra]

    <span class=@cn(classes)>
        @content()
    </span>
}

@* Prefix button addon *@
@fn prefix_button(
    disabled: bool = false,
    class: &str = "",
    content: @(),
) {
    @let base = "inline-flex items-center justify-center rounded-l-md border border-r-0 border-input bg-background px-3 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"
    @let extra = class
    @let classes = [base, extra]

    <button
        type="button"
        class=@cn(classes)
        @if disabled { disabled }
    >
        @content()
    </button>
}

@* Suffix button addon *@
@fn suffix_button(
    disabled: bool = false,
    class: &str = "",
    content: @(),
) {
    @let base = "inline-flex items-center justify-center rounded-r-md border border-l-0 border-input bg-background px-3 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"
    @let extra = class
    @let classes = [base, extra]

    <button
        type="button"
        class=@cn(classes)
        @if disabled { disabled }
    >
        @content()
    </button>
}

@* Input wrapper that removes left border radius when used with prefix *@
@fn input_with_prefix(
    class: &str = "",
    content: @(),
) {
    <div class="flex-1 [&>input]:rounded-l-none [&>input]:border-l-0">
        @content()
    </div>
}

@* Input wrapper that removes right border radius when used with suffix *@
@fn input_with_suffix(
    class: &str = "",
    content: @(),
) {
    <div class="flex-1 [&>input]:rounded-r-none [&>input]:border-r-0">
        @content()
    </div>
}

@* Input wrapper that removes both border radii when used with prefix and suffix *@
@fn input_middle(
    class: &str = "",
    content: @(),
) {
    <div class="flex-1 [&>input]:rounded-none [&>input]:border-x-0">
        @content()
    </div>
}

@* Convenience function for input with icon prefix *@
@fn with_icon(
    icon: Icon,
    class: &str = "",
    content: @(),
) {
    @let extra = class
    @let classes = ["flex w-full", extra]

    <div class=@cn(classes)>
        <span class="flex items-center justify-center rounded-l-md border border-r-0 border-input bg-muted px-3 text-muted-foreground">
            @match icon {
                Icon::Search => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.3-4.3"/>
                    </svg>
                }
                Icon::Mail => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <rect width="20" height="16" x="2" y="4" rx="2"/>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                    </svg>
                }
                Icon::User => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                }
                Icon::Lock => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                }
                Icon::Phone => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                }
                Icon::Link => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </svg>
                }
                Icon::Calendar => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <path d="M8 2v4"/>
                        <path d="M16 2v4"/>
                        <rect width="18" height="18" x="3" y="4" rx="2"/>
                        <path d="M3 10h18"/>
                    </svg>
                }
                Icon::Clock => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                }
                Icon::CreditCard => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <rect width="20" height="14" x="2" y="5" rx="2"/>
                        <line x1="2" x2="22" y1="10" y2="10"/>
                    </svg>
                }
                Icon::Hash => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <line x1="4" x2="20" y1="9" y2="9"/>
                        <line x1="4" x2="20" y1="15" y2="15"/>
                        <line x1="10" x2="8" y1="3" y2="21"/>
                        <line x1="16" x2="14" y1="3" y2="21"/>
                    </svg>
                }
                Icon::AtSign => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <circle cx="12" cy="12" r="4"/>
                        <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>
                    </svg>
                }
                Icon::Globe => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                        <path d="M2 12h20"/>
                    </svg>
                }
            }
        </span>
        <div class="flex-1 [&>input]:rounded-l-none [&>input]:border-l-0">
            @content()
        </div>
    </div>
}

@* Input with prefix and suffix text *@
@fn with_addons(
    prefix_text: &str,
    suffix_text: &str,
    class: &str = "",
    content: @(),
) {
    @let extra = class
    @let classes = ["flex w-full", extra]

    <div class=@cn(classes)>
        <span class="flex items-center justify-center rounded-l-md border border-r-0 border-input bg-muted px-3 text-sm text-muted-foreground">
            @prefix_text
        </span>
        <div class="flex-1 [&>input]:rounded-none [&>input]:border-x-0">
            @content()
        </div>
        <span class="flex items-center justify-center rounded-r-md border border-l-0 border-input bg-muted px-3 text-sm text-muted-foreground">
            @suffix_text
        </span>
    </div>
}

@* Input with only prefix text *@
@fn with_prefix(
    prefix_text: &str,
    class: &str = "",
    content: @(),
) {
    @let extra = class
    @let classes = ["flex w-full", extra]

    <div class=@cn(classes)>
        <span class="flex items-center justify-center rounded-l-md border border-r-0 border-input bg-muted px-3 text-sm text-muted-foreground">
            @prefix_text
        </span>
        <div class="flex-1 [&>input]:rounded-l-none [&>input]:border-l-0">
            @content()
        </div>
    </div>
}

@* Input with only suffix text *@
@fn with_suffix(
    suffix_text: &str,
    class: &str = "",
    content: @(),
) {
    @let extra = class
    @let classes = ["flex w-full", extra]

    <div class=@cn(classes)>
        <div class="flex-1 [&>input]:rounded-r-none [&>input]:border-r-0">
            @content()
        </div>
        <span class="flex items-center justify-center rounded-r-md border border-l-0 border-input bg-muted px-3 text-sm text-muted-foreground">
            @suffix_text
        </span>
    </div>
}

@* Input with button suffix - common pattern for search or subscribe *@
@fn with_button(
    button_text: &str,
    button_disabled: bool = false,
    class: &str = "",
    content: @(),
) {
    @let extra = class
    @let classes = ["flex w-full", extra]

    <div class=@cn(classes)>
        <div class="flex-1 [&>input]:rounded-r-none [&>input]:border-r-0">
            @content()
        </div>
        <button
            type="button"
            class="inline-flex items-center justify-center rounded-r-md border border-l-0 border-input bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"
            @if button_disabled { disabled }
        >
            @button_text
        </button>
    </div>
}

@* Input group with label *@
@fn labeled(
    label: &str,
    name: &str,
    required: bool = false,
    error: Option<&str> = None,
    class: &str = "",
    content: @(),
) {
    <div class="space-y-2">
        <label for=@name class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
            @label
            @if required { <span class="text-destructive">*</span> }
        </label>
        @content()
        @if let Some(e) = error {
            <p class="text-sm text-destructive">@e</p>
        }
    </div>
}
