@*
 * Flash Messages component
 * Server-rendered notification messages with auto-dismiss
 *
 * Flash messages are typically set on the server (e.g., after form submission)
 * and rendered once on page load. They auto-dismiss after a configurable duration.
 *
 * @example
 * @import components/flash-messages.wtz as flash
 *
 * Flash container (place once in your layout):
 * @let messages = vec![
 *     flash::FlashMessage { level: "success".into(), message: "Profile updated!".into() },
 *     flash::FlashMessage { level: "warning".into(), message: "Session expires soon.".into() },
 * ]
 * <@flash::container messages=@messages />
 *
 * Custom variant styles (override defaults):
 * @let styles = flash::VariantStyles {
 *     success: "border-emerald-500 bg-emerald-100 text-emerald-800".into(),
 *     error: "border-rose-500 bg-rose-100 text-rose-800".into(),
 *     warning: "border-amber-500 bg-amber-100 text-amber-800".into(),
 *     info: "border-sky-500 bg-sky-100 text-sky-800".into(),
 *     default: "border-gray-300 bg-gray-50 text-gray-800".into(),
 * }
 * <@flash::container messages=@messages styles=Some(@styles) />
 *
 * Individual flash message:
 * <@flash::apply level="info" message="Welcome back!" />
 *
 * Shorthand variants (use default styling):
 * <@flash::success message="Operation completed." />
 * <@flash::error message="Something went wrong." />
 * <@flash::warning message="Please review your input." />
 * <@flash::info message="New features available." />
 *@


@* Flash message data structure *@
@struct FlashMessage {
    level: String,
    message: String,
}

@* Configurable variant styles - all fields customizable *@
@struct VariantStyles {
    success: String,
    error: String,
    warning: String,
    info: String,
    default: String,
}

@* Flash messages container - renders all messages with positioning *@
@fn container(
    messages: Vec<FlashMessage>,
    styles: Option<VariantStyles> = None,
    position: &str = "top-right",
    duration: u32 = 5000,
    max_messages: Option<usize> = None,
    transition_duration: u32 = 300,
    class: Option<&str> = None,
) {
    @let position_cls = {
        match position {
            "top-left" => "top-0 left-0",
            "top-center" => "top-0 left-1/2 -translate-x-1/2",
            "top-right" => "top-0 right-0",
            "bottom-left" => "bottom-0 left-0",
            "bottom-center" => "bottom-0 left-1/2 -translate-x-1/2",
            _ => "bottom-0 right-0",
        }
    }

    @let container_cls = cn(&["fixed z-[100] flex flex-col gap-2 p-4 max-h-screen overflow-hidden pointer-events-none", position_cls, class.unwrap_or("")])

    @let display_messages = {
        if let Some(max) = max_messages {
            messages.into_iter().take(max).collect::<Vec<_>>()
        } else {
            messages
        }
    }

    @let default_styles = VariantStyles {
        success: "border-green-500/50 bg-green-50 dark:bg-green-950 text-green-900 dark:text-green-100".into(),
        error: "border-destructive/50 bg-red-50 dark:bg-red-950 text-destructive".into(),
        warning: "border-yellow-500/50 bg-yellow-50 dark:bg-yellow-950 text-yellow-900 dark:text-yellow-100".into(),
        info: "border-blue-500/50 bg-blue-50 dark:bg-blue-950 text-blue-900 dark:text-blue-100".into(),
        default: "border-border bg-background text-foreground".into(),
    }

    @let active_styles = styles.unwrap_or(default_styles)

    <div class="@container_cls" role="region" aria-label="Flash messages">
        @for (index, msg) in display_messages.iter().enumerate() {
            <@message
                level=@msg.level.as_str()
                text=@msg.message.as_str()
                styles=@active_styles.clone()
                duration=@duration
                transition_duration=@transition_duration
                index=@index
            />
        }
    </div>
}

@* Individual flash message with auto-dismiss *@
@fn message(
    level: &str,
    text: &str,
    styles: VariantStyles,
    duration: u32 = 5000,
    transition_duration: u32 = 300,
    index: usize = 0,
    class: Option<&str> = None,
) {
    @let base = "pointer-events-auto w-full max-w-sm rounded-lg border p-4 shadow-lg"

    @let variant_cls = {
        match level {
            "success" => styles.success.as_str(),
            "error" => styles.error.as_str(),
            "warning" => styles.warning.as_str(),
            "info" => styles.info.as_str(),
            _ => styles.default.as_str(),
        }
    }

    @let flash_cls = cn(&[base, variant_cls, class.unwrap_or("")])

    @let stagger_delay = (index * 100)
    @let total_duration = (duration + stagger_delay as u32)

    <div
        class="@flash_cls"
        role="alert"
        aria-live="polite"
        x-data="{ show: true }"
        x-show="show"
        x-init="setTimeout(() => show = false, @total_duration)"
        x-transition:enter="transform ease-out"
        x-transition:enter-start="translate-y-2 opacity-0 sm:translate-y-0 sm:translate-x-full"
        x-transition:enter-end="translate-y-0 opacity-100 sm:translate-x-0"
        x-transition:leave="transform ease-in"
        x-transition:leave-start="translate-y-0 opacity-100 sm:translate-x-0"
        x-transition:leave-end="translate-y-2 opacity-0 sm:translate-y-0 sm:translate-x-full"
        :style="`transition-duration: @(transition_duration)ms`"
    >
        <div class="flex items-start gap-3">
            @* Icon based on level *@
            @match level {
                "success" => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                }
                "error" => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                }
                "warning" => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                }
                "info" => {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                }
                _ => {}
            }

            @* Content *@
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium">@text</p>
            </div>

            @* Close button *@
            <button
                type="button"
                class="shrink-0 rounded-md p-1 opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                @click="show = false"
                aria-label="Dismiss"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>
        </div>
    </div>
}

@* Main apply function for individual flash messages *@
@fn apply(
    level: &str,
    message: &str,
    styles: Option<VariantStyles> = None,
    duration: u32 = 5000,
    transition_duration: u32 = 300,
    class: Option<&str> = None,
) {
    @let default_styles = VariantStyles {
        success: "border-green-500/50 bg-green-50 dark:bg-green-950 text-green-900 dark:text-green-100".into(),
        error: "border-destructive/50 bg-red-50 dark:bg-red-950 text-destructive".into(),
        warning: "border-yellow-500/50 bg-yellow-50 dark:bg-yellow-950 text-yellow-900 dark:text-yellow-100".into(),
        info: "border-blue-500/50 bg-blue-50 dark:bg-blue-950 text-blue-900 dark:text-blue-100".into(),
        default: "border-border bg-background text-foreground".into(),
    }

    @let active_styles = styles.unwrap_or(default_styles)

    <@message
        level=@level
        text=@message
        styles=@active_styles
        duration=@duration
        transition_duration=@transition_duration
        class=@class
    />
}

@* Shorthand for success flash message *@
@fn success(message: &str, duration: u32 = 5000, class: Option<&str> = None) {
    <@apply level="success" message=@message duration=@duration class=@class />
}

@* Shorthand for error flash message *@
@fn error(message: &str, duration: u32 = 5000, class: Option<&str> = None) {
    <@apply level="error" message=@message duration=@duration class=@class />
}

@* Shorthand for warning flash message *@
@fn warning(message: &str, duration: u32 = 5000, class: Option<&str> = None) {
    <@apply level="warning" message=@message duration=@duration class=@class />
}

@* Shorthand for info flash message *@
@fn info(message: &str, duration: u32 = 5000, class: Option<&str> = None) {
    <@apply level="info" message=@message duration=@duration class=@class />
}

@* Event-based flash message support for dynamic messages *@
@fn event_container(
    position: &str = "top-right",
    duration: u32 = 5000,
    max_messages: usize = 5,
    transition_duration: u32 = 300,
    class: Option<&str> = None,
) {
    @let position_cls = {
        match position {
            "top-left" => "top-0 left-0",
            "top-center" => "top-0 left-1/2 -translate-x-1/2",
            "top-right" => "top-0 right-0",
            "bottom-left" => "bottom-0 left-0",
            "bottom-center" => "bottom-0 left-1/2 -translate-x-1/2",
            _ => "bottom-0 right-0",
        }
    }

    @let container_cls = cn(&["fixed z-[100] flex flex-col gap-2 p-4 max-h-screen overflow-hidden pointer-events-none", position_cls, class.unwrap_or("")])

    <div
        id="flash-container"
        class="@container_cls"
        role="region"
        aria-label="Flash messages"
        x-data="{ messages: [], maxMessages: @max_messages }"
        @flash.window="
            const id = Date.now();
            if (messages.length >= maxMessages) {
                messages.shift();
            }
            messages.push({ id, level: $event.detail.level || 'info', message: $event.detail.message });
            setTimeout(() => {
                messages = messages.filter(m => m.id !== id);
            }, $event.detail.duration || @duration);
        "
    >
        <template x-for="msg in messages" :key="msg.id">
            <div
                class="pointer-events-auto w-full max-w-sm rounded-lg border p-4 shadow-lg"
                :class="{
                    'border-green-500/50 bg-green-50 dark:bg-green-950 text-green-900 dark:text-green-100': msg.level === 'success',
                    'border-destructive/50 bg-red-50 dark:bg-red-950 text-destructive': msg.level === 'error',
                    'border-yellow-500/50 bg-yellow-50 dark:bg-yellow-950 text-yellow-900 dark:text-yellow-100': msg.level === 'warning',
                    'border-blue-500/50 bg-blue-50 dark:bg-blue-950 text-blue-900 dark:text-blue-100': msg.level === 'info',
                    'border-border bg-background text-foreground': !['success', 'error', 'warning', 'info'].includes(msg.level)
                }"
                x-transition:enter="transform ease-out"
                x-transition:enter-start="translate-y-2 opacity-0 sm:translate-y-0 sm:translate-x-full"
                x-transition:enter-end="translate-y-0 opacity-100 sm:translate-x-0"
                x-transition:leave="transform ease-in"
                x-transition:leave-start="translate-y-0 opacity-100 sm:translate-x-0"
                x-transition:leave-end="translate-y-2 opacity-0 sm:translate-y-0 sm:translate-x-full"
                :style="`transition-duration: @(transition_duration)ms`"
                role="alert"
                aria-live="polite"
            >
                <div class="flex items-start gap-3">
                    @* Icon based on level *@
                    <template x-if="msg.level === 'success'">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </template>
                    <template x-if="msg.level === 'error'">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </template>
                    <template x-if="msg.level === 'warning'">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                    </template>
                    <template x-if="msg.level === 'info'">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                    </template>

                    @* Content *@
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium" x-text="msg.message"></p>
                    </div>

                    @* Close button *@
                    <button
                        type="button"
                        class="shrink-0 rounded-md p-1 opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                        @click="messages = messages.filter(m => m.id !== msg.id)"
                        aria-label="Dismiss"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 6 6 18"></path>
                            <path d="m6 6 12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </template>
    </div>
}

@* Helper script to trigger flash messages from JavaScript *@
@fn trigger_script() {
    <script>
        // Flash message helper - dispatch custom event to show flash
        window.showFlash = function(options) {
            window.dispatchEvent(new CustomEvent('flash', {
                detail: {
                    level: options.level || 'info',
                    message: options.message || 'Notification',
                    duration: options.duration || 5000
                }
            }));
        };
    </script>
}
