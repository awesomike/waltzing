@**
 * Separator component
 * Visual divider between sections
 *
 * Example:
 *   @import components/separator.wtz as separator
 *
 *   Horizontal separator (default):
 *   separator::apply
 *   separator::horizontal
 *
 *   Vertical separator:
 *   separator::vertical
 *
 *   With custom class:
 *   separator::apply with class=Some("my-4")
 **@

@enum Orientation {
    Horizontal,
    Vertical,
}

@import lib/utils.wtz as utils

@fn apply(
    orientation: Orientation = Orientation::Horizontal,
    class: Option<&str> = None,
) {
    @let base = "shrink-0 bg-border"

    @let orientation_cls = match orientation {
        Orientation::Horizontal => "h-[1px] w-full",
        Orientation::Vertical => "h-full w-[1px]",
    }

    @let aria_orientation = match orientation {
        Orientation::Horizontal => "horizontal",
        Orientation::Vertical => "vertical",
    }

    @let cls = class.unwrap_or("")
    @let classes = vec![base, orientation_cls, cls]
    <div
        role="separator"
        aria-orientation="@aria_orientation"
        class="@utils::cn(@classes)"
    ></div>
}

@* Horizontal separator (default) *@
@fn horizontal(class: Option<&str> = None) {
    <@apply orientation=Orientation::Horizontal class=@class />
}

@* Vertical separator *@
@fn vertical(class: Option<&str> = None) {
    <@apply orientation=Orientation::Vertical class=@class />
}
