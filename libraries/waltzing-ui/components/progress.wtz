@*
 * Progress component
 * Visual indicator of progress or loading state with determinate and indeterminate modes
 *
 * Usage:
 *   @import ui/components/progress.wtz as progress
 *
 *   // Basic progress bar (0-100)
 *   <@progress::apply value=50.0 />
 *
 *   // Progress with custom max value
 *   <@progress::apply value=75.0 max=150.0 />
 *
 *   // Progress with custom class
 *   <@progress::apply value=30.0 class="w-64" />
 *
 *   // Indeterminate loading state (unknown duration)
 *   <@progress::indeterminate />
 *
 *   // Progress with percentage label
 *   <@progress::with_label value=65.0 />
 *@


@* Main progress bar with determinate value *@
@fn apply(
    value: f64,
    max: f64 = 100.0,
    class: &str = "",
) {
    @let percentage = (value / max * 100.0)
    @let clamped = if (percentage > 100.0) { 100.0 } else if (percentage < 0.0) { 0.0 } else { percentage }

    @let base = "relative h-2 w-full overflow-hidden rounded-full bg-primary/20"
    @let indicator = "h-full bg-primary transition-all duration-300 ease-in-out"
    @let extra_class = class
    @let classes = [base, extra_class]

    <div
        role="progressbar"
        aria-valuenow=@value
        aria-valuemin="0"
        aria-valuemax=@max
        class=@cn(@classes)
    >
        <div class=@indicator style="width: @(clamped)%"></div>
    </div>
}

@* Indeterminate progress bar for unknown duration *@
@fn indeterminate(class: &str = "") {
    @let base = "relative h-2 w-full overflow-hidden rounded-full bg-primary/20"
    @let indicator = "h-full w-1/3 bg-primary animate-progress-indeterminate"
    @let extra_class = class
    @let classes = [base, extra_class]

    <div
        role="progressbar"
        aria-busy="true"
        aria-valuetext="Loading..."
        class=@cn(@classes)
    >
        <div class=@indicator></div>
    </div>
}

@* Progress bar with label showing percentage *@
@fn with_label(
    value: f64,
    max: f64 = 100.0,
    label: &str = "Progress",
    class: &str = "",
) {
    @let percentage = (value / max * 100.0)
    @let clamped = if (percentage > 100.0) { 100.0 } else if (percentage < 0.0) { 0.0 } else { percentage }
    @let display_pct = (clamped as i64)

    <div class="space-y-1">
        <div class="flex justify-between text-sm">
            <span class="text-muted-foreground">@label</span>
            <span class="font-medium">@(display_pct)%</span>
        </div>
        <@apply value=@value max=@max class=@class />
    </div>
}
