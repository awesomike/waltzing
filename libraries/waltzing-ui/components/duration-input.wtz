@*
 * Duration Input component
 * Input for time durations with configurable format (hh:mm:ss, mm:ss, hh:mm)
 *
 * Usage:
 *   @import components/duration-input.wtz as duration_input
 *
 *   // Default hh:mm:ss format with value in seconds
 *   <@duration_input::create name="duration" value=Some(3661) format="hh:mm:ss" />
 *
 *   // Minutes and seconds only
 *   <@duration_input::create name="timer" value=Some(90) format="mm:ss" />
 *
 *   // Hours and minutes (e.g., for work logs)
 *   <@duration_input::create name="work_time" value=Some(7200) format="hh:mm" />
 *
 *   // With min/max constraints (in seconds)
 *   <@duration_input::create name="interval" format="mm:ss" min=Some(60) max=Some(3600) />
 *
 *   // Inline variant for compact display
 *   <@duration_input::inline name="quick_time" value=Some(300) format="mm:ss" />
 *
 *   // Bound variant with label
 *   <@duration_input::bound label="Meeting Duration" name="meeting" value=Some(1800) format="hh:mm" />
 *
 *   // Compact bound for inline editing
 *   <@duration_input::compact_bound label="Time" name="time" value=Some(60) format="mm:ss" />
 *@


@* Main duration input component - hh:mm:ss format *@
@fn create(
    name: &str,
    value: Option<u32> = None,
    format: &str = "hh:mm:ss",
    min: Option<u32> = None,
    max: Option<u32> = None,
    disabled: bool = false,
    class: &str = "",
) {
    @let initial_seconds = value.unwrap_or(0)
    @let min_seconds = min.unwrap_or(0)
    @let max_seconds = max.unwrap_or(359999)

    @let container_base = "inline-flex items-center gap-1"
    @let input_base = "h-9 w-12 text-center text-sm font-medium rounded-md border border-input bg-transparent shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
    @let separator_cls = "text-muted-foreground text-lg font-light select-none"

    @match format {
        "hh:mm:ss" => {
            <@duration_hms
                name=@name
                initial_seconds=@initial_seconds
                min_seconds=@min_seconds
                max_seconds=@max_seconds
                disabled=@disabled
                class=@class
                container_base=@container_base
                input_base=@input_base
                separator_cls=@separator_cls
            />
        }
        "mm:ss" => {
            <@duration_ms
                name=@name
                initial_seconds=@initial_seconds
                min_seconds=@min_seconds
                max_seconds=@max_seconds
                disabled=@disabled
                class=@class
                container_base=@container_base
                input_base=@input_base
                separator_cls=@separator_cls
            />
        }
        "hh:mm" => {
            <@duration_hm
                name=@name
                initial_seconds=@initial_seconds
                min_seconds=@min_seconds
                max_seconds=@max_seconds
                disabled=@disabled
                class=@class
                container_base=@container_base
                input_base=@input_base
                separator_cls=@separator_cls
            />
        }
        _ => {
            <@duration_hms
                name=@name
                initial_seconds=@initial_seconds
                min_seconds=@min_seconds
                max_seconds=@max_seconds
                disabled=@disabled
                class=@class
                container_base=@container_base
                input_base=@input_base
                separator_cls=@separator_cls
            />
        }
    }
}

@* Internal: hh:mm:ss format *@
@fn duration_hms(
    name: &str,
    initial_seconds: u32,
    min_seconds: u32,
    max_seconds: u32,
    disabled: bool = false,
    class: &str = "",
    container_base: &str,
    input_base: &str,
    separator_cls: &str,
) {
    @let extra_cls = class
    @let container_cls = cn([container_base, extra_cls])
    <div
        class=@container_cls
        x-data=@```json {
            totalSeconds: @initial_seconds,
            hours: 0,
            minutes: 0,
            seconds: 0,
            min: @min_seconds,
            max: @max_seconds,

            init() {
                this.fromSeconds(this.totalSeconds);
            },

            fromSeconds(total) {
                total = Math.max(this.min, Math.min(this.max, total));
                this.totalSeconds = total;
                this.hours = Math.floor(total / 3600);
                total = total % 3600;
                this.minutes = Math.floor(total / 60);
                this.seconds = total % 60;
            },

            toSeconds() {
                let total = (parseInt(this.hours) || 0) * 3600 + (parseInt(this.minutes) || 0) * 60 + (parseInt(this.seconds) || 0);
                total = Math.max(this.min, Math.min(this.max, total));
                this.totalSeconds = total;
                this.fromSeconds(total);
                this.$dispatch('input', { name: '@name', value: total });
            },

            handleInput(field, event) {
                const val = event.target.value.replace(/\D/g, '');
                let num = parseInt(val) || 0;
                if (field === 'hours') this.hours = Math.min(99, num);
                else if (field === 'minutes') this.minutes = Math.min(59, num);
                else if (field === 'seconds') this.seconds = Math.min(59, num);
                this.toSeconds();
            },

            handleKeydown(field, event) {
                const inputs = this.$el.querySelectorAll('input[data-duration-field]');
                const currentIndex = Array.from(inputs).findIndex(el => el === event.target);
                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    if (field === 'hours') this.hours = Math.min(99, (parseInt(this.hours) || 0) + 1);
                    else if (field === 'minutes') this.minutes = Math.min(59, (parseInt(this.minutes) || 0) + 1);
                    else if (field === 'seconds') this.seconds = Math.min(59, (parseInt(this.seconds) || 0) + 1);
                    this.toSeconds();
                } else if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    if (field === 'hours') this.hours = Math.max(0, (parseInt(this.hours) || 0) - 1);
                    else if (field === 'minutes') this.minutes = Math.max(0, (parseInt(this.minutes) || 0) - 1);
                    else if (field === 'seconds') this.seconds = Math.max(0, (parseInt(this.seconds) || 0) - 1);
                    this.toSeconds();
                } else if (event.key === ':') {
                    event.preventDefault();
                    if (currentIndex < inputs.length - 1) inputs[currentIndex + 1].focus();
                }
            },

            handleBlur(field) {
                if (field === 'hours') this.hours = String(parseInt(this.hours) || 0).padStart(2, '0');
                else if (field === 'minutes') this.minutes = String(parseInt(this.minutes) || 0).padStart(2, '0');
                else if (field === 'seconds') this.seconds = String(parseInt(this.seconds) || 0).padStart(2, '0');
            },

            parseFlexible(input) {
                input = input.trim();
                const hhmmss = input.match(/^(\d{1,2}):(\d{1,2}):(\d{1,2})$/);
                if (hhmmss) return parseInt(hhmmss[1]) * 3600 + parseInt(hhmmss[2]) * 60 + parseInt(hhmmss[3]);
                const mmss = input.match(/^(\d{1,3}):(\d{1,2})$/);
                if (mmss) return parseInt(mmss[1]) * 60 + parseInt(mmss[2]);
                const hms = input.match(/^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/i);
                if (hms && (hms[1] || hms[2] || hms[3])) return (parseInt(hms[1]) || 0) * 3600 + (parseInt(hms[2]) || 0) * 60 + (parseInt(hms[3]) || 0);
                const pure = parseInt(input);
                if (!isNaN(pure)) return pure;
                return null;
            },

            handlePaste(event) {
                event.preventDefault();
                const text = (event.clipboardData || window.clipboardData).getData('text');
                const parsed = this.parseFlexible(text);
                if (parsed !== null) {
                    this.fromSeconds(parsed);
                    this.$dispatch('input', { name: '@name', value: this.totalSeconds });
                }
            }
        } ```@
        x-init="init()"
    >
        <input type="hidden" name=@name :value="totalSeconds" />
        <input type="text" inputmode="numeric" maxlength="2" data-duration-field="hours" class=@input_base :value="String(hours).padStart(2, '0')" x-on:input="handleInput('hours', $event)" x-on:keydown="handleKeydown('hours', $event)" x-on:blur="handleBlur('hours')" x-on:paste="handlePaste($event)" x-on:focus="$event.target.select()" placeholder="00" aria-label="Hours" @if disabled { disabled } />
        <span class=@separator_cls>:</span>
        <input type="text" inputmode="numeric" maxlength="2" data-duration-field="minutes" class=@input_base :value="String(minutes).padStart(2, '0')" x-on:input="handleInput('minutes', $event)" x-on:keydown="handleKeydown('minutes', $event)" x-on:blur="handleBlur('minutes')" x-on:paste="handlePaste($event)" x-on:focus="$event.target.select()" placeholder="00" aria-label="Minutes" @if disabled { disabled } />
        <span class=@separator_cls>:</span>
        <input type="text" inputmode="numeric" maxlength="2" data-duration-field="seconds" class=@input_base :value="String(seconds).padStart(2, '0')" x-on:input="handleInput('seconds', $event)" x-on:keydown="handleKeydown('seconds', $event)" x-on:blur="handleBlur('seconds')" x-on:paste="handlePaste($event)" x-on:focus="$event.target.select()" placeholder="00" aria-label="Seconds" @if disabled { disabled } />
    </div>
}

@* Internal: mm:ss format *@
@fn duration_ms(
    name: &str,
    initial_seconds: u32,
    min_seconds: u32,
    max_seconds: u32,
    disabled: bool = false,
    class: &str = "",
    container_base: &str,
    input_base: &str,
    separator_cls: &str,
) {
    @let extra_cls = class
    @let container_cls = cn([container_base, extra_cls])
    <div
        class=@container_cls
        x-data=@```json {
            totalSeconds: @initial_seconds,
            minutes: 0,
            seconds: 0,
            min: @min_seconds,
            max: @max_seconds,

            init() {
                this.fromSeconds(this.totalSeconds);
            },

            fromSeconds(total) {
                total = Math.max(this.min, Math.min(this.max, total));
                this.totalSeconds = total;
                this.minutes = Math.floor(total / 60);
                this.seconds = total % 60;
            },

            toSeconds() {
                let total = (parseInt(this.minutes) || 0) * 60 + (parseInt(this.seconds) || 0);
                total = Math.max(this.min, Math.min(this.max, total));
                this.totalSeconds = total;
                this.fromSeconds(total);
                this.$dispatch('input', { name: '@name', value: total });
            },

            handleInput(field, event) {
                const val = event.target.value.replace(/\D/g, '');
                let num = parseInt(val) || 0;
                if (field === 'minutes') this.minutes = Math.min(999, num);
                else if (field === 'seconds') this.seconds = Math.min(59, num);
                this.toSeconds();
            },

            handleKeydown(field, event) {
                const inputs = this.$el.querySelectorAll('input[data-duration-field]');
                const currentIndex = Array.from(inputs).findIndex(el => el === event.target);
                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    if (field === 'minutes') this.minutes = Math.min(999, (parseInt(this.minutes) || 0) + 1);
                    else if (field === 'seconds') this.seconds = Math.min(59, (parseInt(this.seconds) || 0) + 1);
                    this.toSeconds();
                } else if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    if (field === 'minutes') this.minutes = Math.max(0, (parseInt(this.minutes) || 0) - 1);
                    else if (field === 'seconds') this.seconds = Math.max(0, (parseInt(this.seconds) || 0) - 1);
                    this.toSeconds();
                } else if (event.key === ':') {
                    event.preventDefault();
                    if (currentIndex < inputs.length - 1) inputs[currentIndex + 1].focus();
                }
            },

            handleBlur(field) {
                if (field === 'minutes') this.minutes = String(parseInt(this.minutes) || 0).padStart(2, '0');
                else if (field === 'seconds') this.seconds = String(parseInt(this.seconds) || 0).padStart(2, '0');
            },

            parseFlexible(input) {
                input = input.trim();
                const mmss = input.match(/^(\d{1,3}):(\d{1,2})$/);
                if (mmss) return parseInt(mmss[1]) * 60 + parseInt(mmss[2]);
                const ms = input.match(/^(?:(\d+)m)?(?:(\d+)s)?$/i);
                if (ms && (ms[1] || ms[2])) return (parseInt(ms[1]) || 0) * 60 + (parseInt(ms[2]) || 0);
                const pure = parseInt(input);
                if (!isNaN(pure)) return pure;
                return null;
            },

            handlePaste(event) {
                event.preventDefault();
                const text = (event.clipboardData || window.clipboardData).getData('text');
                const parsed = this.parseFlexible(text);
                if (parsed !== null) {
                    this.fromSeconds(parsed);
                    this.$dispatch('input', { name: '@name', value: this.totalSeconds });
                }
            }
        } ```@
        x-init="init()"
    >
        <input type="hidden" name=@name :value="totalSeconds" />
        <input type="text" inputmode="numeric" maxlength="3" data-duration-field="minutes" class=@input_base :value="String(minutes).padStart(2, '0')" x-on:input="handleInput('minutes', $event)" x-on:keydown="handleKeydown('minutes', $event)" x-on:blur="handleBlur('minutes')" x-on:paste="handlePaste($event)" x-on:focus="$event.target.select()" placeholder="00" aria-label="Minutes" @if disabled { disabled } />
        <span class=@separator_cls>:</span>
        <input type="text" inputmode="numeric" maxlength="2" data-duration-field="seconds" class=@input_base :value="String(seconds).padStart(2, '0')" x-on:input="handleInput('seconds', $event)" x-on:keydown="handleKeydown('seconds', $event)" x-on:blur="handleBlur('seconds')" x-on:paste="handlePaste($event)" x-on:focus="$event.target.select()" placeholder="00" aria-label="Seconds" @if disabled { disabled } />
    </div>
}

@* Internal: hh:mm format *@
@fn duration_hm(
    name: &str,
    initial_seconds: u32,
    min_seconds: u32,
    max_seconds: u32,
    disabled: bool = false,
    class: &str = "",
    container_base: &str,
    input_base: &str,
    separator_cls: &str,
) {
    @let extra_cls = class
    @let container_cls = cn([container_base, extra_cls])
    <div
        class=@container_cls
        x-data=@```json {
            totalSeconds: @initial_seconds,
            hours: 0,
            minutes: 0,
            min: @min_seconds,
            max: @max_seconds,

            init() {
                this.fromSeconds(this.totalSeconds);
            },

            fromSeconds(total) {
                total = Math.max(this.min, Math.min(this.max, total));
                this.totalSeconds = total;
                this.hours = Math.floor(total / 3600);
                this.minutes = Math.floor((total % 3600) / 60);
            },

            toSeconds() {
                let total = (parseInt(this.hours) || 0) * 3600 + (parseInt(this.minutes) || 0) * 60;
                total = Math.max(this.min, Math.min(this.max, total));
                this.totalSeconds = total;
                this.fromSeconds(total);
                this.$dispatch('input', { name: '@name', value: total });
            },

            handleInput(field, event) {
                const val = event.target.value.replace(/\D/g, '');
                let num = parseInt(val) || 0;
                if (field === 'hours') this.hours = Math.min(99, num);
                else if (field === 'minutes') this.minutes = Math.min(59, num);
                this.toSeconds();
            },

            handleKeydown(field, event) {
                const inputs = this.$el.querySelectorAll('input[data-duration-field]');
                const currentIndex = Array.from(inputs).findIndex(el => el === event.target);
                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    if (field === 'hours') this.hours = Math.min(99, (parseInt(this.hours) || 0) + 1);
                    else if (field === 'minutes') this.minutes = Math.min(59, (parseInt(this.minutes) || 0) + 1);
                    this.toSeconds();
                } else if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    if (field === 'hours') this.hours = Math.max(0, (parseInt(this.hours) || 0) - 1);
                    else if (field === 'minutes') this.minutes = Math.max(0, (parseInt(this.minutes) || 0) - 1);
                    this.toSeconds();
                } else if (event.key === ':') {
                    event.preventDefault();
                    if (currentIndex < inputs.length - 1) inputs[currentIndex + 1].focus();
                }
            },

            handleBlur(field) {
                if (field === 'hours') this.hours = String(parseInt(this.hours) || 0).padStart(2, '0');
                else if (field === 'minutes') this.minutes = String(parseInt(this.minutes) || 0).padStart(2, '0');
            },

            parseFlexible(input) {
                input = input.trim();
                const hhmm = input.match(/^(\d{1,2}):(\d{1,2})$/);
                if (hhmm) return parseInt(hhmm[1]) * 3600 + parseInt(hhmm[2]) * 60;
                const hm = input.match(/^(?:(\d+)h)?(?:(\d+)m)?$/i);
                if (hm && (hm[1] || hm[2])) return (parseInt(hm[1]) || 0) * 3600 + (parseInt(hm[2]) || 0) * 60;
                const pure = parseInt(input);
                if (!isNaN(pure)) return pure;
                return null;
            },

            handlePaste(event) {
                event.preventDefault();
                const text = (event.clipboardData || window.clipboardData).getData('text');
                const parsed = this.parseFlexible(text);
                if (parsed !== null) {
                    this.fromSeconds(parsed);
                    this.$dispatch('input', { name: '@name', value: this.totalSeconds });
                }
            }
        } ```@
        x-init="init()"
    >
        <input type="hidden" name=@name :value="totalSeconds" />
        <input type="text" inputmode="numeric" maxlength="2" data-duration-field="hours" class=@input_base :value="String(hours).padStart(2, '0')" x-on:input="handleInput('hours', $event)" x-on:keydown="handleKeydown('hours', $event)" x-on:blur="handleBlur('hours')" x-on:paste="handlePaste($event)" x-on:focus="$event.target.select()" placeholder="00" aria-label="Hours" @if disabled { disabled } />
        <span class=@separator_cls>:</span>
        <input type="text" inputmode="numeric" maxlength="2" data-duration-field="minutes" class=@input_base :value="String(minutes).padStart(2, '0')" x-on:input="handleInput('minutes', $event)" x-on:keydown="handleKeydown('minutes', $event)" x-on:blur="handleBlur('minutes')" x-on:paste="handlePaste($event)" x-on:focus="$event.target.select()" placeholder="00" aria-label="Minutes" @if disabled { disabled } />
    </div>
}

@* Inline variant - more compact styling *@
@fn inline(
    name: &str,
    value: Option<u32> = None,
    format: &str = "mm:ss",
    min: Option<u32> = None,
    max: Option<u32> = None,
    disabled: bool = false,
    class: &str = "",
) {
    @let initial_seconds = value.unwrap_or(0)
    @let min_seconds = min.unwrap_or(0)
    @let max_seconds = max.unwrap_or(359999)

    @let container_base = "inline-flex items-center"
    @let input_base = "h-7 w-8 text-center text-xs font-medium rounded border border-input bg-transparent transition-colors focus:outline-none focus:ring-1 focus:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
    @let separator_cls = "text-muted-foreground text-sm font-light select-none mx-px"

    @match format {
        "hh:mm:ss" => {
            <@duration_hms
                name=@name
                initial_seconds=@initial_seconds
                min_seconds=@min_seconds
                max_seconds=@max_seconds
                disabled=@disabled
                class=@class
                container_base=@container_base
                input_base=@input_base
                separator_cls=@separator_cls
            />
        }
        "mm:ss" => {
            <@duration_ms
                name=@name
                initial_seconds=@initial_seconds
                min_seconds=@min_seconds
                max_seconds=@max_seconds
                disabled=@disabled
                class=@class
                container_base=@container_base
                input_base=@input_base
                separator_cls=@separator_cls
            />
        }
        "hh:mm" => {
            <@duration_hm
                name=@name
                initial_seconds=@initial_seconds
                min_seconds=@min_seconds
                max_seconds=@max_seconds
                disabled=@disabled
                class=@class
                container_base=@container_base
                input_base=@input_base
                separator_cls=@separator_cls
            />
        }
        _ => {
            <@duration_ms
                name=@name
                initial_seconds=@initial_seconds
                min_seconds=@min_seconds
                max_seconds=@max_seconds
                disabled=@disabled
                class=@class
                container_base=@container_base
                input_base=@input_base
                separator_cls=@separator_cls
            />
        }
    }
}

@* Bound variant with label *@
@fn bound(
    label: &str,
    name: &str,
    value: Option<u32> = None,
    format: &str = "hh:mm:ss",
    min: Option<u32> = None,
    max: Option<u32> = None,
    disabled: bool = false,
    required: bool = false,
    error: Option<&str> = None,
    description: Option<&str> = None,
    class: &str = "",
) {
    @let label_cls = "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
    @let disabled_label = if disabled { "opacity-70" } else { "" }
    @let label_classes = cn([label_cls, disabled_label])

    <div class="space-y-2">
        <label for=@name class=@label_classes>
            @label
            @if required { <span class="text-destructive ml-0.5">*</span> }
        </label>
        <@create
            name=@name
            value=@value
            format=@format
            min=@min
            max=@max
            disabled=@disabled
            class=@class
        />
        @if let Some(d) = description {
            @if error.is_none() {
                <p class="text-sm text-muted-foreground">@d</p>
            }
        }
        @if let Some(e) = error {
            <p class="text-sm text-destructive" role="alert">@e</p>
        }
    </div>
}

@* Compact bound for inline editing contexts *@
@fn compact_bound(
    label: &str,
    name: &str,
    value: Option<u32> = None,
    format: &str = "mm:ss",
    min: Option<u32> = None,
    max: Option<u32> = None,
    disabled: bool = false,
    class: &str = "",
) {
    @let label_cls = "text-xs font-medium text-muted-foreground"
    @let extra_cls = class
    @let container_cls = cn(["inline-flex items-center gap-2", extra_cls])

    <div class=@container_cls>
        <label for=@name class=@label_cls>@label</label>
        <@inline
            name=@name
            value=@value
            format=@format
            min=@min
            max=@max
            disabled=@disabled
           
        />
    </div>
}

@* Simple shorthand for mm:ss format *@
@fn timer(name: &str, value: Option<u32>) {
    <@create
        name=@name
        value=@value
        format="mm:ss"
    />
}

@* Simple shorthand for hh:mm format (e.g., work hours) *@
@fn hours(name: &str, value: Option<u32>) {
    <@create
        name=@name
        value=@value
        format="hh:mm"
    />
}

@* Disabled duration input *@
@fn disabled(name: &str, value: Option<u32>, format: &str) {
    <@create
        name=@name
        value=@value
        format=@format
        disabled=true
    />
}
