    @let desc = description.unwrap_or("")
    @if !desc.is_empty() {
        <@apply side=@Side::Top title=@title description=@desc trigger=@trigger content=@content />
    } else {
        <@apply side=@Side::Top title=@title trigger=@trigger content=@content />
