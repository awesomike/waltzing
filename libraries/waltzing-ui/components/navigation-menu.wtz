@*
 * Navigation Menu component
 * Horizontal navigation bar with dropdown menus for nested items
 * Uses Alpine.js for hover-based dropdown behavior
 *
 * Usage:
 *   @import components/navigation-menu.wtz as nav
 *
 *   Build manually with components:
 *   <@nav::root>
 *       <@nav::list>
 *           <@nav::item label="Home" href=Some("/") active=false />
 *           <@nav::dropdown label="Products">
 *               <@nav::dropdown_item href="/products/widgets">Widgets</@nav::dropdown_item>
 *               <@nav::dropdown_item href="/products/gadgets">Gadgets</@nav::dropdown_item>
 *           </@nav::dropdown>
 *           <@nav::item label="About" href=Some("/about") />
 *       </@nav::list>
 *   </@nav::root>
 *@


@struct NavMenuItem {
    label: String,
    href: Option<String>,
    children: Option<Vec<NavMenuItem>>,
}

@* Root navigation container *@
@fn root(
    class: &str = "",
    content: @(),
) {
    <nav
        class=@cn(&["relative z-10", class])
        aria-label="Main navigation"
    >
        @content()
    </nav>
}

@* Navigation list container *@
@fn list(
    class: &str = "",
    content: @(),
) {
    <ul class=@cn(&["flex items-center gap-1", class]) role="menubar">
        @content()
    </ul>
}

@* Single navigation item (no dropdown) *@
@fn item(
    label: &str,
    href: Option<&str> = None,
    active: bool = false,
    class: &str = "",
) {
    @let base_cls = "inline-flex h-9 w-max items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus:outline-none disabled:pointer-events-none disabled:opacity-50"
    @let active_cls = class_if(active, "bg-accent/50 text-accent-foreground")
    @let item_cls = cn(&[base_cls, active_cls, class])

    <li role="none">
        @if let Some(url) = href {
            <a
                href=@url
                class=@item_cls
                role="menuitem"
                @if active { aria-current="page" }
            >
                @label
            </a>
        } else {
            <span class=@item_cls role="menuitem">
                @label
            </span>
        }
    </li>
}

@* Dropdown menu trigger with hoverable content *@
@fn dropdown(
    label: &str,
    active: bool = false,
    class: &str = "",
    content: @(),
) {
    @let trigger_cls = "inline-flex h-9 w-max items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus:outline-none disabled:pointer-events-none disabled:opacity-50 group"
    @let active_cls = class_if(active, "bg-accent/50 text-accent-foreground")
    @let btn_cls = cn(&[trigger_cls, active_cls, class])

    <li
        role="none"
        class="relative"
        x-data="{ open: false, closeTimer: null }"
        @@mouseenter="clearTimeout(closeTimer); open = true"
        @@mouseleave="closeTimer = setTimeout(() => open = false, 100)"
    >
        <button
            type="button"
            class=@btn_cls
            role="menuitem"
            aria-haspopup="true"
            :aria-expanded="open"
            @@focus="open = true"
            @@blur="setTimeout(() => { if (!$el.parentElement.matches(':hover')) open = false }, 100)"
            @@keydown.escape="open = false"
            @@keydown.arrow-down.prevent="open = true"
        >
            @label
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="ml-1 h-3 w-3 transition-transform duration-200 group-hover:rotate-180"
                :class="open ? 'rotate-180' : ''"
                aria-hidden="true"
            >
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </button>

        <div
            x-show="open"
            x-cloak
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 translate-y-1"
            class="absolute left-0 top-full mt-1.5 min-w-[12rem] rounded-md border bg-popover p-1 text-popover-foreground shadow-lg"
            role="menu"
            aria-orientation="vertical"
            @@mouseenter="clearTimeout(closeTimer); open = true"
        >
            @content()
        </div>
    </li>
}

@* Item within a dropdown menu *@
@fn dropdown_item(
    href: &str,
    class: &str = "",
    content: @(),
) {
    @let item_cls = cn(&["block w-full select-none rounded-sm px-3 py-2 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground", class])

    <a
        href=@href
        class=@item_cls
        role="menuitem"
    >
        @content()
    </a>
}

@* Separator within a dropdown menu *@
@fn dropdown_separator(class: &str = "") {
    <div
        class=@cn(&["-mx-1 my-1 h-px bg-border", class])
        role="separator"
    ></div>
}

@* Label/heading within a dropdown menu (non-interactive) *@
@fn dropdown_label(
    class: &str = "",
    content: @(),
) {
    <div class=@cn(&["px-3 py-2 text-xs font-semibold text-muted-foreground", class])>
        @content()
    </div>
}

@* Viewport indicator that shows below active dropdown (optional visual enhancement) *@
@fn viewport_indicator(class: &str = "") {
    <div
        class=@cn(&["absolute left-0 top-full flex justify-center", class])
        style="perspective: 2000px;"
    >
        <div class="relative mt-1.5 h-[var(--radix-navigation-menu-viewport-height)] w-full origin-[top_center] overflow-hidden rounded-md border bg-popover text-popover-foreground shadow-lg transition-[width,height] duration-300"></div>
    </div>
}
