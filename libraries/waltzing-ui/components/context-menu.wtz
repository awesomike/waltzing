@*
 * Context Menu component
 * Right-click menu that positions at cursor location
 *
 * @example
 * @import components/context-menu.wtz as context_menu
 *
 * <@context_menu::apply
 *     trigger=@{
 *         <div class="p-8 border rounded">Right-click here</div>
 *     }
 *     content=@{
 *         <@context_menu::item label="Cut" shortcut=Some("Ctrl+X") />
 *         <@context_menu::item label="Copy" shortcut=Some("Ctrl+C") />
 *         <@context_menu::item label="Paste" shortcut=Some("Ctrl+V") />
 *         <@context_menu::separator />
 *         <@context_menu::sub
 *             label="More Options"
 *             content=@{
 *                 <@context_menu::item label="Option 1" />
 *                 <@context_menu::item label="Option 2" />
 *             }
 *         />
 *         <@context_menu::separator />
 *         <@context_menu::item label="Delete" disabled=true />
 *     }
 * />
 *@


@* Main context menu wrapper *@
@fn apply(
    class: &str = "",
    trigger: @() = @{},
    content: @() = @{},
) {
    @let cls = cn(&["relative", class])
    <div
        class=@cls
        x-data="{ open: false, x: 0, y: 0 }"
        @@contextmenu.prevent="open = true; x = $event.clientX; y = $event.clientY"
    >
        @* Trigger area *@
        @trigger()

        @* Context menu portal *@
        <template x-teleport="body">
            <div
                x-show="open"
                x-cloak
                x-transition:enter="transition ease-out duration-100"
                x-transition:enter-start="opacity-0 scale-95"
                x-transition:enter-end="opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-75"
                x-transition:leave-start="opacity-100 scale-100"
                x-transition:leave-end="opacity-0 scale-95"
                @@click.outside="open = false"
                @@contextmenu.outside="open = false"
                @@keydown.escape.window="open = false"
                class="fixed z-50 min-w-[8rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md"
                :style="`left: ${x}px; top: ${y}px;`"
                role="menu"
            >
                @content()
            </div>
        </template>
    </div>
}

@* Context menu item *@
@fn item(
    label: &str,
    shortcut: Option<&str> = None,
    disabled: bool = false,
    class: &str = "",
) {
    @let base = "relative flex w-full cursor-default select-none items-center justify-between rounded-sm px-2 py-1.5 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground"
    @let disabled_cls = class_if(disabled, "pointer-events-none opacity-50")
    @let cls = cn(&[base, disabled_cls, class])
    <button
        class=@cls
        role="menuitem"
        @if disabled { disabled }
        @@click="open = false"
    >
        <span>@label</span>
        @if let Some(s) = shortcut {
            <span class="ml-auto text-xs tracking-widest text-muted-foreground">@s</span>
        }
    </button>
}

@* Context menu item with custom content *@
@fn item_content(
    disabled: bool = false,
    class: &str = "",
    content: @() = @{},
) {
    @let base = "relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground"
    @let disabled_cls = class_if(disabled, "pointer-events-none opacity-50")
    @let cls = cn(&[base, disabled_cls, class])
    <button
        class=@cls
        role="menuitem"
        @if disabled { disabled }
        @@click="open = false"
    >
        @content()
    </button>
}

@* Context menu separator *@
@fn separator() {
    <div class="-mx-1 my-1 h-px bg-muted" role="separator"></div>
}

@* Context menu label (non-interactive) *@
@fn label(
    class: &str = "",
    content: @() = @{},
) {
    @let cls = cn(&["px-2 py-1.5 text-sm font-semibold", class])
    <div class=@cls>
        @content()
    </div>
}

@* Context menu submenu *@
@fn sub(
    label: &str,
    class: &str = "",
    content: @() = @{},
) {
    @let btn_cls = cn(&["relative flex w-full cursor-default select-none items-center justify-between rounded-sm px-2 py-1.5 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground", class])
    <div
        class="relative"
        x-data="{ subOpen: false, closeTimer: null }"
        @@mouseenter="clearTimeout(closeTimer); subOpen = true"
        @@mouseleave="closeTimer = setTimeout(() => subOpen = false, 150)"
    >
        @* Submenu trigger *@
        <button
            class=@btn_cls
            role="menuitem"
            aria-haspopup="true"
            :aria-expanded="subOpen"
        >
            <span>@label</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto h-4 w-4">
                <path d="m9 18 6-6-6-6"></path>
            </svg>
        </button>

        @* Submenu content *@
        <div
            x-show="subOpen"
            x-transition:enter="transition ease-out duration-100"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            @@mouseenter="clearTimeout(closeTimer); subOpen = true"
            @@mouseleave="closeTimer = setTimeout(() => subOpen = false, 150)"
            class="absolute left-full top-0 ml-1 min-w-[8rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md"
            role="menu"
            style="display: none;"
        >
            @content()
        </div>
    </div>
}

@* Checkbox item for context menu *@
@fn checkbox_item(
    label: &str,
    checked: bool = false,
    disabled: bool = false,
    class: &str = "",
) {
    @let base = "relative flex w-full cursor-default select-none items-center rounded-sm py-1.5 pl-8 pr-2 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground"
    @let disabled_cls = class_if(disabled, "pointer-events-none opacity-50")
    @let cls = cn(&[base, disabled_cls, class])
    <button
        class=@cls
        role="menuitemcheckbox"
        :aria-checked=@checked
        @if disabled { disabled }
    >
        <span class="absolute left-2 flex h-3.5 w-3.5 items-center justify-center">
            @if checked {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                    <path d="M20 6 9 17l-5-5"></path>
                </svg>
            }
        </span>
        @label
    </button>
}
