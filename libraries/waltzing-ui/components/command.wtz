@**
 * Command component
 * Command palette / search interface with keyboard navigation
 * Uses Alpine.js for filtering, selection, and keyboard handling
 *
 * @example
 * @import components/command.wtz as command
 *
 * Composition approach - build manually with sub-components:
 *   command::apply with nested input, list, group, and item components
 *
 * Dialog wrapper - modal command palette (Cmd+K style):
 *   command::dialog with trigger and content slots
 **@

@import lib/utils.wtz as utils

@struct CommandItem {
    id: String,
    label: String,
    shortcut: Option<String>,
    icon: Option<String>,
}

@struct CommandGroup {
    heading: String,
    items: Vec<CommandItem>,
}

@** Main command container with composition support **@
@fn apply(
    placeholder: Option<&str> = None,
    class: Option<&str> = None,
    content: @() = @{},
) {
    @let container_cls = utils::cn(&[
        "flex h-full w-full flex-col overflow-hidden rounded-md bg-popover text-popover-foreground",
        class.unwrap_or("")
    ])

    <div
        class="@container_cls"
        x-data="{
            search: '',
            selectedIndex: 0,
            items: [],
            registerItem(id, label) {
                this.items.push({ id, label });
            },
            get filteredItems() {
                if (!this.search) return this.items;
                const query = this.search.toLowerCase();
                return this.items.filter(item => item.label.toLowerCase().includes(query));
            },
            get totalItems() {
                return this.filteredItems.length;
            },
            selectNext() {
                if (this.totalItems > 0) {
                    this.selectedIndex = (this.selectedIndex + 1) % this.totalItems;
                }
            },
            selectPrev() {
                if (this.totalItems > 0) {
                    this.selectedIndex = (this.selectedIndex - 1 + this.totalItems) % this.totalItems;
                }
            },
            selectItem() {
                if (this.totalItems > 0 && this.filteredItems[this.selectedIndex]) {
                    const item = this.filteredItems[this.selectedIndex];
                    this.$dispatch('command-select', { id: item.id, label: item.label });
                }
            },
            resetSelection() {
                this.selectedIndex = 0;
            }
        }"
        @@keydown.down.prevent="selectNext()"
        @@keydown.up.prevent="selectPrev()"
        @@keydown.enter.prevent="selectItem()"
    >
        @content()
    </div>
}

@** Command input component **@
@fn input(
    placeholder: Option<&str> = None,
    class: Option<&str> = None,
) {
    @let ph = placeholder.unwrap_or("Type a command or search...")
    @let input_cls = utils::cn(&[
        "flex h-10 w-full rounded-md bg-transparent py-3 text-sm outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50",
        class.unwrap_or("")
    ])

    <div class="flex items-center border-b px-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4 shrink-0 opacity-50">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
            x-model="search"
            @@input="resetSelection()"
            class="@input_cls"
            placeholder="@ph"
            type="text"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
        />
    </div>
}

@** Command list container **@
@fn list(
    class: Option<&str> = None,
    content: @() = @{},
) {
    @let list_cls = utils::cn(&[
        "max-h-[300px] overflow-y-auto overflow-x-hidden",
        class.unwrap_or("")
    ])

    <div class="@list_cls" role="listbox">
        @content()
    </div>
}

@** Command group with heading **@
@fn group(
    heading: &str,
    class: Option<&str> = None,
    content: @() = @{},
) {
    @let group_cls = utils::cn(&[
        "overflow-hidden p-1 text-foreground",
        class.unwrap_or("")
    ])

    <div class="@group_cls" role="group">
        <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">
            @heading
        </div>
        @content()
    </div>
}

@** Command item **@
@fn item(
    label: &str,
    shortcut: Option<&str> = None,
    icon: Option<&str> = None,
    disabled: bool = false,
    class: Option<&str> = None,
) {
    @let item_cls = utils::cn(&[
        "relative flex cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none data-[selected=true]:bg-accent data-[selected=true]:text-accent-foreground",
        utils::class_if(disabled, "pointer-events-none opacity-50"),
        class.unwrap_or("")
    ])

    <div
        class="@item_cls"
        role="option"
        tabindex="-1"
        @if disabled { aria-disabled="true" }
        x-data="{ index: -1 }"
        x-init="index = items.length; registerItem($el.dataset.id || '@label', '@label')"
        :data-selected="selectedIndex === index && search ? filteredItems.some(i => i.label === '@label') : selectedIndex === index"
        data-id="@label"
        @@click="selectedIndex = index; selectItem()"
        @@mouseenter="selectedIndex = index"
    >
        @if let Some(i) = icon {
            <span class="mr-2 h-4 w-4">@i</span>
        }
        <span>@label</span>
        @if let Some(s) = shortcut {
            <span class="ml-auto text-xs tracking-widest text-muted-foreground">@s</span>
        }
    </div>
}

@** Empty state message **@
@fn empty(
    message: Option<&str> = None,
    class: Option<&str> = None,
) {
    @let msg = message.unwrap_or("No results found.")
    @let empty_cls = utils::cn(&[
        "py-6 text-center text-sm text-muted-foreground",
        class.unwrap_or("")
    ])

    <div class="@empty_cls" x-show="search && totalItems === 0">
        @msg
    </div>
}

@** Command separator **@
@fn separator(class: Option<&str> = None) {
    @let sep_cls = utils::cn(&[
        "-mx-1 h-px bg-border",
        class.unwrap_or("")
    ])

    <div class="@sep_cls" role="separator"></div>
}

@** Command shortcut display **@
@fn shortcut(keys: &str, class: Option<&str> = None) {
    @let shortcut_cls = utils::cn(&[
        "ml-auto text-xs tracking-widest text-muted-foreground",
        class.unwrap_or("")
    ])

    <kbd class="@shortcut_cls">@keys</kbd>
}

@** Dialog-wrapped command palette (like Cmd+K) **@
@fn dialog(
    trigger: @() = @{},
    class: Option<&str> = None,
    content: @() = @{},
) {
    @let dialog_cls = utils::cn(&[
        "fixed left-[50%] top-[50%] z-50 w-full max-w-lg translate-x-[-50%] translate-y-[-50%] overflow-hidden rounded-lg border bg-popover shadow-lg",
        class.unwrap_or("")
    ])

    <div x-data="{ open: false }">
        <div @@click="open = true">
            @trigger()
        </div>

        <template x-teleport="body">
            <div
                x-show="open"
                x-transition:enter="ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="fixed inset-0 z-50"
                style="display: none;"
            >
                <div
                    class="fixed inset-0 bg-black/50"
                    @@click="open = false"
                    aria-hidden="true"
                ></div>

                <div
                    class="@dialog_cls"
                    @@keydown.escape.window="open = false"
                    @@command-select.window="open = false"
                    role="dialog"
                    aria-modal="true"
                    aria-label="Command palette"
                >
                    @content()
                </div>
            </div>
        </template>
    </div>
}
