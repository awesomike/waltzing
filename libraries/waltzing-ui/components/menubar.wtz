@*
 * Menubar component
 * Application menu bar with dropdown menus (File, Edit, View style)
 *
 * @example
 * @import components/menubar.wtz as menubar
 *
 * <@menubar::apply class=None>
 *     <@menubar::menu label="File">
 *         <@menubar::item label="New File" shortcut=Some("Ctrl+N") disabled=false />
 *         <@menubar::item label="Open..." shortcut=Some("Ctrl+O") disabled=false />
 *         <@menubar::separator />
 *         <@menubar::item label="Save" shortcut=Some("Ctrl+S") disabled=false />
 *         <@menubar::separator />
 *         <@menubar::item label="Exit" shortcut=None disabled=false />
 *     </@>
 *     <@menubar::menu label="Edit">
 *         <@menubar::item label="Undo" shortcut=Some("Ctrl+Z") disabled=false />
 *         <@menubar::item label="Redo" shortcut=Some("Ctrl+Y") disabled=true />
 *         <@menubar::separator />
 *         <@menubar::checkbox label="Word Wrap" checked=true />
 *     </@>
 *     <@menubar::menu label="View">
 *         <@menubar::checkbox label="Show Sidebar" checked=true />
 *         <@menubar::checkbox label="Show Line Numbers" checked=false />
 *     </@>
 * </@>
 *@

@import lib/utils.wtz as utils

@* Menubar container *@
@fn apply(
    class: Option<&str>,
    content: @(),
) {
    @let base = "flex h-9 items-center space-x-1 rounded-md border bg-background p-1 shadow-sm"
    @let empty = ""
    @let cls = class.unwrap_or(@empty)
    @let parts = vec![@base, @cls]
    @let classes = utils::cn(@parts)

    <div
        class=@classes
        role="menubar"
        x-data="{ activeMenu: null, openMenu(id) { this.activeMenu = this.activeMenu === id ? null : id; }, closeMenu() { this.activeMenu = null; }, isOpen(id) { return this.activeMenu === id; } }"
        x-on:keydown.escape.window="closeMenu()"
    >
        @content()
    </div>
}

@* Single menu with dropdown *@
@fn menu(
    label: &str,
    content: @(),
) {
    @let menu_id = label.to_lowercase().replace(" ", "-")

    <div class="relative" x-data="{ focusedIndex: -1 }">
        @* Menu trigger *@
        <button
            type="button"
            class="inline-flex h-7 items-center justify-center rounded-sm px-3 py-1 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus:outline-none disabled:pointer-events-none disabled:opacity-50"
            :class="isOpen('@menu_id') ? 'bg-accent text-accent-foreground' : ''"
            role="menuitem"
            aria-haspopup="true"
            :aria-expanded="isOpen('@menu_id')"
            x-on:click="openMenu('@menu_id')"
            x-on:mouseenter="if (activeMenu !== null && activeMenu !== '@menu_id') openMenu('@menu_id')"
            x-on:keydown.enter.prevent="openMenu('@menu_id')"
            x-on:keydown.space.prevent="openMenu('@menu_id')"
            x-on:keydown.arrow-down.prevent="openMenu('@menu_id')"
        >
            @label
        </button>

        @* Dropdown menu *@
        <div
            x-show="isOpen('@menu_id')"
            x-transition:enter="transition ease-out duration-100"
            x-transition:enter-start="transform opacity-0 scale-95"
            x-transition:enter-end="transform opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="transform opacity-100 scale-100"
            x-transition:leave-end="transform opacity-0 scale-95"
            x-on:click.away="closeMenu()"
            class="absolute left-0 top-full z-50 mt-1 min-w-[12rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md"
            style="display: none;"
            role="menu"
            aria-orientation="vertical"
            x-on:keydown.arrow-down.prevent="const items = $el.querySelectorAll('[role=menuitem]:not([disabled]), [role=menuitemcheckbox]:not([disabled])'); focusedIndex = (focusedIndex + 1) % items.length; items[focusedIndex]?.focus();"
            x-on:keydown.arrow-up.prevent="const items = $el.querySelectorAll('[role=menuitem]:not([disabled]), [role=menuitemcheckbox]:not([disabled])'); focusedIndex = focusedIndex <= 0 ? items.length - 1 : focusedIndex - 1; items[focusedIndex]?.focus();"
            x-on:keydown.home.prevent="const items = $el.querySelectorAll('[role=menuitem]:not([disabled]), [role=menuitemcheckbox]:not([disabled])'); focusedIndex = 0; items[0]?.focus();"
            x-on:keydown.end.prevent="const items = $el.querySelectorAll('[role=menuitem]:not([disabled]), [role=menuitemcheckbox]:not([disabled])'); focusedIndex = items.length - 1; items[focusedIndex]?.focus();"
        >
            @content()
        </div>
    </div>
}

@* Menu item *@
@fn item(
    label: &str,
    shortcut: Option<&str>,
    disabled: bool,
) {
    @let base = "relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground"
    @let disabled_cls = utils::class_if(disabled, "pointer-events-none opacity-50")
    @let parts = vec![@base, @disabled_cls]
    @let classes = utils::cn(@parts)

    <button
        type="button"
        class=@classes
        role="menuitem"
        @if disabled { disabled aria-disabled="true" }
        x-on:click="closeMenu()"
        x-on:keydown.enter.prevent="if (!$el.disabled) { $el.click(); }"
        x-on:keydown.space.prevent="if (!$el.disabled) { $el.click(); }"
    >
        <span class="flex-1 text-left">@label</span>
        @if let Some(sc) = shortcut {
            <span class="ml-auto text-xs tracking-widest text-muted-foreground">@sc</span>
        }
    </button>
}

@* Menu separator *@
@fn separator() {
    <div class="-mx-1 my-1 h-px bg-muted" role="separator"></div>
}

@* Checkable menu item *@
@fn checkbox(
    label: &str,
    checked: bool,
) {
    @let data_state = if checked { "checked" } else { "unchecked" }

    <button
        type="button"
        class="relative flex w-full cursor-default select-none items-center rounded-sm py-1.5 pl-8 pr-2 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground"
        role="menuitemcheckbox"
        aria-checked="@checked"
        data-state="@data_state"
        x-on:click="closeMenu()"
        x-on:keydown.enter.prevent="$el.click()"
        x-on:keydown.space.prevent="$el.click()"
    >
        <span class="absolute left-2 flex h-3.5 w-3.5 items-center justify-center">
            @if checked {
                <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            }
        </span>
        <span>@label</span>
    </button>
}

@* Menu item with custom content *@
@fn custom_item(
    disabled: bool,
    content: @(),
) {
    @let base = "relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground"
    @let disabled_cls = utils::class_if(disabled, "pointer-events-none opacity-50")
    @let parts = vec![@base, @disabled_cls]
    @let classes = utils::cn(@parts)

    <button
        type="button"
        class=@classes
        role="menuitem"
        @if disabled { disabled aria-disabled="true" }
        x-on:click="closeMenu()"
    >
        @content()
    </button>
}
