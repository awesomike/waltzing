@*
 * Dropdown component
 * A dropdown menu with trigger and items
 * Automatically flips to open above if not enough space below
 * Follows trigger on scroll/resize using fixed positioning
 *@


@enum Align {
    Start,
    Center,
    End,
}

@fn apply(
    align: Align,
    trigger: @(),
    content: @(),
) {
    @let align_type = match align {
        Align::Start => "start",
        Align::Center => "center",
        Align::End => "end",
    }

    <div class="inline-block text-left" x-data="{
        open: false,
        pos: { x: 0, y: 0, width: 0 },
        flipTop: false,
        align: '@align_type',
        updatePos() {
            const trigger = this.$refs.trigger;
            if (!trigger) return;
            const rect = trigger.getBoundingClientRect();
            const dropdownHeight = 200;
            const spaceBelow = window.innerHeight - rect.bottom;
            const spaceAbove = rect.top;
            this.flipTop = spaceBelow < dropdownHeight && spaceAbove > spaceBelow;
            this.pos.width = rect.width;
            if (this.align === 'start') {
                this.pos.x = rect.left;
            } else if (this.align === 'center') {
                this.pos.x = rect.left + rect.width / 2;
            } else {
                this.pos.x = rect.right;
            }
            this.pos.y = this.flipTop ? rect.top : rect.bottom;
        },
        onScroll() { if (this.open) this.updatePos(); },
        init() {
            this._scrollHandler = () => this.onScroll();
            window.addEventListener('scroll', this._scrollHandler, true);
            window.addEventListener('resize', this._scrollHandler);
        },
        destroy() {
            window.removeEventListener('scroll', this._scrollHandler, true);
            window.removeEventListener('resize', this._scrollHandler);
        }
    }" x-init="init()" @destroy="destroy()">
        @* Trigger *@
        <div x-ref="trigger" @click="open = !open; $nextTick(() => updatePos())">
            @trigger()
        </div>

        @* Dropdown content (teleported to body) *@
        <template x-teleport="body">
            <div
                x-show="open"
                x-cloak
                x-transition:enter="transition ease-out duration-100"
                x-transition:enter-start="opacity-0 scale-95"
                x-transition:enter-end="opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-75"
                x-transition:leave-start="opacity-100 scale-100"
                x-transition:leave-end="opacity-0 scale-95"
                @click.away="open = false"
                @keydown.escape.window="open = false"
                class="fixed z-[9999] min-w-[8rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md"
                :style="`left: ${align === 'end' ? 'auto' : pos.x + 'px'}; right: ${align === 'end' ? (window.innerWidth - pos.x) + 'px' : 'auto'}; ${flipTop ? 'bottom: ' + (window.innerHeight - pos.y + 8) + 'px' : 'top: ' + (pos.y + 8) + 'px'}; ${align === 'center' ? 'transform: translateX(-50%)' : ''}`"
                role="menu"
            >
                @content()
            </div>
        </template>
    </div>
}

@* Dropdown menu item *@
@fn item(
    disabled: bool,
    class: &str = "",
    content: @(),
) {
    @let extra_class = class
    @let classes = vec!["relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground", @class_if(@disabled, "pointer-events-none opacity-50"), @extra_class]
    <button
        class="@cn(@classes)"
        role="menuitem"
        @if disabled { disabled }
        @click="open = false"
    >
        @content()
    </button>
}

@* Dropdown link item *@
@fn link(
    href: String,
    class: &str = "",
    content: @(),
) {
    @let extra_class = class
    @let classes = vec!["relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground", @extra_class]
    <a
        href="@href"
        class="@cn(@classes)"
        role="menuitem"
        @click="open = false"
    >
        @content()
    </a>
}

@* Dropdown separator *@
@fn separator() {
    <div class="-mx-1 my-1 h-px bg-muted" role="separator"></div>
}

@* Dropdown label (non-interactive) *@
@fn label(content: @()) {
    <div class="px-2 py-1.5 text-sm font-semibold">
        @content()
    </div>
}
