@*
 * Aspect Ratio component
 * Displays content within a desired aspect ratio using CSS aspect-ratio property
 *
 * @example
 * @import components/aspect-ratio.wtz as aspect_ratio
 *
 * <@aspect_ratio::apply ratio=1.7778>
 *     <img src="photo.jpg" class="object-cover w-full h-full" />
 * </@aspect_ratio::apply>
 *
 * <@aspect_ratio::video>
 *     <iframe src="..." class="w-full h-full"></iframe>
 * </@aspect_ratio::video>
 *
 * <@aspect_ratio::square>
 *     <img src="avatar.jpg" class="object-cover w-full h-full rounded-md" />
 * </@aspect_ratio::square>
 *
 * <@aspect_ratio::portrait>
 *     <img src="portrait.jpg" class="object-cover w-full h-full" />
 * </@aspect_ratio::portrait>
 *@


@* Main aspect ratio container *@
@fn apply(
    ratio: f64,
    class: &str = "",
    content: @(),
) {
    @let base = "relative w-full"

    @let style_value = format("aspect-ratio: {};", ratio)
    <div
        class=@cn(&[base, class])
        style=@style_value
    >
        <div class="absolute inset-0">
            @content()
        </div>
    </div>
}

@* 16:9 aspect ratio (widescreen video) *@
@fn video(class: &str = "", content: @()) {
    <@apply ratio=1.7778 class=@class>
        @content()
    </@apply>
}

@* 1:1 aspect ratio (square) *@
@fn square(class: &str = "", content: @()) {
    <@apply ratio=1.0 class=@class>
        @content()
    </@apply>
}

@* 4:3 aspect ratio (classic TV/photo) *@
@fn standard(class: &str = "", content: @()) {
    <@apply ratio=1.3333 class=@class>
        @content()
    </@apply>
}

@* 21:9 aspect ratio (ultrawide/cinema) *@
@fn ultrawide(class: &str = "", content: @()) {
    <@apply ratio=2.3333 class=@class>
        @content()
    </@apply>
}

@* 3:4 aspect ratio (portrait photo) *@
@fn portrait(class: &str = "", content: @()) {
    <@apply ratio=0.75 class=@class>
        @content()
    </@apply>
}
