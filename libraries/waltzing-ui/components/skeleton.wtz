@*
 * Skeleton component
 * Loading placeholder for content
 *
 * Usage:
 *   @import ui/components/skeleton.wtz as skeleton
 *
 *   <@skeleton::apply />
 *   <@skeleton::apply class=Some("h-12 w-12") />
 *   <@skeleton::circle size="h-10 w-10" />
 *   <@skeleton::text lines=3 />
 *@

@import lib/utils.wtz as utils

@fn apply(class: Option<&str>) {
    @let base = "animate-pulse rounded-md bg-muted"

    <div class="@utils::cn(&[@base, @class.unwrap_or("")])"></div>
}

@* Circular skeleton (for avatars, icons) *@
@fn circle(size: &str) {
    @let base = "animate-pulse rounded-full bg-muted"

    <div class="@utils::cn(&[@base, @size])"></div>
}

@* Multiple line text skeleton *@
@fn text(lines: u32) {
    @let base = "animate-pulse rounded-md bg-muted h-4"

    <div class="space-y-2">
        @for i in 0..lines {
            @if (i == (lines - 1)) {
                @* Last line is shorter *@
                <div class="@utils::cn(&[@base, "w-3/4"])"></div>
            } @else {
                <div class="@utils::cn(&[@base, "w-full"])"></div>
            }
        }
    </div>
}
