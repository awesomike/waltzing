@*
 * Skeleton component
 * Loading placeholder for content
 *
 * Usage:
 *   @import ui/components/skeleton.wtz as skeleton
 *
 *   <@skeleton::apply />
 *   <@skeleton::apply class="h-12 w-12" />
 *   <@skeleton::circle size="h-10 w-10" />
 *   <@skeleton::text lines=3 />
 *@


@fn apply(class: &str = "") {
    @let base = "animate-pulse rounded-md bg-muted"
    @let extra = class
    @let classes = [base, extra]

    <div class=@cn(@classes)></div>
}

@* Circular skeleton (for avatars, icons) *@
@fn circle(size: &str) {
    @let base = "animate-pulse rounded-full bg-muted"
    @let classes = [base, size]

    <div class=@cn(@classes)></div>
}

@* Multiple line text skeleton *@
@fn text(lines: u32) {
    @let last = (lines - 1)
    <div class="space-y-2">
        @for i in 0..lines {
            @if (i == last) {
                <div class="animate-pulse rounded-md bg-muted h-4 w-3/4"></div>
            }
            @if (i != last) {
                <div class="animate-pulse rounded-md bg-muted h-4 w-full"></div>
            }
        }
    </div>
}
