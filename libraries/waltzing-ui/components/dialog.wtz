@*
 * Dialog component
 * Modal dialog with backdrop, focus trap, and escape handling
 * Requires: @alpinejs/focus plugin
 *@

@import lib/utils.wtz as utils

@fn apply(
    title: &str,
    description: Option<&str>,
    trigger: @(),
    content: @(),
    footer: Option<@()>,
) {
    <div x-data="{ open: false }">
        @* Trigger *@
        <div @click="open = true">
            @trigger()
        </div>

        @* Dialog *@
        <template x-teleport="body">
            <div
                x-show="open"
                x-transition:enter="ease-out duration-300"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="ease-in duration-200"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="fixed inset-0 z-50"
                style="display: none;"
            >
                @* Backdrop *@
                <div
                    class="fixed inset-0 bg-black/80"
                    @click="open = false"
                    aria-hidden="true"
                ></div>

                @* Content *@
                <div
                    class="fixed left-[50%] top-[50%] z-50 grid w-full max-w-lg translate-x-[-50%] translate-y-[-50%] gap-4 border bg-background p-6 shadow-lg sm:rounded-lg"
                    x-trap.inert.noscroll="open"
                    @keydown.escape.window="open = false"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="dialog-title"
                >
                    @* Close button *@
                    <button
                        class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                        @click="open = false"
                        aria-label="Close"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                            <path d="M18 6 6 18"></path>
                            <path d="m6 6 12 12"></path>
                        </svg>
                    </button>

                    @* Header *@
                    <div class="flex flex-col space-y-1.5 text-center sm:text-left">
                        <h2 id="dialog-title" class="text-lg font-semibold leading-none tracking-tight">
                            @title
                        </h2>
                        @if let Some(desc) = description {
                            <p class="text-sm text-muted-foreground">@desc</p>
                        }
                    </div>

                    @* Content *@
                    <div class="py-4">
                        @content()
                    </div>

                    @* Footer *@
                    @if let Some(f) = footer {
                        <div class="flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2">
                            @f()
                        </div>
                    }
                </div>
            </div>
        </template>
    </div>
}

@* Controlled dialog (external state) *@
@fn controlled(
    open_var: &str,
    title: &str,
    description: Option<&str>,
    content: @(),
    footer: Option<@()>,
) {
    <template x-teleport="body">
        <div
            x-show="@open_var"
            x-transition:enter="ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="ease-in duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="fixed inset-0 z-50"
            style="display: none;"
        >
            <div
                class="fixed inset-0 bg-black/80"
                @click="@open_var = false"
                aria-hidden="true"
            ></div>

            <div
                class="fixed left-[50%] top-[50%] z-50 grid w-full max-w-lg translate-x-[-50%] translate-y-[-50%] gap-4 border bg-background p-6 shadow-lg sm:rounded-lg"
                x-trap.inert.noscroll="@open_var"
                @keydown.escape.window="@open_var = false"
                role="dialog"
                aria-modal="true"
            >
                <button
                    class="absolute right-4 top-4 rounded-sm opacity-70 hover:opacity-100"
                    @click="@open_var = false"
                    aria-label="Close"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                </button>

                <div class="flex flex-col space-y-1.5 text-center sm:text-left">
                    <h2 class="text-lg font-semibold">@title</h2>
                    @if let Some(desc) = description {
                        <p class="text-sm text-muted-foreground">@desc</p>
                    }
                </div>

                <div class="py-4">@content()</div>

                @if let Some(f) = footer {
                    <div class="flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2">
                        @f()
                    </div>
                }
            </div>
        </div>
    </template>
}
