@*
 * Component Showcase
 * A comprehensive demo page displaying all waltzing-ui components organized by category.
 * Includes a dark mode toggle and examples of each component's usage.
 *
 * @example
 * @import showcase.wtz as showcase
 *
 * <@showcase::apply />
 *@

@import /layouts/base.wtz
@import /components/alert.wtz
@import /components/avatar.wtz
@import /components/badge.wtz
@import /components/button.wtz
@import /components/card.wtz
@import /components/checkbox.wtz
@import /components/input.wtz
@import /components/label.wtz
@import /components/progress.wtz
@import /components/separator.wtz
@import /components/skeleton.wtz
@import /components/slider.wtz
@import /components/switch.wtz
@import /components/textarea.wtz
@import /components/toggle.wtz

@import /blocks/forms/contact.wtz as contact_form
@import /blocks/forms/profile.wtz as profile_form
@import /blocks/dialogs/confirm.wtz as confirm_dialog
@import /blocks/dialogs/delete.wtz as delete_dialog
@import /blocks/dialogs/share.wtz as share_dialog

@* Auth blocks *@
@import /blocks/auth/login.wtz as login_block
@import /blocks/auth/signup.wtz as signup_block
@import /blocks/auth/login-01.wtz as login_01_block
@import /blocks/auth/signup-01.wtz as signup_01_block

@* Sidebar blocks *@
@import /blocks/sidebar/sidebar-07.wtz as sidebar_07_block

@* Dashboard blocks *@
@import /blocks/dashboard/dashboard-01.wtz as dashboard_01_block

@* Section wrapper for consistent styling *@
@fn section(title: &str, id: &str, content: @()) {
    <section id="@id" class="scroll-mt-8">
        <h2 class="text-2xl font-semibold tracking-tight mb-4">@title</h2>
        @content()
    </section>
}

@* Subsection for block categories *@
@fn subsection(title: &str, id: &str, content: @()) {
    <div id="@id" class="scroll-mt-8">
        <h3 class="text-xl font-semibold tracking-tight mb-3">@title</h3>
        @content()
    </div>
}

@* Block card for displaying block info *@
@fn block_card(name: &str, description: &str, path: &str, demo_href: Option<&str>) {
    <@card::simple>
        <@card::title>@name</@card::title>
        <@card::description>@description</@card::description>
        <p class="mt-2"><code class="text-xs bg-muted px-1 py-0.5 rounded">@path</code></p>
        @if let Some(href) = demo_href {
            <a href="@href" class="mt-2 inline-flex text-xs text-primary hover:underline">View Demo &rarr;</a>
        }
    </@card::simple>
}

@fn apply() {
    @let page_title = "waltzing-ui Component Showcase"
    @* Placeholder strings with spaces need @let to work in Some(...) *@
    @let enter_password = "Enter password"
    @let tell_about = "Tell us about yourself..."
    @let weekly_updates = "Get weekly updates"
    @let push_notifications = "Receive push notifications"
    @let skeleton_circle_size = "h-12 w-12"
    @let skeleton_w34 = "h-4 w-3/4"
    @let skeleton_w12 = "h-4 w-1/2"

    <@base::apply title=@page_title description=None head=None>
        <div x-data="{ darkMode: false }" x-init="darkMode = document.documentElement.classList.contains('dark')" x-effect="document.documentElement.classList.toggle('dark', darkMode)">
            <div class="container mx-auto px-4 py-8 max-w-6xl">
                @* Header with theme toggle *@
                <header class="flex items-center justify-between mb-12">
                    <div>
                        <h1 class="text-4xl font-bold tracking-tight">waltzing-ui</h1>
                        <p class="text-muted-foreground mt-2">Component Showcase</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <@label::apply>Dark Mode</@label::apply>
                        <button
                            type="button"
                            role="switch"
                            class="peer inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                            :class="darkMode ? 'bg-primary' : 'bg-input'"
                            :aria-checked="darkMode.toString()"
                            x-on:click="darkMode = !darkMode"
                        >
                            <span
                                class="pointer-events-none block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform"
                                :class="darkMode ? 'translate-x-4' : 'translate-x-0'"
                            ></span>
                        </button>
                    </div>
                </header>

                @* Buttons Section *@
                <@section title="Buttons" id="buttons">
                    <p class="text-muted-foreground mb-4">Clickable buttons with multiple variants and sizes.</p>
                    <div class="flex flex-wrap gap-4 items-center">
                        <@button::primary>Primary</@button::primary>
                        <@button::secondary>Secondary</@button::secondary>
                        <@button::outline>Outline</@button::outline>
                        <@button::apply variant=button::Variant::Ghost size=button::Size::Default>Ghost</@button::apply>
                        <@button::apply variant=button::Variant::Destructive size=button::Size::Default>Destructive</@button::apply>
                        <@button::apply variant=button::Variant::Link size=button::Size::Default>Link</@button::apply>
                    </div>
                    <div class="flex flex-wrap gap-4 items-center mt-4">
                        <@button::apply variant=button::Variant::Primary size=button::Size::Sm>Small</@button::apply>
                        <@button::apply variant=button::Variant::Primary size=button::Size::Default>Default</@button::apply>
                        <@button::apply variant=button::Variant::Primary size=button::Size::Lg>Large</@button::apply>
                        <@button::apply variant=button::Variant::Primary size=button::Size::Default disabled=true>Disabled</@button::apply>
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Badges Section *@
                <@section title="Badges" id="badges">
                    <p class="text-muted-foreground mb-4">Small status indicators and tags.</p>
                    <div class="flex flex-wrap gap-2">
                        <@badge::default>Default</@badge::default>
                        <@badge::secondary>Secondary</@badge::secondary>
                        <@badge::outline>Outline</@badge::outline>
                        <@badge::destructive>Destructive</@badge::destructive>
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Inputs Section *@
                <@section title="Inputs" id="inputs">
                    <p class="text-muted-foreground mb-4">Various form input components.</p>
                    <div class="grid gap-6 md:grid-cols-2">
                        <@input::labeled
                            label="Email"
                            input_type=input::InputType::Email
                            name="email"
                           
                            placeholder=Some("name@example.com")
                           
                            required=true
                           
                           
                        />
                        <@input::labeled
                            label="Password"
                            input_type=input::InputType::Password
                            name="password"
                           
                            placeholder=@Some(enter_password)
                           
                            required=true
                           
                           
                        />
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Textarea Section *@
                <@section title="Textarea" id="textarea">
                    <p class="text-muted-foreground mb-4">Multi-line text input.</p>
                    <div class="max-w-md">
                        <@textarea::labeled
                            label="Bio"
                            name="bio"
                           
                            placeholder=@Some(tell_about)
                            rows=Some(4)
                           
                           
                           
                           
                        />
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Checkbox Section *@
                <@section title="Checkbox" id="checkbox">
                    <p class="text-muted-foreground mb-4">Custom styled checkboxes.</p>
                    <div class="space-y-4">
                        <@checkbox::simple name="terms" label="Accept terms" />
                        <@checkbox::checked name="marketing" label="Marketing emails" />
                        <@checkbox::labeled
                            label="Newsletter"
                            name="newsletter"
                            checked=false
                           
                            description=@Some(weekly_updates)
                        />
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Switch Section *@
                <@section title="Switch" id="switch">
                    <p class="text-muted-foreground mb-4">Toggle switches for boolean values.</p>
                    <div class="space-y-4 max-w-sm">
                        <@switch::labeled
                            label="Notifications"
                            name="notifications"
                            checked=true
                           
                            description=@Some(push_notifications)
                        />
                        <@switch::labeled
                            label="Email alerts"
                            name="email_alerts"
                            checked=false
                           
                            description=None
                        />
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Toggle Section *@
                <@section title="Toggle" id="toggle">
                    <p class="text-muted-foreground mb-4">Two-state buttons that can be toggled on or off.</p>
                    <div class="flex flex-wrap gap-2">
                        <@toggle::simple name="bold">B</@toggle::simple>
                        <@toggle::simple name="italic">I</@toggle::simple>
                        <@toggle::outline name="underline" pressed=true>U</@toggle::outline>
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Slider Section *@
                <@section title="Slider" id="slider">
                    <p class="text-muted-foreground mb-4">Range input with custom styling.</p>
                    <div class="space-y-6 max-w-md">
                        <@slider::with_label
                            label="Volume"
                            name="volume"
                            value=50.0
                            min=0.0
                            max=100.0
                            step=1.0
                           
                           
                        />
                        <@slider::with_label
                            label="Brightness"
                            name="brightness"
                            value=75.0
                            min=0.0
                            max=100.0
                            step=5.0
                           
                           
                        />
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Progress Section *@
                <@section title="Progress" id="progress">
                    <p class="text-muted-foreground mb-4">Visual indicator of progress or loading state.</p>
                    <div class="space-y-4 max-w-md">
                        <@progress::apply value=25.0 max=100.0 />
                        <@progress::apply value=50.0 max=100.0 />
                        <@progress::apply value=75.0 max=100.0 />
                        <@progress::with_label value=65.0 max=100.0 label="Progress" />
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Avatar Section *@
                <@section title="Avatar" id="avatar">
                    <p class="text-muted-foreground mb-4">User avatar with image and fallback support.</p>
                    <div class="flex items-center gap-4">
                        <@avatar::sm src="https://github.com/shadcn.png" alt="User" fallback="CN" />
                        <@avatar::image src="https://github.com/shadcn.png" alt="User" fallback="CN" />
                        <@avatar::lg src="https://github.com/shadcn.png" alt="User" fallback="CN" />
                        <@avatar::fallback initials="JD" />
                        <@avatar::fallback initials="AB" />
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Card Section *@
                <@section title="Card" id="card">
                    <p class="text-muted-foreground mb-4">Container with optional header and footer.</p>
                    <div class="grid gap-6 md:grid-cols-2">
                        <@card::simple>
                            <@card::title>Card Title</@card::title>
                            <@card::description>Card description</@card::description>
                            <p class="mt-4">This is the card content area.</p>
                        </@card::simple>
                        <@card::simple>
                            <h3 class="font-semibold mb-2">Simple Card</h3>
                            <p class="text-muted-foreground">Without header or footer.</p>
                        </@card::simple>
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Alert Section *@
                <@section title="Alert" id="alert">
                    <p class="text-muted-foreground mb-4">Callouts for important messages.</p>
                    <div class="space-y-4">
                        <@alert::default>
                            <@alert::title>Heads up!</@alert::title>
                            <@alert::description>Important message here.</@alert::description>
                        </@alert::default>
                        <@alert::success>
                            <@alert::title>Success!</@alert::title>
                            <@alert::description>Changes saved.</@alert::description>
                        </@alert::success>
                        <@alert::warning>
                            <@alert::title>Warning</@alert::title>
                            <@alert::description>Cannot be undone.</@alert::description>
                        </@alert::warning>
                        <@alert::destructive>
                            <@alert::title>Error</@alert::title>
                            <@alert::description>Something went wrong.</@alert::description>
                        </@alert::destructive>
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Skeleton Section *@
                <@section title="Skeleton" id="skeleton">
                    <p class="text-muted-foreground mb-4">Loading placeholders for content.</p>
                    <div class="space-y-4 max-w-md">
                        <div class="flex items-center gap-4">
                            <@skeleton::circle size=@skeleton_circle_size />
                            <div class="space-y-2 flex-1">
                                <@skeleton::apply class=@skeleton_w34 />
                                <@skeleton::apply class=@skeleton_w12 />
                            </div>
                        </div>
                        <@skeleton::text lines=3 />
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Separator Section *@
                <@section title="Separator" id="separator">
                    <p class="text-muted-foreground mb-4">Visual divider between sections.</p>
                    <div class="space-y-4">
                        <p class="text-sm">Content above</p>
                        <@separator::horizontal />
                        <p class="text-sm">Content below</p>
                    </div>
                    <div class="flex items-center gap-4 h-8 mt-4">
                        <span class="text-sm">Item 1</span>
                        <@separator::vertical />
                        <span class="text-sm">Item 2</span>
                        <@separator::vertical />
                        <span class="text-sm">Item 3</span>
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Layouts Section *@
                <@section title="Layouts" id="layouts">
                    <p class="text-muted-foreground mb-4">Page layout templates for common application structures.</p>
                    <div class="grid gap-6 md:grid-cols-2">
                        <@card::simple>
                            <@card::title>Base Layout</@card::title>
                            <@card::description>Standard HTML page with Tailwind, Alpine.js, and theme support</@card::description>
                            <p class="mt-2 text-xs text-muted-foreground">This showcase uses the base layout</p>
                            <p class="mt-2"><code class="text-xs bg-muted px-1 py-0.5 rounded">/layouts/base.wtz</code></p>
                        </@card::simple>
                        <@card::simple>
                            <@card::title>Sidebar Layout</@card::title>
                            <@card::description>Dashboard layout with collapsible navigation sidebar</@card::description>
                            <p class="mt-2 text-xs text-muted-foreground">Supports NavItem and NavGroup for navigation</p>
                            <p class="mt-2"><code class="text-xs bg-muted px-1 py-0.5 rounded">/layouts/sidebar.wtz</code></p>
                            <a href="/sidebar-demo" class="mt-2 inline-flex text-xs text-primary hover:underline">View Demo &rarr;</a>
                        </@card::simple>
                    </div>
                </@section>

                <@separator::horizontal class="my-8" />

                @* Blocks Section - Main container for all blocks *@
                <@section title="Blocks" id="blocks">
                    <p class="text-muted-foreground mb-4">Pre-built, copy-paste page sections and patterns. Organized by category for easy discovery.</p>

                    @* Blocks Navigation *@
                    <nav class="mb-8 p-4 bg-muted/50 rounded-lg">
                        <p class="text-sm font-medium mb-2">Jump to category:</p>
                        <div class="flex flex-wrap gap-2">
                            <a href="#blocks-auth" class="text-sm text-primary hover:underline">Auth</a>
                            <span class="text-muted-foreground">|</span>
                            <a href="#blocks-sidebar" class="text-sm text-primary hover:underline">Sidebar</a>
                            <span class="text-muted-foreground">|</span>
                            <a href="#blocks-dashboard" class="text-sm text-primary hover:underline">Dashboard</a>
                            <span class="text-muted-foreground">|</span>
                            <a href="#blocks-forms" class="text-sm text-primary hover:underline">Forms</a>
                            <span class="text-muted-foreground">|</span>
                            <a href="#blocks-dialogs" class="text-sm text-primary hover:underline">Dialogs</a>
                        </div>
                    </nav>

                    <div class="space-y-12">
                        @* Auth Blocks *@
                        <@subsection title="Auth" id="blocks-auth">
                            <p class="text-muted-foreground mb-4">Authentication pages including login and signup forms with various layouts.</p>
                            <div class="grid gap-6 md:grid-cols-2">
                                <@block_card
                                    name="Login"
                                    description="Simple centered login form with email and password"
                                    path="/blocks/auth/login.wtz"
                                    demo_href=@Some("/demo/blocks/auth/login")
                                />
                                <@block_card
                                    name="Signup"
                                    description="Simple centered signup form with name, email, and password"
                                    path="/blocks/auth/signup.wtz"
                                    demo_href=@Some("/demo/blocks/auth/signup")
                                />
                                <@block_card
                                    name="Login 01"
                                    description="Two-column login with image panel and social auth options"
                                    path="/blocks/auth/login-01.wtz"
                                    demo_href=@Some("/demo/blocks/auth/login-01")
                                />
                                <@block_card
                                    name="Signup 01"
                                    description="Two-column signup with image panel and social auth options"
                                    path="/blocks/auth/signup-01.wtz"
                                    demo_href=@Some("/demo/blocks/auth/signup-01")
                                />
                            </div>
                        </@subsection>

                        <@separator::horizontal class="my-6" />

                        @* Sidebar Blocks *@
                        <@subsection title="Sidebar" id="blocks-sidebar">
                            <p class="text-muted-foreground mb-4">Navigation sidebar patterns for dashboards and applications.</p>
                            <div class="grid gap-6 md:grid-cols-2">
                                <@block_card
                                    name="Sidebar 07"
                                    description="Collapsible sidebar with icons, nested navigation groups, and user menu"
                                    path="/blocks/sidebar/sidebar-07.wtz"
                                    demo_href=@Some("/demo/blocks/sidebar/sidebar-07")
                                />
                            </div>
                        </@subsection>

                        <@separator::horizontal class="my-6" />

                        @* Dashboard Blocks *@
                        <@subsection title="Dashboard" id="blocks-dashboard">
                            <p class="text-muted-foreground mb-4">Dashboard layouts with stats cards, charts, and data tables.</p>
                            <div class="grid gap-6 md:grid-cols-2">
                                <@block_card
                                    name="Dashboard 01"
                                    description="Overview dashboard with stat cards, recent activity, and quick actions"
                                    path="/blocks/dashboard/dashboard-01.wtz"
                                    demo_href=@Some("/demo/blocks/dashboard/dashboard-01")
                                />
                            </div>
                        </@subsection>

                        <@separator::horizontal class="my-6" />

                        @* Forms Blocks *@
                        <@subsection title="Forms" id="blocks-forms">
                            <p class="text-muted-foreground mb-4">Complete form blocks for common use cases.</p>
                            <div class="space-y-8">
                                <@card::simple>
                                    <@card::title>Contact Form</@card::title>
                                    <@card::description>Standard contact form with validation support</@card::description>
                                    <p class="mt-1"><code class="text-xs bg-muted px-1 py-0.5 rounded">/blocks/forms/contact.wtz</code></p>
                                    <div class="mt-4">
                                        <@contact_form::apply
                                            action="#"
                                            method="post"
                                            class="space-y-4"
                                        />
                                    </div>
                                </@card::simple>
                                <@card::simple>
                                    <@card::title>Profile Form</@card::title>
                                    <@card::description>Profile/account settings form with avatar, personal info, and social links</@card::description>
                                    <p class="mt-1"><code class="text-xs bg-muted px-1 py-0.5 rounded">/blocks/forms/profile.wtz</code></p>
                                    <div class="mt-4">
                                        <@profile_form::apply
                                            action="#"
                                            method="post"
                                            avatar_fallback="JD"
                                            name_value=@Some("John Doe")
                                            email_value=@Some("john@example.com")
                                            bio_value=@Some("Software developer passionate about building great products")
                                        />
                                    </div>
                                </@card::simple>
                            </div>
                        </@subsection>

                        <@separator::horizontal class="my-6" />

                        @* Dialogs Blocks *@
                        <@subsection title="Dialogs" id="blocks-dialogs">
                            <p class="text-muted-foreground mb-4">Pre-built dialog patterns for common interactions.</p>
                            <div class="flex flex-wrap gap-4">
                                @* Confirm Dialog *@
                                <div class="space-y-2">
                                    <p class="text-sm font-medium">Confirm Dialog</p>
                                    <p class="text-xs text-muted-foreground"><code class="bg-muted px-1 py-0.5 rounded">/blocks/dialogs/confirm.wtz</code></p>
                                    <@confirm_dialog::apply
                                        title="Confirm Action"
                                        message="Are you sure you want to proceed with this action?"
                                        trigger=@() {
                                            <@button::outline>Open Confirm</@button::outline>
                                        }
                                    />
                                </div>

                                @* Delete Dialog *@
                                <div class="space-y-2">
                                    <p class="text-sm font-medium">Delete Dialog</p>
                                    <p class="text-xs text-muted-foreground"><code class="bg-muted px-1 py-0.5 rounded">/blocks/dialogs/delete.wtz</code></p>
                                    <@delete_dialog::apply
                                        title="Delete Item"
                                        itemName="Example Document"
                                        message="This action cannot be undone. All associated data will be permanently removed."
                                        trigger=@() {
                                            <@button::apply variant=button::Variant::Destructive size=button::Size::Default>Open Delete</@button::apply>
                                        }
                                    />
                                </div>

                                @* Share Dialog *@
                                <div class="space-y-2">
                                    <p class="text-sm font-medium">Share Dialog</p>
                                    <p class="text-xs text-muted-foreground"><code class="bg-muted px-1 py-0.5 rounded">/blocks/dialogs/share.wtz</code></p>
                                    <@share_dialog::apply
                                        url="https://example.com/shared/item-123"
                                        title="Share This"
                                    />
                                </div>
                            </div>
                        </@subsection>
                    </div>
                </@section>

                @* Footer *@
                <footer class="mt-16 py-8 border-t text-center text-sm text-muted-foreground">
                    <p>Built with waltzing-ui</p>
                </footer>
            </div>
        </div>
    </@base::apply>
}
