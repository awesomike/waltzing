@*
 * Auth layout
 * Centered card layout for login/signup pages with optional branding area
 *@

@import /layouts/base.wtz

@struct FooterLink {
    label: String,
    href: String,
}

@struct SocialProvider {
    name: String,
    icon: String,
    href: String,
}

@*
 * Full auth layout with branding area
 * Split layout with branding on left (or top on mobile) and card on right
 *@
@fn apply(
    title: &str,
    brand: Option<@()>,
    brand_content: Option<@()>,
    footer_links: Option<Vec<FooterLink>>,
    social_providers: Option<Vec<SocialProvider>>,
    content: @(),
) {
    <@base::apply title=@title description=None head=None>
        <div class="flex min-h-screen">
            @* Branding area - left side on desktop, top on mobile *@
            @if brand.is_some() || brand_content.is_some() {
                <div class="hidden lg:flex lg:w-1/2 flex-col bg-muted p-10">
                    @* Brand/logo *@
                    @if let Some(b) = brand {
                        <div class="flex items-center gap-2 text-lg font-semibold">
                            @b()
                        </div>
                    }

                    @* Brand content (testimonial, illustration, etc.) *@
                    @if let Some(bc) = brand_content {
                        <div class="flex flex-1 items-center justify-center">
                            @bc()
                        </div>
                    }
                </div>
            }

            @* Main content area *@
            @let content_width = if brand.is_some() || brand_content.is_some() { "lg:w-1/2" } else { "w-full" }
            <div class="flex @content_width flex-col">
                @* Mobile brand header *@
                @if let Some(b) = brand {
                    <div class="flex lg:hidden items-center gap-2 p-6 text-lg font-semibold">
                        @b()
                    </div>
                }

                @* Centered card container *@
                <div class="flex flex-1 items-center justify-center p-6 lg:p-10">
                    <div class="w-full max-w-md space-y-6">
                        @* Main card with form *@
                        <div class="rounded-xl border bg-card text-card-foreground shadow p-6 space-y-6">
                            @content()

                            @* Social login buttons *@
                            @if let Some(providers) = social_providers {
                                @if !providers.is_empty() {
                                    <div class="relative">
                                        <div class="absolute inset-0 flex items-center">
                                            <span class="w-full border-t"></span>
                                        </div>
                                        <div class="relative flex justify-center text-xs uppercase">
                                            <span class="bg-card px-2 text-muted-foreground">Or continue with</span>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-@(providers.len()) gap-3">
                                        @for provider in providers {
                                            <a
                                                href="@provider.href"
                                                class="inline-flex items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                                            >
                                                <span class="h-5 w-5">@safe(&provider.icon)</span>
                                                <span class="sr-only">@provider.name</span>
                                            </a>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        @* Footer links *@
                        @if let Some(links) = footer_links {
                            @if !links.is_empty() {
                                <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-muted-foreground">
                                    @for link in links {
                                        <a
                                            href="@link.href"
                                            class="hover:text-foreground hover:underline underline-offset-4"
                                        >
                                            @link.label
                                        </a>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </@base::apply>
}

@*
 * Simple auth layout - just centered card without branding
 *@
@fn simple(
    title: &str,
    footer_links: Option<Vec<FooterLink>>,
    social_providers: Option<Vec<SocialProvider>>,
    content: @(),
) {
    <@base::apply title=@title description=None head=None>
        <div class="flex min-h-screen items-center justify-center p-6">
            <div class="w-full max-w-md space-y-6">
                @* Main card with form *@
                <div class="rounded-xl border bg-card text-card-foreground shadow p-6 space-y-6">
                    @content()

                    @* Social login buttons *@
                    @if let Some(providers) = social_providers {
                        @if !providers.is_empty() {
                            <div class="relative">
                                <div class="absolute inset-0 flex items-center">
                                    <span class="w-full border-t"></span>
                                </div>
                                <div class="relative flex justify-center text-xs uppercase">
                                    <span class="bg-card px-2 text-muted-foreground">Or continue with</span>
                                </div>
                            </div>

                            <div class="grid grid-cols-@(providers.len()) gap-3">
                                @for provider in providers {
                                    <a
                                        href="@provider.href"
                                        class="inline-flex items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                                    >
                                        <span class="h-5 w-5">@safe(&provider.icon)</span>
                                        <span class="sr-only">@provider.name</span>
                                    </a>
                                }
                            </div>
                        }
                    }
                </div>

                @* Footer links *@
                @if let Some(links) = footer_links {
                    @if !links.is_empty() {
                        <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-muted-foreground">
                            @for link in links {
                                <a
                                    href="@link.href"
                                    class="hover:text-foreground hover:underline underline-offset-4"
                                >
                                    @link.label
                                </a>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </@base::apply>
}

@*
 * Card-only variant for embedding in existing pages
 * No base layout wrapper - just the card structure
 *@
@fn card(
    social_providers: Option<Vec<SocialProvider>>,
    content: @(),
) {
    <div class="w-full max-w-md space-y-6">
        <div class="rounded-xl border bg-card text-card-foreground shadow p-6 space-y-6">
            @content()

            @* Social login buttons *@
            @if let Some(providers) = social_providers {
                @if !providers.is_empty() {
                    <div class="relative">
                        <div class="absolute inset-0 flex items-center">
                            <span class="w-full border-t"></span>
                        </div>
                        <div class="relative flex justify-center text-xs uppercase">
                            <span class="bg-card px-2 text-muted-foreground">Or continue with</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-@(providers.len()) gap-3">
                        @for provider in providers {
                            <a
                                href="@provider.href"
                                class="inline-flex items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                            >
                                <span class="h-5 w-5">@safe(&provider.icon)</span>
                                <span class="sr-only">@provider.name</span>
                            </a>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@*
 * Form header component for consistent styling
 *@
@fn form_header(
    title: &str,
    description: Option<&str>,
) {
    <div class="space-y-2 text-center">
        <h1 class="text-2xl font-semibold tracking-tight">@title</h1>
        @if let Some(desc) = description {
            <p class="text-sm text-muted-foreground">@desc</p>
        }
    </div>
}

@*
 * Form footer for links like "Forgot password?" or "Sign up"
 *@
@fn form_footer(content: @()) {
    <div class="text-center text-sm text-muted-foreground">
        @content()
    </div>
}
