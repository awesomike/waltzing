@*
 * Settings layout
 * Settings page with sidebar navigation and content area
 * Mobile-friendly with dropdown navigation on smaller screens
 *
 * @example
 * @import /layouts/settings.wtz as settings
 *
 * @let nav_items = vec![
 *     settings::NavItem {
 *         id: "profile".to_string(),
 *         label: "Profile".to_string(),
 *         href: Some("/settings/profile".to_string()),
 *         icon: None,
 *     },
 *     settings::NavItem {
 *         id: "account".to_string(),
 *         label: "Account".to_string(),
 *         href: Some("/settings/account".to_string()),
 *         icon: None,
 *     },
 * ]
 *
 * <@settings::apply
 *     title="Settings"
 *     page_title="Settings"
 *     page_description=Some("Manage your account settings and preferences.")
 *     nav_items=nav_items
 *     active_item="profile"
 *     content=@() {
 *         <@settings::section
 *             title="Profile"
 *             description="Update your profile information."
 *         >
 *             <form>...</form>
 *         </@>
 *     }
 * />
 *@

@import /layouts/base.wtz

@struct NavItem {
    id: String,
    label: String,
    href: Option<String>,
    icon: Option<String>,
}

@*
 * Full settings layout with sidebar navigation
 * Wraps content in base layout with header and sidebar
 *@
@fn apply(
    title: &str,
    page_title: &str,
    page_description: Option<&str>,
    nav_items: Vec<NavItem>,
    active_item: &str,
    back_href: Option<&str>,
    content: @(),
) {
    <@base::apply title=@title description=@page_description head=None>
        <div class="min-h-screen bg-background">
            @* Header *@
            <header class="sticky top-0 z-40 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
                <div class="container flex h-16 items-center px-4 md:px-6">
                    @if let Some(href) = back_href {
                        <a
                            href="@href"
                            class="mr-4 flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                                <path d="m15 18-6-6 6-6"/>
                            </svg>
                            <span class="hidden sm:inline">Back</span>
                        </a>
                    }
                    <h1 class="text-lg font-semibold">@page_title</h1>
                </div>
            </header>

            @* Main content area *@
            <div class="container px-4 py-6 md:px-6 lg:py-10">
                @* Page header *@
                <div class="mb-6 space-y-1">
                    <h2 class="text-2xl font-bold tracking-tight">@page_title</h2>
                    @if let Some(desc) = page_description {
                        <p class="text-muted-foreground">@desc</p>
                    }
                </div>

                @* Mobile navigation dropdown *@
                <div class="mb-6 md:hidden" x-data="{ open: false }">
                    <button
                        @click="open = !open"
                        class="flex w-full items-center justify-between rounded-md border bg-background px-4 py-2 text-sm font-medium"
                    >
                        <span>
                            @for item in &nav_items {
                                @if item.id == active_item {
                                    @item.label
                                }
                            }
                        </span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="h-4 w-4 text-muted-foreground transition-transform"
                            :class="open ? 'rotate-180' : ''"
                        >
                            <path d="m6 9 6 6 6-6"/>
                        </svg>
                    </button>

                    <div
                        x-show="open"
                        x-transition:enter="transition ease-out duration-100"
                        x-transition:enter-start="opacity-0 -translate-y-1"
                        x-transition:enter-end="opacity-100 translate-y-0"
                        x-transition:leave="transition ease-in duration-75"
                        x-transition:leave-start="opacity-100 translate-y-0"
                        x-transition:leave-end="opacity-0 -translate-y-1"
                        @click.away="open = false"
                        class="absolute left-4 right-4 z-50 mt-2 rounded-md border bg-popover p-1 shadow-md"
                        style="display: none;"
                    >
                        @for item in &nav_items {
                            @let is_active = (item.id == active_item)
                            @let active_cls = class_if(is_active, "bg-accent text-accent-foreground")
                            @let link_classes = vec!["flex items-center gap-2 rounded-sm px-3 py-2 text-sm transition-colors hover:bg-accent hover:text-accent-foreground", active_cls]
                            @if let Some(href) = &item.href {
                                <a href="@href" class="@cn(@link_classes)" @click="open = false">
                                    @if let Some(icon) = &item.icon {
                                        <span class="h-4 w-4">@safe(icon)</span>
                                    }
                                    @item.label
                                </a>
                            } else {
                                <button type="button" class="@cn(@link_classes) w-full text-left" @click="open = false">
                                    @if let Some(icon) = &item.icon {
                                        <span class="h-4 w-4">@safe(icon)</span>
                                    }
                                    @item.label
                                </button>
                            }
                        }
                    </div>
                </div>

                @* Desktop layout with sidebar *@
                <div class="flex flex-col gap-8 md:flex-row md:gap-10 lg:gap-12">
                    @* Sidebar navigation (desktop) *@
                    <aside class="hidden md:block md:w-48 lg:w-56 flex-shrink-0">
                        <nav class="sticky top-24 space-y-1">
                            @for item in nav_items {
                                @let is_active = (item.id == active_item)
                                @let active_cls = class_if(is_active, "bg-muted font-medium")
                                @let link_classes = vec!["flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors hover:bg-muted", active_cls]
                                @if let Some(href) = &item.href {
                                    <a href="@href" class="@cn(@link_classes)">
                                        @if let Some(icon) = &item.icon {
                                            <span class="h-4 w-4 flex-shrink-0">@safe(icon)</span>
                                        }
                                        @item.label
                                    </a>
                                } else {
                                    <button type="button" class="@cn(@link_classes) w-full text-left">
                                        @if let Some(icon) = &item.icon {
                                            <span class="h-4 w-4 flex-shrink-0">@safe(icon)</span>
                                        }
                                        @item.label
                                    </button>
                                }
                            }
                        </nav>
                    </aside>

                    @* Main content *@
                    <main class="flex-1 min-w-0">
                        @content()
                    </main>
                </div>
            </div>
        </div>
    </@>
}

@*
 * Settings layout without base wrapper (for embedding)
 * Use when you already have a base layout
 *@
@fn embed(
    page_title: &str,
    page_description: Option<&str>,
    nav_items: Vec<NavItem>,
    active_item: &str,
    content: @(),
) {
    <div class="space-y-6">
        @* Page header *@
        <div class="space-y-1">
            <h2 class="text-2xl font-bold tracking-tight">@page_title</h2>
            @if let Some(desc) = page_description {
                <p class="text-muted-foreground">@desc</p>
            }
        </div>

        @* Mobile navigation dropdown *@
        <div class="md:hidden" x-data="{ open: false }">
            <button
                @click="open = !open"
                class="flex w-full items-center justify-between rounded-md border bg-background px-4 py-2 text-sm font-medium"
            >
                <span>
                    @for item in &nav_items {
                        @if item.id == active_item {
                            @item.label
                        }
                    }
                </span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-4 w-4 text-muted-foreground transition-transform"
                    :class="open ? 'rotate-180' : ''"
                >
                    <path d="m6 9 6 6 6-6"/>
                </svg>
            </button>

            <div
                x-show="open"
                x-transition
                @click.away="open = false"
                class="mt-2 rounded-md border bg-popover p-1 shadow-md"
                style="display: none;"
            >
                @for item in &nav_items {
                    @let is_active = (item.id == active_item)
                    @let active_cls = class_if(is_active, "bg-accent text-accent-foreground")
                    @let link_classes = vec!["flex items-center gap-2 rounded-sm px-3 py-2 text-sm transition-colors hover:bg-accent hover:text-accent-foreground", active_cls]
                    @if let Some(href) = &item.href {
                        <a href="@href" class="@cn(@link_classes)" @click="open = false">
                            @if let Some(icon) = &item.icon {
                                <span class="h-4 w-4">@safe(icon)</span>
                            }
                            @item.label
                        </a>
                    } else {
                        <button type="button" class="@cn(@link_classes) w-full text-left" @click="open = false">
                            @if let Some(icon) = &item.icon {
                                <span class="h-4 w-4">@safe(icon)</span>
                            }
                            @item.label
                        </button>
                    }
                }
            </div>
        </div>

        @* Content with sidebar *@
        <div class="flex flex-col gap-8 md:flex-row md:gap-10 lg:gap-12">
            @* Sidebar navigation (desktop) *@
            <aside class="hidden md:block md:w-48 lg:w-56 flex-shrink-0">
                <nav class="sticky top-6 space-y-1">
                    @for item in nav_items {
                        @let is_active = (item.id == active_item)
                        @let active_cls = class_if(is_active, "bg-muted font-medium")
                        @let link_classes = vec!["flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors hover:bg-muted", active_cls]
                        @if let Some(href) = &item.href {
                            <a href="@href" class="@cn(@link_classes)">
                                @if let Some(icon) = &item.icon {
                                    <span class="h-4 w-4 flex-shrink-0">@safe(icon)</span>
                                }
                                @item.label
                            </a>
                        } else {
                            <button type="button" class="@cn(@link_classes) w-full text-left">
                                @if let Some(icon) = &item.icon {
                                    <span class="h-4 w-4 flex-shrink-0">@safe(icon)</span>
                                }
                                @item.label
                            </button>
                        }
                    }
                </nav>
            </aside>

            @* Main content *@
            <main class="flex-1 min-w-0">
                @content()
            </main>
        </div>
    </div>
}

@*
 * Settings section component
 * Use to group related settings with a title and description
 *@
@fn section(
    title: &str,
    description: Option<&str>,
    content: @(),
) {
    <div class="space-y-6">
        <div class="space-y-1">
            <h3 class="text-lg font-medium">@title</h3>
            @if let Some(desc) = description {
                <p class="text-sm text-muted-foreground">@desc</p>
            }
        </div>
        <div class="rounded-lg border bg-card p-6">
            @content()
        </div>
    </div>
}

@*
 * Settings section without card wrapper
 * For when you want more control over the content styling
 *@
@fn section_plain(
    title: &str,
    description: Option<&str>,
    content: @(),
) {
    <div class="space-y-4">
        <div class="space-y-1">
            <h3 class="text-lg font-medium">@title</h3>
            @if let Some(desc) = description {
                <p class="text-sm text-muted-foreground">@desc</p>
            }
        </div>
        @content()
    </div>
}

@*
 * Settings row - a single setting item with label and control
 *@
@fn row(
    label: &str,
    description: Option<&str>,
    control: @(),
) {
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="space-y-1">
            <p class="font-medium text-sm">@label</p>
            @if let Some(desc) = description {
                <p class="text-sm text-muted-foreground">@desc</p>
            }
        </div>
        <div class="flex-shrink-0">
            @control()
        </div>
    </div>
}

@*
 * Separator between settings sections
 *@
@fn separator() {
    <div class="my-6 h-px bg-border" role="separator"></div>
}

@*
 * Danger zone section for destructive actions
 *@
@fn danger_zone(
    title: &str = "Danger Zone",
    description: Option<&str>,
    content: @(),
) {
    <div class="space-y-6">
        <div class="space-y-1">
            <h3 class="text-lg font-medium text-destructive">@title</h3>
            @if let Some(desc) = description {
                <p class="text-sm text-muted-foreground">@desc</p>
            }
        </div>
        <div class="rounded-lg border border-destructive/50 bg-destructive/5 p-6">
            @content()
        </div>
    </div>
}

@*
 * Default navigation items for a typical settings page
 * Returns common settings sections with icons
 *@
@fn default_nav_items(base_path: &str) {
    @let profile_icon = r#"<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>"#
    @let account_icon = r#"<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"></rect><line x1="2" x2="22" y1="10" y2="10"></line></svg>"#
    @let security_icon = r#"<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>"#
    @let notifications_icon = r#"<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>"#
    @let appearance_icon = r#"<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>"#

    @(vec![
        NavItem {
            id: "profile".to_string(),
            label: "Profile".to_string(),
            href: Some(format!("{}/profile", base_path)),
            icon: Some(profile_icon.to_string()),
        },
        NavItem {
            id: "account".to_string(),
            label: "Account".to_string(),
            href: Some(format!("{}/account", base_path)),
            icon: Some(account_icon.to_string()),
        },
        NavItem {
            id: "security".to_string(),
            label: "Security".to_string(),
            href: Some(format!("{}/security", base_path)),
            icon: Some(security_icon.to_string()),
        },
        NavItem {
            id: "notifications".to_string(),
            label: "Notifications".to_string(),
            href: Some(format!("{}/notifications", base_path)),
            icon: Some(notifications_icon.to_string()),
        },
        NavItem {
            id: "appearance".to_string(),
            label: "Appearance".to_string(),
            href: Some(format!("{}/appearance", base_path)),
            icon: Some(appearance_icon.to_string()),
        },
    ])
}
