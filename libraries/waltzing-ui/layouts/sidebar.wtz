@*
 * Sidebar layout
 * Common dashboard/app layout with collapsible sidebar
 *@

@import /layouts/base.wtz

@struct NavItem {
    label: String,
    href: String,
    icon: Option<String>,
    active: bool,
}

@struct NavGroup {
    label: Option<String>,
    items: Vec<NavItem>,
}

@fn apply(
    title: &str,
    brand: @(),
    nav_groups: Vec<NavGroup>,
    header: Option<@()>,
    content: @(),
) {
    <@base::apply title=@title description=None head=None>
        <div
            x-data="{ sidebarOpen: true }"
            class="flex h-screen overflow-hidden"
        >
            @* Sidebar *@
            <aside
                :class="sidebarOpen ? 'w-64' : 'w-16'"
                class="flex flex-col border-r bg-card transition-all duration-300"
            >
                @* Brand *@
                <div class="flex h-16 items-center border-b px-4">
                    <div x-show="sidebarOpen" x-transition>
                        @brand()
                    </div>
                </div>

                @* Navigation *@
                <nav class="flex-1 overflow-y-auto p-4">
                    @for group in nav_groups {
                        <div class="mb-4">
                            @if let Some(label) = &group.label {
                                <h3
                                    x-show="sidebarOpen"
                                    class="mb-2 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                                >
                                    @label
                                </h3>
                            }
                            <ul class="space-y-1">
                                @for item in &group.items {
                                    <li>
                                        @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                        @let link_classes = ["flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground", active_cls]
                                        <a
                                            href="@item.href"
                                            class="@cn(@link_classes)"
                                        >
                                            @if let Some(icon) = &item.icon {
                                                <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                            }
                                            <span x-show="sidebarOpen" x-transition>@item.label</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </nav>

                @* Collapse toggle *@
                <div class="border-t p-4">
                    <button
                        @click="sidebarOpen = !sidebarOpen"
                        class="flex w-full items-center justify-center rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="h-5 w-5 transition-transform"
                            :class="sidebarOpen ? '' : 'rotate-180'"
                        >
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                    </button>
                </div>
            </aside>

            @* Main content *@
            <div class="flex flex-1 flex-col overflow-hidden">
                @* Header *@
                @if let Some(h) = header {
                    <header class="flex h-16 items-center border-b bg-card px-6">
                        @h()
                    </header>
                }

                @* Content *@
                <main class="flex-1 overflow-y-auto p-6">
                    @content()
                </main>
            </div>
        </div>
    </@base::apply>
}

@* Simple sidebar without header *@
@fn simple(
    title: &str,
    brand: @(),
    nav_groups: Vec<NavGroup>,
    content: @(),
) {
    <@apply
        title=@title
        brand=@brand
        nav_groups=@nav_groups
        header=None
        content=@content
    />
}
