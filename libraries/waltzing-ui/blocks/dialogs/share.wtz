@*
 * Share Dialog Block
 * A dialog for sharing content via link, social media, or email
 * Requires: @alpinejs/focus plugin
 *
 * @example
 * @import blocks/dialogs/share.wtz as share
 *
 * <@share::apply url="https://example.com/item/123" title="Share this item" />
 *@

@import /components/dialog.wtz as dialog
@import /components/button.wtz as button
@import /components/input.wtz as input


@* Share dialog with copy link, social sharing, and email invite *@
@fn apply(
    url: &str,
    title: &str = "Share",
    description: Option<&str> = None,
    trigger: Option<@()> = None,
) {
    @let default_desc = "Share this link with others"
    @let desc = description.unwrap_or(@default_desc)

    <@dialog::apply
        title=@title
        description=@Some(desc)
        trigger=@() {
            @if let Some(t) = trigger {
                @t()
            } else {
                <@button::outline>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                        <circle cx="18" cy="5" r="3"></circle>
                        <circle cx="6" cy="12" r="3"></circle>
                        <circle cx="18" cy="19" r="3"></circle>
                        <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
                        <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
                    </svg>
                    Share
                </@button::outline>
            }
        }
        content=@() {
            <div class="space-y-4" x-data="{ copied: false }">
                @* Copy link section *@
                <div class="space-y-2">
                    <label class="text-sm font-medium">Link</label>
                    <div class="flex gap-2">
                        <input
                            type="text"
                            value="@url"
                            readonly
                            class="flex h-9 w-full rounded-md border border-input bg-muted px-3 py-1 text-sm shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                            x-ref="shareUrl"
                        />
                        <@button::apply
                            variant=button::Variant::Outline
                            size=button::Size::Default
                            class="shrink-0"
                        >
                            <span
                                x-on:click="navigator.clipboard.writeText($refs.shareUrl.value); copied = true; setTimeout(() => copied = false, 2000)"
                                x-text="copied ? 'Copied!' : 'Copy'"
                            ></span>
                        </@button::apply>
                    </div>
                </div>

                @* Divider *@
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <span class="w-full border-t"></span>
                    </div>
                    <div class="relative flex justify-center text-xs uppercase">
                        <span class="bg-background px-2 text-muted-foreground">Or share via</span>
                    </div>
                </div>

                @* Social share buttons *@
                <div class="flex justify-center gap-4">
                    @* Twitter/X *@
                    <a
                        href="https://twitter.com/intent/tweet?url=@url"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground transition-colors"
                        aria-label="Share on Twitter"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                        </svg>
                    </a>

                    @* Facebook *@
                    <a
                        href="https://www.facebook.com/sharer/sharer.php?u=@url"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground transition-colors"
                        aria-label="Share on Facebook"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 36.6 36.6 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"></path>
                        </svg>
                    </a>

                    @* LinkedIn *@
                    <a
                        href="https://www.linkedin.com/sharing/share-offsite/?url=@url"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground transition-colors"
                        aria-label="Share on LinkedIn"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                        </svg>
                    </a>

                    @* Email *@
                    <a
                        href="mailto:?subject=Check%20this%20out&body=@url"
                        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground transition-colors"
                        aria-label="Share via Email"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                    </a>
                </div>

                @* Email invite section *@
                <div class="space-y-2">
                    <label class="text-sm font-medium">Invite by email</label>
                    <div class="flex gap-2" x-data="{ email: '', sending: false, sent: false }">
                        <input
                            type="email"
                            x-model="email"
                            placeholder="colleague@example.com"
                            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                        />
                        <@button::apply
                            variant=button::Variant::Primary
                            size=button::Size::Default
                            class="shrink-0"
                        >
                            <span
                                x-on:click="if (email) { window.location.href = 'mailto:' + email + '?subject=Check%20this%20out&body=' + encodeURIComponent('@url'); sent = true; setTimeout(() => sent = false, 2000); }"
                                x-text="sent ? 'Sent!' : 'Send'"
                            ></span>
                        </@button::apply>
                    </div>
                </div>
            </div>
        }
        footer=@None
    />
}


@* Compact share dialog (link copy only) *@
@fn compact(
    url: &str,
    title: &str = "Share",
    trigger: Option<@()> = None,
) {
    @let compact_desc = "Copy the link below to share"

    <@dialog::apply
        title=@title
        description=@Some(compact_desc)
        trigger=@() {
            @if let Some(t) = trigger {
                @t()
            } else {
                <@button::apply variant=button::Variant::Ghost size=button::Size::Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="18" cy="5" r="3"></circle>
                        <circle cx="6" cy="12" r="3"></circle>
                        <circle cx="18" cy="19" r="3"></circle>
                        <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
                        <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
                    </svg>
                </@button::apply>
            }
        }
        content=@() {
            <div class="flex gap-2" x-data="{ copied: false }">
                <input
                    type="text"
                    value="@url"
                    readonly
                    class="flex h-9 w-full rounded-md border border-input bg-muted px-3 py-1 text-sm shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                    x-ref="shareUrl"
                />
                <@button::apply
                    variant=button::Variant::Primary
                    size=button::Size::Default
                    class="shrink-0"
                >
                    <span
                        x-on:click="navigator.clipboard.writeText($refs.shareUrl.value); copied = true; setTimeout(() => copied = false, 2000)"
                        x-text="copied ? 'Copied!' : 'Copy'"
                    ></span>
                </@button::apply>
            </div>
        }
        footer=@None
    />
}
