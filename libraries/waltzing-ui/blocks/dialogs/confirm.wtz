@*
 * Confirm dialog block
 * A reusable confirmation dialog with confirm/cancel buttons
 * Requires: dialog component, button component, @alpinejs/focus plugin
 *@

@import /components/dialog.wtz
@import /components/button.wtz

@enum Variant {
    Default,
    Destructive,
}

@*
 * Confirm dialog with trigger element
 * @param title - Dialog title
 * @param message - Confirmation message
 * @param confirmLabel - Label for confirm button (default: "Confirm")
 * @param cancelLabel - Label for cancel button (default: "Cancel")
 * @param variant - Button variant: Default or Destructive
 * @param trigger - Trigger element render callback
 *@
@fn apply(
    title: &str,
    message: &str,
    confirmLabel: &str = "Confirm",
    cancelLabel: &str = "Cancel",
    variant: Variant = Variant::Default,
    trigger: @(),
) {
    @let dialog_content = @() {
        <p class="text-sm text-muted-foreground">@message</p>
    }

    @let dialog_footer = Some(@() {
        <button
            class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-9 px-4 py-2 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground"
            @click="open = false"
        >
            @cancelLabel
        </button>
        @match variant {
            Variant::Default => {
                <button
                    class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-9 px-4 py-2 bg-primary text-primary-foreground shadow hover:bg-primary/90"
                    @click="open = false"
                >
                    @confirmLabel
                </button>
            }
            Variant::Destructive => {
                <button
                    class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-9 px-4 py-2 bg-destructive text-destructive-foreground shadow-sm hover:bg-destructive/90"
                    @click="open = false"
                >
                    @confirmLabel
                </button>
            }
        }
    })

    <@dialog::apply
        title=@title
        description=None
        trigger=@trigger
        content=@dialog_content
        footer=@dialog_footer
    />
}

@*
 * Controlled confirm dialog (external state)
 * @param openVar - Alpine.js variable name controlling open state
 * @param title - Dialog title
 * @param message - Confirmation message
 * @param confirmLabel - Label for confirm button
 * @param cancelLabel - Label for cancel button
 * @param variant - Button variant: Default or Destructive
 * @param onConfirm - JavaScript expression to execute on confirm (optional)
 *@
@fn controlled(
    openVar: &str,
    title: &str,
    message: &str,
    confirmLabel: &str = "Confirm",
    cancelLabel: &str = "Cancel",
    variant: Variant = Variant::Default,
    onConfirm: &str = "",
) {
    @let dialog_content = @() {
        <p class="text-sm text-muted-foreground">@message</p>
    }

    @let dialog_footer = Some(@() {
        <button
            class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-9 px-4 py-2 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground"
            @click="@openVar = false"
        >
            @cancelLabel
        </button>
        @match variant {
            Variant::Default => {
                <button
                    class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-9 px-4 py-2 bg-primary text-primary-foreground shadow hover:bg-primary/90"
                    @if !onConfirm.is_empty() { @click="@onConfirm; @openVar = false" }
                    @else { @click="@openVar = false" }
                >
                    @confirmLabel
                </button>
            }
            Variant::Destructive => {
                <button
                    class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring h-9 px-4 py-2 bg-destructive text-destructive-foreground shadow-sm hover:bg-destructive/90"
                    @if !onConfirm.is_empty() { @click="@onConfirm; @openVar = false" }
                    @else { @click="@openVar = false" }
                >
                    @confirmLabel
                </button>
            }
        }
    })

    <@dialog::controlled
        open_var=@openVar
        title=@title
        description=None
        content=@dialog_content
        footer=@dialog_footer
    />
}
