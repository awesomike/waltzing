@*
 * Calendar-01 block
 * A full calendar view with month grid, navigation, today highlighting, and event markers
 * Uses Alpine.js for month navigation and state management
 *
 * @example
 * @import blocks/calendar/calendar-01.wtz as calendar_view
 *
 * // Basic calendar view
 * <@calendar_view::apply />
 *
 * // Calendar with events
 * @let events = [
 *     calendar_view::Event {
 *         date: "2024-03-15",
 *         title: "Team Meeting",
 *         color: Some("bg-blue-500"),
 *     },
 *     calendar_view::Event {
 *         date: "2024-03-20",
 *         title: "Project Deadline",
 *         color: Some("bg-red-500"),
 *     },
 * ]
 *
 * <@calendar_view::apply events=@events on_date_click=Some("handleDateClick") />
 *@

@import /components/button.wtz as button
@import /components/card.wtz as card


@* Event data structure *@
@struct Event {
    date: String,
    title: String,
    color: Option<String>,
}


@*
 * Full calendar view block
 * @param events - List of events to display as dots on the calendar
 * @param on_date_click - Optional JavaScript callback when a date is clicked
 * @param show_week_numbers - Show week numbers in the left column
 * @param class - Additional CSS classes for the container
 *@
@fn apply(
    events: Vec<Event> = Vec::new(),
    on_date_click: Option<&str> = None,
    show_week_numbers: bool = false,
    class: &str = "",
) {
    @let click_handler = on_date_click.unwrap_or("null")
    @let container_cls = cn(&["w-full", class])

    @* Build events JSON for Alpine.js *@
    @let events_json = {
        let mut parts = [];
        for e in &events {
            let color = e.color.as_ref().map(|c| c.as_str()).unwrap_or("bg-primary");
            parts.push(format!("{{ date: '{}', title: '{}', color: '{}' }}", e.date, e.title, color));
        }
        format!("[{}]", parts.join(", "))
    }

    <div
        class="@container_cls"
        x-data=@```json {
            currentMonth: null,
            currentYear: null,
            today: new Date(),
            events: @safe(events_json),
            clickHandler: @click_handler,
            showWeekNumbers: @show_week_numbers,
            weekdays: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
            months: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
            days: [],

            init() {
                this.currentMonth = this.today.getMonth();
                this.currentYear = this.today.getFullYear();
                this.buildCalendar();
            },

            buildCalendar() {
                this.days = [];
                const firstDay = new Date(this.currentYear, this.currentMonth, 1);
                const lastDay = new Date(this.currentYear, this.currentMonth + 1, 0);
                const prevMonthLastDay = new Date(this.currentYear, this.currentMonth, 0);
                const startingDay = firstDay.getDay();
                const totalDays = lastDay.getDate();

                // Previous month days
                for (let i = startingDay - 1; i >= 0; i--) {
                    const day = prevMonthLastDay.getDate() - i;
                    const prevMonth = this.currentMonth === 0 ? 11 : this.currentMonth - 1;
                    const prevYear = this.currentMonth === 0 ? this.currentYear - 1 : this.currentYear;
                    const isoDate = this.formatDateWithParams(day, prevMonth, prevYear);
                    this.days.push({
                        day,
                        date: isoDate,
                        outside: true,
                        today: false,
                        events: this.getEventsForDate(isoDate)
                    });
                }

                // Current month days
                for (let day = 1; day <= totalDays; day++) {
                    const isoDate = this.formatDate(day);
                    this.days.push({
                        day,
                        date: isoDate,
                        outside: false,
                        today: this.isToday(day),
                        events: this.getEventsForDate(isoDate)
                    });
                }

                // Next month days to fill the grid
                const remainingCells = 42 - this.days.length;
                for (let i = 1; i <= remainingCells; i++) {
                    const nextMonth = this.currentMonth === 11 ? 0 : this.currentMonth + 1;
                    const nextYear = this.currentMonth === 11 ? this.currentYear + 1 : this.currentYear;
                    const isoDate = this.formatDateWithParams(i, nextMonth, nextYear);
                    this.days.push({
                        day: i,
                        date: isoDate,
                        outside: true,
                        today: false,
                        events: this.getEventsForDate(isoDate)
                    });
                }
            },

            formatDate(day) {
                return this.formatDateWithParams(day, this.currentMonth, this.currentYear);
            },

            formatDateWithParams(day, month, year) {
                const m = String(month + 1).padStart(2, '0');
                const d = String(day).padStart(2, '0');
                return year + '-' + m + '-' + d;
            },

            isToday(day) {
                return this.today.getDate() === day &&
                       this.today.getMonth() === this.currentMonth &&
                       this.today.getFullYear() === this.currentYear;
            },

            getEventsForDate(isoDate) {
                return this.events.filter(e => e.date === isoDate);
            },

            handleDateClick(day) {
                if (typeof this.clickHandler === 'function') {
                    this.clickHandler(day.date, day.events);
                }
                $dispatch('calendar-date-click', { date: day.date, events: day.events });
            },

            prevMonth() {
                if (this.currentMonth === 0) {
                    this.currentMonth = 11;
                    this.currentYear--;
                } else {
                    this.currentMonth--;
                }
                this.buildCalendar();
            },

            nextMonth() {
                if (this.currentMonth === 11) {
                    this.currentMonth = 0;
                    this.currentYear++;
                } else {
                    this.currentMonth++;
                }
                this.buildCalendar();
            },

            goToToday() {
                this.currentMonth = this.today.getMonth();
                this.currentYear = this.today.getFullYear();
                this.buildCalendar();
            },

            getWeekNumber(date) {
                const d = new Date(date);
                d.setHours(0, 0, 0, 0);
                d.setDate(d.getDate() + 4 - (d.getDay() || 7));
                const yearStart = new Date(d.getFullYear(), 0, 1);
                return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
            }
        } ```@
    >
        <@card::apply header=None footer=None class="overflow-hidden">
            @* Calendar header with navigation *@
            <div class="flex items-center justify-between border-b p-4">
                <div class="flex items-center gap-4">
                    <h2 class="text-lg font-semibold" x-text="months[currentMonth] + ' ' + currentYear"></h2>
                    <button
                        type="button"
                        @@click="goToToday()"
                        class="text-sm text-primary hover:underline"
                    >
                        Today
                    </button>
                </div>
                <div class="flex items-center gap-2">
                    <button
                        type="button"
                        @@click="prevMonth()"
                        class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring hover:bg-accent hover:text-accent-foreground h-9 w-9 border border-input bg-background"
                        aria-label="Previous month"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                    </button>
                    <button
                        type="button"
                        @@click="nextMonth()"
                        class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring hover:bg-accent hover:text-accent-foreground h-9 w-9 border border-input bg-background"
                        aria-label="Next month"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 18 6-6-6-6"/>
                        </svg>
                    </button>
                </div>
            </div>

            @* Day of week headers *@
            <div class="grid border-b" :class="showWeekNumbers ? 'grid-cols-8' : 'grid-cols-7'">
                @* Week number header *@
                <template x-if="showWeekNumbers">
                    <div class="border-r bg-muted/50 p-2 text-center text-xs font-medium text-muted-foreground">
                        Wk
                    </div>
                </template>
                <template x-for="(weekday, index) in weekdays" :key="weekday">
                    <div
                        class="p-2 text-center text-xs font-medium text-muted-foreground"
                        :class="index < weekdays.length - 1 ? 'border-r' : ''"
                        x-text="weekday"
                    ></div>
                </template>
            </div>

            @* Calendar grid *@
            <div class="grid" :class="showWeekNumbers ? 'grid-cols-8' : 'grid-cols-7'" role="grid">
                <template x-for="(day, index) in days" :key="index">
                    <template x-if="true">
                        <div class="contents">
                            @* Week number column (show at start of each week) *@
                            <template x-if="showWeekNumbers && index % 7 === 0">
                                <div class="flex items-start justify-center border-r border-b bg-muted/50 p-1 text-xs text-muted-foreground">
                                    <span x-text="getWeekNumber(day.date)"></span>
                                </div>
                            </template>
                            @* Day cell *@
                            <button
                                type="button"
                                @@click="handleDateClick(day)"
                                class="relative flex min-h-[80px] flex-col border-b p-1 text-left transition-colors hover:bg-accent/50 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring focus-visible:ring-inset"
                                :class="{
                                    'border-r': (index + 1) % 7 !== 0,
                                    'bg-muted/30': day.outside,
                                    'bg-accent/20': day.today
                                }"
                            >
                                @* Day number *@
                                <span
                                    class="inline-flex h-7 w-7 items-center justify-center rounded-full text-sm"
                                    :class="{
                                        'bg-primary text-primary-foreground font-semibold': day.today,
                                        'text-muted-foreground': day.outside && !day.today,
                                        'hover:bg-accent': !day.today
                                    }"
                                    x-text="day.day"
                                ></span>
                                @* Event dots *@
                                <div class="mt-1 flex flex-col gap-0.5 overflow-hidden">
                                    <template x-for="(event, eventIndex) in day.events.slice(0, 3)" :key="eventIndex">
                                        <div
                                            class="truncate rounded px-1 py-0.5 text-xs text-white"
                                            :class="event.color || 'bg-primary'"
                                            x-text="event.title"
                                        ></div>
                                    </template>
                                    <template x-if="day.events.length > 3">
                                        <span class="text-xs text-muted-foreground" x-text="'+' + (day.events.length - 3) + ' more'"></span>
                                    </template>
                                </div>
                            </button>
                        </div>
                    </template>
                </template>
            </div>
        </@card::apply>
    </div>
}


@*
 * Compact calendar view (smaller cells, dots only for events)
 * @param events - List of events to display as dots on the calendar
 * @param on_date_click - Optional JavaScript callback when a date is clicked
 * @param class - Additional CSS classes for the container
 *@
@fn compact(
    events: Vec<Event> = Vec::new(),
    on_date_click: Option<&str> = None,
    class: &str = "",
) {
    @let click_handler = on_date_click.unwrap_or("null")
    @let container_cls = cn(&["w-full max-w-md", class])

    @* Build events JSON for Alpine.js *@
    @let events_json = {
        let mut parts = [];
        for e in &events {
            let color = e.color.as_ref().map(|c| c.as_str()).unwrap_or("bg-primary");
            parts.push(format!("{{ date: '{}', title: '{}', color: '{}' }}", e.date, e.title, color));
        }
        format!("[{}]", parts.join(", "))
    }

    <div
        class="@container_cls"
        x-data=@```json {
            currentMonth: null,
            currentYear: null,
            today: new Date(),
            events: @safe(events_json),
            clickHandler: @click_handler,
            weekdays: ['S', 'M', 'T', 'W', 'T', 'F', 'S'],
            months: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
            days: [],

            init() {
                this.currentMonth = this.today.getMonth();
                this.currentYear = this.today.getFullYear();
                this.buildCalendar();
            },

            buildCalendar() {
                this.days = [];
                const firstDay = new Date(this.currentYear, this.currentMonth, 1);
                const lastDay = new Date(this.currentYear, this.currentMonth + 1, 0);
                const prevMonthLastDay = new Date(this.currentYear, this.currentMonth, 0);
                const startingDay = firstDay.getDay();
                const totalDays = lastDay.getDate();

                for (let i = startingDay - 1; i >= 0; i--) {
                    const day = prevMonthLastDay.getDate() - i;
                    const prevMonth = this.currentMonth === 0 ? 11 : this.currentMonth - 1;
                    const prevYear = this.currentMonth === 0 ? this.currentYear - 1 : this.currentYear;
                    const isoDate = this.formatDateWithParams(day, prevMonth, prevYear);
                    this.days.push({
                        day,
                        date: isoDate,
                        outside: true,
                        today: false,
                        hasEvents: this.hasEventsForDate(isoDate)
                    });
                }

                for (let day = 1; day <= totalDays; day++) {
                    const isoDate = this.formatDate(day);
                    this.days.push({
                        day,
                        date: isoDate,
                        outside: false,
                        today: this.isToday(day),
                        hasEvents: this.hasEventsForDate(isoDate)
                    });
                }

                const remainingCells = 42 - this.days.length;
                for (let i = 1; i <= remainingCells; i++) {
                    const nextMonth = this.currentMonth === 11 ? 0 : this.currentMonth + 1;
                    const nextYear = this.currentMonth === 11 ? this.currentYear + 1 : this.currentYear;
                    const isoDate = this.formatDateWithParams(i, nextMonth, nextYear);
                    this.days.push({
                        day: i,
                        date: isoDate,
                        outside: true,
                        today: false,
                        hasEvents: this.hasEventsForDate(isoDate)
                    });
                }
            },

            formatDate(day) {
                return this.formatDateWithParams(day, this.currentMonth, this.currentYear);
            },

            formatDateWithParams(day, month, year) {
                const m = String(month + 1).padStart(2, '0');
                const d = String(day).padStart(2, '0');
                return year + '-' + m + '-' + d;
            },

            isToday(day) {
                return this.today.getDate() === day &&
                       this.today.getMonth() === this.currentMonth &&
                       this.today.getFullYear() === this.currentYear;
            },

            hasEventsForDate(isoDate) {
                return this.events.some(e => e.date === isoDate);
            },

            getEventsForDate(isoDate) {
                return this.events.filter(e => e.date === isoDate);
            },

            handleDateClick(day) {
                const events = this.getEventsForDate(day.date);
                if (typeof this.clickHandler === 'function') {
                    this.clickHandler(day.date, events);
                }
                $dispatch('calendar-date-click', { date: day.date, events: events });
            },

            prevMonth() {
                if (this.currentMonth === 0) {
                    this.currentMonth = 11;
                    this.currentYear--;
                } else {
                    this.currentMonth--;
                }
                this.buildCalendar();
            },

            nextMonth() {
                if (this.currentMonth === 11) {
                    this.currentMonth = 0;
                    this.currentYear++;
                } else {
                    this.currentMonth++;
                }
                this.buildCalendar();
            },

            goToToday() {
                this.currentMonth = this.today.getMonth();
                this.currentYear = this.today.getFullYear();
                this.buildCalendar();
            }
        } ```@
    >
        <@card::apply header=None footer=None class="p-4">
            @* Calendar header with navigation *@
            <div class="flex items-center justify-between mb-4">
                <button
                    type="button"
                    @@click="prevMonth()"
                    class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring hover:bg-accent hover:text-accent-foreground h-8 w-8"
                    aria-label="Previous month"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                </button>

                <div class="flex items-center gap-2">
                    <span class="text-sm font-semibold" x-text="months[currentMonth] + ' ' + currentYear"></span>
                    <button
                        type="button"
                        @@click="goToToday()"
                        class="text-xs text-primary hover:underline"
                    >
                        Today
                    </button>
                </div>

                <button
                    type="button"
                    @@click="nextMonth()"
                    class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring hover:bg-accent hover:text-accent-foreground h-8 w-8"
                    aria-label="Next month"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m9 18 6-6-6-6"/>
                    </svg>
                </button>
            </div>

            @* Day of week headers *@
            <div class="grid grid-cols-7 gap-1 mb-2">
                <template x-for="weekday in weekdays" :key="weekday">
                    <div class="text-center text-xs font-medium text-muted-foreground h-8 flex items-center justify-center" x-text="weekday"></div>
                </template>
            </div>

            @* Calendar grid *@
            <div class="grid grid-cols-7 gap-1" role="grid">
                <template x-for="(day, index) in days" :key="index">
                    <button
                        type="button"
                        @@click="handleDateClick(day)"
                        class="relative h-10 w-10 flex flex-col items-center justify-center text-sm rounded-md transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                        :class="{
                            'bg-primary text-primary-foreground hover:bg-primary/90': day.today,
                            'text-muted-foreground/50': day.outside,
                            'hover:bg-accent hover:text-accent-foreground': !day.today && !day.outside
                        }"
                        :aria-current="day.today ? 'date' : null"
                    >
                        <span x-text="day.day"></span>
                        @* Event indicator dot *@
                        <span
                            x-show="day.hasEvents"
                            class="absolute bottom-1 h-1 w-1 rounded-full bg-primary"
                            :class="{ 'bg-primary-foreground': day.today }"
                        ></span>
                    </button>
                </template>
            </div>
        </@card::apply>
    </div>
}
