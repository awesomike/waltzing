@*
 * Sidebar-12 block
 * A sidebar with an embedded mini calendar and upcoming events list
 * Perfect for scheduling apps, calendaring dashboards, or any app with date-based features
 *
 * Requires: Alpine.js
 *
 * @example
 * @import blocks/sidebar/sidebar-12.wtz as sidebar
 *
 * @let nav_items = vec![
 *     sidebar::NavItem { label: "Dashboard", href: "/", icon: Some("<svg>...</svg>"), active: true },
 *     sidebar::NavItem { label: "Events", href: "/events", icon: Some("<svg>...</svg>"), active: false },
 *     sidebar::NavItem { label: "Tasks", href: "/tasks", icon: Some("<svg>...</svg>"), active: false },
 * ]
 *
 * @let events = vec![
 *     sidebar::Event { title: "Team standup", time: "9:00 AM", date: "2024-03-15" },
 *     sidebar::Event { title: "Product review", time: "2:00 PM", date: "2024-03-15" },
 * ]
 *
 * <@sidebar::apply
 *     brand=@() { <span class="font-bold">Calendar</span> }
 *     nav_items=@nav_items
 *     events=@events
 *     selected_date=Some("2024-03-15")
 * />
 *@

@import /components/calendar.wtz as calendar

@struct NavItem {
    label: String,
    href: String,
    icon: Option<String>,
    active: bool,
}

@struct Event {
    title: String,
    time: String,
    date: String,
}

@*
 * Sidebar with calendar block
 * @param brand - Brand content for the header
 * @param nav_items - Navigation items shown above the calendar
 * @param events - Upcoming events to display below the calendar
 * @param selected_date - Initially selected date in ISO format (YYYY-MM-DD)
 * @param on_date_select - Optional JS function name to call when date is selected
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn apply(
    brand: @(),
    nav_items: Vec<NavItem>,
    events: Vec<Event> = Vec::new(),
    selected_date: Option<&str> = None,
    on_date_select: Option<&str> = None,
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex flex-col w-72 border-r bg-card h-full", class])

    <aside class="@sidebar_cls">
        @* Brand header *@
        <div class="flex h-14 items-center border-b px-4">
            <div class="flex items-center gap-2">
                @brand()
            </div>
        </div>

        @* Navigation *@
        <nav class="p-3 border-b">
            <ul class="space-y-1">
                @for item in nav_items {
                    <li>
                        @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                        @let link_classes = vec![
                            "flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground",
                            active_cls
                        ]
                        <a href="@item.href" class="@cn(@link_classes)">
                            @if let Some(icon) = &item.icon {
                                <span class="h-4 w-4 flex-shrink-0">@safe(icon)</span>
                            }
                            <span>@item.label</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>

        @* Calendar section *@
        <div class="border-b">
            <@calendar::apply
                selected=@selected_date
                on_select=@on_date_select
                class="w-full"
            />
        </div>

        @* Upcoming events section *@
        <div class="flex-1 overflow-y-auto p-3">
            <h3 class="mb-3 px-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Upcoming Events
            </h3>
            @if events.is_empty() {
                <p class="px-1 text-sm text-muted-foreground">No upcoming events</p>
            } else {
                <ul class="space-y-2">
                    @for event in events {
                        <li class="rounded-md border bg-background p-3 hover:bg-accent/50 transition-colors cursor-pointer">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium truncate">@event.title</p>
                                    <p class="text-xs text-muted-foreground mt-0.5">@event.time</p>
                                </div>
                                <div class="flex-shrink-0">
                                    <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
                                        @event.date
                                    </span>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>
}

@*
 * Sidebar with calendar and add event button
 * @param brand - Brand content for the header
 * @param nav_items - Navigation items shown above the calendar
 * @param events - Upcoming events to display below the calendar
 * @param selected_date - Initially selected date in ISO format (YYYY-MM-DD)
 * @param on_date_select - Optional JS function name to call when date is selected
 * @param on_add_event - Optional JS function name to call when add event button is clicked
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn with_add_button(
    brand: @(),
    nav_items: Vec<NavItem>,
    events: Vec<Event> = Vec::new(),
    selected_date: Option<&str> = None,
    on_date_select: Option<&str> = None,
    on_add_event: Option<&str> = None,
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex flex-col w-72 border-r bg-card h-full", class])
    @let add_handler = on_add_event.unwrap_or("")

    <aside class="@sidebar_cls">
        @* Brand header with add button *@
        <div class="flex h-14 items-center justify-between border-b px-4">
            <div class="flex items-center gap-2">
                @brand()
            </div>
            <button
                type="button"
                class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring bg-primary text-primary-foreground hover:bg-primary/90 h-8 w-8"
                @if !add_handler.is_empty() {
                    @@click="@add_handler()"
                }
                aria-label="Add event"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"/>
                    <path d="M12 5v14"/>
                </svg>
            </button>
        </div>

        @* Navigation *@
        <nav class="p-3 border-b">
            <ul class="space-y-1">
                @for item in nav_items {
                    <li>
                        @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                        @let link_classes = vec![
                            "flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground",
                            active_cls
                        ]
                        <a href="@item.href" class="@cn(@link_classes)">
                            @if let Some(icon) = &item.icon {
                                <span class="h-4 w-4 flex-shrink-0">@safe(icon)</span>
                            }
                            <span>@item.label</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>

        @* Calendar section *@
        <div class="border-b">
            <@calendar::apply
                selected=@selected_date
                on_select=@on_date_select
                class="w-full"
            />
        </div>

        @* Upcoming events section *@
        <div class="flex-1 overflow-y-auto p-3">
            <div class="flex items-center justify-between mb-3">
                <h3 class="px-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    Upcoming Events
                </h3>
                <span class="text-xs text-muted-foreground">@(events.len()) total</span>
            </div>
            @if events.is_empty() {
                <div class="rounded-md border border-dashed p-4 text-center">
                    <p class="text-sm text-muted-foreground">No upcoming events</p>
                    <button
                        type="button"
                        class="mt-2 text-sm text-primary hover:underline"
                        @if !add_handler.is_empty() {
                            @@click="@add_handler()"
                        }
                    >
                        Create your first event
                    </button>
                </div>
            } else {
                <ul class="space-y-2">
                    @for event in events {
                        <li class="rounded-md border bg-background p-3 hover:bg-accent/50 transition-colors cursor-pointer">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium truncate">@event.title</p>
                                    <p class="text-xs text-muted-foreground mt-0.5">@event.time</p>
                                </div>
                                <div class="flex-shrink-0">
                                    <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
                                        @event.date
                                    </span>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>
}

@*
 * Mini calendar sidebar (calendar only, no navigation)
 * Compact variant focused on the calendar with events
 * @param events - Upcoming events to display below the calendar
 * @param selected_date - Initially selected date in ISO format (YYYY-MM-DD)
 * @param on_date_select - Optional JS function name to call when date is selected
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn mini(
    events: Vec<Event> = Vec::new(),
    selected_date: Option<&str> = None,
    on_date_select: Option<&str> = None,
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex flex-col w-64 border-r bg-card h-full", class])

    <aside class="@sidebar_cls">
        @* Calendar section *@
        <div class="border-b">
            <@calendar::apply
                selected=@selected_date
                on_select=@on_date_select
                class="w-full"
            />
        </div>

        @* Upcoming events section *@
        <div class="flex-1 overflow-y-auto p-3">
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Upcoming
            </h3>
            @if events.is_empty() {
                <p class="text-sm text-muted-foreground">No events</p>
            } else {
                <ul class="space-y-2">
                    @for event in events {
                        <li class="group flex items-start gap-3 p-2 rounded-md hover:bg-accent/50 transition-colors cursor-pointer">
                            @* Time indicator *@
                            <div class="flex-shrink-0 w-1 h-full rounded-full bg-primary"></div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium truncate">@event.title</p>
                                <p class="text-xs text-muted-foreground">@event.time</p>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>
}
