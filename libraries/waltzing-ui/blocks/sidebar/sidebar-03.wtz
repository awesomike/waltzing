@*
 * Sidebar-03 block
 * A sidebar with nested submenus that expand/collapse on click
 * Supports multiple levels of nesting with proper indentation
 *
 * Requires: Alpine.js with @alpinejs/collapse plugin
 *
 * @example
 * @import blocks/sidebar/sidebar-03.wtz as sidebar
 *
 * @let nav_items = [
 *     sidebar::NavItem {
 *         label: "Dashboard",
 *         href: Some("/"),
 *         icon: Some("<svg>...</svg>"),
 *         active: true,
 *         children: [],
 *     },
 *     sidebar::NavItem {
 *         label: "Products",
 *         href: None,
 *         icon: Some("<svg>...</svg>"),
 *         active: false,
 *         children: [
 *             sidebar::NavItem {
 *                 label: "All Products",
 *                 href: Some("/products"),
 *                 icon: None,
 *                 active: false,
 *                 children: [],
 *             },
 *             sidebar::NavItem {
 *                 label: "Categories",
 *                 href: None,
 *                 icon: None,
 *                 active: false,
 *                 children: [
 *                     sidebar::NavItem {
 *                         label: "Electronics",
 *                         href: Some("/products/electronics"),
 *                         icon: None,
 *                         active: false,
 *                         children: [],
 *                     },
 *                 ],
 *             },
 *         ],
 *     },
 * ]
 *
 * <@sidebar::apply
 *     brand=@() { <span class="font-bold text-lg">My App</span> }
 *     nav_items=@nav_items
 * />
 *@

@* Recursive navigation item with optional children *@
@struct NavItem {
    label: String,
    href: Option<String>,
    icon: Option<String>,
    active: bool,
    children: Vec<NavItem>,
}

@struct NavGroup {
    label: Option<String>,
    items: Vec<NavItem>,
}

@*
 * Render a single navigation item (recursive for children)
 * @param item - The navigation item to render
 * @param depth - Current nesting depth (0 = top level)
 *@
@fn nav_item(item: &NavItem, depth: u32) {
    @let has_children = !item.children.is_empty()
    @let indent_class = match depth {
        0 => "",
        1 => "pl-4",
        2 => "pl-8",
        _ => "pl-12",
    }
    @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
    @let item_classes = cn(&[
        "flex items-center justify-between rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground cursor-pointer",
        indent_class,
        active_cls
    ])

    <li
        x-data="{ open: false }"
        class="relative"
    >
        @if has_children {
            @* Parent item with children - clickable to expand *@
            <button
                @click="open = !open"
                class="@item_classes w-full text-left"
                :aria-expanded="open"
            >
                <span class="flex items-center gap-3">
                    @if let Some(icon) = &item.icon {
                        <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                    }
                    <span class="truncate">@item.label</span>
                </span>
                @* Chevron indicator *@
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-4 w-4 flex-shrink-0 transition-transform duration-200"
                    :class="open ? 'rotate-90' : ''"
                >
                    <path d="m9 18 6-6-6-6"/>
                </svg>
            </button>
            @* Submenu *@
            <ul
                x-show="open"
                x-collapse
                class="mt-1 space-y-1"
            >
                @for child in &item.children {
                    @let child_depth = (depth + 1)
                    <@nav_item item=@child depth=@child_depth />
                }
            </ul>
        } else {
            @* Leaf item - link *@
            @let href = item.href.as_deref().unwrap_or("#")
            <a
                href=@href
                class="@item_classes block"
            >
                <span class="flex items-center gap-3">
                    @if let Some(icon) = &item.icon {
                        <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                    }
                    <span class="truncate">@item.label</span>
                </span>
            </a>
        }
    </li>
}

@*
 * Sidebar with nested submenus
 * @param brand - Brand/logo content
 * @param nav_items - Top-level navigation items (can have nested children)
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn apply(
    brand: @(),
    nav_items: Vec<NavItem>,
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex h-full w-64 flex-col border-r bg-card", class])

    <aside class=@sidebar_cls>
        @* Brand area *@
        <div class="flex h-16 items-center border-b px-4">
            @brand()
        </div>

        @* Navigation *@
        <nav class="flex-1 overflow-y-auto p-2">
            <ul class="space-y-1">
                @for item in nav_items {
                    <@nav_item item=@item depth=0 />
                }
            </ul>
        </nav>
    </aside>
}

@*
 * Sidebar with grouped navigation and submenus
 * @param brand - Brand/logo content
 * @param nav_groups - Navigation groups, each containing items with potential children
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn grouped(
    brand: @(),
    nav_groups: Vec<NavGroup>,
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex h-full w-64 flex-col border-r bg-card", class])

    <aside class=@sidebar_cls>
        @* Brand area *@
        <div class="flex h-16 items-center border-b px-4">
            @brand()
        </div>

        @* Navigation *@
        <nav class="flex-1 overflow-y-auto p-2">
            @for group in nav_groups {
                <div class="mb-4">
                    @if let Some(label) = &group.label {
                        <h3 class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                            @label
                        </h3>
                    }
                    <ul class="space-y-1">
                        @for item in &group.items {
                            <@nav_item item=@item depth=0 />
                        }
                    </ul>
                </div>
            }
        </nav>
    </aside>
}

@*
 * Sidebar with footer content and nested submenus
 * @param brand - Brand/logo content
 * @param nav_items - Top-level navigation items (can have nested children)
 * @param footer - Footer content at the bottom
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn with_footer(
    brand: @(),
    nav_items: Vec<NavItem>,
    footer: @(),
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex h-full w-64 flex-col border-r bg-card", class])

    <aside class=@sidebar_cls>
        @* Brand area *@
        <div class="flex h-16 items-center border-b px-4">
            @brand()
        </div>

        @* Navigation *@
        <nav class="flex-1 overflow-y-auto p-2">
            <ul class="space-y-1">
                @for item in nav_items {
                    <@nav_item item=@item depth=0 />
                }
            </ul>
        </nav>

        @* Footer *@
        <div class="border-t p-4">
            @footer()
        </div>
    </aside>
}
