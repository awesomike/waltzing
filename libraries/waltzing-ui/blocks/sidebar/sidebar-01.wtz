@*
 * Sidebar-01 block
 * Simple grouped navigation sidebar
 * The simplest sidebar variant: grouped navigation with icons and active state
 * No collapsing, no submenus - just straightforward grouped links
 *
 * @example
 * @import blocks/sidebar/sidebar-01.wtz as sidebar
 *
 * @let nav_groups = [
 *     sidebar::NavGroup {
 *         label: Some("Main"),
 *         items: vec![
 *             sidebar::NavItem { label: "Dashboard", href: "/", icon: Some("<svg>...</svg>"), active: true },
 *             sidebar::NavItem { label: "Projects", href: "/projects", icon: Some("<svg>...</svg>"), active: false },
 *         ],
 *     },
 *     sidebar::NavGroup {
 *         label: Some("Settings"),
 *         items: vec![
 *             sidebar::NavItem { label: "Account", href: "/account", icon: Some("<svg>...</svg>"), active: false },
 *             sidebar::NavItem { label: "Preferences", href: "/preferences", icon: Some("<svg>...</svg>"), active: false },
 *         ],
 *     },
 * ]
 *
 * <@sidebar::apply
 *     brand=@() { <span class="font-bold text-lg">My App</span> }
 *     nav_groups=@nav_groups
 * />
 *@

@struct NavItem {
    label: String,
    href: String,
    icon: Option<String>,
    active: bool,
}

@struct NavGroup {
    label: Option<String>,
    items: Vec<NavItem>,
}

@*
 * Simple grouped navigation sidebar
 * @param brand - Brand/logo content for the header
 * @param nav_groups - Navigation groups with items
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn apply(
    brand: @(),
    nav_groups: Vec<NavGroup>,
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex h-full w-64 flex-col border-r bg-card", class])

    <aside class=@sidebar_cls>
        @* Brand header *@
        <div class="flex h-16 items-center border-b px-4">
            @brand()
        </div>

        @* Navigation *@
        <nav class="flex-1 overflow-y-auto p-4">
            @for group in nav_groups {
                <div class="mb-6">
                    @* Group label *@
                    @if let Some(label) = &group.label {
                        <h3 class="mb-2 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                            @label
                        </h3>
                    }
                    @* Navigation items *@
                    <ul class="space-y-1">
                        @for item in &group.items {
                            <li>
                                @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                @let link_classes = [
                                    "flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground",
                                    active_cls
                                ]
                                <a href=@item.href class=@cn(link_classes)>
                                    @* Icon *@
                                    @if let Some(icon) = &item.icon {
                                        <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                    }
                                    @* Label *@
                                    <span>@item.label</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>
    </aside>
}

@*
 * Simple sidebar with footer content
 * @param brand - Brand/logo content for the header
 * @param nav_groups - Navigation groups with items
 * @param footer - Footer content (e.g., user profile, logout button)
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn with_footer(
    brand: @(),
    nav_groups: Vec<NavGroup>,
    footer: @(),
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex h-full w-64 flex-col border-r bg-card", class])

    <aside class=@sidebar_cls>
        @* Brand header *@
        <div class="flex h-16 items-center border-b px-4">
            @brand()
        </div>

        @* Navigation *@
        <nav class="flex-1 overflow-y-auto p-4">
            @for group in nav_groups {
                <div class="mb-6">
                    @if let Some(label) = &group.label {
                        <h3 class="mb-2 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                            @label
                        </h3>
                    }
                    <ul class="space-y-1">
                        @for item in &group.items {
                            <li>
                                @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                @let link_classes = [
                                    "flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground",
                                    active_cls
                                ]
                                <a href=@item.href class=@cn(link_classes)>
                                    @if let Some(icon) = &item.icon {
                                        <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                    }
                                    <span>@item.label</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>

        @* Footer *@
        <div class="border-t p-4">
            @footer()
        </div>
    </aside>
}
