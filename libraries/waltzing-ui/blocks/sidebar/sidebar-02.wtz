@*
 * Sidebar-02 block
 * A sidebar with collapsible sections that expand/collapse with smooth animations
 * Uses Alpine.js x-collapse plugin for animations and localStorage for state persistence
 *
 * Requires: Alpine.js with @alpinejs/collapse plugin
 *
 * @example
 * @import blocks/sidebar/sidebar-02.wtz as sidebar
 *
 * @let sections = [
 *     sidebar::Section {
 *         id: "main",
 *         label: "Main",
 *         icon: Some("<svg>...</svg>"),
 *         collapsed: false,
 *         items: vec![
 *             sidebar::NavItem { label: "Dashboard", href: "/", icon: Some("<svg>...</svg>"), active: true },
 *             sidebar::NavItem { label: "Projects", href: "/projects", icon: None, active: false },
 *         ],
 *     },
 *     sidebar::Section {
 *         id: "settings",
 *         label: "Settings",
 *         icon: None,
 *         collapsed: true,
 *         items: vec![
 *             sidebar::NavItem { label: "Profile", href: "/settings/profile", icon: None, active: false },
 *             sidebar::NavItem { label: "Security", href: "/settings/security", icon: None, active: false },
 *         ],
 *     },
 * ]
 *
 * <@sidebar::apply
 *     brand=@() { <span class="font-bold text-lg">MyApp</span> }
 *     sections=@sections
 *     persist_key="sidebar-sections"
 * />
 *@

@struct NavItem {
    label: String,
    href: String,
    icon: Option<String>,
    active: bool,
}

@struct Section {
    id: String,
    label: String,
    icon: Option<String>,
    collapsed: bool,
    items: Vec<NavItem>,
}

@*
 * Sidebar with collapsible sections
 * @param brand - Brand content for the header
 * @param sections - List of collapsible sections with nav items
 * @param persist_key - Optional localStorage key to persist collapsed state (default: None)
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn apply(
    brand: @(),
    sections: Vec<Section>,
    persist_key: Option<&str> = None,
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex h-full w-64 flex-col border-r bg-card", class])
    @let storage_key = persist_key.unwrap_or("")
    @let use_storage = persist_key.is_some()

    <aside class="@sidebar_cls">
        @* Brand header *@
        <div class="flex h-16 items-center border-b px-4">
            @brand()
        </div>

        @* Scrollable navigation with sections *@
        <nav class="flex-1 overflow-y-auto p-2">
            @for section in sections {
                @let section_id = &section.id
                @let initial_collapsed = if section.collapsed { "true" } else { "false" }

                <div
                    x-data="{
                        collapsed: @if use_storage {
                            localStorage.getItem('@(storage_key)_@section_id') === 'true' || (@initial_collapsed && localStorage.getItem('@(storage_key)_@section_id') === null)
                        } else {
                            @initial_collapsed
                        },
                        toggle() {
                            this.collapsed = !this.collapsed;
                            @if use_storage {
                                localStorage.setItem('@(storage_key)_@section_id', this.collapsed);
                            }
                        }
                    }"
                    class="mb-2"
                >
                    @* Section header (clickable to expand/collapse) *@
                    <button
                        @click="toggle()"
                        class="flex w-full items-center justify-between rounded-md px-3 py-2 text-sm font-semibold text-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                        :aria-expanded="!collapsed"
                    >
                        <span class="flex items-center gap-2">
                            @if let Some(icon) = &section.icon {
                                <span class="h-4 w-4 flex-shrink-0 text-muted-foreground">@safe(icon)</span>
                            }
                            <span>@section.label</span>
                        </span>
                        @* Chevron icon that rotates *@
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="h-4 w-4 text-muted-foreground transition-transform duration-200"
                            :class="collapsed ? '-rotate-90' : 'rotate-0'"
                        >
                            <path d="m6 9 6 6 6-6"/>
                        </svg>
                    </button>

                    @* Collapsible content with x-collapse for smooth animation *@
                    <div x-show="!collapsed" x-collapse>
                        <ul class="mt-1 space-y-1 pl-2">
                            @for item in &section.items {
                                <li>
                                    @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                    @let link_classes = [
                                        "flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground",
                                        active_cls
                                    ]
                                    <a href="@item.href" class="@cn(@link_classes)">
                                        @if let Some(icon) = &item.icon {
                                            <span class="h-4 w-4 flex-shrink-0">@safe(icon)</span>
                                        }
                                        <span>@item.label</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </nav>
    </aside>
}

@*
 * Sidebar with collapsible sections and footer
 * @param brand - Brand content for the header
 * @param sections - List of collapsible sections with nav items
 * @param footer - Footer content below the navigation
 * @param persist_key - Optional localStorage key to persist collapsed state (default: None)
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn with_footer(
    brand: @(),
    sections: Vec<Section>,
    footer: @(),
    persist_key: Option<&str> = None,
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex h-full w-64 flex-col border-r bg-card", class])
    @let storage_key = persist_key.unwrap_or("")
    @let use_storage = persist_key.is_some()

    <aside class="@sidebar_cls">
        @* Brand header *@
        <div class="flex h-16 items-center border-b px-4">
            @brand()
        </div>

        @* Scrollable navigation with sections *@
        <nav class="flex-1 overflow-y-auto p-2">
            @for section in sections {
                @let section_id = &section.id
                @let initial_collapsed = if section.collapsed { "true" } else { "false" }

                <div
                    x-data="{
                        collapsed: @if use_storage {
                            localStorage.getItem('@(storage_key)_@section_id') === 'true' || (@initial_collapsed && localStorage.getItem('@(storage_key)_@section_id') === null)
                        } else {
                            @initial_collapsed
                        },
                        toggle() {
                            this.collapsed = !this.collapsed;
                            @if use_storage {
                                localStorage.setItem('@(storage_key)_@section_id', this.collapsed);
                            }
                        }
                    }"
                    class="mb-2"
                >
                    @* Section header *@
                    <button
                        @click="toggle()"
                        class="flex w-full items-center justify-between rounded-md px-3 py-2 text-sm font-semibold text-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                        :aria-expanded="!collapsed"
                    >
                        <span class="flex items-center gap-2">
                            @if let Some(icon) = &section.icon {
                                <span class="h-4 w-4 flex-shrink-0 text-muted-foreground">@safe(icon)</span>
                            }
                            <span>@section.label</span>
                        </span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="h-4 w-4 text-muted-foreground transition-transform duration-200"
                            :class="collapsed ? '-rotate-90' : 'rotate-0'"
                        >
                            <path d="m6 9 6 6 6-6"/>
                        </svg>
                    </button>

                    <div x-show="!collapsed" x-collapse>
                        <ul class="mt-1 space-y-1 pl-2">
                            @for item in &section.items {
                                <li>
                                    @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                    @let link_classes = [
                                        "flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground",
                                        active_cls
                                    ]
                                    <a href="@item.href" class="@cn(@link_classes)">
                                        @if let Some(icon) = &item.icon {
                                            <span class="h-4 w-4 flex-shrink-0">@safe(icon)</span>
                                        }
                                        <span>@item.label</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </nav>

        @* Footer *@
        <div class="border-t p-4">
            @footer()
        </div>
    </aside>
}

@*
 * Expand/collapse all sections control
 * Place this inside a parent with x-data that has a method to control all sections
 *@
@fn expand_collapse_all() {
    <div class="flex items-center justify-between px-3 py-2 text-xs text-muted-foreground">
        <span class="font-medium uppercase tracking-wider">Navigation</span>
        <div class="flex gap-1">
            <button
                @click="$dispatch('expand-all-sections')"
                class="rounded p-1 hover:bg-accent hover:text-accent-foreground transition-colors"
                title="Expand all"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m7 20 5-5 5 5"/>
                    <path d="m7 4 5 5 5-5"/>
                </svg>
            </button>
            <button
                @click="$dispatch('collapse-all-sections')"
                class="rounded p-1 hover:bg-accent hover:text-accent-foreground transition-colors"
                title="Collapse all"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m7 15 5-5 5 5"/>
                    <path d="m7 9 5 5 5-5"/>
                </svg>
            </button>
        </div>
    </div>
}
