@*
 * Sidebar-07 block
 * A collapsible sidebar that shrinks to icons only
 * Popular pattern for dashboards - full navigation when expanded, icon-only when collapsed
 *
 * Requires: Alpine.js
 *
 * @example
 * @import blocks/sidebar/sidebar-07.wtz as sidebar
 *
 * @let nav_groups = vec![
 *     sidebar::NavGroup {
 *         label: Some("Main"),
 *         items: vec![
 *             sidebar::NavItem { label: "Dashboard", href: "/", icon: Some("<svg>...</svg>"), active: true },
 *             sidebar::NavItem { label: "Projects", href: "/projects", icon: Some("<svg>...</svg>"), active: false },
 *         ],
 *     },
 * ]
 *
 * <@sidebar::apply
 *     brand=@() { <span class="font-bold">Logo</span> }
 *     brand_icon=@() { <span>L</span> }
 *     nav_groups=@nav_groups
 * />
 *@

@struct NavItem {
    label: String,
    href: String,
    icon: Option<String>,
    active: bool,
}

@struct NavGroup {
    label: Option<String>,
    items: Vec<NavItem>,
}

@*
 * Collapsible sidebar block
 * @param brand - Full brand content shown when expanded
 * @param brand_icon - Icon/abbreviated brand shown when collapsed
 * @param nav_groups - Navigation groups with items
 * @param collapsed - Initial collapsed state (default: false)
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn apply(
    brand: @(),
    brand_icon: @(),
    nav_groups: Vec<NavGroup>,
    collapsed: bool = false,
    class: &str = "",
) {
    @let initial_state = if collapsed { "true" } else { "false" }
    @let sidebar_cls = cn(&["flex flex-col border-r bg-card transition-all duration-300 ease-in-out", class])

    <aside
        x-data="{ collapsed: @initial_state }"
        :class="collapsed ? 'w-16' : 'w-64'"
        class="@sidebar_cls"
    >
        @* Brand area *@
        <div class="flex h-16 items-center border-b px-4">
            @* Full brand - shown when expanded *@
            <div
                x-show="!collapsed"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="overflow-hidden whitespace-nowrap"
            >
                @brand()
            </div>
            @* Icon brand - shown when collapsed *@
            <div
                x-show="collapsed"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="flex w-full justify-center"
            >
                @brand_icon()
            </div>
        </div>

        @* Navigation *@
        <nav class="flex-1 overflow-y-auto p-2">
            @for group in nav_groups {
                <div class="mb-4">
                    @* Group label - only shown when expanded *@
                    @if let Some(label) = &group.label {
                        <h3
                            x-show="!collapsed"
                            x-transition:enter="transition ease-out duration-200"
                            x-transition:enter-start="opacity-0"
                            x-transition:enter-end="opacity-100"
                            class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                        >
                            @label
                        </h3>
                    }
                    <ul class="space-y-1">
                        @for item in &group.items {
                            <li class="relative group/item">
                                @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                @let link_classes = vec![
                                    "flex items-center rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground",
                                    active_cls
                                ]
                                <a
                                    href="@item.href"
                                    class="@cn(@link_classes)"
                                    :class="collapsed ? 'justify-center' : 'gap-3'"
                                >
                                    @* Icon *@
                                    @if let Some(icon) = &item.icon {
                                        <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                    }
                                    @* Label - hidden when collapsed *@
                                    <span
                                        x-show="!collapsed"
                                        x-transition:enter="transition ease-out duration-200"
                                        x-transition:enter-start="opacity-0"
                                        x-transition:enter-end="opacity-100"
                                        x-transition:leave="transition ease-in duration-150"
                                        x-transition:leave-start="opacity-100"
                                        x-transition:leave-end="opacity-0"
                                        class="truncate"
                                    >
                                        @item.label
                                    </span>
                                </a>
                                @* Tooltip - shown on hover when collapsed *@
                                <div
                                    x-show="collapsed"
                                    class="absolute left-full top-1/2 z-50 ml-2 -translate-y-1/2 rounded-md bg-popover px-2 py-1 text-sm text-popover-foreground shadow-md opacity-0 pointer-events-none group-hover/item:opacity-100 transition-opacity duration-200 whitespace-nowrap"
                                >
                                    @item.label
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>

        @* Collapse toggle button *@
        <div class="border-t p-2">
            <button
                @click="collapsed = !collapsed"
                class="flex w-full items-center justify-center rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                :aria-label="collapsed ? 'Expand sidebar' : 'Collapse sidebar'"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform duration-300"
                    :class="collapsed ? 'rotate-180' : ''"
                >
                    <path d="m15 18-6-6 6-6"/>
                </svg>
            </button>
        </div>
    </aside>
}

@*
 * Collapsible sidebar with footer content
 * @param brand - Full brand content shown when expanded
 * @param brand_icon - Icon/abbreviated brand shown when collapsed
 * @param nav_groups - Navigation groups with items
 * @param footer - Footer content above the collapse toggle
 * @param collapsed - Initial collapsed state (default: false)
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn with_footer(
    brand: @(),
    brand_icon: @(),
    nav_groups: Vec<NavGroup>,
    footer: @(),
    collapsed: bool = false,
    class: &str = "",
) {
    @let initial_state = if collapsed { "true" } else { "false" }
    @let sidebar_cls = cn(&["flex flex-col border-r bg-card transition-all duration-300 ease-in-out", class])

    <aside
        x-data="{ collapsed: @initial_state }"
        :class="collapsed ? 'w-16' : 'w-64'"
        class="@sidebar_cls"
    >
        @* Brand area *@
        <div class="flex h-16 items-center border-b px-4">
            <div
                x-show="!collapsed"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="overflow-hidden whitespace-nowrap"
            >
                @brand()
            </div>
            <div
                x-show="collapsed"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="flex w-full justify-center"
            >
                @brand_icon()
            </div>
        </div>

        @* Navigation *@
        <nav class="flex-1 overflow-y-auto p-2">
            @for group in nav_groups {
                <div class="mb-4">
                    @if let Some(label) = &group.label {
                        <h3
                            x-show="!collapsed"
                            x-transition:enter="transition ease-out duration-200"
                            x-transition:enter-start="opacity-0"
                            x-transition:enter-end="opacity-100"
                            class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                        >
                            @label
                        </h3>
                    }
                    <ul class="space-y-1">
                        @for item in &group.items {
                            <li class="relative group/item">
                                @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                @let link_classes = vec![
                                    "flex items-center rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground",
                                    active_cls
                                ]
                                <a
                                    href="@item.href"
                                    class="@cn(@link_classes)"
                                    :class="collapsed ? 'justify-center' : 'gap-3'"
                                >
                                    @if let Some(icon) = &item.icon {
                                        <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                    }
                                    <span
                                        x-show="!collapsed"
                                        x-transition:enter="transition ease-out duration-200"
                                        x-transition:enter-start="opacity-0"
                                        x-transition:enter-end="opacity-100"
                                        x-transition:leave="transition ease-in duration-150"
                                        x-transition:leave-start="opacity-100"
                                        x-transition:leave-end="opacity-0"
                                        class="truncate"
                                    >
                                        @item.label
                                    </span>
                                </a>
                                <div
                                    x-show="collapsed"
                                    class="absolute left-full top-1/2 z-50 ml-2 -translate-y-1/2 rounded-md bg-popover px-2 py-1 text-sm text-popover-foreground shadow-md opacity-0 pointer-events-none group-hover/item:opacity-100 transition-opacity duration-200 whitespace-nowrap"
                                >
                                    @item.label
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>

        @* Footer content *@
        <div
            x-show="!collapsed"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="border-t p-4"
        >
            @footer()
        </div>

        @* Collapse toggle button *@
        <div class="border-t p-2">
            <button
                @click="collapsed = !collapsed"
                class="flex w-full items-center justify-center rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                :aria-label="collapsed ? 'Expand sidebar' : 'Collapse sidebar'"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform duration-300"
                    :class="collapsed ? 'rotate-180' : ''"
                >
                    <path d="m15 18-6-6 6-6"/>
                </svg>
            </button>
        </div>
    </aside>
}

@*
 * Controlled collapsible sidebar (external state)
 * Use this when you need to control the collapsed state from a parent component
 * @param collapsed_var - Alpine.js variable name for collapsed state
 * @param brand - Full brand content shown when expanded
 * @param brand_icon - Icon/abbreviated brand shown when collapsed
 * @param nav_groups - Navigation groups with items
 * @param class - Additional CSS classes for the sidebar container
 *@
@fn controlled(
    collapsed_var: &str,
    brand: @(),
    brand_icon: @(),
    nav_groups: Vec<NavGroup>,
    class: &str = "",
) {
    @let sidebar_cls = cn(&["flex flex-col border-r bg-card transition-all duration-300 ease-in-out", class])

    <aside
        :class="@collapsed_var ? 'w-16' : 'w-64'"
        class="@sidebar_cls"
    >
        @* Brand area *@
        <div class="flex h-16 items-center border-b px-4">
            <div
                x-show="!@collapsed_var"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="overflow-hidden whitespace-nowrap"
            >
                @brand()
            </div>
            <div
                x-show="@collapsed_var"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="flex w-full justify-center"
            >
                @brand_icon()
            </div>
        </div>

        @* Navigation *@
        <nav class="flex-1 overflow-y-auto p-2">
            @for group in nav_groups {
                <div class="mb-4">
                    @if let Some(label) = &group.label {
                        <h3
                            x-show="!@collapsed_var"
                            x-transition:enter="transition ease-out duration-200"
                            x-transition:enter-start="opacity-0"
                            x-transition:enter-end="opacity-100"
                            class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                        >
                            @label
                        </h3>
                    }
                    <ul class="space-y-1">
                        @for item in &group.items {
                            <li class="relative group/item">
                                @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                @let link_classes = vec![
                                    "flex items-center rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground",
                                    active_cls
                                ]
                                <a
                                    href="@item.href"
                                    class="@cn(@link_classes)"
                                    :class="@collapsed_var ? 'justify-center' : 'gap-3'"
                                >
                                    @if let Some(icon) = &item.icon {
                                        <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                    }
                                    <span
                                        x-show="!@collapsed_var"
                                        x-transition:enter="transition ease-out duration-200"
                                        x-transition:enter-start="opacity-0"
                                        x-transition:enter-end="opacity-100"
                                        x-transition:leave="transition ease-in duration-150"
                                        x-transition:leave-start="opacity-100"
                                        x-transition:leave-end="opacity-0"
                                        class="truncate"
                                    >
                                        @item.label
                                    </span>
                                </a>
                                <div
                                    x-show="@collapsed_var"
                                    class="absolute left-full top-1/2 z-50 ml-2 -translate-y-1/2 rounded-md bg-popover px-2 py-1 text-sm text-popover-foreground shadow-md opacity-0 pointer-events-none group-hover/item:opacity-100 transition-opacity duration-200 whitespace-nowrap"
                                >
                                    @item.label
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>

        @* Collapse toggle button *@
        <div class="border-t p-2">
            <button
                @click="@collapsed_var = !@collapsed_var"
                class="flex w-full items-center justify-center rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                :aria-label="@collapsed_var ? 'Expand sidebar' : 'Collapse sidebar'"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform duration-300"
                    :class="@collapsed_var ? 'rotate-180' : ''"
                >
                    <path d="m15 18-6-6 6-6"/>
                </svg>
            </button>
        </div>
    </aside>
}
