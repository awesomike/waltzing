@*
 * Sidebar-15 block
 * A dual-sidebar layout with both left and right sidebars
 * Left sidebar for main navigation, right sidebar for contextual info (TOC, related items, etc.)
 * Both sidebars are independently collapsible
 *
 * Requires: Alpine.js
 *
 * @example
 * @import blocks/sidebar/sidebar-15.wtz as sidebar15
 *
 * @let nav_groups = [
 *     sidebar15::NavGroup {
 *         label: Some("Main"),
 *         items: [
 *             sidebar15::NavItem { label: "Dashboard", href: "/", icon: Some("<svg>...</svg>"), active: true },
 *             sidebar15::NavItem { label: "Projects", href: "/projects", icon: Some("<svg>...</svg>"), active: false },
 *         ],
 *     },
 * ]
 *
 * @let toc_items = [
 *     sidebar15::TocItem { label: "Introduction", href: "#intro", level: 1 },
 *     sidebar15::TocItem { label: "Getting Started", href: "#getting-started", level: 2 },
 * ]
 *
 * <@sidebar15::apply
 *     brand=@() { <span class="font-bold">Logo</span> }
 *     brand_icon=@() { <span>L</span> }
 *     nav_groups=@nav_groups
 *     right_title="On this page"
 *     toc_items=@toc_items
 *     content=@() { <div>Main content here</div> }
 * />
 *@

@struct NavItem {
    label: String,
    href: String,
    icon: Option<String>,
    active: bool,
}

@struct NavGroup {
    label: Option<String>,
    items: Vec<NavItem>,
}

@struct TocItem {
    label: String,
    href: String,
    level: u8,
}

@*
 * Dual-sidebar layout block
 * @param brand - Full brand content shown when left sidebar expanded
 * @param brand_icon - Icon/abbreviated brand shown when left sidebar collapsed
 * @param nav_groups - Navigation groups with items for left sidebar
 * @param right_title - Title for the right sidebar section
 * @param toc_items - Table of contents items for right sidebar
 * @param content - Main content render callback
 * @param left_collapsed - Initial collapsed state for left sidebar (default: false)
 * @param right_collapsed - Initial collapsed state for right sidebar (default: false)
 * @param class - Additional CSS classes for the outer container
 *@
@fn apply(
    brand: @(),
    brand_icon: @(),
    nav_groups: Vec<NavGroup>,
    right_title: &str,
    toc_items: Vec<TocItem>,
    content: @(),
    left_collapsed: bool = false,
    right_collapsed: bool = false,
    class: &str = "",
) {
    @let left_initial = if left_collapsed { "true" } else { "false" }
    @let right_initial = if right_collapsed { "true" } else { "false" }
    @let container_cls = cn(&["flex h-screen overflow-hidden bg-background", class])

    <div
        x-data="{
            leftCollapsed: @left_initial,
            rightCollapsed: @right_initial
        }"
        class=@container_cls
    >
        @* Left Sidebar *@
        <aside
            :class="leftCollapsed ? 'w-16' : 'w-64'"
            class="flex flex-col border-r bg-card transition-all duration-300 ease-in-out"
        >
            @* Brand area *@
            <div class="flex h-14 items-center border-b px-4">
                @* Full brand - shown when expanded *@
                <div
                    x-show="!leftCollapsed"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="overflow-hidden whitespace-nowrap"
                >
                    @brand()
                </div>
                @* Icon brand - shown when collapsed *@
                <div
                    x-show="leftCollapsed"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="flex w-full justify-center"
                >
                    @brand_icon()
                </div>
            </div>

            @* Navigation *@
            <nav class="flex-1 overflow-y-auto p-2">
                @for group in nav_groups {
                    <div class="mb-4">
                        @* Group label - only shown when expanded *@
                        @if let Some(label) = &group.label {
                            <h3
                                x-show="!leftCollapsed"
                                x-transition:enter="transition ease-out duration-200"
                                x-transition:enter-start="opacity-0"
                                x-transition:enter-end="opacity-100"
                                class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                            >
                                @label
                            </h3>
                        }
                        <ul class="space-y-1">
                            @for item in &group.items {
                                <li class="relative group/item">
                                    @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                    @let link_classes = ["flex items-center rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground", active_cls]
                                    <a
                                        href=@item.href
                                        class=@cn(link_classes)
                                        :class="leftCollapsed ? 'justify-center' : 'gap-3'"
                                    >
                                        @* Icon *@
                                        @if let Some(icon) = &item.icon {
                                            <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                        }
                                        @* Label - hidden when collapsed *@
                                        <span
                                            x-show="!leftCollapsed"
                                            x-transition:enter="transition ease-out duration-200"
                                            x-transition:enter-start="opacity-0"
                                            x-transition:enter-end="opacity-100"
                                            x-transition:leave="transition ease-in duration-150"
                                            x-transition:leave-start="opacity-100"
                                            x-transition:leave-end="opacity-0"
                                            class="truncate"
                                        >
                                            @item.label
                                        </span>
                                    </a>
                                    @* Tooltip - shown on hover when collapsed *@
                                    <div
                                        x-show="leftCollapsed"
                                        class="absolute left-full top-1/2 z-50 ml-2 -translate-y-1/2 rounded-md bg-popover px-2 py-1 text-sm text-popover-foreground shadow-md opacity-0 pointer-events-none group-hover/item:opacity-100 transition-opacity duration-200 whitespace-nowrap"
                                    >
                                        @item.label
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </nav>

            @* Left collapse toggle button *@
            <div class="border-t p-2">
                <button
                    @click="leftCollapsed = !leftCollapsed"
                    class="flex w-full items-center justify-center rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                    :aria-label="leftCollapsed ? 'Expand left sidebar' : 'Collapse left sidebar'"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform duration-300"
                        :class="leftCollapsed ? 'rotate-180' : ''"
                    >
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                </button>
            </div>
        </aside>

        @* Main Content Area *@
        <main class="flex-1 overflow-y-auto">
            <div class="p-6">
                @content()
            </div>
        </main>

        @* Right Sidebar *@
        <aside
            :class="rightCollapsed ? 'w-12' : 'w-64'"
            class="flex flex-col border-l bg-card transition-all duration-300 ease-in-out"
        >
            @* Right sidebar header with toggle *@
            <div class="flex h-14 items-center justify-between border-b px-3">
                <h2
                    x-show="!rightCollapsed"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="text-sm font-semibold text-foreground truncate"
                >
                    @right_title
                </h2>
                <button
                    @click="rightCollapsed = !rightCollapsed"
                    class="flex items-center justify-center rounded-md p-1.5 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                    :aria-label="rightCollapsed ? 'Expand right sidebar' : 'Collapse right sidebar'"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform duration-300"
                        :class="rightCollapsed ? '' : 'rotate-180'"
                    >
                        <path d="m9 18 6-6-6-6"/>
                    </svg>
                </button>
            </div>

            @* Table of contents / contextual content *@
            <nav
                x-show="!rightCollapsed"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="flex-1 overflow-y-auto p-3"
            >
                <ul class="space-y-1">
                    @for item in toc_items {
                        @let indent_cls = match item.level {
                            1 => "",
                            2 => "pl-3",
                            3 => "pl-6",
                            _ => "pl-9",
                        }
                        @let size_cls = match item.level {
                            1 => "text-sm font-medium",
                            _ => "text-sm",
                        }
                        <li>
                            <a
                                href=@item.href
                                class="@cn(&[&quot;block rounded-md px-2 py-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground&quot;, indent_cls, size_cls])"
                            >
                                @item.label
                            </a>
                        </li>
                    }
                </ul>
            </nav>

            @* Collapsed indicator icons *@
            <div
                x-show="rightCollapsed"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                class="flex-1 flex flex-col items-center pt-4 space-y-2"
            >
                @* TOC icon indicator *@
                <div
                    class="p-2 rounded-md text-muted-foreground"
                    title=@right_title
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="8" x2="21" y1="6" y2="6"/>
                        <line x1="8" x2="21" y1="12" y2="12"/>
                        <line x1="8" x2="21" y1="18" y2="18"/>
                        <line x1="3" x2="3.01" y1="6" y2="6"/>
                        <line x1="3" x2="3.01" y1="12" y2="12"/>
                        <line x1="3" x2="3.01" y1="18" y2="18"/>
                    </svg>
                </div>
            </div>
        </aside>
    </div>
}

@*
 * Dual-sidebar layout with custom right sidebar content
 * @param brand - Full brand content shown when left sidebar expanded
 * @param brand_icon - Icon/abbreviated brand shown when left sidebar collapsed
 * @param nav_groups - Navigation groups with items for left sidebar
 * @param right_title - Title for the right sidebar section
 * @param right_content - Custom render callback for right sidebar content
 * @param content - Main content render callback
 * @param left_collapsed - Initial collapsed state for left sidebar (default: false)
 * @param right_collapsed - Initial collapsed state for right sidebar (default: false)
 * @param class - Additional CSS classes for the outer container
 *@
@fn with_custom_right(
    brand: @(),
    brand_icon: @(),
    nav_groups: Vec<NavGroup>,
    right_title: &str,
    right_content: @(),
    content: @(),
    left_collapsed: bool = false,
    right_collapsed: bool = false,
    class: &str = "",
) {
    @let left_initial = if left_collapsed { "true" } else { "false" }
    @let right_initial = if right_collapsed { "true" } else { "false" }
    @let container_cls = cn(&["flex h-screen overflow-hidden bg-background", class])

    <div
        x-data="{
            leftCollapsed: @left_initial,
            rightCollapsed: @right_initial
        }"
        class=@container_cls
    >
        @* Left Sidebar *@
        <aside
            :class="leftCollapsed ? 'w-16' : 'w-64'"
            class="flex flex-col border-r bg-card transition-all duration-300 ease-in-out"
        >
            @* Brand area *@
            <div class="flex h-14 items-center border-b px-4">
                <div
                    x-show="!leftCollapsed"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="overflow-hidden whitespace-nowrap"
                >
                    @brand()
                </div>
                <div
                    x-show="leftCollapsed"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="flex w-full justify-center"
                >
                    @brand_icon()
                </div>
            </div>

            @* Navigation *@
            <nav class="flex-1 overflow-y-auto p-2">
                @for group in nav_groups {
                    <div class="mb-4">
                        @if let Some(label) = &group.label {
                            <h3
                                x-show="!leftCollapsed"
                                x-transition:enter="transition ease-out duration-200"
                                x-transition:enter-start="opacity-0"
                                x-transition:enter-end="opacity-100"
                                class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                            >
                                @label
                            </h3>
                        }
                        <ul class="space-y-1">
                            @for item in &group.items {
                                <li class="relative group/item">
                                    @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                    @let link_classes = ["flex items-center rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground", active_cls]
                                    <a
                                        href=@item.href
                                        class=@cn(link_classes)
                                        :class="leftCollapsed ? 'justify-center' : 'gap-3'"
                                    >
                                        @if let Some(icon) = &item.icon {
                                            <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                        }
                                        <span
                                            x-show="!leftCollapsed"
                                            x-transition:enter="transition ease-out duration-200"
                                            x-transition:enter-start="opacity-0"
                                            x-transition:enter-end="opacity-100"
                                            x-transition:leave="transition ease-in duration-150"
                                            x-transition:leave-start="opacity-100"
                                            x-transition:leave-end="opacity-0"
                                            class="truncate"
                                        >
                                            @item.label
                                        </span>
                                    </a>
                                    <div
                                        x-show="leftCollapsed"
                                        class="absolute left-full top-1/2 z-50 ml-2 -translate-y-1/2 rounded-md bg-popover px-2 py-1 text-sm text-popover-foreground shadow-md opacity-0 pointer-events-none group-hover/item:opacity-100 transition-opacity duration-200 whitespace-nowrap"
                                    >
                                        @item.label
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </nav>

            @* Left collapse toggle button *@
            <div class="border-t p-2">
                <button
                    @click="leftCollapsed = !leftCollapsed"
                    class="flex w-full items-center justify-center rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                    :aria-label="leftCollapsed ? 'Expand left sidebar' : 'Collapse left sidebar'"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform duration-300"
                        :class="leftCollapsed ? 'rotate-180' : ''"
                    >
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                </button>
            </div>
        </aside>

        @* Main Content Area *@
        <main class="flex-1 overflow-y-auto">
            <div class="p-6">
                @content()
            </div>
        </main>

        @* Right Sidebar *@
        <aside
            :class="rightCollapsed ? 'w-12' : 'w-64'"
            class="flex flex-col border-l bg-card transition-all duration-300 ease-in-out"
        >
            @* Right sidebar header with toggle *@
            <div class="flex h-14 items-center justify-between border-b px-3">
                <h2
                    x-show="!rightCollapsed"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="text-sm font-semibold text-foreground truncate"
                >
                    @right_title
                </h2>
                <button
                    @click="rightCollapsed = !rightCollapsed"
                    class="flex items-center justify-center rounded-md p-1.5 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                    :aria-label="rightCollapsed ? 'Expand right sidebar' : 'Collapse right sidebar'"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform duration-300"
                        :class="rightCollapsed ? '' : 'rotate-180'"
                    >
                        <path d="m9 18 6-6-6-6"/>
                    </svg>
                </button>
            </div>

            @* Custom right sidebar content *@
            <div
                x-show="!rightCollapsed"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="flex-1 overflow-y-auto p-3"
            >
                @right_content()
            </div>

            @* Collapsed indicator *@
            <div
                x-show="rightCollapsed"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                class="flex-1 flex flex-col items-center pt-4 space-y-2"
            >
                <div
                    class="p-2 rounded-md text-muted-foreground"
                    title=@right_title
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect width="18" height="18" x="3" y="3" rx="2"/>
                        <path d="M15 3v18"/>
                    </svg>
                </div>
            </div>
        </aside>
    </div>
}

@*
 * Dual-sidebar with header
 * Adds a top header bar to the dual-sidebar layout
 * @param brand - Full brand content shown when left sidebar expanded
 * @param brand_icon - Icon/abbreviated brand shown when left sidebar collapsed
 * @param nav_groups - Navigation groups with items for left sidebar
 * @param header - Header content render callback
 * @param right_title - Title for the right sidebar section
 * @param toc_items - Table of contents items for right sidebar
 * @param content - Main content render callback
 * @param left_collapsed - Initial collapsed state for left sidebar (default: false)
 * @param right_collapsed - Initial collapsed state for right sidebar (default: false)
 * @param class - Additional CSS classes for the outer container
 *@
@fn with_header(
    brand: @(),
    brand_icon: @(),
    nav_groups: Vec<NavGroup>,
    header: @(),
    right_title: &str,
    toc_items: Vec<TocItem>,
    content: @(),
    left_collapsed: bool = false,
    right_collapsed: bool = false,
    class: &str = "",
) {
    @let left_initial = if left_collapsed { "true" } else { "false" }
    @let right_initial = if right_collapsed { "true" } else { "false" }
    @let container_cls = cn(&["flex h-screen overflow-hidden bg-background", class])

    <div
        x-data="{
            leftCollapsed: @left_initial,
            rightCollapsed: @right_initial
        }"
        class=@container_cls
    >
        @* Left Sidebar *@
        <aside
            :class="leftCollapsed ? 'w-16' : 'w-64'"
            class="flex flex-col border-r bg-card transition-all duration-300 ease-in-out"
        >
            @* Brand area *@
            <div class="flex h-14 items-center border-b px-4">
                <div
                    x-show="!leftCollapsed"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="overflow-hidden whitespace-nowrap"
                >
                    @brand()
                </div>
                <div
                    x-show="leftCollapsed"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="flex w-full justify-center"
                >
                    @brand_icon()
                </div>
            </div>

            @* Navigation *@
            <nav class="flex-1 overflow-y-auto p-2">
                @for group in nav_groups {
                    <div class="mb-4">
                        @if let Some(label) = &group.label {
                            <h3
                                x-show="!leftCollapsed"
                                x-transition:enter="transition ease-out duration-200"
                                x-transition:enter-start="opacity-0"
                                x-transition:enter-end="opacity-100"
                                class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                            >
                                @label
                            </h3>
                        }
                        <ul class="space-y-1">
                            @for item in &group.items {
                                <li class="relative group/item">
                                    @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                    @let link_classes = ["flex items-center rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground", active_cls]
                                    <a
                                        href=@item.href
                                        class=@cn(link_classes)
                                        :class="leftCollapsed ? 'justify-center' : 'gap-3'"
                                    >
                                        @if let Some(icon) = &item.icon {
                                            <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                        }
                                        <span
                                            x-show="!leftCollapsed"
                                            x-transition:enter="transition ease-out duration-200"
                                            x-transition:enter-start="opacity-0"
                                            x-transition:enter-end="opacity-100"
                                            x-transition:leave="transition ease-in duration-150"
                                            x-transition:leave-start="opacity-100"
                                            x-transition:leave-end="opacity-0"
                                            class="truncate"
                                        >
                                            @item.label
                                        </span>
                                    </a>
                                    <div
                                        x-show="leftCollapsed"
                                        class="absolute left-full top-1/2 z-50 ml-2 -translate-y-1/2 rounded-md bg-popover px-2 py-1 text-sm text-popover-foreground shadow-md opacity-0 pointer-events-none group-hover/item:opacity-100 transition-opacity duration-200 whitespace-nowrap"
                                    >
                                        @item.label
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </nav>

            @* Left collapse toggle button *@
            <div class="border-t p-2">
                <button
                    @click="leftCollapsed = !leftCollapsed"
                    class="flex w-full items-center justify-center rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                    :aria-label="leftCollapsed ? 'Expand left sidebar' : 'Collapse left sidebar'"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform duration-300"
                        :class="leftCollapsed ? 'rotate-180' : ''"
                    >
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                </button>
            </div>
        </aside>

        @* Main Content Area with Header *@
        <div class="flex flex-1 flex-col overflow-hidden">
            @* Header *@
            <header class="flex h-14 items-center border-b bg-card px-6">
                @header()
            </header>

            @* Content *@
            <main class="flex-1 overflow-y-auto p-6">
                @content()
            </main>
        </div>

        @* Right Sidebar *@
        <aside
            :class="rightCollapsed ? 'w-12' : 'w-64'"
            class="flex flex-col border-l bg-card transition-all duration-300 ease-in-out"
        >
            @* Right sidebar header with toggle *@
            <div class="flex h-14 items-center justify-between border-b px-3">
                <h2
                    x-show="!rightCollapsed"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="text-sm font-semibold text-foreground truncate"
                >
                    @right_title
                </h2>
                <button
                    @click="rightCollapsed = !rightCollapsed"
                    class="flex items-center justify-center rounded-md p-1.5 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                    :aria-label="rightCollapsed ? 'Expand right sidebar' : 'Collapse right sidebar'"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform duration-300"
                        :class="rightCollapsed ? '' : 'rotate-180'"
                    >
                        <path d="m9 18 6-6-6-6"/>
                    </svg>
                </button>
            </div>

            @* Table of contents *@
            <nav
                x-show="!rightCollapsed"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="flex-1 overflow-y-auto p-3"
            >
                <ul class="space-y-1">
                    @for item in toc_items {
                        @let indent_cls = match item.level {
                            1 => "",
                            2 => "pl-3",
                            3 => "pl-6",
                            _ => "pl-9",
                        }
                        @let size_cls = match item.level {
                            1 => "text-sm font-medium",
                            _ => "text-sm",
                        }
                        <li>
                            <a
                                href=@item.href
                                class="@cn(&[&quot;block rounded-md px-2 py-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground&quot;, indent_cls, size_cls])"
                            >
                                @item.label
                            </a>
                        </li>
                    }
                </ul>
            </nav>

            @* Collapsed indicator *@
            <div
                x-show="rightCollapsed"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                class="flex-1 flex flex-col items-center pt-4 space-y-2"
            >
                <div
                    class="p-2 rounded-md text-muted-foreground"
                    title=@right_title
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="8" x2="21" y1="6" y2="6"/>
                        <line x1="8" x2="21" y1="12" y2="12"/>
                        <line x1="8" x2="21" y1="18" y2="18"/>
                        <line x1="3" x2="3.01" y1="6" y2="6"/>
                        <line x1="3" x2="3.01" y1="12" y2="12"/>
                        <line x1="3" x2="3.01" y1="18" y2="18"/>
                    </svg>
                </div>
            </div>
        </aside>
    </div>
}

@*
 * Controlled dual-sidebar layout (external state)
 * Use this when you need to control the collapsed states from a parent component
 * @param left_collapsed_var - Alpine.js variable name for left sidebar collapsed state
 * @param right_collapsed_var - Alpine.js variable name for right sidebar collapsed state
 * @param brand - Full brand content shown when left sidebar expanded
 * @param brand_icon - Icon/abbreviated brand shown when left sidebar collapsed
 * @param nav_groups - Navigation groups with items for left sidebar
 * @param right_title - Title for the right sidebar section
 * @param toc_items - Table of contents items for right sidebar
 * @param content - Main content render callback
 * @param class - Additional CSS classes for the outer container
 *@
@fn controlled(
    left_collapsed_var: &str,
    right_collapsed_var: &str,
    brand: @(),
    brand_icon: @(),
    nav_groups: Vec<NavGroup>,
    right_title: &str,
    toc_items: Vec<TocItem>,
    content: @(),
    class: &str = "",
) {
    @let container_cls = cn(&["flex h-screen overflow-hidden bg-background", class])

    <div class=@container_cls>
        @* Left Sidebar *@
        <aside
            :class="@left_collapsed_var ? 'w-16' : 'w-64'"
            class="flex flex-col border-r bg-card transition-all duration-300 ease-in-out"
        >
            @* Brand area *@
            <div class="flex h-14 items-center border-b px-4">
                <div
                    x-show="!@left_collapsed_var"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="overflow-hidden whitespace-nowrap"
                >
                    @brand()
                </div>
                <div
                    x-show=@left_collapsed_var
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="flex w-full justify-center"
                >
                    @brand_icon()
                </div>
            </div>

            @* Navigation *@
            <nav class="flex-1 overflow-y-auto p-2">
                @for group in nav_groups {
                    <div class="mb-4">
                        @if let Some(label) = &group.label {
                            <h3
                                x-show="!@left_collapsed_var"
                                x-transition:enter="transition ease-out duration-200"
                                x-transition:enter-start="opacity-0"
                                x-transition:enter-end="opacity-100"
                                class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                            >
                                @label
                            </h3>
                        }
                        <ul class="space-y-1">
                            @for item in &group.items {
                                <li class="relative group/item">
                                    @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                    @let link_classes = ["flex items-center rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground", active_cls]
                                    <a
                                        href=@item.href
                                        class=@cn(link_classes)
                                        :class="@left_collapsed_var ? 'justify-center' : 'gap-3'"
                                    >
                                        @if let Some(icon) = &item.icon {
                                            <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                        }
                                        <span
                                            x-show="!@left_collapsed_var"
                                            x-transition:enter="transition ease-out duration-200"
                                            x-transition:enter-start="opacity-0"
                                            x-transition:enter-end="opacity-100"
                                            x-transition:leave="transition ease-in duration-150"
                                            x-transition:leave-start="opacity-100"
                                            x-transition:leave-end="opacity-0"
                                            class="truncate"
                                        >
                                            @item.label
                                        </span>
                                    </a>
                                    <div
                                        x-show=@left_collapsed_var
                                        class="absolute left-full top-1/2 z-50 ml-2 -translate-y-1/2 rounded-md bg-popover px-2 py-1 text-sm text-popover-foreground shadow-md opacity-0 pointer-events-none group-hover/item:opacity-100 transition-opacity duration-200 whitespace-nowrap"
                                    >
                                        @item.label
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </nav>

            @* Left collapse toggle button *@
            <div class="border-t p-2">
                <button
                    @click="@left_collapsed_var = !@left_collapsed_var"
                    class="flex w-full items-center justify-center rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                    :aria-label="@left_collapsed_var ? 'Expand left sidebar' : 'Collapse left sidebar'"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform duration-300"
                        :class="@left_collapsed_var ? 'rotate-180' : ''"
                    >
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                </button>
            </div>
        </aside>

        @* Main Content Area *@
        <main class="flex-1 overflow-y-auto">
            <div class="p-6">
                @content()
            </div>
        </main>

        @* Right Sidebar *@
        <aside
            :class="@right_collapsed_var ? 'w-12' : 'w-64'"
            class="flex flex-col border-l bg-card transition-all duration-300 ease-in-out"
        >
            @* Right sidebar header with toggle *@
            <div class="flex h-14 items-center justify-between border-b px-3">
                <h2
                    x-show="!@right_collapsed_var"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="text-sm font-semibold text-foreground truncate"
                >
                    @right_title
                </h2>
                <button
                    @click="@right_collapsed_var = !@right_collapsed_var"
                    class="flex items-center justify-center rounded-md p-1.5 text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
                    :aria-label="@right_collapsed_var ? 'Expand right sidebar' : 'Collapse right sidebar'"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform duration-300"
                        :class="@right_collapsed_var ? '' : 'rotate-180'"
                    >
                        <path d="m9 18 6-6-6-6"/>
                    </svg>
                </button>
            </div>

            @* Table of contents *@
            <nav
                x-show="!@right_collapsed_var"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="flex-1 overflow-y-auto p-3"
            >
                <ul class="space-y-1">
                    @for item in toc_items {
                        @let indent_cls = match item.level {
                            1 => "",
                            2 => "pl-3",
                            3 => "pl-6",
                            _ => "pl-9",
                        }
                        @let size_cls = match item.level {
                            1 => "text-sm font-medium",
                            _ => "text-sm",
                        }
                        <li>
                            <a
                                href=@item.href
                                class="@cn(&[&quot;block rounded-md px-2 py-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground&quot;, indent_cls, size_cls])"
                            >
                                @item.label
                            </a>
                        </li>
                    }
                </ul>
            </nav>

            @* Collapsed indicator *@
            <div
                x-show=@right_collapsed_var
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                class="flex-1 flex flex-col items-center pt-4 space-y-2"
            >
                <div
                    class="p-2 rounded-md text-muted-foreground"
                    title=@right_title
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="8" x2="21" y1="6" y2="6"/>
                        <line x1="8" x2="21" y1="12" y2="12"/>
                        <line x1="8" x2="21" y1="18" y2="18"/>
                        <line x1="3" x2="3.01" y1="6" y2="6"/>
                        <line x1="3" x2="3.01" y1="12" y2="12"/>
                        <line x1="3" x2="3.01" y1="18" y2="18"/>
                    </svg>
                </div>
            </div>
        </aside>
    </div>
}
