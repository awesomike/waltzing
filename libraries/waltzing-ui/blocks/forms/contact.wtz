@*
 * Contact form block
 * A complete contact form with name, email, subject, and message fields
 *
 * @example
 * @import blocks/forms/contact.wtz as contact
 *
 * <@contact::apply action="/api/contact" method="post" />
 *
 * <@contact::apply
 *     action="/api/contact"
 *     method="post"
 *     name_error=Some("Name is required")
 *     email_error=None
 *     subject_error=None
 *     message_error=None
 *     class="max-w-lg mx-auto"
 * />
 *@

@import components/input.wtz as input
@import components/textarea.wtz as textarea
@import components/button.wtz as button
@import components/field.wtz as field


@* Main contact form *@
@fn apply(
    action: &str,
    method: &str = "post",
    name_value: Option<&str> = None,
    email_value: Option<&str> = None,
    subject_value: Option<&str> = None,
    message_value: Option<&str> = None,
    name_error: Option<&str> = None,
    email_error: Option<&str> = None,
    subject_error: Option<&str> = None,
    message_error: Option<&str> = None,
    submit_text: &str = "Send Message",
    class: &str = "",
) {
    @let form_cls = cn(&["space-y-6", class])
    @let name_ph = Some("Your name")
    @let email_ph = Some("you@example.com")
    @let subject_ph = Some("How can we help?")
    @let message_ph = Some("Your message...")
    @let message_rows = Some(5)

    <form action="@action" method="@method" class="@form_cls">
        <@field::apply label="Name" required=true error=@name_error>
            <@input::apply
                input_type=input::InputType::Text
                name="name"
                value=@name_value
                placeholder=@name_ph
                required=true
                error=@name_error
            />
        </@>

        <@field::apply label="Email" required=true error=@email_error>
            <@input::apply
                input_type=input::InputType::Email
                name="email"
                value=@email_value
                placeholder=@email_ph
                required=true
                error=@email_error
            />
        </@>

        <@field::apply label="Subject" required=true error=@subject_error>
            <@input::apply
                input_type=input::InputType::Text
                name="subject"
                value=@subject_value
                placeholder=@subject_ph
                required=true
                error=@subject_error
            />
        </@>

        <@field::apply label="Message" required=true error=@message_error>
            <@textarea::apply
                name="message"
                value=@message_value
                placeholder=@message_ph
                rows=@message_rows
                required=true
                error=@message_error
            />
        </@>

        <@button::apply variant=button::Variant::Primary size=button::Size::Default class="w-full">
            @submit_text
        </@>
    </form>
}

@* Contact form with custom submit button *@
@fn with_button(
    action: &str,
    method: &str = "post",
    name_value: Option<&str> = None,
    email_value: Option<&str> = None,
    subject_value: Option<&str> = None,
    message_value: Option<&str> = None,
    name_error: Option<&str> = None,
    email_error: Option<&str> = None,
    subject_error: Option<&str> = None,
    message_error: Option<&str> = None,
    class: &str = "",
    button: @(),
) {
    @let form_cls = cn(&["space-y-6", class])
    @let name_ph = Some("Your name")
    @let email_ph = Some("you@example.com")
    @let subject_ph = Some("How can we help?")
    @let message_ph = Some("Your message...")
    @let message_rows = Some(5)

    <form action="@action" method="@method" class="@form_cls">
        <@field::apply label="Name" required=true error=@name_error>
            <@input::apply
                input_type=input::InputType::Text
                name="name"
                value=@name_value
                placeholder=@name_ph
                required=true
                error=@name_error
            />
        </@>

        <@field::apply label="Email" required=true error=@email_error>
            <@input::apply
                input_type=input::InputType::Email
                name="email"
                value=@email_value
                placeholder=@email_ph
                required=true
                error=@email_error
            />
        </@>

        <@field::apply label="Subject" required=true error=@subject_error>
            <@input::apply
                input_type=input::InputType::Text
                name="subject"
                value=@subject_value
                placeholder=@subject_ph
                required=true
                error=@subject_error
            />
        </@>

        <@field::apply label="Message" required=true error=@message_error>
            <@textarea::apply
                name="message"
                value=@message_value
                placeholder=@message_ph
                rows=@message_rows
                required=true
                error=@message_error
            />
        </@>

        @button()
    </form>
}
