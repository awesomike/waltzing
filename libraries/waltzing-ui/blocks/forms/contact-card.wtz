@*
 * Contact card block
 * A compact, labeled contact form suitable for support and sales pages.
 *@

@import /components/card.wtz as card
@import /components/button.wtz as button

@fn apply(
    action: &str,
    method: &str = "post",
    title: &str = "Contact us",
    description: &str = "Send a message and we will get back to you.",
    name_error: Option<&str> = None,
    email_error: Option<&str> = None,
    message_error: Option<&str> = None,
    submit_text: &str = "Send message",
    class: &str = "",
) {
    @let email_placeholder = "you@example.com"
    @let input_cls = "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
    @let textarea_cls = "flex min-h-[120px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"

    <@card::base class=@class>
        <@card::header>
            <@card::title>@title</@card::title>
            <@card::description>@description</@card::description>
        </@card::header>
        <@card::content>
            <form action=@action method=@method class="space-y-4">
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="space-y-2">
                        <label for="name" class="text-sm font-medium leading-none">Name</label>
                        <input id="name" name="name" type="text" class=@input_cls placeholder="Jane Doe" required />
                        @if let Some(error) = name_error { <p class="text-sm text-destructive" role="alert">@error</p> }
                    </div>
                    <div class="space-y-2">
                        <label for="email" class="text-sm font-medium leading-none">Email</label>
                        <input id="email" name="email" type="email" class=@input_cls placeholder=@email_placeholder required />
                        @if let Some(error) = email_error { <p class="text-sm text-destructive" role="alert">@error</p> }
                    </div>
                </div>

                <div class="space-y-2">
                    <label for="message" class="text-sm font-medium leading-none">Message</label>
                    <textarea id="message" name="message" class=@textarea_cls rows="5" placeholder="How can we help?" required></textarea>
                    @if let Some(error) = message_error { <p class="text-sm text-destructive" role="alert">@error</p> }
                </div>

                <div class="flex justify-end">
                    <@button::apply variant=button::Variant::Primary size=button::Size::Default>
                        @submit_text
                    </@button::apply>
                </div>
            </form>
        </@card::content>
    </@card::base>
}
