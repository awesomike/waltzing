@*
 * Login-04 block
 * Login with decorative image - form on one side, image on the other
 * Responsive: stacks vertically on mobile, side-by-side on larger screens
 *
 * @example
 * @import blocks/auth/login-04.wtz as login
 *
 * <@login::apply
 *     action="/login"
 *     image_src="/images/auth-illustration.svg"
 * />
 *
 * <@login::apply
 *     action="/login"
 *     image_src="/images/auth-bg.jpg"
 *     image_alt="Abstract background"
 *     image_position=login::ImagePosition::Left
 *     title="Welcome back"
 *     description="Sign in to your account to continue"
 *     email_value=Some("user@example.com")
 *     forgot_password_url=Some("/forgot-password")
 *     register_url=Some("/register")
 * />
 *@

@import /components/card.wtz as card
@import /components/input.wtz as input
@import /components/button.wtz as button
@import /components/field.wtz as field


@* Image position variants *@
@enum ImagePosition {
    Left,
    Right,
}


@* Main login with image layout *@
@fn apply(
    action: &str,
    method: &str = "post",
    title: &str = "Welcome back",
    description: &str = "Enter your credentials to sign in to your account",
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    submit_text: &str = "Sign in",
    forgot_password_url: Option<&str> = None,
    register_url: Option<&str> = None,
    image_src: &str,
    image_alt: &str = "Login illustration",
    image_position: ImagePosition = ImagePosition::Right,
    class: &str = "",
) {
    @let container_cls = cn(&["flex min-h-screen w-full", class])
    @let form_order = match image_position {
        ImagePosition::Left => "order-2",
        ImagePosition::Right => "order-1",
    }
    @let image_order = match image_position {
        ImagePosition::Left => "order-1",
        ImagePosition::Right => "order-2",
    }

    <div class="@container_cls">
        @* Form side *@
        <div class="flex w-full items-center justify-center p-6 lg:w-1/2 lg:p-12 @form_order">
            <div class="w-full max-w-md space-y-8">
                @* Header *@
                <div class="space-y-2 text-center lg:text-left">
                    <h1 class="text-3xl font-bold tracking-tight">@title</h1>
                    <p class="text-muted-foreground">@description</p>
                </div>

                @* Form *@
                <@form
                    action=@action
                    method=@method
                    email_value=@email_value
                    email_error=@email_error
                    password_error=@password_error
                    submit_text=@submit_text
                    forgot_password_url=@forgot_password_url
                />

                @* Register link *@
                @if let Some(url) = register_url {
                    <p class="text-center text-sm text-muted-foreground">
                        Don't have an account?
                        <a href="@url" class="font-medium text-primary underline-offset-4 hover:underline">
                            Create an account
                        </a>
                    </p>
                }
            </div>
        </div>

        @* Image side *@
        <div class="hidden bg-muted lg:block lg:w-1/2 @image_order">
            <img
                src="@image_src"
                alt="@image_alt"
                class="h-full w-full object-cover"
            />
        </div>
    </div>
}


@* Card variant - form in a card with image beside it *@
@fn card_layout(
    action: &str,
    method: &str = "post",
    title: &str = "Welcome back",
    description: &str = "Enter your credentials to sign in to your account",
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    submit_text: &str = "Sign in",
    forgot_password_url: Option<&str> = None,
    register_url: Option<&str> = None,
    image_src: &str,
    image_alt: &str = "Login illustration",
    image_position: ImagePosition = ImagePosition::Right,
    class: &str = "",
) {
    @let container_cls = cn(&["flex min-h-screen items-center justify-center p-4", class])
    @let form_order = match image_position {
        ImagePosition::Left => "order-2",
        ImagePosition::Right => "order-1",
    }
    @let image_order = match image_position {
        ImagePosition::Left => "order-1",
        ImagePosition::Right => "order-2",
    }

    <div class="@container_cls">
        <div class="grid w-full max-w-4xl overflow-hidden rounded-xl border bg-card shadow-lg lg:grid-cols-2">
            @* Form side *@
            <div class="p-8 lg:p-12 @form_order">
                <div class="space-y-6">
                    @* Header *@
                    <div class="space-y-2">
                        <h1 class="text-2xl font-bold tracking-tight">@title</h1>
                        <p class="text-sm text-muted-foreground">@description</p>
                    </div>

                    @* Form *@
                    <@form
                        action=@action
                        method=@method
                        email_value=@email_value
                        email_error=@email_error
                        password_error=@password_error
                        submit_text=@submit_text
                        forgot_password_url=@forgot_password_url
                    />

                    @* Register link *@
                    @if let Some(url) = register_url {
                        <p class="text-center text-sm text-muted-foreground">
                            Don't have an account?
                            <a href="@url" class="font-medium text-primary underline-offset-4 hover:underline">
                                Create an account
                            </a>
                        </p>
                    }
                </div>
            </div>

            @* Image side *@
            <div class="hidden bg-muted lg:block @image_order">
                <img
                    src="@image_src"
                    alt="@image_alt"
                    class="h-full w-full object-cover"
                />
            </div>
        </div>
    </div>
}


@* Overlay variant - image as full background with form overlay *@
@fn overlay(
    action: &str,
    method: &str = "post",
    title: &str = "Welcome back",
    description: &str = "Enter your credentials to sign in to your account",
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    submit_text: &str = "Sign in",
    forgot_password_url: Option<&str> = None,
    register_url: Option<&str> = None,
    image_src: &str,
    image_alt: &str = "Background image",
    class: &str = "",
) {
    @let container_cls = cn(&["relative flex min-h-screen items-center justify-center p-4", class])
    @let header = Some(@() {
        <@card::title class="text-xl">@title</@card::title>
        <@card::description>@description</@card::description>
    })

    <div class="@container_cls">
        @* Background image *@
        <div class="absolute inset-0 z-0">
            <img
                src="@image_src"
                alt="@image_alt"
                class="h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-background/80 backdrop-blur-sm"></div>
        </div>

        @* Card overlay *@
        @if let Some(url) = register_url {
            <@card::apply
                header=@header
                footer=@Some(@() {
                    <p class="w-full text-center text-sm text-muted-foreground">
                        Don't have an account?
                        <a href="@url" class="font-medium text-primary underline-offset-4 hover:underline">
                            Create an account
                        </a>
                    </p>
                })
                class="relative z-10 w-full max-w-md"
            >
                <@form
                    action=@action
                    method=@method
                    email_value=@email_value
                    email_error=@email_error
                    password_error=@password_error
                    submit_text=@submit_text
                    forgot_password_url=@forgot_password_url
                />
            </@card::apply>
        } @else {
            <@card::apply header=@header footer=@None class="relative z-10 w-full max-w-md">
                <@form
                    action=@action
                    method=@method
                    email_value=@email_value
                    email_error=@email_error
                    password_error=@password_error
                    submit_text=@submit_text
                    forgot_password_url=@forgot_password_url
                />
            </@card::apply>
        }
    </div>
}


@* Internal form helper *@
@fn form(
    action: &str,
    method: &str,
    email_value: Option<&str>,
    email_error: Option<&str>,
    password_error: Option<&str>,
    submit_text: &str,
    forgot_password_url: Option<&str>,
) {
    @let email_ph = Some("you@example.com")
    @let password_ph = Some("Enter your password")

    <form action="@action" method="@method" class="space-y-4">
        <@field::apply label="Email" required=true error=@email_error>
            <@input::apply
                input_type=input::InputType::Email
                name="email"
                value=@email_value
                placeholder=@email_ph
                required=true
                error=@email_error
            />
        </@field::apply>

        <@field::apply label="Password" required=true error=@password_error>
            <@input::apply
                input_type=input::InputType::Password
                name="password"
                placeholder=@password_ph
                required=true
                error=@password_error
            />
        </@field::apply>

        @if let Some(url) = forgot_password_url {
            <div class="text-right">
                <a href="@url" class="text-sm text-primary underline-offset-4 hover:underline">
                    Forgot password?
                </a>
            </div>
        }

        <@button::apply variant=button::Variant::Primary size=button::Size::Default class="w-full">
            @submit_text
        </@button::apply>
    </form>
}
