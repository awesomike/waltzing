@*
 * Signup Form Block
 * Registration form with name, email, password, confirm password, and terms acceptance
 *
 * @example
 * @import blocks/auth/signup.wtz as signup
 *
 * <@signup::apply action="/api/register" method="post" />
 *
 * With pre-filled values and errors:
 * <@signup::apply
 *     action="/api/register"
 *     method="post"
 *     name_value=Some("John Doe")
 *     email_value=Some("john@example.com")
 *     email_error=Some("This email is already registered")
 *     password_error=Some("Password must be at least 8 characters")
 *     show_social=true
 * />
 *
 * Wrapped in a card:
 * <@signup::card action="/api/register" method="post" />
 *@

@import /components/button.wtz as button
@import /components/card.wtz as card
@import /components/checkbox.wtz as checkbox
@import /components/field.wtz as field
@import /components/form.wtz as form
@import /components/input.wtz as input
@import /components/password-input.wtz as password_input
@import /components/separator.wtz as separator


@* Main signup form *@
@fn apply(
    action: &str,
    method: &str,
    name_value: Option<&str> = None,
    name_error: Option<&str> = None,
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    confirm_password_error: Option<&str> = None,
    terms_checked: bool = false,
    terms_error: Option<&str> = None,
    terms_url: &str = "/terms",
    privacy_url: &str = "/privacy",
    show_social: bool = false,
    login_url: &str = "/login",
    class: &str = "",
) {
    @let cls = class
    @let form_classes = ["w-full max-w-md", cls]

    <@form::apply
        action=@Some(action)
        method=@Some(method)
        enctype=None
        class=@cn(form_classes)
    >
        @* Name Field *@
        <@field::apply label="Full Name" required=true error=@name_error>
            <@input::apply
                input_type=input::InputType::Text
                name="name"
                value=@name_value
                placeholder=@Some("Enter your full name")
                required=true
                error=@name_error
            />
        </@field::apply>

        @* Email Field *@
        <@field::apply label="Email Address" required=true error=@email_error>
            <@input::apply
                input_type=input::InputType::Email
                name="email"
                value=@email_value
                placeholder=@Some("you@example.com")
                required=true
                error=@email_error
            />
        </@field::apply>

        @* Password Field *@
        <@field::apply label="Password" required=true error=@password_error description=@Some("Must be at least 8 characters")>
            <@password_input::apply
                name="password"
                placeholder=@Some("Create a password")
                required=true
                error=@password_error
            />
        </@field::apply>

        @* Confirm Password Field *@
        <@field::apply label="Confirm Password" required=true error=@confirm_password_error>
            <@password_input::apply
                name="confirm_password"
                placeholder=@Some("Confirm your password")
                required=true
                error=@confirm_password_error
            />
        </@field::apply>

        @* Terms and Conditions Checkbox *@
        <div class="space-y-2">
            <div class="flex items-start space-x-2">
                <@checkbox::apply
                    name="terms"
                    checked=@terms_checked
                    class="mt-0.5"
                />
                <div class="grid gap-1.5 leading-none">
                    <label for="terms" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
                        I agree to the <a href="@terms_url" class="text-primary underline underline-offset-4 hover:text-primary/80">Terms of Service</a> and <a href="@privacy_url" class="text-primary underline underline-offset-4 hover:text-primary/80">Privacy Policy</a>
                    </label>
                </div>
            </div>
            @if let Some(e) = terms_error {
                <p class="text-sm text-destructive" role="alert">@e</p>
            }
        </div>

        @* Submit Button *@
        <@form::actions align=None class="flex-col sm:flex-col">
            <@button::apply variant=button::Variant::Primary size=button::Size::Default class="w-full">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <line x1="19" x2="19" y1="8" y2="14"/>
                    <line x1="22" x2="16" y1="11" y2="11"/>
                </svg>
                Create Account
            </@button::apply>
        </@form::actions>

        @* Social Signup Section *@
        @if show_social {
            <div class="relative">
                <div class="absolute inset-0 flex items-center">
                    <@separator::horizontal />
                </div>
                <div class="relative flex justify-center text-xs uppercase">
                    <span class="bg-background px-2 text-muted-foreground">Or continue with</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                @* Google Button *@
                <@button::apply variant=button::Variant::Outline size=button::Size::Default>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="mr-2 h-4 w-4">
                        <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    Google
                </@button::apply>

                @* GitHub Button *@
                <@button::apply variant=button::Variant::Outline size=button::Size::Default>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="mr-2 h-4 w-4">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    GitHub
                </@button::apply>
            </div>
        }

        @* Login Link *@
        <p class="text-center text-sm text-muted-foreground">
            Already have an account?
            <a href="@login_url" class="text-primary underline underline-offset-4 hover:text-primary/80">
                Sign in
            </a>
        </p>
    </@form::apply>
}

@* Signup form wrapped in a card *@
@fn card(
    action: &str,
    method: &str,
    name_value: Option<&str> = None,
    name_error: Option<&str> = None,
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    confirm_password_error: Option<&str> = None,
    terms_checked: bool = false,
    terms_error: Option<&str> = None,
    terms_url: &str = "/terms",
    privacy_url: &str = "/privacy",
    show_social: bool = false,
    login_url: &str = "/login",
) {
    <@card::apply
        header=@Some(@() {
            <@card::title>Create an Account</@card::title>
            <@card::description>Enter your information to get started</@card::description>
        })
        footer=None
    >
        <@apply
            action=@action
            method=@method
            name_value=@name_value
            name_error=@name_error
            email_value=@email_value
            email_error=@email_error
            password_error=@password_error
            confirm_password_error=@confirm_password_error
            terms_checked=@terms_checked
            terms_error=@terms_error
            terms_url=@terms_url
            privacy_url=@privacy_url
            show_social=@show_social
            login_url=@login_url
        />
    </@card::apply>
}

@* Minimal signup form with just essential fields *@
@fn minimal(
    action: &str,
    method: &str,
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    login_url: &str = "/login",
) {
    @let form_classes = "w-full max-w-md"

    <@form::apply
        action=@Some(action)
        method=@Some(method)
        enctype=None
        class=@form_classes
    >
        @* Email Field *@
        <@field::apply label="Email Address" required=true error=@email_error>
            <@input::apply
                input_type=input::InputType::Email
                name="email"
                value=@email_value
                placeholder=@Some("you@example.com")
                required=true
                error=@email_error
            />
        </@field::apply>

        @* Password Field *@
        <@field::apply label="Password" required=true error=@password_error>
            <@password_input::apply
                name="password"
                placeholder=@Some("Create a password")
                required=true
                error=@password_error
            />
        </@field::apply>

        @* Submit Button *@
        <@button::apply variant=button::Variant::Primary size=button::Size::Default class="w-full">
            Create Account
        </@button::apply>

        @* Login Link *@
        <p class="text-center text-sm text-muted-foreground">
            Already have an account?
            <a href="@login_url" class="text-primary underline underline-offset-4 hover:text-primary/80">
                Sign in
            </a>
        </p>
    </@form::apply>
}
