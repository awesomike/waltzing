@*
 * Login-02 block
 * Two column layout with cover image on left, login form on right
 * Responsive: stacks on mobile (image hidden on small screens)
 *
 * @example
 * @import blocks/auth/login-02.wtz as login
 *
 * <@login::apply action="/login" />
 *
 * <@login::apply
 *     action="/login"
 *     image_url="https://images.unsplash.com/photo-1590069261209-f8e9b8642343"
 *     image_alt="Abstract background"
 *     brand_name="Acme Inc"
 *     brand_tagline="Welcome back to your dashboard"
 *     email_value=Some("user@example.com")
 *     email_error=Some("Invalid email address")
 *     forgot_password_url=Some("/forgot-password")
 *     register_url=Some("/register")
 * />
 *@

@import /components/button.wtz as button
@import /components/field.wtz as field
@import /components/input.wtz as input


@* Two-column login layout with cover image *@
@fn apply(
    action: &str,
    method: &str = "post",
    title: &str = "Sign in",
    description: &str = "Enter your credentials to access your account",
    image_url: &str = "https://images.unsplash.com/photo-1590069261209-f8e9b8642343?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80",
    image_alt: &str = "Cover image",
    brand_name: &str = "Acme Inc",
    brand_tagline: &str = "Building the future, one step at a time.",
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    submit_text: &str = "Sign in",
    forgot_password_url: Option<&str> = None,
    register_url: Option<&str> = None,
    class: &str = "",
) {
    @let container_cls = cn(&["min-h-screen w-full lg:grid lg:grid-cols-2", class])
    @let email_ph = Some("you@example.com")
    @let password_ph = Some("Enter your password")

    <div class=@container_cls>
        @** Left side - Cover image (hidden on mobile) **@
        <div class="relative hidden bg-muted lg:block">
            <img
                src=@image_url
                alt=@image_alt
                class="absolute inset-0 h-full w-full object-cover"
            />
            @** Dark overlay for better text readability **@
            <div class="absolute inset-0 bg-black/40"></div>
            @** Branding overlay **@
            <div class="relative z-10 flex h-full flex-col justify-between p-10 text-white">
                <div class="flex items-center gap-2 text-lg font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
                        <path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/>
                    </svg>
                    @brand_name
                </div>
                <div class="space-y-2">
                    <blockquote class="text-lg">
                        "@brand_tagline"
                    </blockquote>
                </div>
            </div>
        </div>

        @** Right side - Login form **@
        <div class="flex items-center justify-center p-6 lg:p-10">
            <div class="mx-auto w-full max-w-sm space-y-6">
                @** Header **@
                <div class="space-y-2 text-center">
                    @** Mobile logo (shown only on small screens) **@
                    <div class="flex justify-center lg:hidden">
                        <div class="flex items-center gap-2 text-lg font-medium">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
                                <path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/>
                            </svg>
                            @brand_name
                        </div>
                    </div>
                    <h1 class="text-2xl font-semibold tracking-tight">@title</h1>
                    <p class="text-sm text-muted-foreground">@description</p>
                </div>

                @** Login form **@
                <form action=@action method=@method class="space-y-4">
                    <@field::apply label="Email" required=true error=@email_error>
                        <@input::apply
                            input_type=input::InputType::Email
                            name="email"
                            value=@email_value
                            placeholder=@email_ph
                            required=true
                            error=@email_error
                        />
                    </@field::apply>

                    <@field::apply label="Password" required=true error=@password_error>
                        <@input::apply
                            input_type=input::InputType::Password
                            name="password"
                            placeholder=@password_ph
                            required=true
                            error=@password_error
                        />
                    </@field::apply>

                    @if let Some(url) = forgot_password_url {
                        <div class="text-right">
                            <a href=@url class="text-sm text-primary hover:underline underline-offset-4">
                                Forgot password?
                            </a>
                        </div>
                    }

                    <@button::apply variant=button::Variant::Primary size=button::Size::Default class="w-full">
                        @submit_text
                    </@button::apply>
                </form>

                @if let Some(url) = register_url {
                    <p class="text-center text-sm text-muted-foreground">
                        Don't have an account?
                        <a href=@url class="text-primary hover:underline underline-offset-4">Create account</a>
                    </p>
                }
            </div>
        </div>
    </div>
}
