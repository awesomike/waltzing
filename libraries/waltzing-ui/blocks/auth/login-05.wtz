@*
 * Login-05 block
 * Email-only (magic link) login form
 *
 * @example
 * @import blocks/auth/login-05.wtz as login
 *
 * <@login::apply action="/auth/magic-link" />
 *
 * <@login::apply
 *     action="/auth/magic-link"
 *     email_value=Some("user@example.com")
 *     email_error=Some("Invalid email address")
 *     register_url=Some("/register")
 * />
 *@

@import /components/card.wtz as card
@import /components/input.wtz as input
@import /components/button.wtz as button
@import /components/field.wtz as field


@* Email-only magic link login form *@
@fn apply(
    action: &str,
    method: &str = "post",
    title: &str = "Sign in with email",
    description: &str = "Enter your email and we'll send you a magic link to sign in",
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    submit_text: &str = "Send magic link",
    info_text: &str = "No password needed. We'll email you a secure link to sign in instantly.",
    register_url: Option<&str> = None,
    class: &str = "",
) {
    @let container_cls = cn(&["flex min-h-screen items-center justify-center p-4", class])
    @let email_ph = Some("you@example.com")
    @let header = Some(@() {
        <@card::title>@title</@>
        <@card::description>@description</@>
    })

    <div class="@container_cls">
        <@card::apply header=@header footer=None class="w-full max-w-sm">
            <form action="@action" method="@method" class="space-y-4">
                <@field::apply label="Email" required=true error=@email_error>
                    <@input::apply
                        input_type=input::InputType::Email
                        name="email"
                        value=@email_value
                        placeholder=@email_ph
                        required=true
                        error=@email_error
                    />
                </@>

                <@button::apply variant=button::Variant::Primary size=button::Size::Default class="w-full">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-2">
                        <rect width="20" height="16" x="2" y="4" rx="2"/>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                    </svg>
                    @submit_text
                </@>

                <p class="text-center text-xs text-muted-foreground">
                    @info_text
                </p>

                @if let Some(url) = register_url {
                    <p class="text-center text-sm text-muted-foreground pt-2">
                        Don't have an account?
                        <a href="@url" class="text-primary hover:underline">Create account</a>
                    </p>
                }
            </form>
        </@>
    </div>
}
