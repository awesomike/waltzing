@*
 * Login Form Block
 * Complete login form with email/password, remember me, forgot password link,
 * and optional social login buttons
 *
 * @example
 * @import blocks/auth/login.wtz as login
 *
 * Basic usage:
 * <@login::apply action="/api/login" method="post" />
 *
 * With pre-filled values and errors:
 * <@login::apply
 *     action="/api/login"
 *     method="post"
 *     email_value=Some("user@example.com")
 *     email_error=None
 *     password_error=Some("Invalid password")
 *     remember_me=true
 *     forgot_password_href=Some("/forgot-password")
 *     show_social=true
 * />
 *
 * Wrapped in a card:
 * <@login::card
 *     action="/api/login"
 *     method="post"
 *     title="Sign in"
 *     description="Enter your credentials to access your account"
 * />
 *@

@import /components/button.wtz as button
@import /components/card.wtz as card
@import /components/checkbox.wtz as checkbox
@import /components/field.wtz as field
@import /components/input.wtz as input
@import /components/separator.wtz as separator


@* Main login form *@
@fn apply(
    action: &str,
    method: &str = "post",
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    remember_me: bool = false,
    forgot_password_href: Option<&str> = None,
    show_social: bool = false,
    google_action: Option<&str> = None,
    github_action: Option<&str> = None,
    submit_text: &str = "Sign in",
    class: &str = "",
) {
    @let form_cls = cn(&["space-y-6", class])
    @let email_ph = Some("you@example.com")
    @let password_ph = Some("Enter your password")

    <form action=@action method=@method class=@form_cls>
        <@field::apply label="Email" required=true error=@email_error>
            <@input::apply
                input_type=input::InputType::Email
                name="email"
                value=@email_value
                placeholder=@email_ph
                required=true
                error=@email_error
            />
        </@field::apply>

        <@field::apply label="Password" required=true error=@password_error>
            <@input::apply
                input_type=input::InputType::Password
                name="password"
                placeholder=@password_ph
                required=true
                error=@password_error
            />
        </@field::apply>

        <div class="flex items-center justify-between">
            <@checkbox::labeled
                label="Remember me"
                name="remember_me"
                checked=@remember_me
                description=None
            />

            @if let Some(href) = forgot_password_href {
                <a href=@href class="text-sm font-medium text-primary hover:underline underline-offset-4">
                    Forgot password?
                </a>
            }
        </div>

        <@button::apply variant=button::Variant::Primary size=button::Size::Default class="w-full">
            @submit_text
        </@button::apply>

        @if show_social {
            <div class="relative">
                <div class="absolute inset-0 flex items-center">
                    <@separator::horizontal />
                </div>
                <div class="relative flex justify-center text-xs uppercase">
                    <span class="bg-background px-2 text-muted-foreground">Or continue with</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                @if let Some(google_url) = google_action {
                    <a href=@google_url class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="h-4 w-4">
                            <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        Google
                    </a>
                } else {
                    <@button::apply variant=button::Variant::Outline size=button::Size::Default disabled=true>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="h-4 w-4">
                            <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        Google
                    </@button::apply>
                }

                @if let Some(github_url) = github_action {
                    <a href=@github_url class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                            <path d="M9 18c-4.51 2-5-2-7-2"/>
                        </svg>
                        GitHub
                    </a>
                } else {
                    <@button::apply variant=button::Variant::Outline size=button::Size::Default disabled=true>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                            <path d="M9 18c-4.51 2-5-2-7-2"/>
                        </svg>
                        GitHub
                    </@button::apply>
                }
            </div>
        }
    </form>
}

@* Login form wrapped in a card *@
@fn card(
    action: &str,
    method: &str = "post",
    title: &str = "Sign in",
    description: &str = "Enter your email and password to access your account",
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    remember_me: bool = false,
    forgot_password_href: Option<&str> = None,
    show_social: bool = false,
    google_action: Option<&str> = None,
    github_action: Option<&str> = None,
    submit_text: &str = "Sign in",
    class: &str = "",
) {
    <@card::apply
        header=@Some(@() {
            <@card::title>@title</@card::title>
            <@card::description>@description</@card::description>
        })
        footer=None
        class=@class
    >
        <@apply
            action=@action
            method=@method
            email_value=@email_value
            email_error=@email_error
            password_error=@password_error
            remember_me=@remember_me
            forgot_password_href=@forgot_password_href
            show_social=@show_social
            google_action=@google_action
            github_action=@github_action
            submit_text=@submit_text
        />
    </@card::apply>
}

@* Minimal login form with just email and password *@
@fn minimal(
    action: &str,
    method: &str = "post",
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    submit_text: &str = "Sign in",
    class: &str = "",
) {
    @let form_cls = cn(&["space-y-4", class])
    @let email_ph = Some("you@example.com")
    @let password_ph = Some("Password")

    <form action=@action method=@method class=@form_cls>
        <@field::apply label="Email" required=true error=@email_error>
            <@input::apply
                input_type=input::InputType::Email
                name="email"
                value=@email_value
                placeholder=@email_ph
                required=true
                error=@email_error
            />
        </@field::apply>

        <@field::apply label="Password" required=true error=@password_error>
            <@input::apply
                input_type=input::InputType::Password
                name="password"
                placeholder=@password_ph
                required=true
                error=@password_error
            />
        </@field::apply>

        <@button::apply variant=button::Variant::Primary size=button::Size::Default class="w-full">
            @submit_text
        </@button::apply>
    </form>
}

@* Login form with signup link *@
@fn with_signup(
    action: &str,
    method: &str = "post",
    email_value: Option<&str> = None,
    email_error: Option<&str> = None,
    password_error: Option<&str> = None,
    remember_me: bool = false,
    forgot_password_href: Option<&str> = None,
    show_social: bool = false,
    google_action: Option<&str> = None,
    github_action: Option<&str> = None,
    submit_text: &str = "Sign in",
    signup_href: &str,
    signup_text: &str = "Don't have an account?",
    signup_link_text: &str = "Sign up",
    class: &str = "",
) {
    @let wrapper_cls = cn(&["space-y-6", class])

    <div class=@wrapper_cls>
        <@apply
            action=@action
            method=@method
            email_value=@email_value
            email_error=@email_error
            password_error=@password_error
            remember_me=@remember_me
            forgot_password_href=@forgot_password_href
            show_social=@show_social
            google_action=@google_action
            github_action=@github_action
            submit_text=@submit_text
        />

        <p class="text-center text-sm text-muted-foreground">
            @signup_text
            <a href=@signup_href class="font-medium text-primary hover:underline underline-offset-4">
                @signup_link_text
            </a>
        </p>
    </div>
}
