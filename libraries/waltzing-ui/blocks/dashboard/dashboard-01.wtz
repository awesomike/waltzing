        },
    ]
}

@* Demo version with default data *@
@fn demo() {
    <@apply
        title="Dashboard"
        brand_name="Acme Inc"
        user_name="John Doe"
        user_email="john@example.com"
        nav_items=@default_nav_items()
        stats=@default_stats()
        recent_sales=@default_recent_sales()
    />
}
