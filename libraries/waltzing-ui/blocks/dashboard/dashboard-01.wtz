@*
 * Dashboard-01 block
 * A complete dashboard page with sidebar, charts, and data table
 * This is a full-page template that imports base.wtz
 *
 * @example
 * @import blocks/dashboard/dashboard-01.wtz as dashboard
 *
 * <@dashboard::apply
 *     title="Dashboard"
 *     brand_name="Acme Inc"
 *     user_name="John Doe"
 *     user_email="john@example.com"
 *     stats=vec![
 *         dashboard::Stat { label: "Total Revenue", value: "$45,231.89", change: Some("+20.1%"), trend: dashboard::Trend::Up },
 *         dashboard::Stat { label: "Subscriptions", value: "+2,350", change: Some("+180.1%"), trend: dashboard::Trend::Up },
 *         dashboard::Stat { label: "Sales", value: "+12,234", change: Some("+19%"), trend: dashboard::Trend::Up },
 *         dashboard::Stat { label: "Active Now", value: "+573", change: Some("+201"), trend: dashboard::Trend::Up },
 *     ]
 *     recent_sales=vec![
 *         dashboard::Sale { name: "Olivia Martin", email: "olivia@example.com", amount: "+$1,999.00" },
 *         dashboard::Sale { name: "Jackson Lee", email: "jackson@example.com", amount: "+$39.00" },
 *     ]
 * />
 *@

@import /layouts/base.wtz as base
@import /components/card.wtz as card
@import /components/table.wtz as table
@import /components/button.wtz as button
@import /components/dropdown.wtz as dropdown
@import /components/input.wtz as input

@* Trend direction for stat changes *@
@enum Trend {
    Up,
    Down,
    Neutral,
}

@* A statistic card item *@
@struct Stat {
    label: String,
    value: String,
    change: Option<String>,
    trend: Trend,
}

@* Navigation item *@
@struct NavItem {
    label: String,
    href: String,
    icon: Option<String>,
    active: bool,
}

@* Recent sale item for the table *@
@struct Sale {
    name: String,
    email: String,
    amount: String,
}

@* Main dashboard page *@
@fn apply(
    title: &str,
    brand_name: &str,
    user_name: &str,
    user_email: &str,
    nav_items: Vec<NavItem>,
    stats: Vec<Stat>,
    recent_sales: Vec<Sale>,
) {
    <@base::apply title=@title description=None head=None>
        <div
            x-data="{ sidebarOpen: true, sidebarCollapsed: false }"
            class="flex h-screen overflow-hidden"
        >
            @* Sidebar *@
            <aside
                :class="sidebarCollapsed ? 'w-16' : 'w-64'"
                class="flex flex-col border-r bg-card transition-all duration-300"
            >
                @* Brand *@
                <div class="flex h-16 items-center border-b px-4">
                    <div class="flex items-center gap-2">
                        @* Logo placeholder *@
                        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
                            </svg>
                        </div>
                        <span x-show="!sidebarCollapsed" x-transition class="font-semibold">@brand_name</span>
                    </div>
                </div>

                @* Navigation *@
                <nav class="flex-1 overflow-y-auto p-4">
                    <ul class="space-y-1">
                        @for item in &nav_items {
                            <li>
                                @let active_cls = class_if(item.active, "bg-accent text-accent-foreground")
                                @let link_classes = vec!["flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground", active_cls]
                                <a
                                    href="@item.href"
                                    class="@cn(@link_classes)"
                                >
                                    @if let Some(icon) = &item.icon {
                                        <span class="h-5 w-5 flex-shrink-0">@safe(icon)</span>
                                    }
                                    <span x-show="!sidebarCollapsed" x-transition>@item.label</span>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>

                @* Collapse toggle *@
                <div class="border-t p-4">
                    <button
                        @@click="sidebarCollapsed = !sidebarCollapsed"
                        class="flex w-full items-center justify-center rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="h-5 w-5 transition-transform"
                            :class="sidebarCollapsed ? 'rotate-180' : ''"
                        >
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                    </button>
                </div>
            </aside>

            @* Main content area *@
            <div class="flex flex-1 flex-col overflow-hidden">
                @* Header *@
                <header class="flex h-16 items-center justify-between border-b bg-card px-6">
                    <div class="flex items-center gap-4">
                        <h1 class="text-xl font-semibold">@title</h1>
                    </div>

                    <div class="flex items-center gap-4">
                        @* Search *@
                        <div class="relative">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.3-4.3"/>
                            </svg>
                            <@input::apply
                                input_type=input::InputType::Search
                                name="search"
                                placeholder=@Some("Search...")
                                class="w-64 pl-9"
                            />
                        </div>

                        @* User menu - simplified inline version *@
                        <div x-data="{ userMenuOpen: false }" class="relative inline-block text-left">
                            <button
                                @@click="userMenuOpen = !userMenuOpen"
                                class="flex items-center gap-2 rounded-full border p-1 pr-3 hover:bg-accent"
                            >
                                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-primary-foreground text-sm font-medium">
                                    @(user_name.chars().next().unwrap_or('U'))
                                </div>
                                <span class="text-sm font-medium">@user_name</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </button>
                            <div
                                x-show="userMenuOpen"
                                x-cloak
                                @@click.away="userMenuOpen = false"
                                class="absolute right-0 z-10 mt-2 w-56 origin-top-right rounded-md border bg-popover p-1 text-popover-foreground shadow-md"
                            >
                                <div class="px-2 py-1.5 text-sm font-semibold">
                                    <p class="font-medium">@user_name</p>
                                    <p class="text-xs text-muted-foreground">@user_email</p>
                                </div>
                                <div class="-mx-1 my-1 h-px bg-muted"></div>
                                <a href="/profile" class="relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground">Profile</a>
                                <a href="/settings" class="relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground">Settings</a>
                                <div class="-mx-1 my-1 h-px bg-muted"></div>
                                <button class="relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground">Sign out</button>
                            </div>
                        </div>
                    </div>
                </header>

                @* Content *@
                <main class="flex-1 overflow-y-auto bg-muted/40 p-6">
                    <div class="space-y-6">
                        @* Stats grid *@
                        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
                            @for stat in &stats {
                                <@stat_card stat=@stat />
                            }
                        </div>

                        @* Chart and recent sales *@
                        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-7">
                            @* Chart area *@
                            <@card::apply
                                header=@Some(@() {
                                    <@card::title>Overview</@card::title>
                                    <@card::description>Revenue over the last 6 months</@card::description>
                                })
                                footer=None
                                class="lg:col-span-4"
                            >
                                @* Placeholder chart using CSS *@
                                <div class="h-[300px] w-full">
                                    <@chart_placeholder />
                                </div>
                            </@card::apply>

                            @* Recent sales *@
                            <@card::apply
                                header=@Some(@() {
                                    <@card::title>Recent Sales</@card::title>
                                    <@card::description>You made @(recent_sales.len()) sales this month.</@card::description>
                                })
                                footer=None
                                class="lg:col-span-3"
                            >
                                <div class="space-y-4">
                                    @for sale in &recent_sales {
                                        <div class="flex items-center gap-4">
                                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-muted text-sm font-medium">
                                                @(sale.name.chars().next().unwrap_or('?'))
                                            </div>
                                            <div class="flex-1 space-y-1">
                                                <p class="text-sm font-medium leading-none">@sale.name</p>
                                                <p class="text-sm text-muted-foreground">@sale.email</p>
                                            </div>
                                            <div class="font-medium">@sale.amount</div>
                                        </div>
                                    }
                                </div>
                            </@card::apply>
                        </div>

                        @* Data table *@
                        <@card::apply header=@Some(@() {
                            <@card::title>Recent Transactions</@card::title>
                            <@card::description>A list of your recent transactions.</@card::description>
                        }) footer=None>
                            <@table::apply
                                header=@() {
                                    <@table::header_row>
                                        <@table::th>Customer</@table::th>
                                        <@table::th>Email</@table::th>
                                        <@table::th>Amount</@table::th>
                                        <@table::th class="text-right">Status</@table::th>
                                    </@table::header_row>
                                }
                                body=@() {
                                    @for sale in &recent_sales {
                                        <@table::row>
                                            <@table::td class="font-medium">@sale.name</@table::td>
                                            <@table::td>@sale.email</@table::td>
                                            <@table::td>@sale.amount</@table::td>
                                            <@table::td class="text-right">
                                                <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-1 text-xs font-medium text-green-700">
                                                    Completed
                                                </span>
                                            </@table::td>
                                        </@table::row>
                                    }
                                }
                            />
                        </@card::apply>
                    </div>
                </main>
            </div>
        </div>
    </@base::apply>
}

@* Stat card component *@
@fn stat_card(stat: &Stat) {
    @let trend_color = match stat.trend {
        Trend::Up => "text-green-600",
        Trend::Down => "text-red-600",
        Trend::Neutral => "text-muted-foreground",
    }
    @let trend_icon = match stat.trend {
        Trend::Up => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m18 15-6-6-6 6\"/></svg>",
        Trend::Down => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>",
        Trend::Neutral => "",
    }

    <@card::simple>
        <div class="flex flex-row items-center justify-between space-y-0 pb-2">
            <h3 class="text-sm font-medium tracking-tight">@stat.label</h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
        </div>
        <div class="text-2xl font-bold">@stat.value</div>
        @if let Some(change) = &stat.change {
            <p class="text-xs @trend_color flex items-center gap-1">
                @safe(trend_icon)
                @change from last month
            </p>
        }
    </@card::simple>
}

@* Placeholder bar chart using CSS *@
@fn chart_placeholder() {
    <div class="flex h-full w-full items-end justify-between gap-2 px-4 pb-4 pt-8">
        @let heights = vec!["45%", "65%", "40%", "80%", "55%", "75%", "60%", "90%", "70%", "85%", "50%", "95%"]
        @let months = vec!["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
        @for (i, height) in heights.iter().enumerate() {
            <div class="flex flex-1 flex-col items-center gap-2">
                <div
                    class="w-full rounded-t bg-primary/80 transition-all hover:bg-primary"
                    style="height: @height"
                ></div>
                <span class="text-xs text-muted-foreground">@months[i]</span>
            </div>
        }
    </div>
}

@* Demo version - data should be provided by the caller *@
@*
 * To use this component for a demo, call the apply function with
 * sample data from your Rust application:
 *
 * <@dashboard::apply
 *     title="Dashboard"
 *     brand_name="Acme Inc"
 *     user_name="John Doe"
 *     user_email="john@example.com"
 *     nav_items=@nav_items
 *     stats=@stats
 *     recent_sales=@recent_sales
 * />
 *@
