{
  "name": "waltzing-tree-sitter",
  "version": "0.1.0",
  "description": "Waltzing template language grammar for tree-sitter",
  "main": "bindings/node",
  "repository": {
    "type": "git",
    "url": "https://github.com/awesomike/waltzing.git"
  },
  "keywords": [
    "tree-sitter",
    "parser",
    "waltzing",
    "template"
  ],
  "author": "Michael <michael@awesomike.com>",
  "license": "MIT",
  "dependencies": {
    "nan": "^2.17.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.24.0"
  },
  "scripts": {
    "build": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "tree-sitter": [
    {
      "scope": "source.waltzing",
      "file-types": [
        "wtz",
        "html.wtz",
        "css.wtz",
        "js.wtz"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "waltzing"
    }
  ]
}
